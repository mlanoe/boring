{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Boring",
  "scopeName": "source.boring",
  "fileTypes": ["br"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#triple-string" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#attribute" },
    { "include": "#function-definition" },
    { "include": "#type-definition" },
    { "include": "#constants" },
    { "include": "#self" },
    { "include": "#control-keywords" },
    { "include": "#declaration-keywords" },
    { "include": "#operator-keywords" },
    { "include": "#builtin-types" },
    { "include": "#ownership-qualifier" },
    { "include": "#impl-shorthand" },
    { "include": "#type-name" },
    { "include": "#leading-dot" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {

    "comment": {
      "name": "comment.line.hash.boring",
      "match": "#.*$"
    },

    "triple-string": {
      "name": "string.quoted.triple.boring",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        { "include": "#escape" },
        { "include": "#string-interpolation" }
      ]
    },

    "string": {
      "name": "string.quoted.double.boring",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "include": "#escape" },
        { "include": "#string-interpolation" }
      ]
    },

    "string-interpolation": {
      "name": "meta.interpolation.boring",
      "begin": "\\{(?![{}])",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.boring" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.boring" }
      },
      "contentName": "source.boring.embedded",
      "patterns": [
        {
          "name": "constant.other.format-spec.boring",
          "match": ":[^}]*"
        },
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#constants" },
        { "include": "#self" },
        { "include": "#builtin-types" },
        { "include": "#ownership-qualifier" },
        { "include": "#type-name" },
        { "include": "#function-call" },
        { "include": "#operators" }
      ]
    },

    "escape": {
      "name": "constant.character.escape.boring",
      "match": "\\{\\{|\\}\\}|\\{\\}|\\\\(?:[nrt\\\\\"0]|u\\{[0-9A-Fa-f]+\\})"
    },

    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.boring",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.boring",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\\b"
        },
        {
          "name": "constant.numeric.binary.boring",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.boring",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.integer.boring",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },

    "attribute": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "punctuation.definition.attribute.boring" },
        "2": { "name": "entity.other.attribute-name.boring" }
      }
    },

    "function-definition": {
      "patterns": [
        {
          "comment": "def / req with explicit return type: `string greet(...)` or `def string greet(...)`",
          "match": "\\b(def|req)\\s+(?:[A-Za-z_?\\[\\]{},<> ]+?\\s+)?([a-z_][A-Za-z0-9_]*)\\s*(?:<[^>]*>)?\\s*\\(",
          "captures": {
            "1": { "name": "keyword.other.declaration.boring" },
            "2": { "name": "entity.name.function.boring" }
          }
        },
        {
          "comment": "shorthand: return type directly, no def/req keyword; also handles <Trait> return type",
          "match": "(?:\\b(?:int|uint|float|bool|string|str|void|[A-Z][A-Za-z0-9_]*)(?:\\?)?(?:'[a-z]+)?|<[A-Z][A-Za-z0-9_]*>)\\s+([a-z_][A-Za-z0-9_]*)\\s*(?:<[^>]*>)?\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.boring" }
          }
        },
        {
          "comment": "stream function: `stream int next():`",
          "match": "\\b(stream)\\s+(?:[A-Za-z_?\\[\\]{},<> ]+?\\s+)?([a-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.other.declaration.boring" },
            "2": { "name": "entity.name.function.boring" }
          }
        },
        {
          "comment": "task shorthand: `task string transform(...)`",
          "match": "\\b(task)\\s+(?:[A-Za-z_?\\[\\]{},<> ]+?\\s+)?([a-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.other.declaration.boring" },
            "2": { "name": "entity.name.function.boring" }
          }
        }
      ]
    },

    "type-definition": {
      "match": "\\b(struct|enum|trait)\\s+([A-Z][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.declaration.boring" },
        "2": { "name": "entity.name.type.boring" }
      }
    },

    "constants": {
      "name": "constant.language.boring",
      "match": "\\b(true|false|nil|void)\\b"
    },

    "self": {
      "name": "variable.language.self.boring",
      "match": "\\bself\\b"
    },

    "control-keywords": {
      "name": "keyword.control.boring",
      "match": "\\b(if|elif|else|while|do|loop|for|in|break|continue|guard|match|return|throw|try|catch|defer|yield|wait)\\b"
    },

    "declaration-keywords": {
      "name": "keyword.other.declaration.boring",
      "match": "\\b(let|mut|var|def|req|struct|enum|trait|use|ext|as|type|mod|init|pub|native|stream|set|task|static|transient|pass|any|select|join|channel)\\b"
    },

    "operator-keywords": {
      "name": "keyword.operator.word.boring",
      "match": "\\b(and|or|not|is|throws)\\b"
    },

    "builtin-types": {
      "name": "storage.type.boring",
      "match": "\\b(int|uint|float|bool|string|str)\\b"
    },

    "ownership-qualifier": {
      "patterns": [
        {
          "comment": "qualified: 'heap, 'task, 'shared, 'actor, 'auto, 'weak, 'copy, 'const, 'stack",
          "name": "storage.modifier.ownership.boring",
          "match": "'(?:heap|task|shared|actor|auto|weak|copy|const|stack|guard)\\b"
        },
        {
          "comment": "bare tick before identifier or opening paren — ownership inferred from RHS",
          "name": "storage.modifier.ownership.boring",
          "match": "'(?=[A-Za-z(])"
        }
      ]
    },

    "leading-dot": {
      "comment": "Leading-dot shorthand for type-inferred calls: .fromSecs(5), .Variant, .North",
      "match": "(?<![.A-Za-z0-9_])\\.([A-Z][A-Za-z0-9_]*|[a-z][A-Za-z0-9_]*(?=\\())",
      "captures": {
        "1": { "name": "entity.name.boring" }
      }
    },

    "impl-shorthand": {
      "comment": "<Trait> shorthand for impl Trait",
      "match": "<([A-Z][A-Za-z0-9_]*)>",
      "captures": {
        "1": { "name": "entity.name.type.boring" }
      }
    },

    "type-name": {
      "comment": "PascalCase identifiers — struct, enum, or type names",
      "name": "entity.name.type.boring",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },

    "function-call": {
      "comment": "any lowercase identifier immediately followed by `(`",
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.boring" }
      }
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.boring",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.range.boring",
          "match": "\\.\\.<|\\.\\."
        },
        {
          "name": "keyword.operator.arrow.boring",
          "match": "->"
        },
        {
          "name": "keyword.operator.nil-coalescing.boring",
          "match": "\\?="
        },
        {
          "name": "keyword.operator.optional-chain.boring",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.compound-assign.boring",
          "match": "[+\\-*/%&|^]=|<<="
        },
        {
          "name": "keyword.operator.comparison.boring",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.boring",
          "match": "(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.boring",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise.boring",
          "match": "[&|^~]"
        },
        {
          "name": "keyword.operator.macro.boring",
          "match": "!"
        }
      ]
    }
  }
}
