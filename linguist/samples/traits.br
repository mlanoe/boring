# Boring language sample — traits, generics, closures

# ── Traits ────────────────────────────────────────────────────────────────────

trait Named:
    req string name()

# Supertrait: Describable requires Named
trait Describable as Named:
    req string describe():          # default implementation
        "{self.name()} (no description)"

struct Animal as Describable:
    string species
    string sound

    req string name(): self.species

    req string describe():
        "{self.species} says {self.sound}"

let cat = Animal(species = "Cat", sound = "meow")
print cat.describe()

# ── <Trait> impl-shorthand — `impl Trait` return type ─────────────────────────

# <Trait> as return type means "impl Trait" (static dispatch, no allocation)
<Describable> make_animal(string species, string sound):
    Animal(species = species, sound = sound)

let dog = make_animal("Dog", "woof")
print dog.describe()

# Bare `Trait` as return type means `Box<dyn Trait>` (dynamic dispatch, heap)
# Describable clone_animal(Animal a): a

# ── Leading-dot shorthand ─────────────────────────────────────────────────────

enum Direction:
    North
    South
    East
    West

string dir_name(Direction d):
    match d:
        Direction.North: "north"
        Direction.South: "south"
        _:               "other"

# Leading-dot: compiler infers type from context (Direction known from param)
print dir_name(.North)
print dir_name(.South)

# ── Generics ──────────────────────────────────────────────────────────────────

T first<T>([T] items): items[0]
T identity<T>(T x): x

print first([10, 20, 30])
print identity("hello")

struct Pair<T, U>:
    T first
    U second

let p = Pair(10, "hello")
print "{p.first} / {p.second}"

# ── Closures and higher-order functions ───────────────────────────────────────

let double  = (n): n * 2
let add_one = (n): n + 1

int apply(int f(int), int x): f(x)

print apply(double, 21)

let pipeline = [double, add_one, double]
var val = 3
for fn in pipeline:
    val = fn(val)
print "pipeline(3) = {val}"

# ── Pipe operator |> ──────────────────────────────────────────────────────────

int inc(int n): n + 1

let result = 5
    |> double()
    |> inc()
    |> inc()
print result    # 13

# ── Error handling ────────────────────────────────────────────────────────────

enum AppError:
    NotFound
    InvalidInput(string)

def void risky(int n) throws AppError:
    if n == 1: throw AppError.NotFound
    if n == 2: throw AppError.InvalidInput("bad value")

let msg = try risky(1) else:
    match error:
        AppError.NotFound:          "not found"
        AppError.InvalidInput(m):   "invalid: {m}"
        _:                          "other: {error}"
print msg

# ── Optionals ─────────────────────────────────────────────────────────────────

let int? some = 42
let int? none = nil
print "{some else 0}, {none else 0}"

# ── Defer ─────────────────────────────────────────────────────────────────────

string with_cleanup():
    var log = ""
    defer: log = log + "+closed"
    log = log + "open"
    log

print with_cleanup()    # open+closed
