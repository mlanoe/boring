# Boring language sample — GPU kernel structs (CUDA / Metal / wgpu)
# Build with: boring build --target cuda
#         or: boring build --target metal
#         or: boring build --target wgpu

# ── SAXPY: y = alpha * x + y ──────────────────────────────────────────────────

kernel Saxpy:
    let float alpha             # 'const inferred — scalar let → constant cache
    let [float]'global x        # device-only read array
    mut [float]'global y        # device-only write array

    init(float a, [float] xs, [float] ys):
        alpha = a
        x = xs
        y = ys

    def ():
        let i = gpu.thread.x + gpu.block.x * gpu.block_dim.x
        y[i] = alpha * x[i] + y[i]

let n = 1024
let xs = [i as float for i in ..n]
let ys = [1.0 for ..n]

mut k = Saxpy(2.0, xs, ys)
kernel:
    k(block = 256)

print "y[0] = {k.y[0]}"    # 1.0
print "y[1] = {k.y[1]}"    # 3.0

# ── Const generic params — fixed-size tile ─────────────────────────────────────
#
# kernel Foo<int W, int H>: declares compile-time constants W and H.
# Array sizes may reference them directly or as expressions.
# wgpu monomorphises each unique instantiation into a distinct WGSL shader.

kernel Blur<int W, int H>:
    let [float, W * H]'const weights    # constant cache — size known at compile time
    let [float]'global        input
    mut [float]'global        output
    let float                 sigma = 1.0   # scalar default — omitted from constructor

    init([float] w, [float] inp, [float] out):
        weights = w
        input   = inp
        output  = out

    def ():
        let i = gpu.thread.x + gpu.block.x * gpu.block_dim.x
        var acc = 0.0
        for k in 0..W * H:
            acc = acc + weights[k] * input[i + k]
        output[i] = acc

let w = [0.25, 0.5, 0.25]
let pixels = [i as float for i in ..1024]
mut result = [0.0 for ..1024]

mut blur = Blur<3, 1>(w, pixels, result)
kernel:
    blur(block = 256)

# ── Shared-memory tile reduction ───────────────────────────────────────────────

kernel TileSum:
    let [float]'global  data
    mut [float]'unified result
    mut [float, 256]'actor tile   # block SRAM — barriers inserted automatically

    init([float] data, [float]'unified result):
        data = data
        result = result

    def ():
        let i    = gpu.thread.x + gpu.block.x * gpu.block_dim.x
        let tid  = gpu.thread.x
        tile[tid] = data[i]

        var stride = gpu.block_dim.x / 2
        while stride > 0:
            if tid < stride:
                tile[tid] = tile[tid] + tile[tid + stride]
            stride = stride / 2

        if tid == 0:
            result[gpu.block.x] = tile[0]

let data    = [i as float for i in ..1024]
mut partial = [0.0 for ..4]

mut ts = TileSum(data, partial)
kernel:
    ts(block = 256, grid = 4)

let total = partial.reduce(0.0, (acc, v): acc + v)
print "sum = {total}"
