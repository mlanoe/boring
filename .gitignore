# Scratch project-mode Cargo project for tests/transpile.rs's `ext_const_promotion` case
# (needs a real `boring.toml` project dir, unlike every other `tests/cases/*_rust/` case
# above, which is a single flat `.br` file `--emit-rust` never nests under `src/`).
tests/cases/ext_const_promotion/src/main_rust/
tests/cases/ext_const_promotion/src/main_rust_single/
tests/cases/ext_const_promotion/src/main_rust_managed/
tests/cases/ext_const_promotion/src/main_rust_managed_single/
