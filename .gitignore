tests/cases/ext_tuple_construct/src/main_rust/
tests/cases/ext_tuple_construct/src/main_rust_single/
tests/cases/ext_tuple_construct/src/main_rust_managed/
tests/cases/ext_tuple_construct/src/main_rust_managed_single/
