# == EXEC AND CALL ==

# ─── exec_block ───────────────────────────────────────────────────────────────

def Signal? exec_block(mut Interpreter interp, [Stmt] stmts):
    for stmt in stmts:
        let Signal? sig = exec_stmt(interp, stmt)
        if sig != nil:
            return sig
    nil

# Like exec_block but treats the last Stmt::Expr as an implicit return value
def Signal? exec_block_do(mut Interpreter interp, [Stmt] stmts):
    let n = stmts.length
    var i = 0
    while i < n:
        let stmt = stmts[i]
        if i == n - 1:
            match stmt:
                Stmt.Expr(e):
                    let val = eval_expr(interp, e)
                    if interp.has_pending_return:
                        return nil
                    return YieldSignal(val, 0)
                Stmt.If(s):
                    return exec_if_as_do(interp, s)
                _:
                    let sig = exec_stmt(interp, stmt)
                    if sig != nil:
                        return sig
        else:
            let sig = exec_stmt(interp, stmt)
            if sig != nil:
                return sig
        i = i + 1
    nil

def Signal? exec_if_as_do(mut Interpreter interp, IfStmt s):
    for branch in s.branches:
        let cond_val = eval_expr(interp, branch.cond)
        let b = expect_bool(cond_val)
        if b:
            let child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block_do(interp, branch.body)
            interp.current_env = prev
            if sig != nil:
                return sig
            return nil
    if let else_body = s.else_body:
        let child = new_env(interp.current_env)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block_do(interp, else_body)
        interp.current_env = prev
        if sig != nil:
            return sig
    nil

def Signal? exec_if_as_expr(mut Interpreter interp, IfStmt s):
    for branch in s.branches:
        let cond_val = eval_expr(interp, branch.cond)
        let b = expect_bool(cond_val)
        if b:
            let child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block_fn(interp, branch.body)
            interp.current_env = prev
            if sig != nil:
                return sig
            return ReturnSignal(Value.Nil)
    if let else_body = s.else_body:
        let child = new_env(interp.current_env)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block_fn(interp, else_body)
        interp.current_env = prev
        if sig != nil:
            return sig
        return ReturnSignal(Value.Nil)
    ReturnSignal(Value.Nil)

def Signal? exec_match_as_expr(mut Interpreter interp, MatchStmt s):
    let subject = eval_expr(interp, s.subject)
    let result = eval_match(interp, subject, s.arms)
    ReturnSignal(result)

def Signal? exec_block_fn(mut Interpreter interp, [Stmt] stmts):
    var [[Stmt]] defers = []
    let n = stmts.length
    var i = 0
    var Signal? final_sig = nil
    while i < n:
        let stmt = stmts[i]
        match stmt:
            Stmt.Defer(body):
                defers.push(body)
            _:
                if i == n - 1:
                    match stmt:
                        Stmt.Expr(e):
                            let val = eval_expr(interp, e)
                            if interp.has_pending_throw:
                                final_sig = ThrowSignal(interp.take_pending_throw())
                            else:
                                final_sig = ReturnSignal(val)
                        Stmt.If(s):
                            final_sig = exec_if_as_expr(interp, s)
                        Stmt.Match(s):
                            final_sig = exec_match_as_expr(interp, s)
                        _:
                            let sig = exec_stmt(interp, stmt)
                            if sig != nil:
                                final_sig = sig
                else:
                    let sig = exec_stmt(interp, stmt)
                    if sig != nil:
                        final_sig = sig
        if final_sig != nil:
            break
        i = i + 1
    if defers.length > 0:
        var di = defers.length - 1
        while di >= 0:
            exec_block(interp, defers[di])
            di = di - 1
    final_sig

# ─── exec_stmt ────────────────────────────────────────────────────────────────

def Signal? exec_stmt(mut Interpreter interp, Stmt stmt):
    match stmt:
        Let(s):
            var val = Uninitialized
            var string? move_source = nil
            if let expr = s.value:
                match expr.kind:
                    ExprKind.Var(src): move_source = some(src)
                    _: nil
                val = eval_expr(interp, expr)
                if interp.has_pending_throw:
                    return ThrowSignal(interp.take_pending_throw())
                # Note: move semantics not enforced in interpreter — all values treated as copyable
            if s.is_lazy:
                interp.current_env.define_lazy(s.name)
            elif s.mutable:
                interp.current_env.define_mut(s.name, val)
            else:
                interp.current_env.define(s.name, val)
            nil

        If(s):
            exec_if(interp, s)

        While(s):
            exec_while(interp, s)

        For(s):
            exec_for(interp, s)

        Match(s):
            exec_match_stmt(interp, s)

        Return(s):
            var val = Nil
            if let expr = s.value:
                val = eval_expr(interp, expr)
                if interp.has_pending_throw:
                    return ThrowSignal(interp.take_pending_throw())
            ReturnSignal(val)

        Break(line, value_expr):
            var break_val = Void
            if let expr = value_expr:
                break_val = eval_expr(interp, expr)
            BreakSignal(break_val)

        Continue:
            ContinueSignal

        Yield(expr, _):
            let yv = eval_expr(interp, expr)
            if interp.in_stream_fn:
                var sy = interp.stream_yields
                sy.push(yv)
                interp.stream_yields = sy
                nil
            else:
                YieldSignal(yv, 0)

        Throw(s):
            var val = Nil
            if let expr = s.value:
                val = eval_expr(interp, expr)
            else:
                let err = interp.current_env.get("error")
                val = err else Nil
            ThrowSignal(val)

        Try(s):
            exec_try(interp, s)

        DoWhile(s):
            exec_do_while(interp, s)

        Expr(expr):
            eval_expr(interp, expr)
            if interp.has_pending_throw:
                interp.has_pending_return = false
                interp.pending_return_val = Value.Nil
                return ThrowSignal(interp.take_pending_throw())
            if interp.has_pending_return:
                let v = interp.pending_return_val
                interp.has_pending_return = false
                interp.pending_return_val = Value.Nil
                return ReturnSignal(v)
            nil

        Guard(s):
            let cond_val = match s.cond:
                GuardCond.Expr(e): eval_expr(interp, e)
                GuardCond.Clauses(clauses):
                    var all_true = true
                    var ci = 0
                    while ci < clauses.length and all_true:
                        let clause = clauses[ci]
                        match clause:
                            CondClause.Expr(e):
                                if not val_to_bool(eval_expr(interp, e)):
                                    all_true = false
                            CondClause.Let(name, e):
                                let v = eval_expr(interp, e)
                                match v:
                                    Value.Nil: all_true = false
                                    _: interp.current_env.define(name, v)
                            _: nil
                        ci = ci + 1
                    Value.Bool(all_true)
            let passed = val_to_bool(cond_val)
            if not passed:
                let child = new_env(interp.current_env)
                let prev = interp.current_env
                interp.current_env = child
                let sig = exec_block(interp, s.else_body)
                interp.current_env = prev
                if sig != nil:
                    return sig
            nil

        LetDestructure(s):
            let val = eval_expr(interp, s.value)
            var elems = []
            match val:
                Value.Tuple(items): elems = items
                Value.Array(items): elems = items
                _: elems = [val]
            var i = 0
            for binding in s.bindings:
                if binding.name == "_":
                    i = i + 1
                    continue
                let v = elems[i] else Value.Nil
                if s.mutable:
                    interp.current_env.define_mut(binding.name, v)
                else:
                    interp.current_env.define(binding.name, v)
                i = i + 1
            nil

        Loop(s):
            exec_loop(interp, s)

        IfLet(s):
            exec_if_let(interp, s)

        WhileLet(s):
            exec_while_let(interp, s)

        Fn(decl):
            # Nested function declaration — register in current scope
            let fn_name = decl.name
            interp.set_fn_decl(fn_name, decl)
            let fn_val = Value.Fn(fn_name, interp.current_env)
            interp.current_env.define(fn_name, fn_val)
            nil

        Struct(decl):
            # Nested struct declaration
            let sname = decl.name
            interp.set_struct_decl(sname, decl)
            interp.set_method_decls(sname, decl.methods)
            interp.current_env.define(sname, Value.StructDef(sname))
            nil

        Enum(decl):
            # Nested enum declaration
            let ename = decl.name
            interp.set_enum_decl(ename, decl)
            interp.set_method_decls(ename, decl.methods)
            interp.current_env.define(ename, Value.EnumDef(ename))
            nil

        Mod(decl):
            for sub_item in decl.items:
                exec_item(interp, sub_item)
            nil

        KernelBlock(body, _):
            exec_kernel_block(interp, body)

        _: nil

# ─── exec_if_let ──────────────────────────────────────────────────────────────

def Signal? exec_if_let(mut Interpreter interp, IfLetStmt s):
    let all_matched = exec_if_let_match(interp, s.clauses)
    if all_matched:
        let child = interp.current_env
        let sig = exec_block(interp, s.then_body)
        interp.current_env = child
        return sig
    if let else_stmts = s.else_body:
        return exec_block(interp, else_stmts)
    nil

def Value eval_in_env(mut Interpreter interp, Env'actor env, Expr expr):
    let prev = interp.current_env
    interp.current_env = env
    let v = eval_expr(interp, expr)
    interp.current_env = prev
    v

def bool exec_if_let_match(mut Interpreter interp, [CondClause] clauses):
    # Evaluate all bindings in the parent scope, populate child env
    let child = new_env(interp.current_env)
    var all_matched = true
    var ci = 0
    while all_matched and ci < clauses.length:
        let clause = clauses[ci]
        ci = ci + 1
        match clause:
            CondClause.Let(name, expr):
                let v = eval_expr(interp, expr)
                match v:
                    Value.Nil: all_matched = false
                    _: child.define(name, v)
            CondClause.LetPat(pat, expr):
                let v = eval_expr(interp, expr)
                if not match_pattern(v, pat, child):
                    all_matched = false
            CondClause.Expr(expr):
                # guard: eval in child context via helper (forces Arc::clone at call site)
                let gv = eval_in_env(interp, child, expr)
                if not val_to_bool(gv):
                    all_matched = false
    if all_matched:
        interp.current_env = child
    all_matched

# ─── exec_while_let ───────────────────────────────────────────────────────────

def Signal? exec_while_let_pattern(mut Interpreter interp, Pattern pattern, Expr value_expr, [Stmt] body):
    while true:
        let v = eval_expr(interp, value_expr)
        let child = new_env(interp.current_env)
        if not match_pattern(v, pattern, child):
            break
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block(interp, body)
        interp.current_env = prev
        match sig:
            BreakSignal(_): return nil
            ReturnSignal(rv): return ReturnSignal(rv)
            ThrowSignal(tv): return ThrowSignal(tv)
            _: nil
    nil

def Signal? exec_while_let_simple(mut Interpreter interp, string name, Expr value_expr, [Stmt] body):
    while true:
        let v = eval_expr(interp, value_expr)
        match v:
            Value.Nil: break
            _:
                let child = new_env(interp.current_env)
                child.define(name, v)
                let prev = interp.current_env
                interp.current_env = child
                let sig = exec_block(interp, body)
                interp.current_env = prev
                match sig:
                    BreakSignal(_): return nil
                    ReturnSignal(rv): return ReturnSignal(rv)
                    ThrowSignal(tv): return ThrowSignal(tv)
                    _: nil
    nil

def Signal? exec_while_let(mut Interpreter interp, WhileLetStmt s):
    if let pattern = s.pattern:
        exec_while_let_pattern(interp, pattern, s.value, s.body)
    else:
        exec_while_let_simple(interp, s.name, s.value, s.body)

# ─── exec_loop ────────────────────────────────────────────────────────────────

def Signal? exec_loop(mut Interpreter interp, LoopStmt s):
    while true:
        let child = new_env(interp.current_env)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block(interp, s.body)
        interp.current_env = prev
        match sig:
            BreakSignal(_): return nil
            ReturnSignal(v): return ReturnSignal(v)
            ThrowSignal(v): return ThrowSignal(v)
            _: nil
    nil

# ─── exec_do_while ────────────────────────────────────────────────────────────

def Signal? exec_do_while(mut Interpreter interp, DoWhileStmt s):
    while true:
        let child = new_env(interp.current_env)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block(interp, s.body)
        interp.current_env = prev
        match sig:
            BreakSignal(_): return nil
            ReturnSignal(v): return ReturnSignal(v)
            ThrowSignal(v): return ThrowSignal(v)
            _: nil
        let cond_val = eval_expr(interp, s.condition)
        let cond = expect_bool(cond_val)
        if not cond:
            break
    nil

# ─── exec_if ──────────────────────────────────────────────────────────────────

def Signal? exec_if(mut Interpreter interp, IfStmt s):
    for branch in s.branches:
        let cond_val = eval_expr(interp, branch.cond)
        let b = expect_bool(cond_val)
        if b:
            let child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block(interp, branch.body)
            interp.current_env = prev
            return sig
    if let else_body = s.else_body:
        let child = new_env(interp.current_env)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block(interp, else_body)
        interp.current_env = prev
        return sig
    nil

# ─── exec_while ───────────────────────────────────────────────────────────────

def Signal? exec_while(mut Interpreter interp, WhileStmt s):
    var running = true
    var Signal? result = nil
    while running:
        let cond_val = eval_expr(interp, s.condition)
        let b = expect_bool(cond_val)
        if not b:
            running = false
        else:
            let child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block(interp, s.body)
            interp.current_env = prev
            match sig:
                nil: nil
                BreakSignal(_): running = false
                ContinueSignal: nil
                _:
                    running = false
                    result = sig
    result

# ─── exec_for ─────────────────────────────────────────────────────────────────

def Signal? exec_for(mut Interpreter interp, ForStmt s):
    let iterable = eval_expr(interp, s.iterable)
    let items = collect_iterable_with_interp(interp, iterable)
    var Signal? result = nil
    var idx = 0
    var done = false
    while not done and idx < items.length:
        let item = items[idx]
        idx = idx + 1
        let child = new_env(interp.current_env)
        let vars = s.vars
        if vars.length == 1:
            child.define_mut(vars[0], item)
        else:
            match item:
                Tuple(elems):
                    var i = 0
                    for v in vars:
                        let val = if i < elems.length: elems[i] else: Value.Nil
                        child.define_mut(v, val)
                        i = i + 1
                _:
                    child.define_mut(vars[0], Int(idx - 1))
                    if vars.length >= 2:
                        child.define_mut(vars[1], item)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block(interp, s.body)
        interp.current_env = prev
        match sig:
            nil: nil
            BreakSignal(_): done = true
            ContinueSignal: nil
            _:
                done = true
                result = sig
    result

# ─── collect_iterable ─────────────────────────────────────────────────────────

def [Value] collect_iterable(Value val):
    match val:
        Array(elems): elems
        Set(elems): elems
        Tuple(elems): elems
        Value.Dict(pairs):
            var out = []
            for p in pairs:
                out.push(Tuple([p.0, p.1]))
            out
        Range(start, end, inclusive, _):
            var out = []
            var i = start
            let limit = if inclusive: end + 1 else: end
            while i < limit:
                out.push(Int(i))
                i = i + 1
            out
        Str(s):
            var out = []
            for c in s.chars():
                out.push(Value.Str(c))
            out
        _: throw "value is not iterable"

def [Value] collect_iterable_with_interp(Interpreter interp, Value val):
    match val:
        Value.Object(rx_inner):
            if rx_inner.type_name != "__ChannelRx__":
                throw "value is not iterable"
            let ch_id_opt = rx_inner.get_field("__ch_id__")
            if let ch_id_val = ch_id_opt:
                let ch_key = match ch_id_val:
                    Value.Str(s): s
                    _: ""
                if ch_key != "":
                    let queue_opt = interp.channel_queues.get(ch_key)
                    if let q = queue_opt:
                        return q
            []
        _: collect_iterable(val)

# ─── exec_match_stmt ──────────────────────────────────────────────────────────

def Signal? exec_match_stmt(mut Interpreter interp, MatchStmt s):
    let subject = eval_expr(interp, s.subject)
    var matched = false
    var Signal? result = nil
    var arm_idx = 0
    while not matched and arm_idx < s.arms.length:
        let arm = s.arms[arm_idx]
        arm_idx = arm_idx + 1
        var pat_idx = 0
        while not matched and pat_idx < arm.patterns.length:
            let pattern = arm.patterns[pat_idx]
            pat_idx = pat_idx + 1
            let child = new_env(interp.current_env)
            let did_match = match_pattern(subject, pattern, child)
            if did_match:
                var guard_ok = true
                if let guard_expr = arm.match_guard:
                    let gprev = interp.current_env
                    interp.current_env = child.clone()
                    let gv = eval_expr(interp, guard_expr)
                    interp.current_env = gprev
                    guard_ok = expect_bool(gv)
                if guard_ok:
                    matched = true
                    let prev = interp.current_env
                    interp.current_env = child
                    let sig = match arm.body:
                        MatchBody.Expr(e):
                            eval_expr(interp, e)
                            nil
                        MatchBody.Block(stmts):
                            exec_block(interp, stmts)
                    interp.current_env = prev
                    result = sig
    result

# ─── match_pattern ────────────────────────────────────────────────────────────

def Value expr_to_value_literal(Expr expr):
    match expr.kind:
        ExprKind.Int(n): Value.Int(n)
        ExprKind.Float(f): Value.Float(f)
        ExprKind.Str(s): Value.Str(s)
        ExprKind.Bool(b): Value.Bool(b)
        ExprKind.Nil: Value.Nil
        ExprKind.Void: Value.Nil
        _: Value.Nil

def bool match_pattern(Value val, Pattern pattern, Env'actor env):
    match pattern:
        Pattern.Wildcard:
            true
        Pattern.Bind(name):
            env.define(name, val)
            true
        Pattern.None:
            match val:
                Value.Nil: true
                Value.EnumVariant(stype, svariant, sfields):
                    svariant == "None" or svariant == "none"
                _: false
        Pattern.Some(inner):
            match val:
                Value.Nil: false
                Value.EnumVariant(stype, svariant, sfields):
                    if svariant == "Some" or svariant == "some":
                        if sfields.length == 1:
                            match_pattern(sfields[0], inner, env)
                        else:
                            match_pattern(Value.Tuple(sfields), inner, env)
                    else:
                        false
                _: match_pattern(val, inner, env)
        Pattern.Lit(lit):
            match lit:
                LitPattern.Int(n):
                    match val:
                        Value.Int(v): v == n
                        _: false
                LitPattern.Float(f):
                    match val:
                        Value.Float(v): v == f
                        _: false
                LitPattern.Str(s):
                    match val:
                        Value.Str(v): v == s
                        _: false
                LitPattern.Bool(b):
                    match val:
                        Value.Bool(v): v == b
                        _: false
                LitPattern.Nil:
                    match val:
                        Value.Nil: true
                        _: false
        Pattern.Tuple(pats):
            match val:
                Value.Tuple(elems):
                    if elems.length != pats.length:
                        false
                    else:
                        var ok = true
                        var i = 0
                        while ok and i < pats.length:
                            ok = match_pattern(elems[i], pats[i], env)
                            i = i + 1
                        ok
                _: false
        Pattern.Variant(variant_name, field_pats):
            match val:
                Value.EnumVariant(vtype, vvariant, vfields):
                    let full = if vtype.length > 0: "{vtype}.{vvariant}" else: vvariant
                    if full != variant_name and vvariant != variant_name:
                        false
                    else:
                        var ok = true
                        var i = 0
                        while ok and i < field_pats.length:
                            let fval = if i < vfields.length: vfields[i] else: Value.Nil
                            ok = match_pattern(fval, field_pats[i], env)
                            i = i + 1
                        ok
                _: false

# ─── exec_try ─────────────────────────────────────────────────────────────────

def Signal? exec_try(mut Interpreter interp, TryStmt s):
    let child = new_env(interp.current_env)
    let prev = interp.current_env
    interp.current_env = child
    let body_sig = exec_block(interp, s.body)
    interp.current_env = prev
    # Check pending throw from function calls
    var Value? exc_val_opt = nil
    match body_sig:
        ThrowSignal(v): exc_val_opt = v
        _: nil
    if exc_val_opt == nil and interp.has_pending_throw:
        exc_val_opt = interp.take_pending_throw()
    if let exc_val = exc_val_opt:
        let exc_type = value_type_name(exc_val)
        var handled = false
        var clause_idx = 0
        while not handled and clause_idx < s.catch_clauses.length:
            let clause = s.catch_clauses[clause_idx]
            clause_idx = clause_idx + 1
            let catch_types = clause.types
            let num_types = catch_types.length
            var type_matches = false
            for ct in catch_types:
                if ct == exc_type or normalize_type_name(ct) == exc_type:
                    type_matches = true
            let matches = num_types == 0 or type_matches
            if matches:
                handled = true
                let cenv = new_env(interp.current_env)
                cenv.define("error", exc_val)
                let cprev = interp.current_env
                interp.current_env = cenv
                let csig = exec_block(interp, clause.body)
                interp.current_env = cprev
                return csig
        if not handled:
            return ThrowSignal(exc_val)
        nil
    else:
        body_sig

# ─── exec_kernel_block ────────────────────────────────────────────────────────
#
# Executes the body of a `kernel:` block.
# Strategy mirrors the Rust interpreter (eval_gpu.rs):
#   1. Set in_kernel_context = true so callers can detect kernel scope.
#   2. For each statement that is an expression returning a KernelHandle,
#      write the merged result back to the kernel variable in scope.
#   3. All other statements execute normally.
# Parallelism: the Boring interpreter uses synchronous `task` semantics,
# so threads run sequentially here (same as how JoinAll works in eval.br).
# True thread-level parallelism would require rayon, which is only available
# in the Rust host; this structure is the correct foundation for it.

def Signal? exec_kernel_block(mut Interpreter interp, [Stmt] stmts):
    let prev_kernel = interp.in_kernel_context
    interp.in_kernel_context = true
    var Signal? result = nil
    var i = 0
    while i < stmts.length and result == nil:
        let stmt = stmts[i]
        i = i + 1
        match stmt:
            Stmt.Expr(expr):
                let val = eval_expr(interp, expr)
                if interp.has_pending_throw:
                    result = ThrowSignal(interp.take_pending_throw())
                else:
                    # If the call returned a KernelHandle, write the merged
                    # result back to the variable that holds the kernel object.
                    match val:
                        Value.KernelHandle(merged):
                            let var_name = kernel_expr_var_name(expr)
                            if let vname = var_name:
                                interp.current_env.force_set(vname, merged)
                        _: nil
            _:
                let sig = exec_stmt(interp, stmt)
                if sig != nil:
                    result = sig
    interp.in_kernel_context = prev_kernel
    result

# Extract the variable name from a bare `k(block=N)` expression so we can
# write back the merged kernel result, mirroring `exec_kernel_block_inner` in
# the Rust interpreter.
def string? kernel_expr_var_name(Expr expr):
    match expr.kind:
        ExprKind.Call(callee, _):
            match callee.kind:
                ExprKind.Var(name): some(name)
                _: nil
        _: nil

# ─── exec_stream_fn ───────────────────────────────────────────────────────────

def [Value] exec_stream_fn(mut Interpreter interp, [Stmt] stmts):
    let prev_in_stream = interp.in_stream_fn
    let prev_yields = interp.stream_yields
    interp.in_stream_fn = true
    interp.stream_yields = []
    exec_block_fn(interp, stmts)
    interp.in_stream_fn = prev_in_stream
    let result = interp.stream_yields
    interp.stream_yields = prev_yields
    result

# ─── call_fn ──────────────────────────────────────────────────────────────────

def Value call_fn(mut Interpreter interp, FnDecl decl, [Value] args, Env'actor? captured):
    let base_env = captured else interp.global_env
    let fn_env = new_env(base_env.clone())
    var {string=Value} labeled = {}
    var positional = []
    for val in args:
        match val:
            Labeled(label, v):
                labeled.set(label, v)
            _:
                positional.push(val)
    var pos_idx = 0
    for param in decl.params:
        if param.variadic:
            # Collect all remaining positional args into an array
            var rest = [Value]{}
            while pos_idx < positional.length:
                rest.push(positional[pos_idx])
                pos_idx = pos_idx + 1
            if param.mutable:
                fn_env.define_mut(param.name, Array(rest))
            else:
                fn_env.define(param.name, Array(rest))
        else:
            var val = Nil
            if labeled.has(param.name):
                val = labeled[param.name]
            else:
                if pos_idx < positional.length:
                    val = positional[pos_idx]
                    pos_idx = pos_idx + 1
                else:
                    if let default_expr = param.default:
                        let dprev = interp.current_env
                        interp.current_env = base_env.clone()
                        val = eval_expr(interp, default_expr)
                        interp.current_env = dprev
            if param.mutable:
                fn_env.define_mut(param.name, val)
            else:
                fn_env.define(param.name, val)
    let prev_env = interp.current_env
    interp.current_env = fn_env
    if decl.is_stream:
        # Stream function: collect all yielded values into an array
        let stream_result = exec_stream_fn(interp, decl.body)
        interp.current_env = prev_env
        return Value.Array(stream_result)
    let sig = exec_block_fn(interp, decl.body)
    interp.current_env = prev_env
    match sig:
        nil: Nil
        ReturnSignal(v): v
        ThrowSignal(v):
            interp.set_pending_throw(v)
            Nil
        _: Nil

# ─── call_closure ─────────────────────────────────────────────────────────────

def Value call_closure(mut Interpreter interp, [Param] params, ClosureBody body, [Value] args, Env? captured):
    let fn_env = new_env(captured)
    var i = 0
    for param in params:
        let val = if i < args.length: args[i] else: Nil
        fn_env.define(param.name, val)
        i = i + 1
    let prev_env = interp.current_env
    interp.current_env = fn_env
    var Signal? sig = nil
    match body:
        ClosureBody.Block(stmts):
            sig = exec_block_fn(interp, stmts)
        ClosureBody.Expr(e):
            sig = Signal.ReturnSignal(eval_expr(interp, e))
    interp.current_env = prev_env
    match sig:
        nil: Nil
        ReturnSignal(v): v
        BreakSignal(v): v
        ContinueSignal: Nil
        ThrowSignal(v):
            interp.set_pending_throw(v)
            Nil
        _: Nil

# ─── call_value ───────────────────────────────────────────────────────────────

def Value call_value(mut Interpreter interp, Value callee, [Value] args):
    match callee:
        Value.Fn(name, captured):
            let decl = lookup_fn_decl(interp, name)
            call_fn(interp, decl, args, captured)

        Value.Closure(params, body_stmts, captured):
            call_closure(interp, params, body_stmts, args, captured)

        Value.NativeFn(name, func):
            call_native(interp, name, func, args)

        Value.OverloadedFn(name, variants):
            let best = resolve_overload(interp, variants, args)
            call_value(interp, best, args)

        Value.StructDef(name):
            let decl_opt = interp.get_struct_decl(name)
            if let decl = decl_opt:
                instantiate_struct(interp, decl, args)
            else:
                throw "struct not found: {name}"

        Value.EnumDef(name):
            let variant_name = match args[0] else Value.Nil:
                Value.Str(s): s
                _: throw "enum constructor requires variant name"
            var fields = []
            var i = 1
            while i < args.length:
                fields.push(args[i])
                i = i + 1
            Value.EnumVariant(name, variant_name, fields)

        Value.EnumVariant(type_name, variant, _):
            Value.EnumVariant(type_name, variant, args)

        Value.Object(obj):
            # Callable struct: look for __call__ method
            let obj_type = obj.type_name
            let method_opt = interp.find_method(obj_type, "__call__")
            if let _ = method_opt:
                call_method(interp, Value.Object(obj), "__call__", args)
            else:
                throw "struct '{obj_type}' is not callable"

        _: throw "value is not callable"

# ─── helpers ──────────────────────────────────────────────────────────────────

def string normalize_type_name(string name):
    if name == "String": "string"
    else if name == "Int": "int"
    else if name == "Float": "float"
    else if name == "Bool": "bool"
    else if name == "Nil": "nil"
    else: name

def bool expect_bool(Value val):
    match val:
        Bool(b): b
        _: throw "expected bool"

def string value_type_name(Value val):
    match val:
        Nil: "nil"
        Void: "void"
        Uninitialized: "uninitialized"
        Bool(_): "bool"
        Int(_): "int"
        Float(_): "float"
        Str(_): "string"
        Array(_): "array"
        Tuple(_): "tuple"
        Dict(_): "dict"
        Set(_): "set"
        Object(inner): inner.type_name.clone()
        EnumVariant(t, _, _): t
        Fn(n, _): "fn({n})"
        Closure(_, _, _): "closure"
        NativeFn(n, _): "native({n})"
        OverloadedFn(n, _): "fn({n})"
        Range(_, _, _, _): "range"
        Labeled(_, _): "labeled"
        StructDef(n): "struct:{n}"
        EnumDef(n): "enum:{n}"
        KernelHandle(_): "kernel-handle"
        Moved(_): "moved"

def string value_to_string(Value val):
    match val:
        Nil: "nil"
        Void: ""
        Bool(b): if b: "true" else: "false"
        Int(n): "{n}"
        Float(f): "{f}"
        Str(s): s
        _: value_type_name(val)

def bool value_equals(Value a, Value b):
    match a:
        Uninitialized:
            match b:
                Uninitialized: true
                _: false
        Nil:
            match b:
                Nil: true
                _: false
        Bool(x):
            match b:
                Bool(y): x == y
                _: false
        Int(x):
            match b:
                Int(y): x == y
                _: false
        Float(x):
            match b:
                Float(y): x == y
                _: false
        Str(x):
            match b:
                Str(y): x == y
                _: false
        Set(xa):
            match b:
                Set(ya):
                    if xa.length != ya.length:
                        false
                    else:
                        var all_found = true
                        for elem in xa:
                            var found = false
                            for other in ya:
                                if value_equals(elem, other):
                                    found = true
                            if not found:
                                all_found = false
                        all_found
                _: false
        _: false

def Value value_add(Value a, Value b):
    match a:
        Int(x):
            match b:
                Int(y): Int(x + y)
                _: throw "type error in +="
        Float(x):
            match b:
                Float(y): Float(x + y)
                _: throw "type error in +="
        Str(x):
            match b:
                Str(y): Str("{x}{y}")
                _: throw "type error in +="
        _: throw "type error in +="

def Value value_sub(Value a, Value b):
    match a:
        Int(x):
            match b:
                Int(y): Int(x - y)
                _: throw "type error in -="
        Float(x):
            match b:
                Float(y): Float(x - y)
                _: throw "type error in -="
        _: throw "type error in -="

def Value value_mul(Value a, Value b):
    match a:
        Int(x):
            match b:
                Int(y): Int(x * y)
                _: throw "type error in *="
        Float(x):
            match b:
                Float(y): Float(x * y)
                _: throw "type error in *="
        _: throw "type error in *="

def Value value_div(Value a, Value b):
    match a:
        Int(x):
            match b:
                Int(y): Int(x / y)
                _: throw "type error in /="
        Float(x):
            match b:
                Float(y): Float(x / y)
                _: throw "type error in /="
        _: throw "type error in /="

def Value value_mod(Value a, Value b):
    match a:
        Int(x):
            match b:
                Int(y): Int(x % y)
                _: throw "type error in %="
        _: throw "type error in %="
