
# == AST TYPES ==

# ─── Attributes ───────────────────────────────────────────────────────────────

struct Attr:
    string name
    [string] args
    int line

# ─── Top-level ────────────────────────────────────────────────────────────────

struct Program:
    [Item] items

enum Item:
    Use(UseDecl decl)
    Fn(FnDecl decl)
    Struct(StructDecl decl)
    Enum(EnumDecl decl)
    Trait(TraitDecl decl)
    Ext(ExtDecl decl)
    Mod(ModDecl decl)
    Let(LetStmt stmt)
    Alias(AliasDecl decl)
    Stmt(Stmt stmt)

struct ModDecl:
    string name
    [Item] items
    int line

struct AliasDecl:
    string name
    [string] type_params
    Type ty
    bool newtype
    int line

struct ExtDecl:
    string type_name
    [Type] type_args
    [string] type_params
    [{string=string}] where_clause
    [string] traits
    [FnDecl] methods
    [SetDecl] setters
    [AsDecl] conversions
    [AssocTypeDef] assoc_type_defs
    int line

struct UseDecl:
    [string] path
    bool glob
    [string] items
    int line

# ─── Declarations ─────────────────────────────────────────────────────────────

struct FnDecl:
    string name
    string? qualifier
    [Param] params
    Type? return_ty
    [Stmt] body
    bool is_pub
    bool can_throw
    bool is_task
    bool is_stream
    int? stream_capacity
    bool mutating
    bool is_native
    Type? throws_ty
    [string] type_params
    [{string=string}] where_clause
    [Attr] attrs
    int line

struct Param:
    string name
    Type? ty
    bool mutable
    bool owned
    bool variadic
    Expr? default
    int line

struct SetDecl:
    string name
    string param_name
    Type param_ty
    bool is_pub
    bool can_throw
    bool is_task
    [Stmt] body
    int line

struct StructDecl:
    string name
    bool is_pub
    bool is_native
    [string] protocols
    [FieldDecl] fields
    [InitDecl] inits
    [FnDecl] methods
    [AsDecl] conversions
    [string] type_params
    [{string=string}] where_clause
    [SetDecl] setters
    [TypeMethod] type_methods
    [TypeVar] type_vars
    [AssocTypeDef] assoc_type_defs
    [Attr] attrs
    int line

enum TypeMethodKind:
    Def
    Req
    Set

struct TypeMethod:
    TypeMethodKind kind
    string name
    [Param] params
    Type? return_ty
    [Stmt] body
    bool is_pub
    bool can_throw
    bool is_task
    int line

struct TypeVar:
    string name
    Type? ty
    Expr default
    bool is_pub
    bool mutable
    int line

struct AsDecl:
    bool is_pub
    Type ty
    bool can_throw
    bool is_task
    [Stmt] body
    int line

struct FieldDecl:
    string name
    bool is_pub
    bool mutable
    bool is_transient
    Type ty
    Expr? default
    int line

struct InitDecl:
    [InitParam] params
    [Stmt] body
    int line

struct InitParam:
    bool is_pub
    bool mutable
    string name
    Type? ty
    Expr? default
    int line

struct EnumDecl:
    string name
    bool is_pub
    bool is_native
    [string] type_params
    [string] protocols
    [EnumVariant] variants
    [FnDecl] methods
    [SetDecl] setters
    [AsDecl] conversions
    [Attr] attrs
    int line

struct EnumVariant:
    string name
    [VariantField] fields
    [Attr] attrs
    int line

struct VariantField:
    string? name
    Type ty
    # `true` for a field declared `mut Type` (docs/mut-type-modifier.md) — e.g.
    # `enum Holder: Value(mut Point p)`. Unlike `parse_type`'s general `mut`-prefix
    # handling (which discards the modifier — this simpler, qualifier-blind
    # interpreter has no `Type.Mut` variant to carry it in), a variant field's `mut`
    # is captured here specifically, one flag per field, so `match_pattern`/
    # `try_match_pattern` can bind the matched field content-mutable. Defaults to
    # `false` for every other field/qualifier position this interpreter still doesn't
    # track.
    bool is_mut = false

struct AssocTypeDecl:
    string name
    Type? constraint
    [string] type_params
    int line

struct AssocTypeDef:
    string name
    Type ty
    int line

struct TraitDecl:
    string name
    [string] parents
    [FnSignature] signatures
    [FnDecl] defaults
    [FnSignature] type_signatures
    [string] type_params
    [AssocTypeDecl] assoc_types
    int line

struct FnSignature:
    string name
    [Param] params
    Type? return_ty
    bool can_throw
    bool is_task
    bool is_stream
    bool mutating
    [string] type_params
    int line

# ─── Statements ───────────────────────────────────────────────────────────────

enum Stmt:
    Let(LetStmt stmt)
    LetDestructure(LetDestructureStmt stmt)
    Return(ReturnStmt stmt)
    Break(int line, Expr? value)
    Continue(int line)
    Throw(ThrowStmt stmt)
    If(IfStmt stmt)
    IfLet(IfLetStmt stmt)
    Match(MatchStmt stmt)
    While(WhileStmt stmt)
    WhileLet(WhileLetStmt stmt)
    DoWhile(DoWhileStmt stmt)
    Loop(LoopStmt stmt)
    Wait(Expr expr, int line)
    For(ForStmt stmt)
    Guard(GuardStmt stmt)
    Try(TryStmt stmt)
    Defer([Stmt] body)
    Expr(Expr expr)
    Fn(FnDecl decl)
    Struct(StructDecl decl)
    Enum(EnumDecl decl)
    Mod(ModDecl decl)
    Alias(AliasDecl decl)
    Yield(Expr expr, int line)
    Comment(string text)
    KernelBlock([Stmt] body, int line)
    With(WithStmt stmt)

struct LetDestructureStmt:
    bool mutable
    [DestructureBinding] bindings
    Expr value
    int line

struct DestructureBinding:
    string name
    Type? ty

enum CondClause:
    Let(string name, Expr expr)
    LetPat(Pattern pat, Expr expr)
    Expr(Expr expr)

struct IfLetStmt:
    [CondClause] clauses
    [Stmt] then_body
    [Stmt]? else_body
    int line

struct LetStmt:
    bool mutable
    bool is_pub
    bool is_static
    bool is_lazy
    string name
    Type? ty
    Expr? value
    int line

struct ReturnStmt:
    Expr? value
    int line

struct IfBranch:
    Expr cond
    [Stmt] body

struct IfStmt:
    [IfBranch] branches
    [Stmt]? else_body
    int line

struct MatchStmt:
    Expr subject
    [MatchArm] arms
    int line

struct MatchArm:
    [Pattern] patterns
    Expr? match_guard
    MatchBody body
    int line

enum MatchBody:
    Expr(Expr expr)
    Block([Stmt] stmts)

struct WhileStmt:
    Expr condition
    [Stmt] body
    int line

struct WhileLetStmt:
    string name
    Pattern? pattern
    Expr value
    [Stmt] body
    int line

struct DoWhileStmt:
    [Stmt] body
    Expr condition
    int line

struct LoopStmt:
    [Stmt] body
    int line

struct TryStmt:
    [Stmt] body
    [CatchClause] catch_clauses
    int line

struct CatchClause:
    [string] types
    string? variant
    [Stmt] body
    int line

struct ThrowStmt:
    Expr? value
    int line

struct ForStmt:
    [string] vars
    Expr iterable
    [Stmt] body
    int line

struct GuardStmt:
    GuardCond cond
    [Stmt] else_body
    int line

# `with <name> [, <name> ...]:` — scoped access block (docs/scoped-access-blocks.md).
# Deliberately does not carry each name's qualifier or read/write access level —
# both are resolved elsewhere from each name's already-known binding/qualifier,
# same as `def`/`req` method-call legality already is.
struct WithStmt:
    [string] names
    [Stmt] body
    int line

struct DeferStmt:
    [Stmt] body
    int line

enum GuardCond:
    Expr(Expr expr)
    Clauses([CondClause] clauses)

# ─── Patterns ─────────────────────────────────────────────────────────────────

enum Pattern:
    Wildcard
    Bind(string name)
    Variant(string name, [Pattern] fields)
    Lit(LitPattern lit)
    None
    Some(Pattern inner)
    Tuple([Pattern] elems)

enum LitPattern:
    Int(int n)
    Float(float f)
    Str(string s)
    Bool(bool b)
    Nil

# ─── String interpolation ─────────────────────────────────────────────────────

enum StringSegment:
    Lit(string text)
    Expr(Expr expr)
    FormattedExpr(Expr expr, string fmt_spec)

# ─── Expressions ──────────────────────────────────────────────────────────────

struct Expr:
    ExprKind kind
    int line

struct Arg:
    string? label
    Expr value
    bool spread
    # Bare `_` — fill every remaining field of a struct-construction call with
    # its default value, e.g. `Transform(translation = ..., scale = ..., _)`.
    # Mirrors the `_` wildcard already used in match arms and discard bindings.
    # `label` is always nil and `value` an unused placeholder when this is true.
    bool default_rest

enum ClosureBody:
    Expr(Expr expr)
    Block([Stmt] stmts)

enum ExprKind:
    Int(int n)
    Float(float f)
    Str(string s)
    StringInterp([StringSegment] segments)
    Bool(bool b)
    Nil
    Void
    Var(string name)
    BinOp(BinOp op, Expr left, Expr right)
    UnaryOp(UnaryOp op, Expr expr)
    Assign(Expr target, Expr value)
    QuestionAssign(Expr target, Expr value)
    Field(Expr expr, string name)
    Index(Expr expr, Expr index)
    Call(Expr callee, [Arg] args)
    MethodCall(Expr receiver, string name, [Arg] args)
    GenericCall(Expr callee, [Type] type_args, [Arg] args)
    Pipe(Expr left, string name, [Arg] args)
    TryElse(Expr expr, Expr default)
    TryElseBlock([Stmt] body, [Stmt] else_body)
    Array([Expr] elems)
    ArrayFill(Expr value, Expr count)
    ArrayComp(Expr expr, string varname, Expr count)
    ArrayCompIter(Expr expr, string varname, Expr iter)
    # Labeled multi-dim arrays (docs/array-multidim-types.md).
    LabeledIndex(Expr expr, [Arg] args)                    # a[width = w, height = h]
    LabeledArrayComp(Expr expr, [(string, Expr)] clauses)  # [f(w,h) for w in ..W for h in ..H]
    RelabelCast(Expr expr, [(string, string)] pairs)       # a as [line = width, column = height]
    Tuple([Expr] elems)
    Dict([(Expr, Expr)] pairs)
    Set([Expr] elems)
    DotIdent(string name)
    Range(Expr start, Expr end, bool inclusive)
    # SliceRange: absent start/end encoded as ExprKind.Hole
    SliceRange(Expr start, Expr end, bool inclusive)
    Hole  # sentinel for absent slice bound
    Cast(Expr expr, Type ty)
    Else(Expr expr, Expr default)
    OptionalField(Expr expr, string name)
    OptionalMethodCall(Expr expr, string name, [Arg] args)
    Closure([Param] params, Type? return_ty, ClosureBody body, bool can_throw, bool is_task)
    If(IfStmt stmt)
    Match(MatchStmt stmt)
    Block([Stmt] stmts)
    Do([Stmt] stmts)
    Loop(LoopStmt stmt)
    Task(Expr expr)
    TaskWithTimeout(Expr timeout, Expr expr)
    JoinAll([Expr] exprs)
    MacroCall(string name, [Expr] args)
    WildcardPat
    LiteralPat(Expr lit)
    VarPat(string name)
    TuplePat([Expr] pats)
    EnumPat(string type_name, string variant, [Expr] field_pats)

# ─── Operators ────────────────────────────────────────────────────────────────

enum BinOp:
    Add
    Sub
    Mul
    Div
    Rem
    Eq
    NotEq
    RefEq
    Lt
    Gt
    LtEq
    GtEq
    And
    Or
    BitAnd
    BitOr
    BitXor
    Shl
    Shr
    Is
    IsNot

enum UnaryOp:
    Neg
    Not
    BitNot

# ─── Ownership qualifiers ─────────────────────────────────────────────────────

enum OwnerQual:
    Owned
    Copy
    Const
    Actor
    Guard
    Shared
    Weak
    Inline
    Static
    Lifetime(string name)
    BorrowShared
    Borrow
    BorrowOwned
    BorrowOption
    BorrowWeak
    BorrowMut

# ─── Types ────────────────────────────────────────────────────────────────────

enum Type:
    Int
    Uint
    Uint8
    Int8
    Int16
    Int32
    Int64
    Int128
    Uint16
    Uint32
    Uint64
    Uint128
    Float32
    Float64
    Str
    Bool
    Nil
    Void
    Never
    Named(string name)
    Optional(Type inner)
    Array(Type elem)
    ArrayN(Type elem, int n)
    Tuple([Type] elems)
    Dict(Type key, Type value)
    Set(Type elem)
    Fn(Type? return_ty, [Type] params, bool can_throw, bool is_task, bool is_req)
    Qualified(Type ty, OwnerQual qual)
    Dyn(Type inner)
    Impl(Type inner)
    TypeParam(string name)
    Generic(string name, [Type] args)
    SelfAssoc(string name)
    AssocOf(Type base, string name)
    LabeledArray(Type elem, [LabeledAxis] axes)

# One axis of a labeled multi-dim array type (docs/array-multidim-types.md).
# `size` is nil for a dynamic axis (`width`), set for a fixed one
# (`width = 4`) — this interpreter has no const-generic machinery, so unlike
# the Rust compiler's `ConstExpr`, only an integer-literal fixed size is
# representable here; a fixed axis using a named const-generic parameter
# isn't supported (matches this file's pre-existing `Type.ArrayN`, whose own
# size is a plain `int`, not an expression — see parser_core.br).
struct LabeledAxis:
    string label
    int? size
