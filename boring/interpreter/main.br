    MatchArm(patterns: patterns, match_guard: match_guard, body: body, line: line)

def Param make_param_at(string name, Type? ty, bool mutable, int line):
    Param(name: name, ty: ty, mutable: mutable, owned: false, variadic: false, default: nil, line: line)

def string int_to_string(int n):
    "{n}"

def string string_trim(string s):
    s.trim()

def string string(Value v):
    v.to_string()

def Type type_named(string name):
    Type.Named(name)

static let int MAX_EXPR_DEPTH = 200

def TryStmt make_try_stmt([Stmt] body, [CatchClause] catch_clauses, int line):
    TryStmt(body: body, catch_clauses: catch_clauses, line: line)

def [Arg] map_args([Expr] exprs):
    var result = []
    for e in exprs:
        result.append(make_arg(nil, e, false))
    result

def [Param] elems_to_params([Expr] elems, int line):
    var result = []
    for e in elems:
        result.append(expr_to_param(e, line))
    result

def Param expr_to_param(Expr expr, int line):
    match expr.kind:
        ExprKind.Var(name): make_param(name, nil, false)
        _: make_param("_", nil, false)

def [Stmt] unwrap_block_or_wrap(Expr expr):
    match expr.kind:
        ExprKind.Block(stmts): stmts
        _: [stmt_expr(expr, expr.line)]

def string? shorthand_binop_from_peek(var Parser'actor p):
    let k = parser_peek_kind(p)
    match k:
        "PlusEq": some("Plus")
        "MinusEq": some("Minus")
        "StarEq": some("Star")
        "SlashEq": some("Slash")
        "PercentEq": some("Percent")
        "AmpersandEq": some("Ampersand")
        "PipeEq": some("Pipe")
        "CaretEq": some("Caret")
        _: nil

def bool parser_is_newline2(var Parser'actor p):
    let k = parser_peek_kind(p)
    k == "Newline" or k == "Eof"

struct SkipResult:
    int offset
    int indents

def SkipResult? peek_pipe_after_newlines(var Parser'actor p):
    nil

def SkipResult? peek_dot_after_newlines_and_indents(var Parser'actor p):
    nil

def Parser'actor make_parser([Token] tokens):
    var par = Parser(tokens: tokens, pos: 0) as Parser'actor
    par

def LoopStmt parse_loop_stmt(var Parser'actor p) throws:
    let body = parse_block(p)
    LoopStmt(body: body, line: p.pos)

def Pattern parse_pattern(var Parser'actor p) throws:
    let name = parser_expect_ident(p)
    Pattern.Bind(name)

def [MatchArm] parse_inline_match_arms(var Parser'actor p) throws:
    var arms = []
    while not parser_check(p, "Newline") and not parser_check(p, "Eof"):
        let arm = parse_match_arm(p)
        arms.append(arm)
    arms

def MatchArm parse_match_arm(var Parser'actor p) throws:
    let pat = parse_pattern(p)
    parser_expect(p, "Colon")
    let body = parse_expr(p)
    let body_line = body.line
    let stmt = stmt_expr(body, body_line)
    make_match_arm([pat], nil, MatchBody.Block([stmt]), p.pos)

def ModDecl parse_mod_decl(var Parser'actor p, bool is_pub) throws:
    let name = parser_expect_ident(p)
    parser_expect_newline(p)
    ModDecl(name: name, items: [], line: p.pos)

def AliasDecl parse_alias_decl(var Parser'actor p) throws:
    let name = parser_expect_ident(p)
    parser_expect(p, "As")
    let ty = parse_type(p)
    AliasDecl(name: name, ty: ty, type_params: [], newtype: false, line: p.pos)

def GuardStmt parse_guard_stmt(var Parser'actor p) throws:
    let cond = parse_expr(p)
    parser_expect(p, "Else")
    let body = parse_block(p)
    GuardStmt(cond: GuardCond.Expr(cond), else_body: body, line: p.pos)

def [Stmt] parse_defer_stmt(var Parser'actor p) throws:
    parse_block(p)

def IfLetStmt parse_if_let_stmt(var Parser'actor p) throws:
    let name = parser_expect_ident(p)
    parser_expect(p, "Eq")
    let expr = parse_expr(p)
    let then_body = parse_block(p)
    IfLetStmt(clauses: [CondClause.Let(name, expr)], then_body: then_body, else_body: nil, line: p.pos)

def WhileLetStmt parse_while_let_stmt(var Parser'actor p) throws:
    let name = parser_expect_ident(p)
    parser_expect(p, "Eq")
    let expr = parse_expr(p)
    let body = parse_block(p)
    WhileLetStmt(name: name, pattern: nil, value: expr, body: body, line: p.pos)

def [Expr] parse_macro_args(var Parser'actor p) throws:
    var args = []
    while not parser_check(p, "RParen") and not parser_check(p, "Newline") and not parser_check(p, "Eof"):
        let e = parse_expr(p)
        args.append(e)
        parser_eat(p, "Comma")
    args

def Type apply_var_to_borrow(Type ty):
    Type.Qualified(ty, OwnerQual.BorrowMut)

def Type infer_type_from_constructor(Type qualified, Expr value):
    qualified

def FnDecl lookup_fn_decl(var Interpreter'actor interp, string name):
    throw "lookup_fn_decl: function '{name}' not found"

def Value resolve_overload(var Interpreter'actor interp, [Value] variants, [Value] args):
    match variants.length:
        0: throw "no overloads for call"
        _: variants[0]

def Value call_native(var Interpreter'actor interp, string name, Value func, [Value] args):
    throw "call_native: native function '{name}' not supported"

def ThrowsTask parse_closure_modifiers(var Parser'actor p) throws:
    let can_throw = p.eat(TokenKind.Throws)
    let is_task = p.eat(TokenKind.Task)
    ThrowsTask(can_throw: can_throw, is_task: is_task)

def bool parser_allow_trailing_closure(var Parser'actor p):
    true

def Type parse_type_qualifier(var Parser'actor p, Type base) throws:
    if not p.eat(TokenKind.Tick):
        return base
    let qual_name = parser_expect_ident(p)
    let qual = match qual_name:
        "actor": OwnerQual.Actor
        "shared": OwnerQual.Shared
        "guard": OwnerQual.Guard
        "stack": OwnerQual.Stack
        "heap": OwnerQual.Owned
        "weak": OwnerQual.Weak
        _: OwnerQual.Actor
    Type.Qualified(base, qual)

# == PARSER EXPRESSIONS AND STATEMENTS ==

# ─── Expression Parsing ─────────────────────────────────────────────────────

def Expr parse_expr(var Parser'actor p) throws:
    parse_else_expr(p)

def Stmt parse_inline_stmt(var Parser'actor p) throws:
    parse_inline_stmt_impl(p, false)

def Stmt parse_inline_if_body(var Parser'actor p) throws:
    parse_inline_stmt_impl(p, true)

def [Stmt] parse_inline_stmts(var Parser'actor p) throws:
    var stmts = [parse_inline_stmt(p)]
    while parser_check(p, "Semicolon"):
        parser_advance(p)
        if parser_is_newline(p) or parser_check(p, "Eof"):
            break
        stmts.append(parse_inline_stmt(p))
    stmts

def [Stmt] parse_inline_stmts_if_body(var Parser'actor p) throws:
    var stmts = [parse_inline_if_body(p)]
    while parser_check(p, "Semicolon"):
        parser_advance(p)
        if parser_is_newline(p) or parser_check(p, "Eof") or parser_check(p, "Else") or parser_check(p, "Elif"):
            break
        stmts.append(parse_inline_if_body(p))
    stmts

def string parser_peek_kind(var Parser'actor p):
    token_kind_name(p.peek())

def string? compound_op_from_peek(var Parser'actor p):
    let k = parser_peek_kind(p)
    match k:
        "PlusEq": some("Plus")
        "MinusEq": some("Minus")
        "StarEq": some("Star")
        "SlashEq": some("Slash")
        "PercentEq": some("Percent")
        "AmpersandEq": some("Ampersand")
        "PipeEq": some("Pipe")
        "CaretEq": some("Caret")
        _: nil

def string? comparison_op_from_peek(var Parser'actor p):
    let k = parser_peek_kind(p)
    match k:
        "Lt": some("Lt")
        "Gt": some("Gt")
        "LtEq": some("LtEq")
        "GtEq": some("GtEq")
        "EqEq": some("EqEq")
        "BangEq": some("BangEq")
        _: nil

def string? additive_op_from_peek(var Parser'actor p):
    let k = parser_peek_kind(p)
    match k:
        "Plus": some("Plus")
        "Minus": some("Minus")
        _: nil

def string? multiplicative_op_from_peek(var Parser'actor p):
    let k = parser_peek_kind(p)
    match k:
        "Star": some("Star")
        "Slash": some("Slash")
        "Percent": some("Percent")
        _: nil

def Stmt parse_inline_stmt_impl(var Parser'actor p, bool stop_at_else) throws:
    let line = parser_line(p)
    if parser_check(p, "Return"):
        parser_advance(p)
        let Expr? value = if parser_is_newline(p) or parser_check(p, "Eof"):
            nil
        else:
            some(parse_or(p))
        return Stmt.Return(make_return_stmt(value, line))
    if parser_check(p, "Throw"):
        parser_advance(p)
        let Expr? value = if parser_is_newline(p) or parser_check(p, "Eof"):
            nil
        else:
            some(parse_or(p))
        return Stmt.Throw(make_throw_stmt(value, line))
    if parser_check(p, "Break"):
        parser_advance(p)
        let Expr? value = if parser_is_newline(p) or parser_check(p, "Eof"):
            nil
        else:
            some(parse_or(p))
        return make_break_stmt(line, value)
    if parser_check(p, "Continue"):
        parser_advance(p)
        return make_continue_stmt(line)
    let lhs = if stop_at_else: parse_or(p) else: parse_else_expr(p)
    if parser_eat(p, "Eq"):
        let rhs = parse_or(p)
        return stmt_expr(make_assign(lhs, rhs, line), line)
    let op = compound_op_from_peek(p)
    if let op_val = op:
        parser_advance(p)
        let rhs = parse_or(p)
        let binop = make_binop(op_val, lhs.clone(), rhs, line)
        return stmt_expr(make_assign(lhs, binop, line), line)
    if parser_eat(p, "QuestionEq"):
        let rhs = parse_or(p)
        let else_expr = make_else_expr(lhs.clone(), rhs, line)
        return stmt_expr(make_assign(lhs, else_expr, line), line)
    let expr = if expr_is_var(lhs.clone()):
        if parser_peek_starts_expr(p):
            var args = []
            while true:
                let arg = parse_or(p)
                args.append(make_arg(nil, arg, false))
                if not parser_eat(p, "Comma"):
                    break
            make_call(lhs, args, line)
        else:
            lhs
    else:
        lhs
    stmt_expr(expr, line)

def Expr parse_else_expr(var Parser'actor p) throws:
    let line = parser_line(p)
    if parser_check(p, "Try"):
        parser_advance(p)
        if parser_check(p, "Colon") and (parser_is_newline2(p) or parser_check2(p, "Eof")):
            parser_advance(p)
            parser_expect_newline(p)
            let try_stmts = parse_block(p)
            parser_expect(p, "Else")
            let else_stmts = parse_else_body_stmts(p)
            return make_try_else_block(try_stmts, else_stmts, line)
        if parser_eat(p, "Question"):
            let inner = parse_pipe(p)
            return make_try_else(inner, make_nil_expr(line), line)
        let inner = parse_pipe(p)
        if parser_check(p, "Else"):
            parser_advance(p)
            let else_expr = parse_else_body_expr(p)
            let else_stmts = unwrap_block_or_wrap(else_expr)
            return make_try_else_block([stmt_expr(inner, line)], else_stmts, line)
        throw "try expr requires an else clause or '?' — use_val: \n  try f() else default\n  try? f()\n  try: … catch: …"
    let expr = parse_pipe(p)
    if parser_check(p, "Else"):
        parser_advance(p)
        let default = parse_else_body_expr(p)
        return make_else_expr(expr, default, expr.line)
    expr

def Expr parse_pipe(var Parser'actor p) throws:
    var lhs = parse_or(p)
    var indent_depth = 0
    while true:
        let skipped = if parser_check(p, "Newline"):
            peek_pipe_after_newlines(p)
        else:
            nil
        if let sk = skipped:
            parser_skip_to_offset(p, sk.offset)
            indent_depth = indent_depth + sk.indents
        if not parser_check(p, "PipeArrow"):
            break
        let line = parser_line(p)
        parser_advance(p)
        let name = parser_expect_ident(p)
        let args = if parser_check(p, "LParen"):
            parse_call_args(p)
        else:
            []
        lhs = make_pipe(lhs, name, args, line)
    if indent_depth > 0:
        let saved = parser_pos(p)
        parser_skip_newlines(p)
        var consumed = 0
        while consumed < indent_depth and parser_check(p, "Dedent"):
            parser_advance(p)
            consumed = consumed + 1
        if consumed < indent_depth:
            parser_set_pos(p, saved)
    lhs

def Expr parse_or(var Parser'actor p) throws:
    var lhs = parse_and(p)
    while parser_check(p, "Or"):
        let line = parser_line(p)
        parser_advance(p)
        let rhs = parse_and(p)
        lhs = make_binop("Or", lhs, rhs, line)
    lhs

def Expr parse_and(var Parser'actor p) throws:
    var lhs = parse_not(p)
    while parser_check(p, "And"):
        let line = parser_line(p)
        parser_advance(p)
        let rhs = parse_not(p)
        lhs = make_binop("And", lhs, rhs, line)
    lhs

def Expr parse_not(var Parser'actor p) throws:
    if parser_check(p, "Not"):
        let line = parser_line(p)
        parser_advance(p)
        parser_depth_inc(p)
        if parser_depth(p) > MAX_EXPR_DEPTH:
            parser_depth_dec(p)
            throw "expression nested too deeply"
        let result = parse_not(p)
        parser_depth_dec(p)
        return make_unary("Not", result, line)
    parse_comparison(p)

def Expr parse_comparison(var Parser'actor p) throws:
    var lhs = parse_bitor(p)
    while true:
        if parser_check(p, "Is"):
            let line = parser_line(p)
            parser_advance(p)
            let op = if parser_check(p, "Not"):
                parser_advance(p)
                "IsNot"
            else:
                "Is"
            let rhs = parse_bitor(p)
            lhs = make_binop(op, lhs, rhs, line)
            continue
        let op = comparison_op_from_peek(p)
        if let o = op:
            let line = parser_line(p)
            parser_advance(p)
            let rhs = parse_bitor(p)
            lhs = make_binop(o, lhs, rhs, line)
        else:
            break
    lhs

def Expr parse_bitor(var Parser'actor p) throws:
    var lhs = parse_bitxor(p)
    while parser_check(p, "Pipe"):
        let line = parser_line(p)
        parser_advance(p)
        let rhs = parse_bitxor(p)
        lhs = make_binop("BitOr", lhs, rhs, line)
    lhs

def Expr parse_bitxor(var Parser'actor p) throws:
    var lhs = parse_bitand(p)
    while parser_check(p, "Caret"):
        let line = parser_line(p)
        parser_advance(p)
        let rhs = parse_bitand(p)
        lhs = make_binop("BitXor", lhs, rhs, line)
    lhs

def Expr parse_bitand(var Parser'actor p) throws:
    var lhs = parse_shift(p)
    while parser_check(p, "Ampersand"):
        let line = parser_line(p)
        parser_advance(p)
        let rhs = parse_shift(p)
        lhs = make_binop("BitAnd", lhs, rhs, line)
    lhs

def Expr parse_shift(var Parser'actor p) throws:
    var lhs = parse_additive(p)
    while true:
        if parser_check(p, "Lt") and parser_check2(p, "Lt"):
            let line = parser_line(p)
            parser_advance(p)
            parser_advance(p)
            let rhs = parse_additive(p)
            lhs = make_binop("Shl", lhs, rhs, line)
        elif parser_check(p, "Gt") and parser_check2(p, "Gt"):
            let line = parser_line(p)
            parser_advance(p)
            parser_advance(p)
            let rhs = parse_additive(p)
            lhs = make_binop("Shr", lhs, rhs, line)
        else:
            break
    lhs

def Expr parse_additive(var Parser'actor p) throws:
    var lhs = parse_multiplicative(p)
    while true:
        let op = additive_op_from_peek(p)
        if let o = op:
            let line = parser_line(p)
            parser_advance(p)
            let rhs = parse_multiplicative(p)
            lhs = make_binop(o, lhs, rhs, line)
        else:
            break
    lhs

def Expr parse_multiplicative(var Parser'actor p) throws:
    var lhs = parse_unary(p)
    while true:
        let op = multiplicative_op_from_peek(p)
        if let o = op:
            let line = parser_line(p)
            parser_advance(p)
            let rhs = parse_unary(p)
            lhs = make_binop(o, lhs, rhs, line)
        else:
            break
    lhs

def Expr parse_unary(var Parser'actor p) throws:
    let line = parser_line(p)
    if parser_check(p, "Minus"):
        parser_advance(p)
        let expr = parse_unary(p)
        return make_unary("Neg", expr, line)
    if parser_check(p, "Bang"):
        parser_advance(p)
        let expr = parse_unary(p)
        return make_unary("Not", expr, line)
    if parser_check(p, "Tilde"):
        parser_advance(p)
        let expr = parse_unary(p)
        return make_unary("BitNot", expr, line)
    parse_postfix(p)

def Expr parse_postfix(var Parser'actor p) throws:
    parse_postfix_inner(p, true)

def Expr parse_postfix_inner(var Parser'actor p, bool allow_chain) throws:
    var expr = parse_primary(p)
    var continuation_indent_depth = 0
    var seen_trailing_closure = false
    while true:
        if parser_check(p, "Newline") and allow_chain and seen_trailing_closure:
            let skipped = peek_dot_after_newlines_and_indents(p)
            if let sk = skipped:
                parser_skip_to_offset(p, sk.offset)
                continuation_indent_depth = continuation_indent_depth + sk.indents
            else:
                break
        elif parser_is_newline(p):
            break
        let line = parser_line(p)
        if parser_check(p, "Dot"):
            parser_advance(p)
            let field = if parser_peek_is_int(p):
                let n = parser_peek_int(p)
                parser_advance(p)
                int_to_string(n)
            else:
                parser_expect_ident_or_keyword(p)
            if parser_peek_is_trailing_closure(p):
                let args = parse_trailing_closure(p, [])
                seen_trailing_closure = true
                expr = make_method_call(expr, field, args, line)
            elif parser_check(p, "LParen"):
                var args = parse_call_args(p)
                if parser_peek_is_trailing_closure(p):
                    args = parse_trailing_closure(p, args)
                    seen_trailing_closure = true
                elif parser_peek_is_trailing_closure_no_paren(p):
                    args = parse_trailing_closure_no_paren(p, args)
                    seen_trailing_closure = true
                elif parser_allow_trailing_closure(p) and parser_check(p, "Colon"):
                    args = parse_trailing_body(p, args)
                    seen_trailing_closure = true
                elif parser_peek_is_trailing_body_no_colon(p):
                    args = parse_trailing_body_no_colon(p, args)
                    seen_trailing_closure = true
                expr = make_method_call(expr, field, args, line)
            elif parser_peek_is_trailing_closure_no_paren(p):
                let args = parse_trailing_closure_no_paren(p, [])
                seen_trailing_closure = true
                expr = make_method_call(expr, field, args, line)
            else:
                expr = make_field_expr(expr, field, line)
        elif parser_check(p, "QuestionDot"):
            parser_advance(p)
            let field = parser_expect_ident_or_keyword(p)
            if parser_peek_is_trailing_closure(p):
                let args = parse_trailing_closure(p, [])
                seen_trailing_closure = true
                expr = make_optional_method_call(expr, field, args, line)
            elif parser_check(p, "LParen"):
                var args = parse_call_args(p)
                if parser_peek_is_trailing_closure(p):
                    args = parse_trailing_closure(p, args)
                    seen_trailing_closure = true
                expr = make_optional_method_call(expr, field, args, line)
            else:
                expr = make_optional_field(expr, field, line)
        elif parser_check(p, "LBracket"):
            parser_advance(p)
            let idx = parse_expr(p)
            parser_expect(p, "RBracket")
            expr = make_index(expr, idx, line)
        elif parser_check(p, "LParen"):
            if parser_peek_is_trailing_closure(p):
                let args = parse_trailing_closure(p, [])
                seen_trailing_closure = true
                expr = make_call(expr, args, line)
            else:
                var args = parse_call_args(p)
                if parser_peek_is_trailing_closure(p):
                    args = parse_trailing_closure(p, args)
                    seen_trailing_closure = true
                elif parser_allow_trailing_closure(p) and parser_check(p, "Colon"):
                    args = parse_trailing_body(p, args)
                    seen_trailing_closure = true
                elif parser_peek_is_trailing_body_no_colon(p):
                    args = parse_trailing_body_no_colon(p, args)
                    seen_trailing_closure = true
                expr = make_call(expr, args, line)
        elif parser_check(p, "As"):
            parser_advance(p)
            let ty = parse_type(p)
            expr = make_cast(expr, ty, line)
        elif parser_check(p, "DotDot") or parser_check(p, "DotDotEq"):
            let inclusive = parser_check(p, "DotDotEq")
            parser_advance(p)
            let end = parse_primary(p)
            expr = make_range(expr, end, inclusive, line)
        elif parser_peek_is_ident(p) and parser_peek_is_trailing_closure_no_paren(p):
            let args = parse_trailing_closure_no_paren(p, [])
            seen_trailing_closure = true
            expr = make_call(expr, args, line)
        else:
            break
    if continuation_indent_depth > 0:
        let saved_pos = parser_pos(p)
        parser_skip_newlines(p)
        var consumed = 0
        while consumed < continuation_indent_depth and parser_check(p, "Dedent"):
            parser_advance(p)
            consumed = consumed + 1
        if consumed < continuation_indent_depth:
            parser_set_pos(p, saved_pos)
    expr

def Expr parse_primary(var Parser'actor p) throws:
    let line = parser_line(p)
    if parser_check(p, "Int"):
        let n = parser_peek_int(p)
        parser_advance(p)
        return make_int_expr(n, line)
    if parser_check(p, "Float"):
        let f = parser_peek_float(p)
        parser_advance(p)
        return make_float_expr(f, line)
    if parser_check(p, "Str"):
        let s = parser_peek_str(p)
        parser_advance(p)
        return make_str_expr(s, line)
    if parser_check(p, "StringInterp"):
        let parts = parser_peek_interp_parts(p)
        parser_advance(p)
        let segments = resolve_interp(p, parts, line)
        return make_string_interp(segments, line)
    if parser_check(p, "Bool"):
        let b = parser_peek_bool(p)
        parser_advance(p)
        return make_bool_expr(b, line)
    if parser_check(p, "Nil"):
        parser_advance(p)
        return make_nil_expr(line)
    if parser_check(p, "Void"):
        parser_advance(p)
        return make_void_expr(line)
    if parser_check(p, "SelfKw"):
        parser_advance(p)
        return make_var_expr("self", line)
    if parser_check(p, "Ident"):
        let name = parser_peek_ident(p)
        if parser_peek_is_macro_call(p):
            parser_advance(p)
            parser_advance(p)
            let args = parse_macro_args(p)
            return make_macro_call(name, args, line)
        if parser_peek_is_generic_call(p):
            parser_advance(p)
            parser_advance(p)
            var type_args = [parse_type(p)]
            while parser_eat(p, "Comma"):
                if parser_check(p, "Gt"):
                    break
                type_args.append(parse_type(p))
            parser_expect(p, "Gt")
            let callee = make_var_expr(name, line)
            let args = if parser_check(p, "LParen"): parse_call_args(p) else: []
            return make_generic_call(callee, type_args, args, line)
        if parser_allow_noparen_closure(p) and parser_peek_next_is_colon(p):
            parser_advance(p)
            parser_advance(p)
            let param = make_param(name, nil, false)
            let body = parse_closure_body(p)
            let (throws_task, body) = infer_throws_task(body)
            return make_closure([param], nil, body, throws_task.can_throw, throws_task.is_task, line)
        parser_advance(p)
        return make_var_expr(name, line)
    if parser_check(p, "Colon"):
        parser_advance(p)
        let param = make_param("__x", nil, false)
        let base = make_var_expr("__x", line)
        let member = parser_expect_ident(p)
        var acc = make_field_expr(base, member, line)
        if parser_check(p, "LParen"):
            let args = parse_call_args(p)
            acc = make_method_call(base, member, args, line)
        while parser_check(p, "Dot"):
            parser_advance(p)
            let next = parser_expect_ident(p)
            if parser_check(p, "LParen"):
                let args = parse_call_args(p)
                acc = make_method_call(acc, next, args, line)
            else:
                acc = make_field_expr(acc, next, line)
        let body_op = shorthand_binop_from_peek(p)
        var body_expr = acc
        if let op = body_op:
            parser_advance(p)
            let rhs = parse_or(p)
            body_expr = make_binop(op, acc, rhs, line)
        let body = closure_body_expr(body_expr)
        let (throws_task, body) = infer_throws_task(body)
        return make_closure([param], nil, body, throws_task.can_throw, throws_task.is_task, line)
    if parser_check(p, "Dot"):
        parser_advance(p)
        let name = parser_expect_ident(p)
        return make_dot_ident(name, line)
    if parser_check(p, "LParen"):
        parser_advance(p)
        parser_skip_newlines_and_indent(p)
        if parser_check(p, "RParen"):
            parser_advance(p)
            let ex = parse_closure_modifiers(p)
            if parser_check(p, "Colon"):
                parser_advance(p)
                let body = parse_closure_body(p)
                let (inf, body) = infer_throws_task(body)
                return make_closure([], nil, body, ex.can_throw or inf.can_throw, ex.is_task or inf.is_task, line)
            return make_tuple([], line)
        if parser_peek_is_typed_closure(p):
            var params = [parse_param(p)]
            while parser_eat(p, "Comma"):
                parser_skip_newlines_and_indent(p)
                if parser_check(p, "RParen"):
                    break
                params.append(parse_param(p))
            parser_skip_newlines_and_indent(p)
            parser_expect(p, "RParen")
            let ex = parse_closure_modifiers(p)
            parser_expect(p, "Colon")
            let body = parse_closure_body(p)
            let (inf, body) = infer_throws_task(body)
            return make_closure(params, nil, body, ex.can_throw or inf.can_throw, ex.is_task or inf.is_task, line)
        let first_expr = parse_expr(p)
        if parser_check(p, "Comma"):
            var elems = [first_expr]
            while parser_eat(p, "Comma"):
                parser_skip_newlines_and_indent(p)
                if parser_check(p, "RParen"):
                    break
                elems.append(parse_expr(p))
            parser_skip_newlines_and_indent(p)
            parser_expect(p, "RParen")
            let ex = parse_closure_modifiers(p)
            if parser_allow_trailing_closure(p) and parser_check(p, "Colon"):
                parser_advance(p)
                let params = elems_to_params(elems, line)
                let body = parse_closure_body(p)
                let (inf, body) = infer_throws_task(body)
                return make_closure(params, nil, body, ex.can_throw or inf.can_throw, ex.is_task or inf.is_task, line)
            return make_tuple(elems, line)
        else:
            parser_skip_newlines_and_indent(p)
            parser_expect(p, "RParen")
            let ex = parse_closure_modifiers(p)
            if parser_allow_trailing_closure(p) and parser_check(p, "Colon"):
                parser_advance(p)
                let params = [expr_to_param(first_expr, line)]
                let body = parse_closure_body(p)
                let (inf, body) = infer_throws_task(body)
                return make_closure(params, nil, body, ex.can_throw or inf.can_throw, ex.is_task or inf.is_task, line)
            return first_expr
    if parser_check(p, "LBracket"):
        parser_advance(p)
        parser_skip_newlines_and_indent(p)
        var elems = []
        while not parser_check(p, "RBracket") and not parser_check(p, "Eof"):
            elems.append(parse_expr(p))
            if not parser_eat(p, "Comma"):
                break
            parser_skip_newlines_and_indent(p)
        parser_skip_newlines_and_indent(p)
        parser_expect(p, "RBracket")
        return make_array(elems, line)
    if parser_check(p, "LBrace"):
        return parse_brace_expr(p, line)
    if parser_check(p, "If"):
        let if_stmt = parse_if_stmt(p)
        return make_if_expr(if_stmt, line)
    if parser_check(p, "Match"):
        let match_stmt = parse_match_stmt(p)
        return make_match_expr(match_stmt, line)
    if parser_check(p, "Do"):
        parser_advance(p)
        parser_expect(p, "Colon")
        parser_expect_newline(p)
        let stmts = parse_block(p)
        return make_do_expr(stmts, line)
    if parser_check(p, "Loop"):
        let s = parse_loop_stmt(p)
        return make_loop_expr(s, line)
    if parser_check(p, "Task"):
        return parse_task_expr(p)
    if parser_check(p, "Join"):
        parser_advance(p)
        parser_expect(p, "LParen")
        var exprs = []
        while not parser_check(p, "RParen") and not parser_check(p, "Eof"):
            exprs.append(parse_expr(p))
            if not parser_eat(p, "Comma"):
                break
        parser_expect(p, "RParen")
        return make_join_all(exprs, line)
    if parser_check(p, "Get"):
        parser_advance(p)
        return make_var_expr("get", line)
    if parser_check(p, "Set"):
        parser_advance(p)
        return make_var_expr("set", line)
    if parser_check(p, "Wait"):
        parser_advance(p)
        return make_var_expr("wait", line)
    throw "unexpected token in expression: {parser_peek_debug(p)}"

def [Arg] parse_arg_list(var Parser'actor p) throws:
    parse_call_args(p)

def [Arg] parse_call_args(var Parser'actor p) throws:
    parser_expect(p, "LParen")
    parser_skip_newlines_and_indent(p)
    let saved_tc = parser_get_allow_trailing_closure(p)
    parser_set_allow_trailing_closure(p, true)
    var args = []
    while not parser_check(p, "RParen") and not parser_check(p, "Eof"):
        args.append(parse_arg(p))
        if not parser_eat(p, "Comma"):
            break
        parser_skip_newlines_and_indent(p)
    parser_skip_newlines_and_indent(p)
    parser_expect(p, "RParen")
    parser_set_allow_trailing_closure(p, saved_tc)
    args

def Arg parse_arg(var Parser'actor p) throws:
    if parser_eat(p, "DotDot"):
        let value = parse_or(p)
        return make_arg(nil, value, true)
    if parser_peek_is_ident(p) and parser_check2(p, "Eq"):
        let after_eq_pos = parser_pos(p) + 2
        let is_double_eq = parser_token_at_is_eq(p, after_eq_pos)
        if not is_double_eq:
            let label = parser_expect_ident(p)
            parser_advance(p)
            let value = parse_or(p)
            return make_arg(some(label), value, false)
    let value = parse_expr(p)
    make_arg(nil, value, false)

def Expr parse_brace_expr(var Parser'actor p, int line) throws:
    parser_expect(p, "LBrace")
    parser_skip_newlines_and_indent(p)
    if parser_check(p, "RBrace"):
        parser_advance(p)
        return make_set([], line)
    if parser_check(p, "Eq"):
        parser_advance(p)
        parser_expect(p, "RBrace")
        return make_dict([], line)
    let first_expr = parse_expr(p)
    if parser_eat(p, "Eq"):
        let first_val = parse_expr(p)
        var pairs = [(first_expr, first_val)]
        while parser_eat(p, "Comma"):
            parser_skip_newlines_and_indent(p)
            if parser_check(p, "RBrace"):
                break
            let k = parse_expr(p)
            parser_expect(p, "Eq")
            let v = parse_expr(p)
            pairs.append((k, v))
        parser_skip_newlines_and_indent(p)
        parser_expect(p, "RBrace")
        return make_dict(pairs, line)
    else:
        var elems = [first_expr]
        while parser_eat(p, "Comma"):
            parser_skip_newlines_and_indent(p)
            if parser_check(p, "RBrace"):
                break
            elems.append(parse_expr(p))
        parser_skip_newlines_and_indent(p)
        parser_expect(p, "RBrace")
        return make_set(elems, line)

def [StringSegment] resolve_interp(var Parser'actor p, [RawInterpPart] parts, int line) throws:
    var segments = []
    for part in parts:
        match part:
            Lit(s):
                segments.append(segment_lit(s))
            Hole(code):
                if string_trim(code) == "":
                    segments.append(segment_lit("{}"))
                else:
                    let hole_tokens = lex(code)
                    let sub_parser = make_parser(hole_tokens)
                    parser_skip_newlines(sub_parser)
                    let expr = parse_expr(sub_parser)
                    segments.append(segment_expr(expr))
            HoleFormatted(code, fmt):
                if string_trim(code) == "":
                    segments.append(segment_lit("{:{fmt}}"))
                else:
                    let hole_tokens = lex(code)
                    let sub_parser = make_parser(hole_tokens)
                    parser_skip_newlines(sub_parser)
                    let expr = parse_expr(sub_parser)
                    segments.append(segment_formatted_expr(expr, fmt))
    segments

def ClosureBody parse_closure_body(var Parser'actor p) throws:
    if parser_is_newline(p):
        parser_expect_newline(p)
        let stmts = parse_block(p)
        check_no_return(stmts.clone(), "closure")
        return closure_body_block(stmts)
    if parser_check(p, "Return"):
        throw "last expression (no 'return' allowed in closure)"
    let expr = parse_or(p)
    closure_body_expr(expr)

def [Arg] parse_trailing_closure(var Parser'actor p, [Arg] existing_args) throws:
    let line = parser_line(p)
    let params = parse_closure_params(p)
    let ex = parse_closure_modifiers(p)
    parser_expect(p, "Colon")
    let body = parse_closure_body(p)
    let (is_block, body) = closure_body_is_block(body)
    if is_block:
        if parser_peek_dot_after_newlines(p):
            throw "multiline trailing closure cannot be chained — use parentheses: f((x):\n    body).next()"
    let (inf, body) = infer_throws_task(body)
    let closure_expr = make_closure(params, nil, body, ex.can_throw or inf.can_throw, ex.is_task or inf.is_task, line)
    var args = existing_args
    args.append(make_arg(nil, closure_expr, false))
    args

def [Arg] parse_trailing_body(var Parser'actor p, [Arg] existing_args) throws:
    let line = parser_line(p)
    parser_expect(p, "Colon")
    let body = parse_closure_body(p)
    let (is_block, body) = closure_body_is_block(body)
    if is_block:
        if parser_peek_dot_after_newlines(p):
            throw "multiline trailing body cannot be chained — use parentheses: f(args, ():\n    body).next()"
    let (inf, body) = infer_throws_task(body)
    let closure_expr = make_closure([], nil, body, inf.can_throw, inf.is_task, line)
    var args = existing_args
    args.append(make_arg(nil, closure_expr, false))
    args

def [Arg] parse_trailing_body_no_colon(var Parser'actor p, [Arg] existing_args) throws:
    let line = parser_line(p)
    let body_expr = parse_or(p)
    let body = closure_body_expr(body_expr)
    let (inf, body) = infer_throws_task(body)
    let closure_expr = make_closure([], nil, body, inf.can_throw, inf.is_task, line)
    var args = existing_args
    args.append(make_arg(nil, closure_expr, false))
    args

def [Arg] parse_trailing_closure_no_paren(var Parser'actor p, [Arg] existing_args) throws:
    let line = parser_line(p)
    let name = parser_expect_ident(p)
    parser_expect(p, "Colon")
    let param = make_param(name, nil, false)
    let body = parse_closure_body(p)
    let (is_block, body) = closure_body_is_block(body)
    if is_block and parser_check(p, "Dot"):
        throw "multiline trailing closure cannot be chained — use parentheses: f((x):\n    body).next()"
    let (throws_task, body) = infer_throws_task(body)
    let closure_expr = make_closure([param], nil, body, throws_task.can_throw, throws_task.is_task, line)
    var args = existing_args
    args.append(make_arg(nil, closure_expr, false))
    args

def [Param] parse_closure_params(var Parser'actor p) throws:
    parser_expect(p, "LParen")
    parser_skip_newlines_and_indent(p)
    var params = []
    if parser_check(p, "RParen"):
        parser_advance(p)
        return params
    while not parser_check(p, "RParen") and not parser_check(p, "Eof"):
        if parser_is_type_start_before_ident(p):
            params.append(parse_param(p))
        else:
            let line = parser_line(p)
            let name = parser_expect_ident(p)
            params.append(make_param_at(name, nil, false, line))
        if not parser_eat(p, "Comma"):
            break
        parser_skip_newlines_and_indent(p)
    parser_skip_newlines_and_indent(p)
    parser_expect(p, "RParen")
    params

def Expr parse_task_expr(var Parser'actor p) throws:
    let line = parser_line(p)
    parser_expect(p, "Task")
    if parser_check(p, "LParen"):
        parser_advance(p)
        let dur_expr = if parser_check(p, "Ident") and parser_peek_ident(p) == "timeout" and parser_check2(p, "Eq"):
            parser_advance(p)
            parser_advance(p)
            parse_expr(p)
        else:
            parse_expr(p)
        parser_expect(p, "RParen")
        parser_eat(p, "Colon")
        let body = if parser_is_newline(p) or parser_check(p, "Eof"):
            parser_expect_newline(p)
            let stmts = parse_block(p)
            check_no_return(stmts.clone(), "task block")
            make_block_expr(stmts, line)
        else:
            parse_or(p)
        return make_task_with_timeout(dur_expr, body, line)
    parser_eat(p, "Colon")
    let inner = if parser_is_newline(p):
        parser_expect_newline(p)
        let stmts = parse_block(p)
        check_no_return(stmts.clone(), "task block")
        make_block_expr(stmts, line)
    else:
        let expr = parse_or(p)
        if expr_is_var(expr) and parser_peek_starts_expr(p):
            let arg_line = expr.line
            let arg = parse_expr(p)
            make_call(expr, [make_arg(nil, arg, false)], arg_line)
        else:
            expr
    make_task_expr(inner, line)

# ─── Statement Parsing ────────────────────────────────────────────────────────

def [Stmt] parse_block(var Parser'actor p) throws:
    while parser_check(p, "Comment") or parser_check(p, "Newline") or parser_check(p, "Semicolon"):
        parser_advance(p)
    parser_expect(p, "Indent")
    let stmts = parse_stmts_until_dedent(p)
    parser_eat(p, "Dedent")
    stmts

def [Stmt] parse_stmts_until_dedent(var Parser'actor p) throws:
    var stmts = []
    while true:
        parser_skip_newlines(p)
        if parser_check(p, "Dedent") or parser_check(p, "Eof") or parser_check(p, "RParen") or parser_check(p, "RBracket") or parser_check(p, "RBrace"):
            break
        stmts.append(parse_stmt(p))
    stmts

def Stmt parse_stmt(var Parser'actor p) throws:
    if parser_check(p, "Comment"):
        let text = parser_peek_comment(p)
        parser_advance(p)
        while parser_is_newline(p):
            parser_advance(p)
        return stmt_comment(text)
    if parser_check(p, "Let") or parser_check(p, "Var") or parser_check(p, "Static"):
        if parser_is_let_destructure(p):
            let line = parser_line(p)
            parser_eat(p, "Static")
            let mutable = parser_check(p, "Var")
            parser_advance(p)
            return stmt_let_destructure(parse_let_destructure(p, mutable, line))
        else:
            return stmt_let(parse_let_stmt(p))
    if parser_check(p, "Return"):
        return stmt_return(parse_return_stmt(p))
    if parser_check(p, "Yield"):
        let line = parser_line(p)
        parser_advance(p)
        let expr = parse_expr(p)
        parser_expect_newline_soft(p)
        return stmt_yield(expr, line)
    if parser_check(p, "Break"):
        let line = parser_line(p)
        parser_advance(p)
        let value = if parser_is_newline(p) or parser_check(p, "Dedent") or parser_check(p, "Eof"):
            nil
        else:
            some(parse_expr(p))
        parser_expect_newline_soft(p)
        return make_break_stmt(line, value)
    if parser_check(p, "Continue"):
        let line = parser_line(p)
        parser_advance(p)
        parser_expect_newline(p)
        return make_continue_stmt(line)
    if parser_check(p, "Throw"):
        return stmt_throw(parse_throw_stmt(p))
    if parser_check(p, "If"):
        if parser_peek_next_is(p, "Let"):
            return stmt_if_let(parse_if_let_stmt(p))
        else:
            return stmt_if(parse_if_stmt(p))
    if parser_check(p, "Match"):
        return stmt_match(parse_match_stmt(p))
    if parser_check(p, "While"):
        if parser_peek_next_is(p, "Let"):
            return stmt_while_let(parse_while_let_stmt(p))
        else:
            return stmt_while(parse_while_stmt(p))
    if parser_check(p, "Do"):
        let line = parser_line(p)
        parser_advance(p)
        parser_expect(p, "Colon")
        if not parser_is_newline(p) and not parser_check(p, "Eof"):
            let body = parse_inline_stmts(p)
            if parser_check(p, "While"):
                parser_advance(p)
                let condition = parse_expr(p)
                parser_expect_newline_soft(p)
                return stmt_do_while(body, condition, line)
            else:
                parser_expect_newline_soft(p)
                return stmt_expr(make_do_expr(body, line), line)
        else:
            parser_expect_newline(p)
            let body = parse_block(p)
            parser_skip_newlines(p)
            if parser_check(p, "While"):
                parser_advance(p)
                let condition = parse_expr(p)
                parser_expect_newline(p)
                return stmt_do_while(body, condition, line)
            else:
                return stmt_expr(make_do_expr(body, line), line)
    if parser_check(p, "Loop"):
        return stmt_loop(parse_loop_stmt(p))
    if parser_check(p, "Wait"):
        let line = parser_line(p)
        parser_advance(p)
        let dur = parse_expr(p)
        parser_expect_newline_soft(p)
        return stmt_wait(dur, line)
    if parser_check(p, "For"):
        return stmt_for(parse_for_stmt(p))
    if parser_check(p, "Guard"):
        return stmt_guard(parse_guard_stmt(p))
    if parser_check(p, "Try"):
        if parser_peek_next_is(p, "Colon"):
            return stmt_try(parse_try_stmt(p))
        else:
            let expr = parse_expr(p)
            parser_expect_newline_soft(p)
            return stmt_expr(expr, parser_line(p))
    if parser_check(p, "Defer"):
        return stmt_defer(parse_defer_stmt(p))
    if parser_check(p, "Def"):
        return stmt_fn(parse_fn_decl(p, false, true))
    if parser_check(p, "Req"):
        return stmt_fn(parse_fn_decl(p, false, false))
    if parser_check(p, "Struct"):
        return stmt_struct(parse_struct_decl(p, false))
    if parser_check(p, "Enum"):
        return stmt_enum(parse_enum_decl(p, false))
    if parser_check(p, "Mod"):
        return stmt_mod(parse_mod_decl(p, false))
    if parser_check(p, "Use"):
        let after_ident = parser_token_at_offset_is(p, 2, "As")
        if after_ident:
            return stmt_alias(parse_alias_decl(p))
        else:
            throw "use inside a function body must be a type alias: `use Name as Type`"
    if parser_check(p, "Pub"):
        parser_advance(p)
        if parser_check(p, "Static") or parser_check(p, "Let") or parser_check(p, "Var"):
            return stmt_let(parse_let_stmt_pub(p, true))
        elif parser_check(p, "Req"):
            return stmt_fn(parse_fn_decl(p, true, false))
        elif parser_check(p, "Struct"):
            return stmt_struct(parse_struct_decl(p, true))
        elif parser_check(p, "Enum"):
            return stmt_enum(parse_enum_decl(p, true))
        else:
            return stmt_fn(parse_fn_decl(p, true, true))
    if parser_check(p, "Task"):
        if parser_peek_next_is(p, "Def"):
            return stmt_fn(parse_fn_decl(p, false, true))
        elif parser_peek_next_is(p, "Req"):
            return stmt_fn(parse_fn_decl(p, false, false))
        elif parser_is_task_fn_shorthand(p):
            return stmt_fn(parse_fn_decl(p, false, true))
        let task_expr = parse_task_expr(p)
        if parser_is_newline(p) or parser_check(p, "Eof"):
            parser_skip_newlines(p)
        return stmt_expr(task_expr, task_expr.line)
    let line = parser_line(p)
    let lhs = parse_expr(p)
    if parser_eat(p, "Eq"):
        let rhs = parse_else_expr(p)
        parser_expect_newline(p)
        return stmt_expr(make_assign(lhs, rhs, line), line)
    let compound_op = compound_op_from_peek(p)
    if let op = compound_op:
        parser_advance(p)
        let rhs = parse_else_expr(p)
        let binop = make_binop(op, lhs, rhs, line)
        parser_expect_newline(p)
        return stmt_expr(make_assign(lhs, binop, line), line)
    if parser_eat(p, "QuestionEq"):
        let rhs = parse_else_expr(p)
        let else_expr = make_else_expr(lhs, rhs, line)
        parser_expect_newline(p)
        return stmt_expr(make_assign(lhs, else_expr, line), line)
    let expr = if expr_is_var(lhs):
        if parser_peek_starts_expr(p):
            var args = []
            while true:
                let arg = parse_or(p)
                args.append(make_arg(nil, arg, false))
                if not parser_eat(p, "Comma"):
                    break
            make_call(lhs, args, line)
        else:
            lhs
    else:
        lhs
    parser_expect_newline(p)
    stmt_expr(expr, line)

def LetStmt parse_let_stmt(var Parser'actor p) throws:
    parse_let_stmt_pub(p, false)

def LetStmt parse_let_stmt_pub(var Parser'actor p, bool is_pub) throws:
    let line = parser_line(p)
    let is_static = parser_eat(p, "Static")
    let mutable = if parser_check(p, "Var"):
        parser_advance(p)
        true
    else:
        parser_advance(p)
        false
    let name_ty = if parser_is_type_start_before_ident(p):
        let base = parse_type(p)
        let ty = parse_type_qualifier(p, base)
        let ty2 = if mutable: apply_var_to_borrow(ty) else: ty
        let name = parser_expect_ident(p)
        let ty3 = if parser_check(p, "Tick") and parser_peek_next_is_qualifier(p):
            parse_type_qualifier(p, ty2)
        else:
            ty2
        let pair = (name, some(ty3))
        pair
    else:
        let name = parser_expect_ident(p)
        if parser_check(p, "Tick"):
            let next_kind = token_kind_name(parser_peek_token_at(p, 1).kind)
            if next_kind == "Eq":
                parser_advance(p)
                parser_expect(p, "Eq")
                let value = parse_expr(p)
                parser_expect_newline_soft(p)
                return make_let_stmt(mutable, is_pub, is_static, name, nil, some(value), true, line)
            elif next_kind == "Ident" or next_kind == "Task" or next_kind == "Guard":
                let placeholder = type_named("_")
                let qualified = parse_type_qualifier(p, placeholder)
                parser_expect(p, "Eq")
                let value = parse_expr(p)
                parser_expect_newline_soft(p)
                let ty = infer_type_from_constructor(qualified, value)
                return make_let_stmt(mutable, is_pub, is_static, name, ty, some(value), false, line)
        (name, nil)
    let (string nt_name, Type? nt_ty) = name_ty
    if not parser_check(p, "Eq"):
        parser_expect_newline_soft(p)
        return make_let_stmt(mutable, is_pub, is_static, nt_name, nt_ty, nil, false, line)
    parser_expect(p, "Eq")
    let value = parse_expr(p)
    parser_expect_newline_soft(p)
    make_let_stmt(mutable, is_pub, is_static, nt_name, nt_ty, some(value), false, line)

def LetDestructureStmt parse_let_destructure(var Parser'actor p, bool mutable, int line) throws:
    let parens = parser_eat(p, "LParen")
    if parens:
        parser_skip_newlines_and_indent(p)
    var bindings = []
    while true:
        if parens and parser_check(p, "RParen"):
            break
        if not parens and (parser_check(p, "Eq") or parser_check(p, "Eof")):
            break
        let name_ty = if parser_peek_ident(p) == "_":
            parser_advance(p)
            ("_", nil)
        elif parser_is_type_start_before_ident(p):
            let ty = parse_type(p)
            let name = parser_expect_ident(p)
            (name, some(ty))
        else:
            (parser_expect_ident(p), nil)
        let (string dt_name, Type? dt_ty) = name_ty
        bindings.append(make_destructure_binding(dt_name, dt_ty))
        if not parser_eat(p, "Comma"):
            break
        parser_skip_newlines_and_indent(p)
    if parens:
        parser_skip_newlines_and_indent(p)
        parser_expect(p, "RParen")
    parser_expect(p, "Eq")
    let value = parse_expr(p)
    parser_expect_newline_soft(p)
    make_let_destructure_stmt(mutable, bindings, value, line)

def ReturnStmt parse_return_stmt(var Parser'actor p) throws:
    let line = parser_line(p)
    parser_expect(p, "Return")
    let value = if parser_is_newline(p) or parser_check(p, "Eof"):
        nil
    else:
        some(parse_expr(p))
    parser_expect_newline(p)
    make_return_stmt(value, line)

def ThrowStmt parse_throw_stmt(var Parser'actor p) throws:
    let line = parser_line(p)
    parser_expect(p, "Throw")
    let value = if parser_is_newline(p) or parser_check(p, "Eof"):
        nil
    else:
        some(parse_expr(p))
    parser_expect_newline(p)
    make_throw_stmt(value, line)

def IfStmt parse_if_stmt(var Parser'actor p) throws:
    let line = parser_line(p)
    parser_expect(p, "If")
    let saved_np = parser_get_allow_noparen_closure(p)
    parser_set_allow_noparen_closure(p, false)
    parser_set_allow_trailing_closure(p, false)
    let cond = parse_expr(p)
    parser_set_allow_noparen_closure(p, saved_np)
    parser_set_allow_trailing_closure(p, true)
    parser_expect(p, "Colon")
    if not parser_is_newline(p) and not parser_check(p, "Eof"):
        let then_stmts = parse_inline_stmts_if_body(p)
        var branches = [IfBranch(cond: cond, body: then_stmts)]
        var [Stmt]? else_body = nil
        while true:
            if parser_check(p, "Elif"):
                parser_advance(p)
                let saved = parser_get_allow_noparen_closure(p)
                parser_set_allow_noparen_closure(p, false)
                parser_set_allow_trailing_closure(p, false)
                let elif_cond = parse_expr(p)
                parser_set_allow_noparen_closure(p, saved)
                parser_set_allow_trailing_closure(p, true)
                parser_expect(p, "Colon")
                let elif_stmts = parse_inline_stmts_if_body(p)
                branches.append(IfBranch(cond: elif_cond, body: elif_stmts))
            elif parser_check(p, "Else"):
                parser_advance(p)
                else_body = some(parse_else_body_stmts(p))
                break
            else:
                break
        if else_body == nil:
            parser_expect_newline(p)
            while true:
                parser_skip_newlines(p)
                if parser_check(p, "Elif"):
                    parser_advance(p)
                    let saved = parser_get_allow_noparen_closure(p)
                    parser_set_allow_noparen_closure(p, false)
                    parser_set_allow_trailing_closure(p, false)
                    let elif_cond = parse_expr(p)
                    parser_set_allow_noparen_closure(p, saved)
                    parser_set_allow_trailing_closure(p, true)
                    parser_expect(p, "Colon")
                    let elif_body = if not parser_is_newline(p) and not parser_check(p, "Eof"):
                        parse_inline_stmts_if_body(p)
                    else:
                        parser_expect_newline(p)
                        parse_block(p)
                    branches.append(IfBranch(cond: elif_cond, body: elif_body))
                elif parser_check(p, "Else"):
                    parser_advance(p)
                    else_body = some(parse_else_body_stmts(p))
                    break
                else:
                    break
        elif parser_is_newline(p) or parser_check(p, "Eof"):
            parser_expect_newline_soft(p)
        return make_if_stmt(branches, else_body, line)
    parser_expect_newline(p)
    let body = parse_block(p)
    var branches = [IfBranch(cond: cond, body: body)]
    var [Stmt]? else_body = nil
    while true:
        parser_skip_newlines(p)
        if parser_check(p, "Elif"):
            parser_advance(p)
            let saved = parser_get_allow_noparen_closure(p)
            parser_set_allow_noparen_closure(p, false)
            parser_set_allow_trailing_closure(p, false)
            let elif_cond = parse_expr(p)
            parser_set_allow_noparen_closure(p, saved)
            parser_set_allow_trailing_closure(p, true)
            parser_expect(p, "Colon")
            let elif_body = if not parser_is_newline(p) and not parser_check(p, "Eof"):
                parse_inline_stmts_if_body(p)
            else:
                parser_expect_newline(p)
                parse_block(p)
            branches.append(IfBranch(cond: elif_cond, body: elif_body))
        elif parser_check(p, "Else"):
            parser_advance(p)
            else_body = some(parse_else_body_stmts(p))
            break
        else:
            break
    make_if_stmt(branches, else_body, line)

def WhileStmt parse_while_stmt(var Parser'actor p) throws:
    let line = parser_line(p)
    parser_expect(p, "While")
    let saved = parser_get_allow_noparen_closure(p)
    parser_set_allow_noparen_closure(p, false)
    parser_set_allow_trailing_closure(p, false)
    let condition = parse_expr(p)
    parser_set_allow_noparen_closure(p, saved)
    parser_set_allow_trailing_closure(p, true)
    parser_expect(p, "Colon")
    let body = if not parser_is_newline(p) and not parser_check(p, "Eof"):
        let stmts = parse_inline_stmts(p)
        parser_expect_newline_soft(p)
        stmts
    else:
        parser_expect_newline(p)
        parse_block(p)
    make_while_stmt(condition, body, line)

def ForStmt parse_for_stmt(var Parser'actor p) throws:
    let line = parser_line(p)
    parser_expect(p, "For")
    let saved = parser_get_allow_noparen_closure(p)
    parser_set_allow_noparen_closure(p, false)
    parser_set_allow_trailing_closure(p, false)
    let vars_iterable = if parser_is_for_with_vars(p):
        var vars = [parser_expect_ident(p)]
        while parser_eat(p, "Comma"):
            vars.append(parser_expect_ident(p))
        parser_expect(p, "In")
        let iterable = parse_expr(p)
        (vars, iterable)
    else:
        let iterable = parse_expr(p)
        (["_"], iterable)
    parser_set_allow_noparen_closure(p, saved)
    parser_set_allow_trailing_closure(p, true)
    parser_expect(p, "Colon")
    let body = if not parser_is_newline(p) and not parser_check(p, "Eof"):
        let stmts = parse_inline_stmts(p)
        parser_expect_newline_soft(p)
        stmts
    else:
        parser_expect_newline(p)
        parse_block(p)
    make_for_stmt(vars_iterable.0, vars_iterable.1, body, line)

def MatchStmt parse_match_stmt(var Parser'actor p) throws:
    let line = parser_line(p)
    parser_expect(p, "Match")
    let saved = parser_get_allow_noparen_closure(p)
    parser_set_allow_noparen_closure(p, false)
    parser_set_allow_trailing_closure(p, false)
    let subject = parse_expr(p)
    parser_set_allow_noparen_closure(p, saved)
    parser_set_allow_trailing_closure(p, true)
    if parser_check(p, "With"):
        parser_advance(p)
        let arms = parse_inline_match_arms(p)
        return make_match_stmt(subject, arms, line)
    parser_expect(p, "Colon")
    parser_expect_newline(p)
    parser_expect(p, "Indent")
    var arms = []
    while true:
        parser_skip_newlines(p)
        if parser_check(p, "Dedent") or parser_check(p, "Eof") or parser_check(p, "RParen") or parser_check(p, "RBracket") or parser_check(p, "RBrace"):
            break
        arms.append(parse_match_arm(p))
    parser_eat(p, "Dedent")
    make_match_stmt(subject, arms, line)

def TryStmt parse_try_stmt(var Parser'actor p) throws:
    let line = parser_line(p)
    parser_expect(p, "Try")
    parser_expect(p, "Colon")
    parser_expect_newline(p)
    let body = parse_block(p)
    var catch_clauses = []
    while true:
        parser_skip_newlines(p)
        if parser_check(p, "Catch"):
            let catch_line = parser_line(p)
            parser_advance(p)
            var types = []
            var string? variant = nil
            if parser_peek_is_ident(p):
                let first_type = parser_expect_ident(p)
                if parser_eat(p, "Dot"):
                    variant = some(parser_expect_ident(p))
                    types.append(first_type)
                else:
                    types.append(first_type)
                    while parser_eat(p, "Comma"):
                        types.append(parser_expect_ident(p))
            parser_expect(p, "Colon")
            parser_expect_newline(p)
            let catch_body = parse_block(p)
            catch_clauses.append(make_catch_clause(types, variant, catch_body, catch_line))
        else:
            break
    make_try_stmt(body, catch_clauses, line)

def Stmt parse_print_stmt(var Parser'actor p) throws:
    let line = parser_line(p)
    parser_expect(p, "Print")
    var args = []
    while not parser_is_newline(p) and not parser_check(p, "Eof"):
        args.append(parse_or(p))
        if not parser_eat(p, "Comma"):
            break
    parser_expect_newline_soft(p)
    stmt_expr(make_call(make_var_expr("print", line), map_args(args), line), line)

def [Stmt] parse_else_body_stmts(var Parser'actor p) throws:
    parser_eat(p, "Colon")
    if parser_is_newline(p):
        parser_expect_newline(p)
        parse_block(p)
    else:
        let stmts = parse_inline_stmts(p)
        parser_expect_newline_soft(p)
        stmts

def Expr parse_else_body_expr(var Parser'actor p) throws:
    let line = parser_line(p)
    parser_eat(p, "Colon")
    if parser_is_newline(p):
        parser_expect_newline(p)
        let stmts = parse_block(p)
        make_block_expr(stmts, line)
    else:
        parse_or(p)
# == BUILT-IN METHODS ==

def string val_type_name(Value v):
    match v:
        Value.Int(_): "int"
        Value.Float(_): "float"
        Value.Str(_): "string"
        Value.Bool(_): "bool"
        Value.Array(_): "array"
        Value.Dict(_): "dict"
        Value.Set(_): "set"
        Value.Nil: "nil"
        Value.Void: "void"
        Value.Tuple(_): "tuple"
        Value.Range(_, _, _, _): "range"
        Value.Object(inner): inner.type_name
        Value.EnumVariant(type_name, _, _): type_name
        _: "unknown"

def Value call_method(var Interpreter'actor interp, Value recv, string method_name, [Value] args):
    match recv:
        Value.Str(s):
            match method_name:
                "length":
                    Value.Int(s.length)
                "len":
                    Value.Int(s.length)
                "split":
                    let sep = args[0] else Value.Str("")
                    match sep:
                        Value.Str(sv):
                            Value.Array(s.split(sv).map((part): Value.Str(part)))
                        _: throw "split: expected string separator"
                "trim":
                    Value.Str(s.trim())
                "trimStart":
                    Value.Str(s.trimStart())
                "trimEnd":
                    Value.Str(s.trimEnd())
                "startsWith":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv): Value.Bool(s.startsWith(sv))
                        _: throw "startsWith: expected string argument"
                "endsWith":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv): Value.Bool(s.endsWith(sv))
                        _: throw "endsWith: expected string argument"
                "contains":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv): Value.Bool(s.contains(sv))
                        _: throw "contains: expected string argument"
                "replace":
                    let from_val = args[0] else Value.Str("")
                    let to_val = args[1] else Value.Str("")
                    match from_val:
                        Value.Str(from_s):
                            match to_val:
                                Value.Str(to_s): Value.Str(s.replace(from_s, to_s))
                                _: throw "replace: expected string arguments"
                        _: throw "replace: expected string arguments"
                "toUpper":
                    Value.Str(s.toUpper())
                "toLower":
                    Value.Str(s.toLower())
                "chars":
                    Value.Array(s.chars().map((c): Value.Str(c)))
                "lines":
                    Value.Array(s.split("\n").map((l): Value.Str(l)))
                "slice":
                    let start_val = args[0] else Value.Int(0)
                    let end_val = args[1] else Value.Int(s.length)
                    match start_val:
                        Value.Int(start):
                            match end_val:
                                Value.Int(end): Value.Str(s.slice(start, end))
                                _: throw "slice: expected int end"
                        _: throw "slice: expected int start"
                "indexOf":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv):
                            let idx = s.indexOf(sv)
                            if let idx_val = idx:
                                Value.Int(idx_val)
                            else:
                                Value.Nil
                        _: throw "indexOf: expected string argument"
                "repeat":
                    let arg = args[0] else Value.Int(0)
                    match arg:
                        Value.Int(n): Value.Str(s.repeat(n as uint))
                        _: throw "repeat: expected int argument"
                "padLeft":
                    let width_val = args[0] else Value.Int(0)
                    let pad_val = args[1] else Value.Str(" ")
                    match width_val:
                        Value.Int(w):
                            match pad_val:
                                Value.Str(p):
                                    let cur_len = s.length
                                    if cur_len >= w:
                                        Value.Str(s)
                                    else:
                                        let padding = p.repeat((w - cur_len) as uint)
                                        Value.Str("{padding}{s}")
                                _: throw "padLeft: expected string pad"
                        _: throw "padLeft: expected int width"
                "padRight":
                    let width_val = args[0] else Value.Int(0)
                    let pad_val = args[1] else Value.Str(" ")
                    match width_val:
                        Value.Int(w):
                            match pad_val:
                                Value.Str(p):
                                    let cur_len = s.length
                                    if cur_len >= w:
                                        Value.Str(s)
                                    else:
                                        let padding = p.repeat((w - cur_len) as uint)
                                        Value.Str("{s}{padding}")
                                _: throw "padRight: expected string pad"
                        _: throw "padRight: expected int width"
                "parseInt":
                    let parsed = s.parseInt()
                    if parsed == nil:
                        Value.Nil
                    else:
                        Value.Int(parsed else 0)
                "parseFloat":
                    let parsed = s.parseFloat()
                    if parsed == nil:
                        Value.Nil
                    else:
                        Value.Float(parsed else 0.0)
                "isDigit":
                    Value.Bool(s.length == 1 and s.chars().all((c): c >= "0" and c <= "9"))
                "isAlpha":
                    Value.Bool(s.length == 1 and ((s >= "a" and s <= "z") or (s >= "A" and s <= "Z")))
                "isEmpty":
                    Value.Bool(s.length == 0)
                _:
                    throw "unknown method {method_name} on {val_type_name(recv)}"

        Value.Array(arr):
            match method_name:
                "length":
                    Value.Int(arr.length)
                "len":
                    Value.Int(arr.length)
                "append":
                    let other_val = args[0] else Value.Nil
                    match other_val:
                        Value.Array(other):
                            var result = arr
                            var i = 0
                            while i < other.length:
                                result.append(other[i])
                                i = i + 1
                            Value.Array(result)
                        _:
                            var result = arr
                            result.append(other_val)
                            Value.Array(result)
                "push":
                    let val = args[0] else Value.Nil
                    var result = arr
                    result.append(val)
                    Value.Array(result)
                "pop":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        arr[arr.length - 1]
                "remove":
                    let idx_val = args[0] else Value.Int(0)
                    match idx_val:
                        Value.Int(idx):
                            var result = arr
                            result.remove(idx)
                            Value.Array(result)
                        _: throw "remove: expected int index"
                "insert":
                    let idx_val = args[0] else Value.Int(0)
                    let val = args[1] else Value.Nil
                    match idx_val:
                        Value.Int(idx):
                            var result = arr
                            result.insert(idx, val)
                            Value.Array(result)
                        _: throw "insert: expected int index"
                "first":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        arr[0]
                "last":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        arr[arr.length - 1]
                "contains":
                    let target = args[0] else Value.Nil
                    Value.Bool(arr.contains(target))
                "map":
                    let closure = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < arr.length:
                        let r = call_value(interp, closure, [arr[i]])
                        result.append(r)
                        i = i + 1
                    Value.Array(result)
                "filter":
                    let closure = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < arr.length:
                        let r = call_value(interp, closure, [arr[i]])
                        match r:
                            Value.Bool(b):
                                if b:
                                    result.append(arr[i])
                            _: throw "filter: predicate must return bool"
                        i = i + 1
                    Value.Array(result)
                "reduce":
                    let init_val = args[0] else Value.Nil
                    let closure = args[1] else Value.Nil
                    var acc = init_val
                    var i = 0
                    while i < arr.length:
                        acc = call_value(interp, closure, [acc, arr[i]])
                        i = i + 1
                    acc
                "sorted":
                    var result = arr
                    result = result.sorted()
                    Value.Array(result)
                "sortedBy":
                    let closure = args[0] else Value.Nil
                    var keys = []
                    var i = 0
                    while i < arr.length:
                        let k = call_value(interp, closure, [arr[i]])
                        keys.append(k)
                        i = i + 1
                    var indices = []
                    var j = 0
                    while j < arr.length:
                        indices.append(Value.Int(j))
                        j = j + 1
                    let sorted_indices = indices.sortedBy((idx_val):
                        match idx_val:
                            Value.Int(idx): keys[idx]
                            _: Value.Nil
                    )
                    var result = []
                    var k = 0
                    while k < sorted_indices.length:
                        match sorted_indices[k]:
                            Value.Int(idx): result.append(arr[idx])
                            _: throw "sortedBy: internal error"
                        k = k + 1
                    Value.Array(result)
                "reversed":
                    var result = arr
                    result = result.reversed()
                    Value.Array(result)
                "any":
                    let closure = args[0] else Value.Nil
                    var found = false
                    var i = 0
                    while i < arr.length and not found:
                        let r = call_value(interp, closure, [arr[i]])
                        match r:
                            Value.Bool(b):
                                if b:
                                    found = true
                            _: throw "any: predicate must return bool"
                        i = i + 1
                    Value.Bool(found)
                "all":
                    let closure = args[0] else Value.Nil
                    var all_pass = true
                    var i = 0
                    while i < arr.length and all_pass:
                        let r = call_value(interp, closure, [arr[i]])
                        match r:
                            Value.Bool(b):
                                if not b:
                                    all_pass = false
                            _: throw "all: predicate must return bool"
                        i = i + 1
                    Value.Bool(all_pass)
                "count":
                    if args.length == 0:
                        Value.Int(arr.length)
                    else:
                        let closure = args[0]
                        var n = 0
                        var i = 0
                        while i < arr.length:
                            let r = call_value(interp, closure, [arr[i]])
                            match r:
                                Value.Bool(b):
                                    if b:
                                        n = n + 1
                                _: throw "count: predicate must return bool"
                            i = i + 1
                        Value.Int(n)
                "take":
                    let n_val = args[0] else Value.Int(0)
                    match n_val:
                        Value.Int(n):
                            let end = if n < arr.length: n else: arr.length
                            Value.Array(arr.slice(0, end))
                        _: throw "take: expected int argument"
                "drop":
                    let n_val = args[0] else Value.Int(0)
                    match n_val:
                        Value.Int(n):
                            let start = if n < arr.length: n else: arr.length
                            Value.Array(arr.slice(start, arr.length))
                        _: throw "drop: expected int argument"
                "slice":
                    let start_val = args[0] else Value.Int(0)
                    let end_val = args[1] else Value.Int(arr.length)
                    match start_val:
                        Value.Int(start):
                            match end_val:
                                Value.Int(end):
                                    let s = if start < arr.length: start else: arr.length
                                    let e = if end < arr.length: end else: arr.length
                                    Value.Array(arr.slice(s, e))
                                _: throw "slice: expected int end"
                        _: throw "slice: expected int start"
                "zip":
                    let other_val = args[0] else Value.Array([])
                    match other_val:
                        Value.Array(other):
                            var result = []
                            let len = if arr.length < other.length: arr.length else: other.length
                            var i = 0
                            while i < len:
                                result.append(Value.Tuple([arr[i], other[i]]))
                                i = i + 1
                            Value.Array(result)
                        _: throw "zip: expected array argument"
                "enumerate":
                    var result = []
                    var i = 0
                    while i < arr.length:
                        result.append(Value.Tuple([Value.Int(i), arr[i]]))
                        i = i + 1
                    Value.Array(result)
                "indexOf":
                    let target = args[0] else Value.Nil
                    var found_idx = Value.Nil
                    var i = 0
                    while i < arr.length and found_idx == Value.Nil:
                        if arr[i] == target:
                            found_idx = Value.Int(i)
                        i = i + 1
                    found_idx
                "flat":
                    var result = []
                    var i = 0
                    while i < arr.length:
                        match arr[i]:
                            Value.Array(inner):
                                var j = 0
                                while j < inner.length:
                                    result.append(inner[j])
                                    j = j + 1
                            other:
                                result.append(other)
                        i = i + 1
                    Value.Array(result)
                "flatMap":
                    let closure = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < arr.length:
                        let r = call_value(interp, closure, [arr[i]])
                        match r:
                            Value.Array(inner):
                                var j = 0
                                while j < inner.length:
                                    result.append(inner[j])
                                    j = j + 1
                            other:
                                result.append(other)
                        i = i + 1
                    Value.Array(result)
                "join":
                    let sep_val = args[0] else Value.Str("")
                    match sep_val:
                        Value.Str(sep):
                            var [string] parts = []
                            var i = 0
                            while i < arr.length:
                                match arr[i]:
                                    Value.Str(sv): parts.append(sv)
                                    Value.Int(n): parts.append("{n}")
                                    Value.Float(f): parts.append("{f}")
                                    Value.Bool(b): parts.append("{b}")
                                    _: parts.append("nil")
                                i = i + 1
                            Value.Str(parts.joined(sep))
                        _: throw "join_val: expected string separator"
                "sum":
                    var int_sum = 0
                    var float_sum = 0.0
                    var has_float = false
                    var i = 0
                    while i < arr.length:
                        match arr[i]:
                            Value.Int(n): int_sum = int_sum + n
                            Value.Float(f):
                                float_sum = float_sum + f
                                has_float = true
                            _: throw "sum: non-numeric element"
                        i = i + 1
                    if has_float:
                        Value.Float(float_sum + int_sum as float)
                    else:
                        Value.Int(int_sum)
                "min":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        var min_val = arr[0]
                        var i = 1
                        while i < arr.length:
                            match arr[i]:
                                Value.Int(n):
                                    match min_val:
                                        Value.Int(m):
                                            if n < m:
                                                min_val = arr[i]
                                        _: throw "min: mixed types"
                                Value.Float(f):
                                    match min_val:
                                        Value.Float(m):
                                            if f < m:
                                                min_val = arr[i]
                                        _: throw "min: mixed types"
                                _: throw "min: non-numeric element"
                            i = i + 1
                        min_val
                "max":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        var max_val = arr[0]
                        var i = 1
                        while i < arr.length:
                            match arr[i]:
                                Value.Int(n):
                                    match max_val:
                                        Value.Int(m):
                                            if n > m:
                                                max_val = arr[i]
                                        _: throw "max: mixed types"
                                Value.Float(f):
                                    match max_val:
                                        Value.Float(m):
                                            if f > m:
                                                max_val = arr[i]
                                        _: throw "max: mixed types"
                                _: throw "max: non-numeric element"
                            i = i + 1
                        max_val
                "shuffle":
                    Value.Array(arr)
                "distinct":
                    var result = []
                    var i = 0
                    while i < arr.length:
                        if not result.contains(arr[i]):
                            result.append(arr[i])
                        i = i + 1
                    Value.Array(result)
                "isEmpty":
                    Value.Bool(arr.length == 0)
                _:
                    throw "unknown method {method_name} on {val_type_name(recv)}"

        Value.Dict(pairs):
            match method_name:
                "length":
                    Value.Int(pairs.length)
                "len":
                    Value.Int(pairs.length)
                "get":
                    let key = args[0] else Value.Nil
                    let default = args[1] else Value.Nil
                    var found = default
                    var i = 0
                    while i < pairs.length:
                        let pair = pairs[i]
                        if pair.0 == key:
                            found = pair.1
                        i = i + 1
                    found
                "set":
                    let key = args[0] else Value.Nil
                    let val = args[1] else Value.Nil
                    var new_pairs = pairs
                    var updated = false
                    var i = 0
                    while i < new_pairs.length:
                        let pair = new_pairs[i]
                        if pair.0 == key:
                            new_pairs[i] = (key, val)
                            updated = true
                        i = i + 1
                    if not updated:
                        new_pairs.append((key, val))
                    Value.Dict(new_pairs)
                "contains":
                    let key = args[0] else Value.Nil
                    var found = false
                    var i = 0
                    while i < pairs.length:
                        if pairs[i].0 == key:
                            found = true
                        i = i + 1
                    Value.Bool(found)
                "remove":
                    let key = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < pairs.length:
                        if pairs[i].0 != key:
                            result.append(pairs[i])
                        i = i + 1
                    Value.Dict(result)
                "keys":
                    var result = []
                    var i = 0
                    while i < pairs.length:
                        result.append(pairs[i].0)
                        i = i + 1
                    Value.Array(result)
                "values":
                    var result = []
                    var i = 0
                    while i < pairs.length:
                        result.append(pairs[i].1)
                        i = i + 1
                    Value.Array(result)
                "entries":
                    var result = []
                    var i = 0
                    while i < pairs.length:
                        let (ek, ev) = pairs[i]
                        result.append(Value.Array([ek, ev]))
                        i = i + 1
                    Value.Array(result)
                "merge":
                    let other_val = args[0] else Value.Dict([])
                    match other_val:
                        Value.Dict(other):
                            var result = pairs
                            var i = 0
                            while i < other.length:
                                let oe = other[i]
                                var found = false
                                var j = 0
                                while j < result.length:
                                    if result[j].0 == oe.0:
                                        result[j] = (oe.0, oe.1)
                                        found = true
                                    j = j + 1
                                if not found:
                                    result.append(oe)
                                i = i + 1
                            Value.Dict(result)
                        _: throw "merge: expected dict argument"
                "isEmpty":
                    Value.Bool(pairs.length == 0)
                _:
                    throw "unknown method {method_name} on {val_type_name(recv)}"

        Value.Set(elements):
            match method_name:
                "length":
                    Value.Int(elements.length)
                "len":
                    Value.Int(elements.length)
                "contains":
                    let val = args[0] else Value.Nil
                    Value.Bool(elements.contains(val))
                "add":
                    let val = args[0] else Value.Nil
                    if elements.contains(val):
                        Value.Set(elements)
                    else:
                        var result = elements
                        result.append(val)
                        Value.Set(result)
                "remove":
                    let val = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < elements.length:
                        if elements[i] != val:
                            result.append(elements[i])
                        i = i + 1
                    Value.Set(result)
                "toArray":
                    Value.Array(elements)
                "union":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "union: expected set or array"
                    var result = elements
                    var i = 0
                    while i < other.length:
                        if not result.contains(other[i]):
                            result.append(other[i])
                        i = i + 1
                    Value.Set(result)
                "intersection":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "intersection: expected set or array"
                    var result = []
                    var i = 0
                    while i < elements.length:
                        if other.contains(elements[i]):
                            result.append(elements[i])
                        i = i + 1
                    Value.Set(result)
                "difference":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "difference: expected set or array"
                    var result = []
                    var i = 0
                    while i < elements.length:
                        if not other.contains(elements[i]):
                            result.append(elements[i])
                        i = i + 1
                    Value.Set(result)
                "isSubset":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "isSubset: expected set or array"
                    var all_in = true
                    var i = 0
                    while i < elements.length and all_in:
                        if not other.contains(elements[i]):
                            all_in = false
                        i = i + 1
                    Value.Bool(all_in)
                "isSuperset":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "isSuperset: expected set or array"
                    var all_in = true
                    var i = 0
                    while i < other.length and all_in:
                        if not elements.contains(other[i]):
                            all_in = false
                        i = i + 1
                    Value.Bool(all_in)
                "isEmpty":
                    Value.Bool(elements.length == 0)
                _:
                    throw "unknown method {method_name} on {val_type_name(recv)}"

        Value.Int(n):
            match method_name:
                "abs":
                    if n < 0:
                        Value.Int(0 - n)
                    else:
                        Value.Int(n)
                "sqrt":
                    Value.Float((n as float).sqrt())
                "floor":
                    Value.Int(n)
                "ceil":
                    Value.Int(n)
                "round":
                    Value.Int(n)
                "toStr":
                    Value.Str("{n}")
                "toBin":
                    Value.Str("{n:b}")
                "toHex":
                    Value.Str("{n:x}")
                _:
                    throw "unknown method {method_name} on {val_type_name(recv)}"

        Value.Float(f):
            match method_name:
                "abs":
                    if f < 0.0:
                        Value.Float(0.0 - f)
                    else:
                        Value.Float(f)
                "sqrt":
                    Value.Float(f.sqrt())
                "floor":
                    Value.Int(f.floor() as int)
                "ceil":
                    Value.Int(f.ceil() as int)
                "round":
                    Value.Int(f.round() as int)
                "toStr":
                    Value.Str("{f}")
                "toBin":
                    let fi = f.floor() as int
                    Value.Str("{fi:b}")
                "toHex":
                    let fi = f.floor() as int
                    Value.Str("{fi:x}")
                _:
                    throw "unknown method {method_name} on {val_type_name(recv)}"

        Value.Range(start, end, inclusive, step):
            match method_name:
                "toArray":
                    var result = []
                    var i = start
                    let lim = if inclusive: end + 1 else: end
                    while i < lim:
                        result.append(Value.Int(i))
                        i = i + step
                    Value.Array(result)
                "contains":
                    let val = args[0] else Value.Nil
                    match val:
                        Value.Int(n):
                            let lim = if inclusive: end + 1 else: end
                            var found = false
                            var i = start
                            while i < lim and not found:
                                if i == n:
                                    found = true
                                i = i + step
                            Value.Bool(found)
                        _: Value.Bool(false)
                "length":
                    let lim = if inclusive: end + 1 else: end
                    let len = (lim - start + step - 1) / step
                    Value.Int(if len < 0: 0 else: len)
                "step":
                    let s_val = args[0] else Value.Int(1)
                    match s_val:
                        Value.Int(sv): Value.Range(start, end, inclusive, sv)
                        _: throw "step: expected int argument"
                _:
                    throw "unknown method {method_name} on {val_type_name(recv)}"

        _:
            throw "unknown method {method_name} on {val_type_name(recv)}"
# == EXEC AND CALL ==

# ─── exec_block ───────────────────────────────────────────────────────────────

def Signal? exec_block(var Interpreter'actor interp, [Stmt] stmts):
    for stmt in stmts:
        let Signal? sig = exec_stmt(interp, stmt)
        if sig != nil:
            return sig
    nil

# ─── exec_stmt ────────────────────────────────────────────────────────────────

def Signal? exec_stmt(var Interpreter'actor interp, Stmt stmt):
    match stmt:
        Let(s):
            var val = Uninitialized
            if let expr = s.value:
                val = eval_expr(interp, expr)
            if s.mutable:
                interp.current_env.define_mut(s.name, val)
            else:
                interp.current_env.define(s.name, val)
            nil

        If(s):
            exec_if(interp, s)

        While(s):
            exec_while(interp, s)

        For(s):
            exec_for(interp, s)

        Match(s):
            exec_match_stmt(interp, s)

        Return(s):
            var val = Nil
            if let expr = s.value:
                val = eval_expr(interp, expr)
            ReturnSignal(val)

        Break:
            BreakSignal(Void)

        Continue:
            ContinueSignal

        Throw(s):
            var val = Nil
            if let expr = s.value:
                val = eval_expr(interp, expr)
            else:
                let err = interp.current_env.get("error")
                val = err else Nil
            ThrowSignal(val)

        Try(s):
            exec_try(interp, s)

        Expr(expr):
            eval_expr(interp, expr)
            nil

        _: nil

# ─── exec_if ──────────────────────────────────────────────────────────────────

def Signal? exec_if(var Interpreter'actor interp, IfStmt s):
    for branch in s.branches:
        let cond_val = eval_expr(interp, branch.cond)
        let b = expect_bool(cond_val)
        if b:
            let child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block(interp, branch.body)
            interp.current_env = prev
            return sig
    if let else_body = s.else_body:
        let child = new_env(interp.current_env)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block(interp, else_body)
        interp.current_env = prev
        return sig
    nil

# ─── exec_while ───────────────────────────────────────────────────────────────

def Signal? exec_while(var Interpreter'actor interp, WhileStmt s):
    var running = true
    var Signal? result = nil
    while running:
        let cond_val = eval_expr(interp, s.condition.clone())
        let b = expect_bool(cond_val)
        if not b:
            running = false
        else:
            let child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block(interp, s.body.clone())
            interp.current_env = prev
            match sig:
                nil: nil
                BreakSignal(_): running = false
                ContinueSignal: nil
                _:
                    running = false
                    result = sig
    result

# ─── exec_for ─────────────────────────────────────────────────────────────────

def Signal? exec_for(var Interpreter'actor interp, ForStmt s):
    let iterable = eval_expr(interp, s.iterable)
    let items = collect_iterable(iterable)
    var Signal? result = nil
    var idx = 0
    var done = false
    while not done and idx < items.length:
        let item = items[idx]
        idx = idx + 1
        let child = new_env(interp.current_env)
        let vars = s.vars.clone()
        if vars.length == 1:
            child.define(vars[0], item)
        else:
            match item:
                Tuple(elems):
                    var i = 0
                    for v in vars:
                        let val = if i < elems.length: elems[i] else: Value.Nil
                        child.define(v, val)
                        i = i + 1
                _:
                    child.define(vars[0], Int(idx - 1))
                    if vars.length >= 2:
                        child.define(vars[1], item)
        let prev = interp.current_env
        interp.current_env = child
        let sig = exec_block(interp, s.body.clone())
        interp.current_env = prev
        match sig:
            nil: nil
            BreakSignal(_): done = true
            ContinueSignal: nil
            _:
                done = true
                result = sig
    result

# ─── collect_iterable ─────────────────────────────────────────────────────────

def [Value] collect_iterable(Value val):
    match val:
        Array(elems): elems
        Set(elems): elems
        Tuple(elems): elems
        Value.Dict(pairs):
            var out = []
            for p in pairs:
                out.append(Tuple([p.0, p.1]))
            out
        Range(start, end, inclusive, _):
            var out = []
            var i = start
            let limit = if inclusive: end + 1 else: end
            while i < limit:
                out.append(Int(i))
                i = i + 1
            out
        Str(s):
            var out = []
            for c in s:
                out.append(Str(c))
            out
        _: throw "value is not iterable"

# ─── exec_match_stmt ──────────────────────────────────────────────────────────

def Signal? exec_match_stmt(var Interpreter'actor interp, MatchStmt s):
    let subject = eval_expr(interp, s.subject)
    var matched = false
    var Signal? result = nil
    var arm_idx = 0
    while not matched and arm_idx < s.arms.length:
        let arm = s.arms[arm_idx]
        arm_idx = arm_idx + 1
        var pat_idx = 0
        while not matched and pat_idx < arm.patterns.length:
            let pattern = arm.patterns[pat_idx]
            pat_idx = pat_idx + 1
            let child = new_env(interp.current_env)
            let did_match = match_pattern(subject.clone(), pattern, child.clone())
            if did_match:
                var guard_ok = true
                if let guard_expr = arm.match_guard:
                    let gprev = interp.current_env
                    interp.current_env = child.clone()
                    let gv = eval_expr(interp, guard_expr)
                    interp.current_env = gprev
                    guard_ok = expect_bool(gv)
                if guard_ok:
                    matched = true
                    let prev = interp.current_env
                    interp.current_env = child
                    let sig = match arm.body:
                        MatchBody.Expr(e):
                            eval_expr(interp, e)
                            nil
                        MatchBody.Block(stmts):
                            exec_block(interp, stmts)
                    interp.current_env = prev
                    result = sig
    result

# ─── match_pattern ────────────────────────────────────────────────────────────

def Value expr_to_value_literal(Expr expr):
    match expr.kind:
        ExprKind.Int(n): Value.Int(n)
        ExprKind.Float(f): Value.Float(f)
        ExprKind.Str(s): Value.Str(s)
        ExprKind.Bool(b): Value.Bool(b)
        ExprKind.Nil: Value.Nil
        _: Value.Nil

def bool match_pattern(Value val, Pattern pattern, var Env'actor env):
    match pattern:
        Pattern.Wildcard:
            true
        Pattern.Bind(name):
            env.define(name, val)
            true
        Pattern.None:
            match val:
                Value.Nil: true
                _: false
        Pattern.Some(inner):
            match val:
                Value.Nil: false
                _: match_pattern(val, inner, env)
        Pattern.Lit(lit):
            match lit:
                LitPattern.Int(n):
                    match val:
                        Value.Int(v): v == n
                        _: false
                LitPattern.Float(f):
                    match val:
                        Value.Float(v): v == f
                        _: false
                LitPattern.Str(s):
                    match val:
                        Value.Str(v): v == s
                        _: false
                LitPattern.Bool(b):
                    match val:
                        Value.Bool(v): v == b
                        _: false
                LitPattern.Nil:
                    match val:
                        Value.Nil: true
                        _: false
        Pattern.Tuple(pats):
            match val:
                Value.Tuple(elems):
                    if elems.length != pats.length:
                        false
                    else:
                        var ok = true
                        var i = 0
                        while ok and i < pats.length:
                            ok = match_pattern(elems[i], pats[i], env)
                            i = i + 1
                        ok
                _: false
        Pattern.Variant(variant_name, field_pats):
            match val:
                Value.EnumVariant(vtype, vvariant, vfields):
                    let full = if vtype.length > 0: "{vtype}.{vvariant}" else: vvariant
                    if full != variant_name and vvariant != variant_name:
                        false
                    else:
                        var ok = true
                        var i = 0
                        while ok and i < field_pats.length:
                            let fval = if i < vfields.length: vfields[i] else: Value.Nil
                            ok = match_pattern(fval, field_pats[i], env)
                            i = i + 1
                        ok
                _: false

# ─── exec_try ─────────────────────────────────────────────────────────────────

def Signal? exec_try(var Interpreter'actor interp, TryStmt s):
    let child = new_env(interp.current_env)
    let prev = interp.current_env
    interp.current_env = child
    let body_sig = exec_block(interp, s.body)
    interp.current_env = prev
    match body_sig:
        ThrowSignal(exc_val):
            let exc_type = value_type_name(exc_val.clone())
            var handled = false
            var clause_idx = 0
            while not handled and clause_idx < s.catch_clauses.length:
                let clause = s.catch_clauses[clause_idx]
                clause_idx = clause_idx + 1
                let matches = clause.types.length == 0 or clause.types.contains(exc_type)
                if matches:
                    handled = true
                    let cenv = new_env(interp.current_env)
                    cenv.define("error", exc_val.clone())
                    let cprev = interp.current_env
                    interp.current_env = cenv
                    let csig = exec_block(interp, clause.body)
                    interp.current_env = cprev
                    return csig
            if not handled:
                ThrowSignal(exc_val)
            else:
                nil
        _: body_sig

# ─── call_fn ──────────────────────────────────────────────────────────────────

def Value call_fn(var Interpreter'actor interp, FnDecl decl, [Value] args, Env'actor? captured):
    let base_env = captured else interp.global_env
    let fn_env = new_env(base_env.clone())
    var {string=Value} labeled = {}
    var positional = []
    for val in args:
        match val:
            Labeled(label, v):
                labeled.set(label, v)
            _:
                positional.append(val)
    var pos_idx = 0
    for param in decl.params:
        var val = Nil
        if labeled.has(param.name):
            val = labeled[param.name]
        else:
            if pos_idx < positional.length:
                val = positional[pos_idx]
                pos_idx = pos_idx + 1
            else:
                if let default_expr = param.default:
                    let dprev = interp.current_env
                    interp.current_env = base_env.clone()
                    val = eval_expr(interp, default_expr)
                    interp.current_env = dprev
        if param.mutable:
            fn_env.define_mut(param.name, val)
        else:
            fn_env.define(param.name, val)
    let prev_env = interp.current_env
    interp.current_env = fn_env
    let sig = exec_block(interp, decl.body)
    interp.current_env = prev_env
    match sig:
        nil: Nil
        ReturnSignal(v): v
        ThrowSignal(v): throw value_to_string(v)
        _: Nil

# ─── call_closure ─────────────────────────────────────────────────────────────

def Value call_closure(var Interpreter'actor interp, [Param] params, ClosureBody body, [Value] args, Env'actor? captured):
    let fn_env = new_env(captured)
    var i = 0
    for param in params:
        let val = if i < args.length: args[i] else: Nil
        fn_env.define(param.name, val)
        i = i + 1
    let prev_env = interp.current_env
    interp.current_env = fn_env
    let sig = match body:
        ClosureBody.Block(stmts): exec_block(interp, stmts)
        ClosureBody.Expr(e): some(Signal.ReturnSignal(eval_expr(interp, e)))
    interp.current_env = prev_env
    match sig:
        nil: Nil
        ReturnSignal(v): v
        BreakSignal(v): v
        ContinueSignal: Nil
        ThrowSignal(v): throw value_to_string(v)
        _: Nil

# ─── call_value ───────────────────────────────────────────────────────────────

def Value call_value(var Interpreter'actor interp, Value callee, [Value] args):
    match callee:
        Value.Fn(name, captured):
            let decl = lookup_fn_decl(interp, name)
            call_fn(interp, decl, args, captured)

        Value.Closure(params, body_stmts, captured):
            call_closure(interp, params, body_stmts, args, captured)

        Value.NativeFn(name, func):
            call_native(interp, name, func, args)

        Value.OverloadedFn(name, variants):
            let best = resolve_overload(interp, variants, args.clone())
            call_value(interp, best, args)

        _: throw "value is not callable"

# ─── helpers ──────────────────────────────────────────────────────────────────

def bool expect_bool(Value val):
    match val:
        Bool(b): b
        _: throw "expected bool"

def string value_type_name(Value val):
    match val:
        Nil: "nil"
        Void: "void"
        Bool(_): "bool"
        Int(_): "int"
        Float(_): "float"
        Str(_): "string"
        Array(_): "array"
        Tuple(_): "tuple"
        Dict(_): "dict"
        Set(_): "set"
        Object(inner): inner.type_name
        EnumVariant(t, _, _): t
        Fn(n, _): "fn({n})"
        Closure(_, _, _): "closure"
        NativeFn(n, _): "native({n})"
        OverloadedFn(n, _): "fn({n})"
        Range(_, _, _, _): "range"
        Labeled(_, _): "labeled"

def string value_to_string(Value val):
    match val:
        Nil: "nil"
        Void: ""
        Bool(b): if b: "true" else: "false"
        Int(n): "{n}"
        Float(f): "{f}"
        Str(s): s
        _: value_type_name(val)

def bool value_equals(Value a, Value b):
    match a:
        Nil:
            match b:
                Nil: true
                _: false
        Bool(x):
            match b:
                Bool(y): x == y
                _: false
        Int(x):
            match b:
                Int(y): x == y
                _: false
        Float(x):
            match b:
                Float(y): x == y
                _: false
        Str(x):
            match b:
                Str(y): x == y
                _: false
        _: false

def Value value_add(Value a, Value b):
    match a:
        Int(x):
            match b:
                Int(y): Int(x + y)
                _: throw "type error in +="
        Float(x):
            match b:
                Float(y): Float(x + y)
                _: throw "type error in +="
        Str(x):
            match b:
                Str(y): Str("{x}{y}")
                _: throw "type error in +="
        _: throw "type error in +="

def Value value_sub(Value a, Value b):
    match a:
        Int(x):
            match b:
                Int(y): Int(x - y)
                _: throw "type error in -="
        Float(x):
            match b:
                Float(y): Float(x - y)
                _: throw "type error in -="
        _: throw "type error in -="

def Value value_mul(Value a, Value b):
    match a:
        Int(x):
            match b:
                Int(y): Int(x * y)
                _: throw "type error in *="
        Float(x):
            match b:
                Float(y): Float(x * y)
                _: throw "type error in *="
        _: throw "type error in *="

def Value value_div(Value a, Value b):
    match a:
        Int(x):
            match b:
                Int(y): Int(x / y)
                _: throw "type error in /="
        Float(x):
            match b:
                Float(y): Float(x / y)
                _: throw "type error in /="
        _: throw "type error in /="

def Value value_mod(Value a, Value b):
    match a:
        Int(x):
            match b:
                Int(y): Int(x % y)
                _: throw "type error in %="
        _: throw "type error in %="
# == EVAL EXPR ==

# Environment helpers

def Value env_get(var Interpreter'actor interp, string name):
    let env = interp.current_env
    let result = env.get(name)
    if let val = result:
        val
    else:
        throw "undefined variable '{name}'"

def void env_set(var Interpreter'actor interp, string name, Value val):
    let env = interp.current_env
    let ok = env.set(name, val)
    if not ok:
        throw "cannot assign to undefined variable '{name}'"

def void env_define(var Interpreter'actor interp, string name, Value val, bool is_mutable):
    if is_mutable:
        interp.current_env.define_mut(name, val)
    else:
        interp.current_env.define(name, val)

def Env'actor push_scope(var Interpreter'actor interp):
    let child = new_env(interp.current_env)
    interp.current_env = child.clone()
    child

def void pop_scope(var Interpreter'actor interp):
    let parent = interp.current_env.parent
    if let p = parent:
        interp.current_env = p

# Main expression evaluator

def Value eval_expr(var Interpreter'actor interp, Expr expr):
    match expr.kind:
        # Literals
        ExprKind.Int(n):
            Value.Int(n)
        ExprKind.Float(f):
            Value.Float(f)
        ExprKind.Str(s):
            Value.Str(s)
        ExprKind.Bool(b):
            Value.Bool(b)
        ExprKind.Nil:
            Value.Nil

        # Variable lookup
        ExprKind.Var(name):
            let result = interp.current_env.get(name)
            if let val = result:
                match val:
                    Value.Uninitialized:
                        throw "variable '{name}' used before being assigned"
                    _:
                        val
            else:
                # Check implicit self field access
                let self_opt = interp.current_env.get("self")
                if let self_val = self_opt:
                    match self_val:
                        Value.Object(obj):
                            let field_opt = obj.get_field(name)
                            if let fval = field_opt:
                                fval
                            else:
                                throw "undefined variable '{name}'"
                        _:
                            throw "undefined variable '{name}'"
                else:
                    throw "undefined variable '{name}'"

        # Binary operations
        ExprKind.BinOp(op, left, right):
            eval_binop(interp, op, left, right)

        # Unary operations
        ExprKind.UnaryOp(op, inner):
            let val = eval_expr(interp, inner)
            match op:
                UnaryOp.Neg:
                    match val:
                        Value.Int(n):
                            Value.Int(0 - n)
                        Value.Float(f):
                            Value.Float(0.0 - f)
                        _:
                            throw "cannot negate {val.type_name()}"
                UnaryOp.Not:
                    match val:
                        Value.Bool(b):
                            Value.Bool(not b)
                        _:
                            throw "expected bool for 'not', got {val.type_name()}"
                _:
                    throw "unhandled unary op"

        # Function/constructor call
        ExprKind.Call(callee_expr, args):
            let callee = eval_expr(interp, callee_expr)
            let arg_vals = eval_args(interp, args)
            call_value(interp, callee, arg_vals)

        # Method call
        ExprKind.MethodCall(recv_expr, method, args):
            let recv = eval_expr(interp, recv_expr)
            let arg_vals = eval_args(interp, args)
            call_method(interp, recv, method, arg_vals)

        # Field access
        ExprKind.Field(obj_expr, field_name):
            let obj = eval_expr(interp, obj_expr)
            get_field(interp, obj, field_name)

        # Index access
        ExprKind.Index(obj_expr, idx_expr):
            let obj = eval_expr(interp, obj_expr)
            let idx = eval_expr(interp, idx_expr)
            get_index(interp, obj, idx)

        # Array literal
        ExprKind.Array(elems):
            var vals = []
            for item in elems:
                vals.append(eval_expr(interp, item))
            Value.Array(vals)

        # Dict literal
        ExprKind.Dict(pairs):
            var entries = []
            for pair in pairs:
                let k = eval_expr(interp, pair.0)
                let v = eval_expr(interp, pair.1)
                entries.append((k, v))
            Value.Dict(entries)

        # Set literal
        ExprKind.Set(elems):
            var vals = []
            for item in elems:
                let v = eval_expr(interp, item)
                if not vals.contains(v):
                    vals.append(v)
            Value.Set(vals)

        # String interpolation
        ExprKind.StringInterp(segments):
            var result = ""
            for seg in segments:
                match seg:
                    StringSegment.Lit(text):
                        result = result + text
                    StringSegment.Expr(e):
                        let v = eval_expr(interp, e)
                        result = result + display_value(interp, v)
                    StringSegment.FormattedExpr(e, _):
                        let v = eval_expr(interp, e)
                        result = result + display_value(interp, v)
            Value.Str(result)

        # Closure
        ExprKind.Closure(params, _, body, _, _):
            Value.Closure(params, body, interp.current_env)

        # Type cast
        ExprKind.Cast(inner_expr, ty):
            let val = eval_expr(interp, inner_expr)
            cast_value(interp, val, ty)

        # Range
        ExprKind.Range(start_expr, end_expr, inclusive):
            let s = eval_expr(interp, start_expr)
            let e = eval_expr(interp, end_expr)
            match s:
                Value.Int(a):
                    match e:
                        Value.Int(b):
                            Value.Range(a, b, inclusive, 1)
                        _:
                            throw "range end must be Int, got {e.type_name()}"
                _:
                    throw "range start must be Int, got {s.type_name()}"

        # If expression
        ExprKind.If(s):
            var result_val = Value.Nil
            var handled = false
            for branch in s.branches:
                if not handled:
                    let cond_val = eval_expr(interp, branch.cond)
                    match cond_val:
                        Value.Bool(b):
                            if b:
                                let child = push_scope(interp)
                                result_val = eval_block(interp, branch.body)
                                pop_scope(interp)
                                handled = true
                        _:
                            throw "condition must be bool"
            if not handled:
                if let else_body = s.else_body:
                    let child = push_scope(interp)
                    result_val = eval_block(interp, else_body)
                    pop_scope(interp)
            result_val

        _:
            throw "unhandled expression kind"

# Evaluate a list of call arguments
def [Value] eval_args(var Interpreter'actor interp, [Arg] args):
    var vals = []
    for arg in args:
        vals.append(eval_expr(interp, arg.value))
    vals

# Binary operation dispatch
def Value eval_binop(var Interpreter'actor interp, BinOp op, Expr lhs, Expr rhs):
    # Short-circuit logical ops
    match op:
        BinOp.And:
            let l = eval_expr(interp, lhs)
            match l:
                Value.Bool(false):
                    Value.Bool(false)
                Value.Bool(true):
                    let r = eval_expr(interp, rhs)
                    match r:
                        Value.Bool(b):
                            Value.Bool(b)
                        _:
                            throw "right side of 'and' must be bool"
                _:
                    throw "left side of 'and' must be bool"
        BinOp.Or:
            let l = eval_expr(interp, lhs)
            match l:
                Value.Bool(true):
                    Value.Bool(true)
                Value.Bool(false):
                    let r = eval_expr(interp, rhs)
                    match r:
                        Value.Bool(b):
                            Value.Bool(b)
                        _:
                            throw "right side of 'or' must be bool"
                _:
                    throw "left side of 'or' must be bool"
        _:
            let l = eval_expr(interp, lhs)
            let r = eval_expr(interp, rhs)
            apply_binop(op, l, r)

# Apply a binary operator to two already-evaluated values
def Value apply_binop(BinOp op, Value l, Value r):
    match op:
        BinOp.Add:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            Value.Int(a + b)
                        Value.Float(b):
                            Value.Float(a as float + b)
                        _:
                            throw "cannot add Int and {r.type_name()}"
                Value.Float(a):
                    match r:
                        Value.Float(b):
                            Value.Float(a + b)
                        Value.Int(b):
                            Value.Float(a + b as float)
                        _:
                            throw "cannot add Float and {r.type_name()}"
                Value.Str(a):
                    match r:
                        Value.Str(b):
                            Value.Str(a + b)
                        _:
                            throw "cannot add String and {r.type_name()}"
                Value.Array(a):
                    match r:
                        Value.Array(b):
                            var merged = a
                            for item in b:
                                merged.append(item)
                            Value.Array(merged)
                        _:
                            throw "cannot add Array and {r.type_name()}"
                _:
                    throw "cannot add {l.type_name()} and {r.type_name()}"
        BinOp.Sub:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            Value.Int(a - b)
                        Value.Float(b):
                            Value.Float(a as float - b)
                        _:
                            throw "cannot subtract {r.type_name()} from Int"
                Value.Float(a):
                    match r:
                        Value.Float(b):
                            Value.Float(a - b)
                        Value.Int(b):
                            Value.Float(a - b as float)
                        _:
                            throw "cannot subtract {r.type_name()} from Float"
                _:
                    throw "cannot subtract {r.type_name()} from {l.type_name()}"
        BinOp.Mul:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            Value.Int(a * b)
                        Value.Float(b):
                            Value.Float(a as float * b)
                        _:
                            throw "cannot multiply Int by {r.type_name()}"
                Value.Float(a):
                    match r:
                        Value.Float(b):
                            Value.Float(a * b)
                        Value.Int(b):
                            Value.Float(a * b as float)
                        _:
                            throw "cannot multiply Float by {r.type_name()}"
                _:
                    throw "cannot multiply {l.type_name()} and {r.type_name()}"
        BinOp.Div:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            if b == 0:
                                throw "division by zero"
                            Value.Int(a / b)
                        Value.Float(b):
                            Value.Float(a as float / b)
                        _:
                            throw "cannot divide Int by {r.type_name()}"
                Value.Float(a):
                    match r:
                        Value.Float(b):
                            Value.Float(a / b)
                        Value.Int(b):
                            Value.Float(a / b as float)
                        _:
                            throw "cannot divide Float by {r.type_name()}"
                _:
                    throw "cannot divide {l.type_name()} by {r.type_name()}"
        BinOp.Rem:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            if b == 0:
                                throw "remainder by zero"
                            Value.Int(a % b)
                        _:
                            throw "cannot remainder Int by {r.type_name()}"
                Value.Float(a):
                    match r:
                        Value.Float(b):
                            Value.Float(a % b)
                        Value.Int(b):
                            Value.Float(a % b as float)
                        _:
                            throw "cannot remainder Float by {r.type_name()}"
                _:
                    throw "cannot remainder {l.type_name()} by {r.type_name()}"
        BinOp.Eq:
            Value.Bool(l == r)
        BinOp.NotEq:
            Value.Bool(l != r)
        BinOp.Lt:
            Value.Bool(compare_values(l, r) < 0)
        BinOp.Gt:
            Value.Bool(compare_values(l, r) > 0)
        BinOp.LtEq:
            Value.Bool(compare_values(l, r) <= 0)
        BinOp.GtEq:
            Value.Bool(compare_values(l, r) >= 0)
        BinOp.BitAnd:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            Value.Int(a & b)
                        _:
                            throw "bitwise-and requires Int operands"
                _:
                    throw "bitwise-and requires Int operands"
        BinOp.BitOr:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            Value.Int(a | b)
                        _:
                            throw "bitwise-or requires Int operands"
                _:
                    throw "bitwise-or requires Int operands"
        BinOp.BitXor:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            Value.Int(a ^ b)
                        _:
                            throw "bitwise-xor requires Int operands"
                _:
                    throw "bitwise-xor requires Int operands"
        BinOp.Shl:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            if b < 0:
                                throw "shift amount cannot be negative"
                            Value.Int(a << b)
                        _:
                            throw "shift requires Int operands"
                _:
                    throw "shift requires Int operands"
        BinOp.Shr:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            if b < 0:
                                throw "shift amount cannot be negative"
                            Value.Int(a >> b)
                        _:
                            throw "shift requires Int operands"
                _:
                    throw "shift requires Int operands"
        BinOp.Is:
            match r:
                Value.Nil:
                    Value.Bool(l == Value.Nil)
                _:
                    Value.Bool(l.type_name() == r.type_name())
        BinOp.And:
            throw "And handled by short-circuit path"
        BinOp.Or:
            throw "Or handled by short-circuit path"

# Compare two values: returns negative/zero/positive
req int compare_values(Value l, Value r) throws:
    match l:
        Value.Int(a):
            match r:
                Value.Int(b):
                    if a < b: -1
                    else if a > b: 1
                    else: 0
                Value.Float(b):
                    let af = a as float
                    if af < b: -1
                    else if af > b: 1
                    else: 0
                _:
                    throw "cannot compare Int and {r.type_name()}"
        Value.Float(a):
            match r:
                Value.Float(b):
                    if a < b: -1
                    else if a > b: 1
                    else: 0
                Value.Int(b):
                    let bf = b as float
                    if a < bf: -1
                    else if a > bf: 1
                    else: 0
                _:
                    throw "cannot compare Float and {r.type_name()}"
        Value.Str(a):
            match r:
                Value.Str(b):
                    if a < b: -1
                    else if a > b: 1
                    else: 0
                _:
                    throw "cannot compare String and {r.type_name()}"
        _:
            throw "cannot compare {l.type_name()} and {r.type_name()}"

# Field access on a value
def Value get_field(var Interpreter'actor interp, Value obj, string field_name):
    match obj:
        Value.Object(inner):
            let val_opt = inner.get_field(field_name)
            if let v = val_opt:
                v
            else:
                throw "no field '{field_name}' on object of type {inner.type_name}"
        Value.EnumVariant(type_name, variant, fields):
            if field_name == "type":
                Value.Str(type_name)
            else if field_name == "variant":
                Value.Str(variant)
            else:
                throw "cannot access field '{field_name}' on enum variant"
        Value.Nil:
            throw "field access on nil"
        _:
            throw "cannot access field '{field_name}' on {obj.type_name()}"

# Index access on a value
def Value get_index(var Interpreter'actor interp, Value obj, Value idx):
    match obj:
        Value.Array(items):
            match idx:
                Value.Int(i):
                    if i < 0 or i >= items.length:
                        throw "array index {i} out of bounds (length {items.length})"
                    items[i]
                _:
                    throw "array index must be Int, got {idx.type_name()}"
        Value.Dict(entries):
            for entry in entries:
                if entry.0 == idx:
                    entry.1
            throw "key not found in dict"
        Value.Str(s):
            match idx:
                Value.Int(i):
                    if i < 0 or i >= s.length:
                        throw "string index {i} out of bounds"
                    Value.Str(s.char_at(i))
                _:
                    throw "string index must be Int, got {idx.type_name()}"
        Value.Range(start, end, inclusive, _):
            match idx:
                Value.Int(i):
                    let actual = start + i
                    let limit = if inclusive: end + 1 else end
                    if actual >= limit:
                        throw "range index {i} out of bounds"
                    Value.Int(actual)
                _:
                    throw "range index must be Int"
        _:
            throw "cannot index into {obj.type_name()}"

# Call a value (function, closure, constructor)
def Value call_value(var Interpreter'actor interp, Value callee, [Value] args):
    match callee:
        Value.Fn(decl, captured_env):
            call_fn(interp, decl, captured_env, args)
        Value.Closure(params, body, captured_env):
            call_closure(interp, params, body, captured_env, args)
        Value.Struct(decl, captured_env):
            instantiate_struct(interp, decl, args)
        Value.EnumVariant(type_name, variant, _):
            Value.EnumVariant(type_name, variant, args)
        Value.NativeFn(func):
            func(args)
        _:
            throw "'{callee.type_name()}' is not callable"

# Call a method on a receiver value
def Value call_method(var Interpreter'actor interp, Value recv, string method, [Value] args):
    match recv:
        Value.Object(obj):
            call_object_method(interp, obj, method, args)
        Value.Array(items):
            call_array_method(interp, items, method, args)
        Value.Str(s):
            call_string_method(s, method, args)
        Value.Dict(entries):
            call_dict_method(interp, entries, method, args)
        Value.Set(items):
            call_set_method(interp, items, method, args)
        Value.Int(n):
            call_int_method(n, method, args)
        Value.Float(f):
            call_float_method(f, method, args)
        _:
            throw "no method '{method}' on {recv.type_name()}"

# Call built-in array methods
def Value call_array_method(var Interpreter'actor interp, var [Value] items, string method, [Value] args):
    match method:
        "length":
            Value.Int(items.length)
        "append":
            if args.length != 1:
                throw "append takes 1 argument"
            items.append(args[0])
            Value.Nil
        "pop":
            if items.length == 0:
                throw "pop on empty array"
            items.pop()
        "get":
            if args.length == 0:
                throw "get requires index argument"
            match args[0]:
                Value.Int(i):
                    if i < 0 or i >= items.length:
                        Value.Nil
                    else:
                        items[i]
                _:
                    throw "get index must be Int"
        "contains":
            if args.length != 1:
                throw "contains takes 1 argument"
            Value.Bool(items.contains(args[0]))
        "first":
            if items.length == 0:
                Value.Nil
            else:
                items[0]
        "last":
            if items.length == 0:
                Value.Nil
            else:
                items[items.length - 1]
        "reverse":
            var rev = []
            var i = items.length - 1
            while i >= 0:
                rev.append(items[i])
                i = i - 1
            Value.Array(rev)
        "join":
            let sep = if args.length > 0:
                match args[0]:
                    Value.Str(s): s
                    _: ""
            else:
                ""
            var result = ""
            var idx = 0
            while idx < items.length:
                if idx > 0:
                    result = result + sep
                match items[idx]:
                    Value.Str(s):
                        result = result + s
                    other:
                        result = result + display_value(interp, other)
                idx = idx + 1
            Value.Str(result)
        _:
            throw "no method '{method}' on Array"

# Call built-in string methods
def Value call_string_method(string s, string method, [Value] args):
    match method:
        "length":
            Value.Int(s.length)
        "contains":
            if args.length != 1:
                throw "contains takes 1 argument"
            match args[0]:
                Value.Str(sub):
                    Value.Bool(s.contains(sub))
                _:
                    throw "contains argument must be string"
        "starts_with":
            if args.length != 1:
                throw "starts_with takes 1 argument"
            match args[0]:
                Value.Str(prefix):
                    Value.Bool(s.starts_with(prefix))
                _:
                    throw "starts_with argument must be string"
        "ends_with":
            if args.length != 1:
                throw "ends_with takes 1 argument"
            match args[0]:
                Value.Str(suffix):
                    Value.Bool(s.ends_with(suffix))
                _:
                    throw "ends_with argument must be string"
        "to_upper":
            Value.Str(s.to_upper())
        "to_lower":
            Value.Str(s.to_lower())
        "trim":
            Value.Str(s.trim())
        "split":
            if args.length != 1:
                throw "split takes 1 argument"
            match args[0]:
                Value.Str(sep):
                    let parts = s.split(sep)
                    var result = []
                    for p in parts:
                        result.append(Value.Str(p))
                    Value.Array(result)
                _:
                    throw "split argument must be string"
        "replace":
            if args.length != 2:
                throw "replace takes 2 arguments"
            match args[0]:
                Value.Str(from):
                    match args[1]:
                        Value.Str(to):
                            Value.Str(s.replace(from, to))
                        _:
                            throw "replace second argument must be string"
                _:
                    throw "replace first argument must be string"
        "parse_int":
            let n = s.parse_int()
            if let v = n:
                Value.Int(v)
            else:
                Value.Nil
        "parse_float":
            let f = s.parse_float()
            if let v = f:
                Value.Float(v)
            else:
                Value.Nil
        _:
            throw "no method '{method}' on String"

# Call built-in dict methods
def Value call_dict_method(var Interpreter'actor interp, var [(Value, Value)] entries, string method, [Value] args):
    match method:
        "get":
            if args.length < 1:
                throw "get requires key argument"
            let key = args[0]
            let default_val = if args.length > 1: args[1] else: Value.Nil
            for entry in entries:
                if entry.0 == key:
                    entry.1
            default_val
        "set":
            if args.length != 2:
                throw "set requires key and value"
            let key = args[0]
            let val = args[1]
            var found = false
            var i = 0
            while i < entries.length and not found:
                if entries[i].0 == key:
                    entries[i] = (key.clone(), val.clone())
                    found = true
                i = i + 1
            if not found:
                entries.append((key, val))
            Value.Nil
        "contains_key":
            if args.length != 1:
                throw "contains_key takes 1 argument"
            let key = args[0]
            var result = false
            for entry in entries:
                if entry.0 == key:
                    result = true
            Value.Bool(result)
        "keys":
            var result = []
            for entry in entries:
                result.append(entry.0)
            Value.Array(result)
        "values":
            var result = []
            for entry in entries:
                result.append(entry.1)
            Value.Array(result)
        "length":
            Value.Int(entries.length)
        _:
            throw "no method '{method}' on Dict"

# Call built-in set methods
def Value call_set_method(var Interpreter'actor interp, var [Value] items, string method, [Value] args):
    match method:
        "contains":
            if args.length != 1:
                throw "contains takes 1 argument"
            Value.Bool(items.contains(args[0]))
        "insert":
            if args.length != 1:
                throw "insert takes 1 argument"
            if not items.contains(args[0]):
                items.append(args[0])
            Value.Nil
        "remove":
            if args.length != 1:
                throw "remove takes 1 argument"
            var result = []
            for item in items:
                if item != args[0]:
                    result.append(item)
            items = result
            Value.Nil
        "length":
            Value.Int(items.length)
        _:
            throw "no method '{method}' on Set"

# Call built-in int methods
def Value call_int_method(int n, string method, [Value] args):
    match method:
        "abs":
            if n < 0:
                Value.Int(0 - n)
            else:
                Value.Int(n)
        "to_string":
            Value.Str("{n}")
        "as_float":
            Value.Float(n as float)
        _:
            throw "no method '{method}' on Int"

# Call built-in float methods
def Value call_float_method(float f, string method, [Value] args):
    match method:
        "abs":
            if f < 0.0:
                Value.Float(0.0 - f)
            else:
                Value.Float(f)
        "floor":
            Value.Int(f.floor() as int)
        "ceil":
            Value.Int(f.ceil() as int)
        "round":
            Value.Int(f.round() as int)
        "to_string":
            Value.Str("{f}")
        "sqrt":
            Value.Float(f.sqrt())
        _:
            throw "no method '{method}' on Float"

# Type cast
def Value cast_value(var Interpreter'actor interp, Value val, Type ty):
    let type_name = match ty:
        Type.Named(name): name
        Type.Int: "int"
        Type.Float: "float"
        Type.Bool: "bool"
        Type.Str: "string"
        Type.Uint: "uint"
        _: "unknown"
    match type_name:
        "int":
            match val:
                Value.Int(n): Value.Int(n)
                Value.Float(f): Value.Int(f as int)
                Value.Bool(b): if b: Value.Int(1) else: Value.Int(0)
                Value.Str(s):
                    let n = s.parse_int()
                    if let v = n:
                        Value.Int(v)
                    else:
                        throw "cannot cast string to int"
                _: throw "cannot cast {val.type_name()} to int"
        "float":
            match val:
                Value.Float(f): Value.Float(f)
                Value.Int(n): Value.Float(n as float)
                Value.Str(s):
                    let f = s.parse_float()
                    if let v = f:
                        Value.Float(v)
                    else:
                        throw "cannot cast string to float"
                _: throw "cannot cast {val.type_name()} to float"
        "string":
            Value.Str(display_value(interp, val))
        "bool":
            match val:
                Value.Bool(b): Value.Bool(b)
                Value.Int(n): Value.Bool(n != 0)
                Value.Nil: Value.Bool(false)
                _: Value.Bool(true)
        _:
            throw "unknown cast target type '{type_name}'"

# Runtime type check
req bool value_is_type(var Interpreter'actor interp, Value val, TypeRef ty) throws:
    let type_name = ty.name
    match type_name:
        "int":
            match val:
                Value.Int(_): true
                _: false
        "float":
            match val:
                Value.Float(_): true
                _: false
        "string":
            match val:
                Value.Str(_): true
                _: false
        "bool":
            match val:
                Value.Bool(_): true
                _: false
        "nil":
            match val:
                Value.Nil: true
                _: false
        _:
            val.type_name() == type_name

# Display a value as string for interpolation
req string display_value(var Interpreter'actor interp, Value val):
    match val:
        Value.Nil: "nil"
        Value.Bool(b): if b: "true" else: "false"
        Value.Int(n): "{n}"
        Value.Float(f): "{f}"
        Value.Str(s): s
        Value.Array(items):
            var result = "["
            var i = 0
            while i < items.length:
                if i > 0:
                    result = result + ", "
                result = result + display_value(interp, items[i])
                i = i + 1
            result + "]"
        Value.Dict(entries):
            var result = "{{"
            var i = 0
            while i < entries.length:
                if i > 0:
                    result = result + ", "
                result = result + display_value(interp, entries[i].0) + ": " + display_value(interp, entries[i].1)
                i = i + 1
            result + "}}"
        Value.Object(obj):
            obj.type_name
        Value.EnumVariant(type_name, variant, fields):
            if fields.length == 0:
                "{type_name}.{variant}"
            else:
                var result = "{type_name}.{variant}("
                var i = 0
                while i < fields.length:
                    if i > 0:
                        result = result + ", "
                    result = result + display_value(interp, fields[i])
                    i = i + 1
                result + ")"
        _:
            "<value>"

# Call a method on a struct object
def Value call_object_method(var Interpreter'actor interp, ObjectInner'actor obj, string method, [Value] args):
    let type_name = obj.type_name
    let method_decl_opt = interp.find_method(type_name, method)
    if let method_decl = method_decl_opt:
        let child_env = push_scope(interp)
        env_define(interp, "self", Value.Object(obj), false)
        var i = 0
        while i < method_decl.params.length and i < args.length:
            let param = method_decl.params[i]
            env_define(interp, param.name, args[i], param.mutable)
            i = i + 1
        let result = eval_block(interp, method_decl.body)
        pop_scope(interp)
        result
    else:
        throw "no method '{method}' on type '{type_name}'"

# Evaluate a function call
def Value call_fn(var Interpreter'actor interp, FnDecl decl, Env'actor captured_env, [Value] args):
    let saved_env = interp.current_env
    interp.current_env = new_env(captured_env)
    var i = 0
    while i < decl.params.length and i < args.length:
        let param = decl.params[i]
        env_define(interp, param.name, args[i], param.mutable)
        i = i + 1
    let result = eval_block(interp, decl.body)
    interp.current_env = saved_env
    result

# Evaluate a closure call
def Value call_closure(var Interpreter'actor interp, [string] params, [Stmt] body, Env'actor captured_env, [Value] args):
    let saved_env = interp.current_env
    interp.current_env = new_env(captured_env)
    var i = 0
    while i < params.length and i < args.length:
        env_define(interp, params[i], args[i], false)
        i = i + 1
    let result = eval_block(interp, body)
    interp.current_env = saved_env
    result

# Evaluate a block of statements, returning the last expression value
def Value eval_block(var Interpreter'actor interp, [Stmt] stmts):
    var last = Value.Nil
    var i = 0
    while i < stmts.length:
        let stmt = stmts[i]
        if i == stmts.length - 1:
            last = eval_stmt_as_expr(interp, stmt)
        else:
            exec_stmt(interp, stmt)
        i = i + 1
    last

# Execute a statement (side-effects only)
def void exec_stmt(var Interpreter'actor interp, Stmt stmt):
    match stmt:
        Stmt.Expr(e):
            eval_expr(interp, e)
        Stmt.Let(name, expr, is_mutable):
            let val = eval_expr(interp, expr)
            env_define(interp, name, val, is_mutable)
        Stmt.Return(expr_opt):
            if let e = expr_opt:
                let val = eval_expr(interp, e)
                throw ReturnSignal(val)
            else:
                throw ReturnSignal(Value.Nil)
        Stmt.While(cond, body):
            var running = true
            while running:
                let cond_val = eval_expr(interp, cond)
                match cond_val:
                    Value.Bool(b):
                        if b:
                            let child = push_scope(interp)
                            eval_block(interp, body)
                            pop_scope(interp)
                        else:
                            running = false
                    _:
                        throw "while condition must be bool"
        Stmt.For(var_name, iter_expr, body):
            let iter_val = eval_expr(interp, iter_expr)
            match iter_val:
                Value.Array(items):
                    for item in items:
                        let child = push_scope(interp)
                        env_define(interp, var_name, item, false)
                        eval_block(interp, body)
                        pop_scope(interp)
                Value.Range(start, end, inclusive, _):
                    let limit = if inclusive: end + 1 else: end
                    var n = start
                    while n < limit:
                        let child = push_scope(interp)
                        env_define(interp, var_name, Value.Int(n), false)
                        eval_block(interp, body)
                        pop_scope(interp)
                        n = n + 1
                _:
                    throw "for loop requires iterable, got {iter_val.type_name()}"
        Stmt.Assign(target, expr):
            let val = eval_expr(interp, expr)
            assign_target(interp, target, val)
        Stmt.Throw(expr):
            let val = eval_expr(interp, expr)
            throw ExceptionSignal(val)
        _:
            throw "unhandled statement kind"

# Evaluate the last statement as an expression (for implicit return)
def Value eval_stmt_as_expr(var Interpreter'actor interp, Stmt stmt):
    match stmt:
        Stmt.Expr(e):
            eval_expr(interp, e)
        Stmt.If(s):
            exec_stmt(interp, Stmt.If(s))
            Value.Nil
        Stmt.Match(s):
            let subject = eval_expr(interp, s.subject)
            eval_match(interp, subject, s.arms)
        _:
            exec_stmt(interp, stmt)
            Value.Nil

# Match evaluation
def Value eval_match_body(var Interpreter'actor interp, MatchBody body):
    match body:
        MatchBody.Expr(e): eval_expr(interp, e)
        MatchBody.Block(stmts): eval_block(interp, stmts)

def Value eval_match(var Interpreter'actor interp, Value subject, [MatchArm] arms):
    for arm in arms:
        let [Binding]? matched = try_match_pattern(interp, subject.clone(), arm.patterns[0])
        if let bindings = matched:
            if let guard_cond = arm.match_guard:
                let child = push_scope(interp)
                for binding in bindings:
                    env_define(interp, binding.name, binding.value, false)
                let guard_val = eval_expr(interp, guard_cond)
                pop_scope(interp)
                match guard_val:
                    Value.Bool(true):
                        let child2 = push_scope(interp)
                        for binding in bindings:
                            env_define(interp, binding.name, binding.value, false)
                        let result = eval_match_body(interp, arm.body)
                        pop_scope(interp)
                        result
                    _:
                        continue
            else:
                let child = push_scope(interp)
                for binding in bindings:
                    env_define(interp, binding.name, binding.value, false)
                let result = eval_match_body(interp, arm.body)
                pop_scope(interp)
                result
    Value.Nil

# Try to match a value against a pattern, returning bindings or nil
req [Binding]? try_match_pattern(var Interpreter'actor interp, Value subject, Pattern pat):
    match pat:
        Pattern.Wildcard:
            some([])
        Pattern.Lit(lit):
            let lit_val = match lit:
                LitPattern.Int(n): Value.Int(n)
                LitPattern.Float(f): Value.Float(f)
                LitPattern.Str(s): Value.Str(s)
                LitPattern.Bool(b): Value.Bool(b)
                LitPattern.Nil: Value.Nil
            if value_equals(subject, lit_val):
                some([])
            else:
                nil
        Pattern.Bind(name):
            some([Binding(name, subject)])
        Pattern.Variant(variant, sub_patterns):
            match subject:
                Value.EnumVariant(stype, svariant, sfields):
                    if svariant == variant:
                        if sub_patterns.length == 0:
                            some([])
                        else if sub_patterns.length == sfields.length:
                            var [Binding] all_bindings = []
                            var ok = true
                            var i = 0
                            while i < sub_patterns.length:
                                let [Binding]? sub_match = try_match_pattern(interp, sfields[i], sub_patterns[i])
                                if let sb = sub_match:
                                    for b in sb:
                                        all_bindings.append(b)
                                else:
                                    ok = false
                                i = i + 1
                            if ok: some(all_bindings) else: nil
                        else:
                            nil
                    else:
                        nil
                _:
                    nil
        Pattern.Tuple(sub_patterns):
            match subject:
                Value.Tuple(items):
                    if items.length == sub_patterns.length:
                        var [Binding] all_bindings = []
                        var ok = true
                        var i = 0
                        while i < sub_patterns.length:
                            let [Binding]? sub_match = try_match_pattern(interp, items[i], sub_patterns[i])
                            if let sb = sub_match:
                                for b in sb:
                                    all_bindings.append(b)
                            else:
                                ok = false
                            i = i + 1
                        if ok: some(all_bindings) else: nil
                    else:
                        nil
                _:
                    nil
        _:
            nil

# Assignment to a target expression
def void assign_target(var Interpreter'actor interp, Expr target, Value val):
    match target.kind:
        ExprKind.Var(name):
            let ok = interp.current_env.set(name, val)
            if not ok:
                throw "cannot assign to undefined variable '{name}'"
        ExprKind.Field(obj_expr, field_name):
            let obj = eval_expr(interp, obj_expr)
            match obj:
                Value.Object(inner):
                    inner.set_field(field_name, val)
                _:
                    throw "cannot assign field on non-object"
        ExprKind.Index(obj_expr, idx_expr):
            let obj = eval_expr(interp, obj_expr)
            let idx = eval_expr(interp, idx_expr)
            match obj:
                Value.Array(items):
                    match idx:
                        Value.Int(i):
                            if i < 0 or i >= items.length:
                                throw "array index {i} out of bounds"
                            items[i] = val
                        _:
                            throw "array index must be Int"
                _:
                    throw "cannot index-assign into {obj.type_name()}"
        _:
            throw "invalid assignment target"

# Instantiate a struct from constructor args
def Value instantiate_struct(var Interpreter'actor interp, StructDecl decl, [Value] args):
    var fields = []
    var i = 0
    while i < decl.fields.length and i < args.length:
        let field = decl.fields[i]
        fields.append((field.name, args[i]))
        i = i + 1
    # Fill remaining fields with defaults
    while i < decl.fields.length:
        let field = decl.fields[i]
        if let default_expr = field.default:
            let dval = eval_expr(interp, default_expr)
            fields.append((field.name, dval))
        else:
            fields.append((field.name, Value.Nil))
        i = i + 1
    let obj = ObjectInner(type_name: decl.name, fields: fields)
    Value.Object(obj)
# == STDLIB AND INTERPRETER ==

# ─── Interpreter struct ────────────────────────────────────────────────────────

struct Interpreter:
    var Env'actor global_env
    Env'actor current_env

# ─── val_to_string ────────────────────────────────────────────────────────────

def string val_to_string(Value v):
    match v:
        Value.Nil: "nil"
        Value.Void: "void"
        Value.Uninitialized: "<uninitialized>"
        Value.Bool(b): if b: "true" else "false"
        Value.Int(n): int_to_string(n)
        Value.Float(f): "{f}"
        Value.Str(s): s
        Value.Array(elems):
            var parts = ["["]
            var first = true
            for e in elems:
                if not first:
                    parts.append(", ")
                parts.append(val_to_string(e))
                first = false
            parts.append("]")
            var string result = ""
            for p in parts:
                result = "{result}{p}"
            result
        Value.Tuple(elems):
            var parts = ["("]
            var first = true
            for e in elems:
                if not first:
                    parts.append(", ")
                parts.append(val_to_string(e))
                first = false
            parts.append(")")
            var string result = ""
            for p in parts:
                result = "{result}{p}"
            result
        Value.Dict(pairs):
            var parts = ["{{"]
            var first = true
            for pair in pairs:
                if not first:
                    parts.append(", ")
                parts.append(val_to_string(pair.0))
                parts.append(": ")
                parts.append(val_to_string(pair.1))
                first = false
            parts.append("}}")
            var string result = ""
            for p in parts:
                result = "{result}{p}"
            result
        Value.Set(elems):
            var parts = ["{{"]
            var first = true
            for e in elems:
                if not first:
                    parts.append(", ")
                parts.append(val_to_string(e))
                first = false
            parts.append("}}")
            var string result = ""
            for p in parts:
                result = "{result}{p}"
            result
        Value.EnumVariant(typeName, variant, fields):
            if fields.length == 0:
                variant
            else:
                var parts = ["{variant}("]
                var first = true
                for f in fields:
                    if not first:
                        parts.append(", ")
                    parts.append(val_to_string(f))
                    first = false
                parts.append(")")
                var result = ""
                for p in parts:
                    result = "{result}{p}"
                result
        Value.NativeFn(name, _): "<fn {name}>"
        Value.Fn(name, _): "<fn {name}>"
        Value.OverloadedFn(name, _): "<overloaded fn {name}>"
        Value.Closure(_, _, _): "<closure>"
        Value.Range(start, end, inclusive, _):
            if inclusive:
                "{start}..{end}"
            else:
                "{start}..<{end}"
        Value.Labeled(label, val): "{label}={val_to_string(val)}"
        Value.Object(inner): "<object>"
        _: "<value>"

# ─── val_to_bool ──────────────────────────────────────────────────────────────

def bool val_to_bool(Value v):
    match v:
        Value.Nil: false
        Value.Void: false
        Value.Uninitialized: false
        Value.Bool(b): b
        Value.Int(n): n != 0
        Value.Float(f): f != 0.0
        Value.Str(s): s != ""
        Value.Array(elems): elems.length != 0
        Value.Dict(pairs): pairs.length != 0
        Value.Set(elems): elems.length != 0
        Value.Tuple(elems): elems.length != 0
        _: true

# ─── values_equal ─────────────────────────────────────────────────────────────

def bool values_equal(Value a, Value b):
    match a:
        Value.Nil:
            match b:
                Value.Nil: true
                _: false
        Value.Void:
            match b:
                Value.Void: true
                _: false
        Value.Bool(x):
            match b:
                Value.Bool(y): x == y
                _: false
        Value.Int(x):
            match b:
                Value.Int(y): x == y
                Value.Float(y): float(x) == y
                _: false
        Value.Float(x):
            match b:
                Value.Float(y): x == y
                Value.Int(y): x == float(y)
                _: false
        Value.Str(x):
            match b:
                Value.Str(y): x == y
                _: false
        Value.Array(xs):
            match b:
                Value.Array(ys):
                    if xs.length != ys.length:
                        false
                    else:
                        var i = 0
                        var eq = true
                        while i < xs.length:
                            if not values_equal(xs[i], ys[i]):
                                eq = false
                            i = i + 1
                        eq
                _: false
        Value.Tuple(xs):
            match b:
                Value.Tuple(ys):
                    if xs.length != ys.length:
                        false
                    else:
                        var i = 0
                        var eq = true
                        while i < xs.length:
                            if not values_equal(xs[i], ys[i]):
                                eq = false
                            i = i + 1
                        eq
                _: false
        Value.EnumVariant(tn1, v1, f1):
            match b:
                Value.EnumVariant(tn2, v2, f2):
                    if tn1 != tn2 or v1 != v2 or f1.length != f2.length:
                        false
                    else:
                        var i = 0
                        var eq = true
                        while i < f1.length:
                            if not values_equal(f1[i], f2[i]):
                                eq = false
                            i = i + 1
                        eq
                _: false
        Value.Range(s1, e1, inc1, _):
            match b:
                Value.Range(s2, e2, inc2, _): s1 == s2 and e1 == e2 and inc1 == inc2
                _: false
        _: false

# ─── env_define ───────────────────────────────────────────────────────────────

def void env_define(var Env'actor env, string name, Value val, bool mutable):
    if mutable:
        env.define_mut(name, val)
    else:
        env.define(name, val)

# ─── register_stdlib ──────────────────────────────────────────────────────────

def void register_stdlib(var Interpreter'actor interp):
    let env = interp.global_env

    let print_fn = Value.NativeFn("print", Value.Nil)
    env_define(env, "print", print_fn, false)

    let println_fn = Value.NativeFn("println", Value.Nil)
    env_define(env, "println", println_fn, false)

    let write_fn = Value.NativeFn("write", Value.Nil)
