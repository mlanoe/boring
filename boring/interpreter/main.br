# ─── new_interpreter ──────────────────────────────────────────────────────────

def Interpreter'actor new_interpreter():
    let global = new_env(nil)
    let interp = Interpreter(
        global_env = global,
        current_env = global
    )
    let interp_actor = interp as Interpreter'actor
    register_stdlib(interp_actor)
    interp_actor

# ─── exec_item ────────────────────────────────────────────────────────────────

def void exec_item(var Interpreter'actor interp, Item item):
    match item:
        Item.Fn(decl):
            let fn_val = Value.Fn(decl.name, interp.global_env)
            env_define(interp.global_env, decl.name, fn_val, false)
        Item.Struct(decl):
            let struct_val = Value.Nil
            env_define(interp.global_env, decl.name, struct_val, false)
        Item.Enum(decl):
            let enum_val = Value.Nil
            env_define(interp.global_env, decl.name, enum_val, false)
        Item.Trait(decl):
            env_define(interp.global_env, decl.name, Value.Nil, false)
        Item.Let(stmt):
            env_define(interp.current_env, stmt.name, Value.Uninitialized, true)
        Item.Alias(decl):
            env_define(interp.global_env, decl.name, Value.Nil, false)
        Item.Stmt(stmt):
            env_define(interp.current_env, "__stmt__", Value.Nil, true)
        Item.Use(decl):
            env_define(interp.current_env, "__use__", Value.Nil, true)
        Item.Ext(decl):
            env_define(interp.global_env, decl.type_name, Value.Nil, false)
        Item.Mod(decl):
            for sub_item in decl.items:
                exec_item(interp, sub_item)

# ─── run_program ──────────────────────────────────────────────────────────────

def void run_program(var Interpreter'actor interp, Program prog):
    for item in prog.items:
        exec_item(interp, item)

# == MAIN ==

def void main():
    var source = ""
    var done = false
    while not done:
        let ln = readLine()
        if ln == "":
            done = true
        else:
            source = source + ln + "\n"
    let prog = parse(source)
    var interp = new_interpreter()
    run_program(interp, prog)
