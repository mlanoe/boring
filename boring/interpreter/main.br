def Expr make_method_call(Expr receiver, string name, [Arg] args, int line):
    Expr(kind: ExprKind.MethodCall(receiver, name, args), line: line)

def Expr make_closure([Param] params, Type? return_ty, ClosureBody body, bool can_throw, bool is_task, int line):
