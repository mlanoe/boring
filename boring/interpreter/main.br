struct LetStmt:
    bool mutable
    bool is_pub
    bool is_static
    string name
    Type? ty
    Expr? value
    bool is_move
    int line

struct ReturnStmt:
    Expr? value
    int line

struct IfBranch:
    Expr cond
    [Stmt] body

struct IfStmt:
    [IfBranch] branches
    [Stmt]? else_body
    int line

struct MatchStmt:
    Expr subject
    [MatchArm] arms
    int line

struct MatchArm:
    [Pattern] patterns
    Expr? match_guard
    MatchBody body
    int line

enum MatchBody:
    Expr(Expr expr)
    Block([Stmt] stmts)

struct WhileStmt:
    Expr condition
    [Stmt] body
    int line

struct WhileLetStmt:
    string name
    Pattern? pattern
    Expr value
    [Stmt] body
    int line

struct DoWhileStmt:
    [Stmt] body
    Expr condition
    int line

struct LoopStmt:
    [Stmt] body
    int line

