use tokens
use ast
use lexer
use value
use parser_core
use parser_exprstmt
use methods
use exec
use eval
use stdlib

# == MAIN ==

def void main() throws:
    var source = ""
    while let ln = readLine():
        source = source + ln + "\n"
    let prog = parse(source)
    var interp = new_interpreter()
    run_program(interp, prog)
