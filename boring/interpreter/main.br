# == LEXER ==

# ── Helpers ──────────────────────────────────────────────────────────────────

def string lex_ident_chars(string first, [string] chars, int pos):
    throw "use the Lexer method instead"

def int measure_indent(string line):
    var int spaces = 0
    var int tabs = 0
    for ch in line.chars():
        if ch == " ":
            spaces += 1
        elif ch == "\t":
            tabs += 1
        else:
            break
    if spaces > 0 and tabs > 0:
        throw "inconsistent indentation (mixed tabs and spaces)"
    return spaces + tabs * 4

def int comment_start_index([string] chars):
    throw "use the Lexer method instead"

# ── Preprocess triple strings ────────────────────────────────────────────────

def string dedent_triple(string raw):
    var string s = raw
    if s.startsWith("\n"):
        s = s.slice(1, s.length)
    if s.endsWith("\n"):
        s = s.slice(0, s.length - 1)
    if s.length == 0:
        return ""
    var lines = s.split("\n")
    var int min_indent = 999999
    for ln in lines:
        if ln.trim().length > 0:
            var int count = 0
            for ch in ln.chars():
                if ch == " " or ch == "\t":
                    count += 1
                else:
                    break
            if count < min_indent:
                min_indent = count
    if min_indent == 999999:
        min_indent = 0
    if min_indent == 0:
        return s
    var [string] result = []
    for ln in lines:
        if ln.trim().length == 0:
            result.append("")
        elif ln.length >= min_indent:
            result.append(ln.slice(min_indent, ln.length))
        else:
            result.append(ln)
    var string out = ""
    for ii in 0..result.length:
        if ii > 0:
            out = out + "\n"
        out = out + result[ii]
    return out

def string preprocess_triple_strings(string source):
    let chars = source.chars()
    let n = chars.length
    var string result = ""
    var int i = 0
    var int line = 1
    while i < n:
        let ch = chars[i]
        if ch == "\n":
            line += 1
            result = result + "\n"
            i += 1
            continue
        if ch == "#":
            while i < n and chars[i] != "\n":
                result = result + chars[i]
                i += 1
            continue
        if ch == "\"":
            if i + 2 < n and chars[i + 1] == "\"" and chars[i + 2] == "\"":
                let start_line = line
                i += 3
                var string raw = ""
                var int newlines_consumed = 0
                var bool closed = false
                while i < n:
                    if i + 2 < n and chars[i] == "\"" and chars[i + 1] == "\"" and chars[i + 2] == "\"":
                        i += 3
                        closed = true
                        break
                    if chars[i] == "\n":
                        newlines_consumed += 1
                        line += 1
                    raw = raw + chars[i]
                    i += 1
                if not closed:
                    throw "line {start_line}: unterminated triple-quoted string"
                let content = dedent_triple(raw)
                result = result + "\""
                for c in content.chars():
                    if c == "\"":
                        result = result + "\\\""
                    elif c == "\n":
                        result = result + "\\n"
                    elif c == "\r":
                        result = result + "\\r"
                    else:
                        result = result + c
                result = result + "\""
                var int nl = 0
                while nl < newlines_consumed:
                    result = result + "\n"
                    nl += 1
                continue
            result = result + "\""
            i += 1
            while i < n:
                let c = chars[i]
                result = result + c
                i += 1
                if c == "\\":
                    if i < n:
                        result = result + chars[i]
                        i += 1
                elif c == "{{":
                    var int depth = 1
                    while i < n and depth > 0:
                        let ic = chars[i]
                        result = result + ic
                        i += 1
                        if ic == "{{":
                            depth += 1
                        elif ic == "}}":
                            depth -= 1
                elif c == "\"" or c == "\n":
                    if c == "\n":
                        line += 1
                    break
            continue
        result = result + ch
        i += 1
    return result

# ── Split interpolation hole on first ':' at depth 0 ─────────────────────────

def [string] split_hole_fmt(string s):
    var int depth = 0
    var int idx = 0
    for ch in s.chars():
        if ch == "(" or ch == "[" or ch == "{{":
            depth += 1
        elif ch == ")" or ch == "]" or ch == "}}":
            depth -= 1
        elif ch == ":" and depth == 0:
            let expr = s.slice(0, idx)
            let rest = s.slice(idx + 1, s.length).trim()
            if rest.length == 0:
                return [s, ""]
            return [expr, rest]
        idx += 1
    return [s, ""]

# ── Lexer struct ──────────────────────────────────────────────────────────────

struct Lexer:
    var [string] chars
    var int pos
    var int line
    var int col
    var [int] indent_stack
    var [Token] tokens
    var int paren_depth
    var int inner_colon_blocks
    var [int] inner_block_base_indents

    init([string] chars):
        self.chars = chars
        self.pos = 0
        self.line = 1
        self.col = 1
        self.indent_stack = [0]
        self.tokens = []
        self.paren_depth = 0
        self.inner_colon_blocks = 0
        self.inner_block_base_indents = []

    req bool at_end():
        self.pos >= self.chars.length

    req string? peek_char():
        if self.pos < self.chars.length:
            self.chars[self.pos]
        else:
            nil

    req string? peek_char_at(int offset):
        let idx = self.pos + offset
        if idx < self.chars.length:
            self.chars[idx]
        else:
            nil

    def string advance():
        let ch = self.chars[self.pos]
        self.pos += 1
        if ch == "\n":
            self.line += 1
            self.col = 1
        else:
            self.col += 1
        return ch

    req bool match_char(string expected):
        if self.pos < self.chars.length and self.chars[self.pos] == expected:
            return true
        return false

    def string consume():
        let ch = self.chars[self.pos]
        self.pos += 1
        self.col += 1
        return ch

    def void push(TokenKind kind):
        self.tokens.append(Token(kind: kind, line: self.line))

    # ── Comment-start scanning (skips inside strings) ──────────────────────
    req int find_comment_start([string] line_chars):
        var int i = 0
        while i < line_chars.length:
            let ch = line_chars[i]
            if ch == "#":
                return i
            if ch == "\"":
                i += 1
                while i < line_chars.length:
                    let c = line_chars[i]
                    i += 1
                    if c == "\\":
                        if i < line_chars.length:
                            i += 1
                    elif c == "{{":
                        if i < line_chars.length and line_chars[i] == "{{":
                            i += 1
                        else:
                            var int depth = 1
                            while i < line_chars.length and depth > 0:
                                let ic = line_chars[i]
                                i += 1
                                if ic == "{{":
                                    depth += 1
                                elif ic == "}}":
                                    depth -= 1
                    elif c == "\"" or c == "\n":
                        break
                continue
            i += 1
        return line_chars.length

    # ── Lex a string (after opening quote consumed) ────────────────────────
    def TokenKind lex_string() throws:
        var [RawInterpPart] parts = []
        var string current_lit = ""
        while true:
            if self.at_end():
                throw "line {self.line}: unterminated string literal"
            let ch = self.consume()
            if ch == "\n":
                throw "line {self.line}: unterminated string literal"
            elif ch == "\"":
                break
            elif ch == "{{":
                if self.match_char("{{"):
                    self.consume()
                    current_lit = current_lit + "{{"
                else:
                    if current_lit.length > 0:
                        parts.append(RawInterpPart.Lit(current_lit))
                        current_lit = ""
                    var string inner = ""
                    var int depth = 0
                    while true:
                        if self.at_end():
                            throw "line {self.line}: unterminated string literal"
                        let ic = self.consume()
                        if ic == "{{":
                            depth += 1
                            inner = inner + ic
                        elif ic == "}}":
                            if depth == 0:
                                break
                            depth -= 1
                            inner = inner + ic
                        else:
                            inner = inner + ic
                    let split = split_hole_fmt(inner)
                    let expr = split[0].trim()
                    let fmt = split[1]
                    if fmt.length > 0:
                        parts.append(RawInterpPart.HoleFormatted(expr, fmt))
                    else:
                        parts.append(RawInterpPart.Hole(expr))
            elif ch == "}}":
                if self.match_char("}}"):
                    self.consume()
                current_lit = current_lit + "}}"
            elif ch == "\\":
                if self.at_end():
                    current_lit = current_lit + "\\"
                else:
                    let esc = self.consume()
                    if esc == "n":
                        current_lit = current_lit + "\n"
                    elif esc == "t":
                        current_lit = current_lit + "\t"
                    elif esc == "r":
                        current_lit = current_lit + "\r"
                    elif esc == "0":
                        current_lit = current_lit + "\0"
                    elif esc == "\\":
                        current_lit = current_lit + "\\"
                    elif esc == "\"":
                        current_lit = current_lit + "\""
                    elif esc == "u":
                        if self.match_char("{{"):
                            self.consume()
                            var string hex = ""
                            while not self.at_end() and self.chars[self.pos] != "}}":
                                hex = hex + self.consume()
                            if not self.at_end():
                                self.consume()
                            current_lit = current_lit + "\u{hex}"
                        else:
                            current_lit = current_lit + "u"
                    else:
                        current_lit = current_lit + "\\"
            else:
                current_lit = current_lit + ch
        if parts.length == 0:
            return TokenKind.Str(current_lit)
        if current_lit.length > 0:
            parts.append(RawInterpPart.Lit(current_lit))
        return TokenKind.StringInterp(parts)

    # ── Lex a number (first digit already read) ────────────────────────────
    def TokenKind lex_number(string first) throws:
        if first == "0" and not self.at_end():
            let prefix = self.chars[self.pos]
            if prefix == "x" or prefix == "X":
                self.consume()
                var string hex = ""
                while not self.at_end():
                    let c = self.chars[self.pos]
                    if c == "_":
                        self.consume()
                        continue
                    if (c >= "0" and c <= "9") or (c >= "a" and c <= "f") or (c >= "A" and c <= "F"):
                        hex = hex + self.consume()
                    else:
                        break
                return TokenKind.Int((hex as int) else 0)
            elif prefix == "b" or prefix == "B":
                self.consume()
                var string bin = ""
                while not self.at_end():
                    let c = self.chars[self.pos]
                    if c == "_":
                        self.consume()
                        continue
                    if c == "0" or c == "1":
                        bin = bin + self.consume()
                    else:
                        break
                return TokenKind.Int((bin as int) else 0)
            elif prefix == "o" or prefix == "O":
                self.consume()
                var string oct = ""
                while not self.at_end():
                    let c = self.chars[self.pos]
                    if c == "_":
                        self.consume()
                        continue
                    if c >= "0" and c <= "7":
                        oct = oct + self.consume()
                    else:
                        break
                return TokenKind.Int((oct as int) else 0)
        var string s = first
        while not self.at_end():
            let c = self.chars[self.pos]
            if c == "_":
                self.consume()
                continue
            if c >= "0" and c <= "9":
                s = s + self.consume()
            else:
                break
        if not self.at_end() and self.chars[self.pos] == ".":
            if self.pos + 1 < self.chars.length:
                let next = self.chars[self.pos + 1]
                if next >= "0" and next <= "9":
                    s = s + self.consume()
                    while not self.at_end():
                        let c = self.chars[self.pos]
                        if c == "_":
                            self.consume()
                            continue
                        if c >= "0" and c <= "9":
                            s = s + self.consume()
                        else:
                            break
                    if not self.at_end():
                        let e = self.chars[self.pos]
                        if e == "e" or e == "E":
                            s = s + self.consume()
                            if not self.at_end():
                                let sign = self.chars[self.pos]
                                if sign == "+" or sign == "-":
                                    s = s + self.consume()
                            while not self.at_end() and self.chars[self.pos] >= "0" and self.chars[self.pos] <= "9":
                                s = s + self.consume()
                    return TokenKind.Float((s as float) else 0.0)
        return TokenKind.Int((s as int) else 0)

    # ── Lex an identifier (first char already read) ────────────────────────
    def string lex_ident(string first):
        var string s = first
        while not self.at_end():
            let c = self.chars[self.pos]
            if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_":
                s = s + self.consume()
            else:
                break
        return s

    # ── Map identifier to keyword or Ident token ──────────────────────────
    req TokenKind keyword_or_ident(string s):
        match s:
            "let": return TokenKind.Let
            "var": return TokenKind.Var
            "def": return TokenKind.Def
            "return": return TokenKind.Return
            "if": return TokenKind.If
            "elif": return TokenKind.Elif
            "else": return TokenKind.Else
            "match": return TokenKind.Match
            "while": return TokenKind.While
            "do": return TokenKind.Do
            "loop": return TokenKind.Loop
            "wait": return TokenKind.Wait
            "for": return TokenKind.For
            "in": return TokenKind.In
            "break": return TokenKind.Break
            "continue": return TokenKind.Continue
            "struct": return TokenKind.Struct
            "enum": return TokenKind.Enum
            "trait": return TokenKind.Trait
            "use": return TokenKind.Use
            "ext": return TokenKind.Ext
            "as": return TokenKind.As
            "and": return TokenKind.And
            "or": return TokenKind.Or
            "not": return TokenKind.Not
            "is": return TokenKind.Is
            "self": return TokenKind.SelfKw
            "throw": return TokenKind.Throw
            "throws": return TokenKind.Throws
            "try": return TokenKind.Try
            "catch": return TokenKind.Catch
            "defer": return TokenKind.Defer
            "void": return TokenKind.Void
            "pub": return TokenKind.Pub
            "guard": return TokenKind.Guard
            "task": return TokenKind.Task
            "join": return TokenKind.Join
            "stream": return TokenKind.Stream
            "yield": return TokenKind.Yield
            "static": return TokenKind.Static
            "type": return TokenKind.Type
            "req": return TokenKind.Req
            "transient": return TokenKind.Transient
            "with": return TokenKind.With
            "get": return TokenKind.Get
            "set": return TokenKind.Set
            "init_val": return TokenKind.Init
            "pass": return TokenKind.Pass
            "native": return TokenKind.Native
            "mod": return TokenKind.Mod
            "true": return TokenKind.Bool(true)
            "false": return TokenKind.Bool(false)
            "nil": return TokenKind.Nil
            _: return TokenKind.Ident(s)

    # ── Lex one token at current position ─────────────────────────────────
    def TokenKind lex_one_token() throws:
        let ch = self.consume()
        match ch:
            "(": return TokenKind.LParen
            ")": return TokenKind.RParen
            "[": return TokenKind.LBracket
            "]": return TokenKind.RBracket
            "{{": return TokenKind.LBrace
            "}}": return TokenKind.RBrace
            ",": return TokenKind.Comma
            ";": return TokenKind.Semicolon
            "@": return TokenKind.At
            "'": return TokenKind.Tick
            "~": return TokenKind.Tilde
            ":": return TokenKind.Colon
            "+":
                if self.match_char("="):
                    self.consume()
                    return TokenKind.PlusEq
                return TokenKind.Plus
            "-":
                if self.match_char("="):
                    self.consume()
                    return TokenKind.MinusEq
                return TokenKind.Minus
            "*":
                if self.match_char("="):
                    self.consume()
                    return TokenKind.StarEq
                return TokenKind.Star
            "/":
                if self.match_char("="):
                    self.consume()
                    return TokenKind.SlashEq
                return TokenKind.Slash
            "%":
                if self.match_char("="):
                    self.consume()
                    return TokenKind.PercentEq
                return TokenKind.Percent
            "&":
                if self.match_char("="):
                    self.consume()
                    return TokenKind.AmpersandEq
                return TokenKind.Ampersand
            "|":
                if self.match_char("="):
                    self.consume()
                    return TokenKind.PipeEq
                if self.match_char(">"):
                    self.consume()
                    return TokenKind.PipeArrow
                return TokenKind.Pipe
            "^":
                if self.match_char("="):
                    self.consume()
                    return TokenKind.CaretEq
                return TokenKind.Caret
            "?":
                if self.match_char("."):
                    self.consume()
                    return TokenKind.QuestionDot
                if self.match_char("="):
                    self.consume()
                    return TokenKind.QuestionEq
                return TokenKind.Question
            "!":
                if self.match_char("="):
                    self.consume()
                    return TokenKind.BangEq
                return TokenKind.Bang
            "=":
                if self.match_char("="):
                    self.consume()
                    if self.match_char("="):
                        self.consume()
                        return TokenKind.EqEqEq
                    return TokenKind.EqEq
                return TokenKind.Eq
            "<":
                if self.match_char("="):
                    self.consume()
                    return TokenKind.LtEq
                return TokenKind.Lt
            ">":
                if self.match_char("="):
                    self.consume()
                    return TokenKind.GtEq
                return TokenKind.Gt
            ".":
                if self.match_char("."):
                    self.consume()
                    if self.match_char("."):
                        self.consume()
                        return TokenKind.DotDotDot
                    if self.match_char("="):
                        self.consume()
                        return TokenKind.DotDotEq
                    return TokenKind.DotDot
                return TokenKind.Dot
            "\"":
                return self.lex_string()
            _:
                if ch >= "0" and ch <= "9":
                    return self.lex_number(ch)
                if (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_":
                    let ident = self.lex_ident(ch)
                    return self.keyword_or_ident(ident)
                throw "line {self.line}: unexpected character '{ch}'"

    # ── Lex a single physical line (no indent/dedent logic) ───────────────
    def [Token] lex_line_tokens(string content) throws:
        let cut = self.find_comment_start(content.chars())
        let line_chars = content.chars()
        var string trimmed_content = ""
        var int ci = 0
        while ci < cut:
            trimmed_content = trimmed_content + line_chars[ci]
            ci += 1
        trimmed_content = trimmed_content.trim()
        let save_pos = self.pos
        let save_line = self.line
        let save_col = self.col
        self.chars = trimmed_content.chars()
        self.pos = 0
        var [Token] line_tokens = []
        while self.pos < self.chars.length:
            let c = self.chars[self.pos]
            if c == " " or c == "\t":
                self.pos += 1
                continue
            let kind = self.lex_one_token()
            line_tokens.append(Token(kind: kind, line: self.line))
        return line_tokens

    # ── Main tokenize pass ────────────────────────────────────────────────
    def [Token] tokenize(string preprocessed) throws:
        let all_lines = preprocessed.split("\n")
        var int i = 0
        self.line = 1
        self.indent_stack = [0]
        self.tokens = []
        self.paren_depth = 0
        self.inner_colon_blocks = 0
        self.inner_block_base_indents = []
        while i < all_lines.length:
            self.line = i + 1
            let raw = all_lines[i]
            let trimmed = raw.trim()
            if trimmed.length == 0:
                if self.paren_depth == 0:
                    self.push(TokenKind.Newline)
                i += 1
                continue
            let apply_indent = self.paren_depth == 0 or self.inner_colon_blocks > 0
            if trimmed.startsWith("#") and apply_indent:
                let comment_indent = measure_indent(raw)
                let cur_indent = self.indent_stack[self.indent_stack.length - 1]
                if comment_indent < cur_indent:
                    while true:
                        let top = self.indent_stack[self.indent_stack.length - 1]
                        if top <= comment_indent:
                            break
                        self.indent_stack.pop()
                        self.push(TokenKind.Dedent)
                let text = trimmed.slice(1, trimmed.length).trim()
                self.push(TokenKind.Comment(text))
                self.push(TokenKind.Newline)
                i += 1
                continue
            let line_indent = if apply_indent: measure_indent(raw) else: 0
            if apply_indent:
                while self.inner_colon_blocks > 0:
                    let base = self.inner_block_base_indents[self.inner_block_base_indents.length - 1]
                    if line_indent <= base:
                        self.inner_colon_blocks -= 1
                        self.inner_block_base_indents.pop()
                    else:
                        break
                let cur_indent = self.indent_stack[self.indent_stack.length - 1]
                if line_indent > cur_indent:
                    self.indent_stack.append(line_indent)
                    self.push(TokenKind.Indent)
                elif line_indent < cur_indent:
                    while true:
                        let top = self.indent_stack[self.indent_stack.length - 1]
                        if top == line_indent:
                            break
                        if top < line_indent:
                            throw "line {self.line}: dedent does not match any outer indentation level"
                        self.indent_stack.pop()
                        self.push(TokenKind.Dedent)
            let line_tokens = self.lex_line_tokens(raw.trim())
            var bool last_is_colon = false
            for t in line_tokens:
                match t.kind:
                    TokenKind.LParen: self.paren_depth += 1
                    TokenKind.LBracket: self.paren_depth += 1
                    TokenKind.LBrace: self.paren_depth += 1
                    TokenKind.RParen: self.paren_depth -= 1
                    TokenKind.RBracket: self.paren_depth -= 1
                    TokenKind.RBrace: self.paren_depth -= 1
                    _: nil
                match t.kind:
                    TokenKind.Colon: last_is_colon = true
                    _: last_is_colon = false
                self.tokens.append(t)
            if last_is_colon and self.paren_depth > 0:
                self.inner_colon_blocks += 1
                self.inner_block_base_indents.append(line_indent)
            if self.paren_depth == 0 or last_is_colon or self.inner_colon_blocks > 0:
                self.push(TokenKind.Newline)
            i += 1
        while self.indent_stack.length > 1:
            self.indent_stack.pop()
            self.push(TokenKind.Dedent)
        self.push(TokenKind.Eof)
        return self.tokens

# ── Public entry point ────────────────────────────────────────────────────────

def [Token] lex(string source) throws:
    let preprocessed = preprocess_triple_strings(source)
    var lexer = Lexer(preprocessed.chars())
    return lexer.tokenize(preprocessed)
# == VALUE AND ENV ==

# ─── Signal ───────────────────────────────────────────────────────────────────

enum Signal:
    ReturnSignal(Value returnVal)
    BreakSignal(Value val)
    ContinueSignal
    ThrowSignal(Value error)
    ErrorSignal(string message, int line)
    YieldSignal(Value val, int line)

# ─── Binding ──────────────────────────────────────────────────────────────────

struct Binding:
    string name
    Value value

# ─── ObjectInner ──────────────────────────────────────────────────────────────

struct ObjectInner:
    string type_name
    [(string, Value)] fields

struct TypeRef:
    string name

# ─── Value ────────────────────────────────────────────────────────────────────

enum Value:
    Nil
    Void
    Uninitialized
    Bool(bool v)
    Int(int n)
    Float(float f)
    Str(string s)
    Array([Value] elems)
    Tuple([Value] elems)
    Dict([(Value, Value)] pairs)
    Set([Value] elems)
    Object(ObjectInner'actor inner)
    EnumVariant(string typeName, string variant, [Value] fields)
    Fn(string name, Env'actor? captured)
    Closure([Param] params, ClosureBody body, Env'actor? captured)
    NativeFn(string name, Value func)
    OverloadedFn(string name, [Value] variants)
    Range(int start, int end, bool inclusive, int step)
    Labeled(string label, Value val)

    req string type_name():
        match self:
            Value.Nil: "nil"
            Value.Void: "void"
            Value.Uninitialized: "uninitialized"
            Value.Bool(_): "bool"
            Value.Int(_): "int"
            Value.Float(_): "float"
            Value.Str(_): "string"
            Value.Array(_): "array"
            Value.Tuple(_): "tuple"
            Value.Dict(_): "dict"
            Value.Set(_): "set"
            Value.Object(_): "object"
            Value.EnumVariant(typeName, _, _): "{typeName}"
            Value.Fn(_, _): "fn"
            Value.Closure(_, _, _): "closure"
            Value.NativeFn(_, _): "native-fn"
            Value.OverloadedFn(_, _): "overloaded-fn"
            Value.Range(_, _, _, _): "range"
            Value.Labeled(_, _): "labeled"

# ─── Env ──────────────────────────────────────────────────────────────────────

struct Env:
    var {string=Value} vars
    {string} mutable_vars
    {string} owned_collections
    {string} task_safe_vars
    {string} owned_vars
    {string} shared_bindings
    Env'actor? parent

    req Value? get(string name):
        if self.vars.has(name):
            self.vars[name]
        else:
            if let p = self.parent:
                p.get(name)
            else:
                nil

    def bool set(string name, Value value):
        if self.vars.has(name):
            if not self.mutable_vars.contains(name):
                false
            else:
                self.vars.set(name, value)
                true
        else:
            if let p = self.parent:
                p.set(name, value)
            else:
                false

    def void define(string name, Value value):
        self.vars.set(name, value)
        self.mutable_vars.remove(name)

    def void define_mut(string name, Value value):
        self.vars.set(name, value)
        self.mutable_vars.add(name)

    def void define_shared_mut(string name, Value value):
        self.vars.set(name, value)
        self.mutable_vars.add(name)
        self.shared_bindings.add(name)

    def bool force_set(string name, Value value):
        if self.vars.has(name):
            self.vars.set(name, value)
            true
        else:
            if let p = self.parent:
                p.force_set(name, value)
            else:
                false

    req bool is_mutable(string name):
        if self.vars.has(name):
            self.mutable_vars.contains(name)
        else:
            if let p = self.parent:
                p.is_mutable(name)
            else:
                true

    req bool is_shared(string name):
        if self.vars.has(name):
            self.shared_bindings.contains(name)
        else:
            if let p = self.parent:
                p.is_shared(name)
            else:
                false

    req bool is_task_safe_var(string name):
        if self.task_safe_vars.contains(name):
            true
        else:
            if let p = self.parent:
                p.is_task_safe_var(name)
            else:
                false

    req bool is_owned_collection(string name):
        if self.owned_collections.contains(name):
            true
        else:
            if let p = self.parent:
                p.is_owned_collection(name)
            else:
                false

    def void invalidate(string name):
        if self.vars.has(name):
            self.vars.remove(name)
            self.mutable_vars.remove(name)
            self.owned_collections.remove(name)
            self.task_safe_vars.remove(name)
            self.owned_vars.remove(name)
            self.shared_bindings.remove(name)
        else:
            if let p = self.parent:
                p.invalidate(name)

    req [string] all_names():
        var names = self.vars.keys()
        if let p = self.parent:
            for n in p.all_names():
                names.append(n)
        names

# ─── new_env ──────────────────────────────────────────────────────────────────

def Env'actor new_env(Env'actor? parent):
    let e = Env(
        vars = {=},
        mutable_vars = {},
        owned_collections = {},
        task_safe_vars = {},
        owned_vars = {},
        shared_bindings = {},
        parent = parent
    )
    e as Env'actor

# == PARSER CORE ==

# ── Parser struct ─────────────────────────────────────────────────────────────

struct Parser:
    [Token] tokens
    int pos

    req TokenKind peek():
        self.tokens[self.pos].kind

    req TokenKind peek2():
        let next = self.pos + 1
        if next < self.tokens.length:
            self.tokens[next].kind
        else:
            TokenKind.Eof

    def Token advance():
        let t = self.tokens[self.pos]
        if self.pos + 1 < self.tokens.length:
            self.pos = self.pos + 1
        t

    def bool eat(TokenKind k):
        if self.peek() == k:
            self.advance()
            true
        else:
            false

    def Token expect(TokenKind k) throws:
        if self.peek() == k:
            self.advance()
        else:
            throw "expected {token_kind_name(k)}, got {token_kind_name(self.peek())}"

    req bool at_end():
        self.peek() == TokenKind.Eof

    req int current_line():
        self.tokens[self.pos].line

# ── Parser helpers ────────────────────────────────────────────────────────────

def string token_kind_name(TokenKind k):
    match k:
        TokenKind.Int(_): "Int"
        TokenKind.Float(_): "Float"
        TokenKind.Str(_): "Str"
        TokenKind.StringInterp(_): "StringInterp"
        TokenKind.Bool(_): "Bool"
        TokenKind.Nil: "Nil"
        TokenKind.Ident(_): "Ident"
        TokenKind.Let: "Let"
        TokenKind.Var: "Var"
        TokenKind.Def: "Def"
        TokenKind.Return: "Return"
        TokenKind.If: "If"
        TokenKind.Elif: "Elif"
        TokenKind.Else: "Else"
        TokenKind.Match: "Match"
        TokenKind.While: "While"
        TokenKind.Do: "Do"
        TokenKind.Loop: "Loop"
        TokenKind.Wait: "Wait"
        TokenKind.For: "For"
        TokenKind.In: "In"
        TokenKind.Break: "Break"
        TokenKind.Continue: "Continue"
        TokenKind.Struct: "Struct"
        TokenKind.Enum: "Enum"
        TokenKind.Trait: "Trait"
        TokenKind.Use: "Use"
        TokenKind.Ext: "Ext"
        TokenKind.As: "As"
        TokenKind.And: "And"
        TokenKind.Or: "Or"
        TokenKind.Not: "Not"
        TokenKind.Is: "Is"
        TokenKind.SelfKw: "SelfKw"
        TokenKind.Throw: "Throw"
        TokenKind.Throws: "Throws"
        TokenKind.Try: "Try"
        TokenKind.Catch: "Catch"
        TokenKind.Defer: "Defer"
        TokenKind.Void: "Void"
        TokenKind.Pub: "Pub"
        TokenKind.Guard: "Guard"
        TokenKind.Task: "Task"
        TokenKind.Join: "Join"
        TokenKind.Stream: "Stream"
        TokenKind.Yield: "Yield"
        TokenKind.Static: "Static"
        TokenKind.Type: "Type"
        TokenKind.Req: "Req"
        TokenKind.Transient: "Transient"
        TokenKind.With: "With"
        TokenKind.Get: "Get"
        TokenKind.Set: "Set"
        TokenKind.Init: "Init"
        TokenKind.Pass: "Pass"
        TokenKind.Native: "Native"
        TokenKind.Mod: "Mod"
        TokenKind.Plus: "Plus"
        TokenKind.Minus: "Minus"
        TokenKind.Star: "Star"
        TokenKind.Slash: "Slash"
        TokenKind.Percent: "Percent"
        TokenKind.Eq: "Eq"
        TokenKind.EqEq: "EqEq"
        TokenKind.EqEqEq: "EqEqEq"
        TokenKind.BangEq: "BangEq"
        TokenKind.Lt: "Lt"
        TokenKind.Gt: "Gt"
        TokenKind.LtEq: "LtEq"
        TokenKind.GtEq: "GtEq"
        TokenKind.Dot: "Dot"
        TokenKind.DotDot: "DotDot"
        TokenKind.DotDotEq: "DotDotEq"
        TokenKind.DotDotDot: "DotDotDot"
        TokenKind.Question: "Question"
        TokenKind.QuestionDot: "QuestionDot"
        TokenKind.Bang: "Bang"
        TokenKind.Tick: "Tick"
        TokenKind.Ampersand: "Ampersand"
        TokenKind.Pipe: "Pipe"
        TokenKind.Caret: "Caret"
        TokenKind.Tilde: "Tilde"
        TokenKind.PlusEq: "PlusEq"
        TokenKind.MinusEq: "MinusEq"
        TokenKind.StarEq: "StarEq"
        TokenKind.SlashEq: "SlashEq"
        TokenKind.PercentEq: "PercentEq"
        TokenKind.AmpersandEq: "AmpersandEq"
        TokenKind.PipeEq: "PipeEq"
        TokenKind.CaretEq: "CaretEq"
        TokenKind.QuestionEq: "QuestionEq"
        TokenKind.PipeArrow: "PipeArrow"
        TokenKind.LParen: "LParen"
        TokenKind.RParen: "RParen"
        TokenKind.LBracket: "LBracket"
        TokenKind.RBracket: "RBracket"
        TokenKind.LBrace: "LBrace"
        TokenKind.RBrace: "RBrace"
        TokenKind.Comma: "Comma"
        TokenKind.Colon: "Colon"
        TokenKind.At: "At"
        TokenKind.Newline: "Newline"
        TokenKind.Semicolon: "Semicolon"
        TokenKind.Indent: "Indent"
        TokenKind.Dedent: "Dedent"
        TokenKind.Eof: "Eof"
        TokenKind.Comment(_): "Comment"

def bool parser_check(var Parser'actor p, string name):
    token_kind_name(p.peek()) == name

def bool parser_check2(var Parser'actor p, string name):
    token_kind_name(p.peek2()) == name

def Token parser_advance(var Parser'actor p) throws:
    p.advance()

def bool parser_eat(var Parser'actor p, string name) throws:
    if parser_check(p, name):
        p.advance()
        true
    else:
        false

def Token parser_expect(var Parser'actor p, string name) throws:
    if parser_check(p, name):
        p.advance()
    else:
        throw "expected {name}, got {token_kind_name(p.peek())}"

def string parser_expect_ident(var Parser'actor p) throws:
    if parser_check(p, "Ident"):
        p.advance().text()
    else:
        throw "expected identifier, got {token_kind_name(p.peek())}"

def string parser_expect_ident_or_keyword(var Parser'actor p) throws:
    let k = p.peek()
    let name = token_kind_name(k)
    if name == "Ident" or name == "Let" or name == "Var" or name == "Def" or name == "Return" or name == "If" or name == "For" or name == "While" or name == "Match" or name == "Type":
        p.advance().text()
    else:
        throw "expected identifier or keyword, got {name}"

def bool parser_peek_is_ident(var Parser'actor p):
    parser_check(p, "Ident")

def bool parser_peek_is_int(var Parser'actor p):
    parser_check(p, "Int")

def bool parser_is_newline(var Parser'actor p):
    parser_check(p, "Newline") or parser_check(p, "Semicolon")

def int parser_line(var Parser'actor p):
    p.current_line()

def int parser_pos(var Parser'actor p):
    p.pos

def void parser_set_pos(var Parser'actor p, int pos):
    p.pos = pos

def void parser_skip_newlines(var Parser'actor p) throws:
    while parser_check(p, "Newline") or parser_check(p, "Semicolon"):
        p.advance()
        nil

def void parser_skip_newlines_and_indent(var Parser'actor p) throws:
    while parser_check(p, "Newline") or parser_check(p, "Indent") or parser_check(p, "Semicolon"):
        p.advance()
        nil

def void parser_expect_newline(var Parser'actor p) throws:
    if parser_check(p, "Newline") or parser_check(p, "Semicolon") or parser_check(p, "Eof"):
        if not parser_check(p, "Eof"):
            p.advance()
    else:
        throw "expected newline, got {token_kind_name(p.peek())}"

def void parser_expect_newline_soft(var Parser'actor p) throws:
    if parser_check(p, "Newline") or parser_check(p, "Semicolon"):
        p.advance()
        nil

def string parser_peek_ident(var Parser'actor p):
    match p.peek():
        TokenKind.Ident(name): name
        _: ""

def int parser_peek_int(var Parser'actor p):
    match p.peek():
        TokenKind.Int(n): n
        _: 0

def float parser_peek_float(var Parser'actor p):
    match p.peek():
        TokenKind.Float(f): f
        _: 0.0

def string parser_peek_str(var Parser'actor p):
    match p.peek():
        TokenKind.Str(s): s
        _: ""

def bool parser_peek_bool(var Parser'actor p):
    match p.peek():
        TokenKind.Bool(b): b
        _: false

def [RawInterpPart] parser_peek_interp_parts(var Parser'actor p):
    match p.peek():
        TokenKind.StringInterp(parts): parts
        _: []

def string parser_peek_comment(var Parser'actor p):
    match p.peek():
        TokenKind.Comment(text): text
        _: ""

def Token parser_peek_token_at(var Parser'actor p, int offset):
    let idx = p.pos + offset
    if idx < p.tokens.length:
        p.tokens[idx]
    else:
        Token(kind: TokenKind.Eof, line: 0)

def bool parser_token_at_is_eq(var Parser'actor p, int offset):
    token_kind_name(parser_peek_token_at(p, offset).kind) == "Eq"

def bool parser_token_at_offset_is(var Parser'actor p, int offset, string name):
    token_kind_name(parser_peek_token_at(p, offset).kind) == name

def void parser_skip_to_offset(var Parser'actor p, int offset) throws:
    p.pos = p.pos + offset

def bool parser_peek_next_is(var Parser'actor p, string name):
    parser_check2(p, name)

def bool parser_peek_next_is_colon(var Parser'actor p):
    parser_check2(p, "Colon")

def bool parser_peek_next_is_qualifier(var Parser'actor p):
    let n = token_kind_name(p.peek2())
    n == "Tick" or n == "Ampersand"

def bool parser_peek_is_macro_call(var Parser'actor p):
    false

def bool parser_peek_is_generic_call(var Parser'actor p):
    false

def bool parser_peek_is_trailing_closure(var Parser'actor p):
    false

def bool parser_peek_is_trailing_body_no_colon(var Parser'actor p) throws:
    false

def bool parser_peek_is_trailing_closure_no_paren(var Parser'actor p):
    false

def bool parser_peek_is_typed_closure(var Parser'actor p) throws:
    false

def bool parser_peek_starts_expr(var Parser'actor p) throws:
    let name = token_kind_name(p.peek())
    name == "Int" or name == "Float" or name == "Str" or name == "Bool" or name == "Nil" or name == "Ident" or name == "LParen" or name == "LBracket" or name == "LBrace" or name == "Not" or name == "Minus" or name == "SelfKw"

def bool parser_allow_noparen_closure(var Parser'actor p) throws:
    true

def bool parser_get_allow_noparen_closure(var Parser'actor p) throws:
    true

def bool parser_get_allow_trailing_closure(var Parser'actor p) throws:
    true

def void parser_set_allow_noparen_closure(var Parser'actor p, bool v) throws:
    nil

def void parser_set_allow_trailing_closure(var Parser'actor p, bool v) throws:
    nil

def int parser_depth(var Parser'actor p) throws:
    0

def void parser_depth_inc(var Parser'actor p) throws:
    nil

def void parser_depth_dec(var Parser'actor p) throws:
    nil

def bool parser_is_type_start_before_ident(var Parser'actor p):
    false

def bool parser_is_let_destructure(var Parser'actor p) throws:
    false

def bool parser_is_for_with_vars(var Parser'actor p) throws:
    false

def bool parser_is_task_fn_shorthand(var Parser'actor p) throws:
    false

def bool parser_peek_dot_after_newlines(var Parser'actor p) throws:
    false

def string parser_peek_debug(var Parser'actor p) throws:
    token_kind_name(p.peek())

# ── Type parsing ──────────────────────────────────────────────────────────────

def Type parse_type(var Parser'actor p) throws:
    let base = parse_type_base(p)
    if p.eat(TokenKind.Question):
        Type.Optional(base)
    else:
        base

def Type parse_type_base(var Parser'actor p) throws:
    match p.peek():
        TokenKind.Ident(s):
            p.advance()
            match s:
                "int":   Type.Int
                "uint":  Type.Uint
                "float": Type.Float
                "string": Type.Str
                "bool":  Type.Bool
                "void":  Type.Void
                _:       Type.Named(s)
        TokenKind.Void:
            p.advance()
            Type.Void
        TokenKind.LBracket:
            p.advance()
            let inner = parse_type(p)
            p.expect(TokenKind.RBracket)
            Type.Array(inner)
        TokenKind.LBrace:
            p.advance()
            let key = parse_type(p)
            p.expect(TokenKind.Eq)
            let val = parse_type(p)
            p.expect(TokenKind.RBrace)
            Type.Dict(key, val)
        TokenKind.LParen:
            p.advance()
            var types = [Type]{}
            if p.peek() != TokenKind.RParen:
                types.append(parse_type(p))
                while p.eat(TokenKind.Comma):
                    if p.peek() == TokenKind.RParen:
                        break
                    types.append(parse_type(p))
            p.expect(TokenKind.RParen)
            Type.Tuple(types)
        _:
            throw "expected type, got {token_kind_name(p.peek())} at line {p.current_line()}"

# ── Fn / struct / enum / program parsing ─────────────────────────────────────

def FnDecl parse_fn_decl(var Parser'actor p, bool is_pub, bool is_def) throws:
    let line = p.current_line()
    var mutating = true
    if p.eat(TokenKind.Req):
        mutating = false
    else:
        p.expect(TokenKind.Def)
    var return_ty = Type.Void
    var has_ret = false
    match p.peek():
        TokenKind.Ident(_): has_ret = true
        TokenKind.Void:     has_ret = true
        TokenKind.LBracket: has_ret = true
        TokenKind.LBrace:   has_ret = true
        TokenKind.LParen:   has_ret = true
        _: nil
    if has_ret:
        return_ty = parse_type(p)
    let name = p.expect(TokenKind.Ident(""))
    var [Param] params = []
    p.expect(TokenKind.LParen)
    while p.peek() != TokenKind.RParen:
        params.append(parse_param(p))
        if p.peek() != TokenKind.RParen:
            p.expect(TokenKind.Comma)
    p.expect(TokenKind.RParen)
    let can_throw = p.eat(TokenKind.Throws)
    p.expect(TokenKind.Colon)
    let body = parse_block(p)
    FnDecl(name: name.text(), params: params, return_ty: return_ty, can_throw: can_throw, mutating: mutating, is_pub: is_pub, body: body, line: line, qualifier: nil, is_task: false, is_stream: false, stream_capacity: nil, is_native: false, throws_ty: nil, type_params: [], where_clause: [], attrs: [])

def Param parse_param(var Parser'actor p) throws:
    let line = p.current_line()
    let mutable = p.eat(TokenKind.Var)
    let ty = parse_type(p)
    let name_tok = p.expect(TokenKind.Ident(""))
    Param(name: name_tok.text(), ty: ty, mutable: mutable, owned: false, variadic: false, default: nil, line: line)

def StructDecl parse_struct_decl(var Parser'actor p, bool is_pub) throws:
    let line = p.current_line()
    p.expect(TokenKind.Struct)
    let name_tok = p.expect(TokenKind.Ident(""))
    let name = name_tok.text()
    p.expect(TokenKind.Colon)
    p.expect(TokenKind.Newline)
    p.expect(TokenKind.Indent)
    var fields = [FieldDecl]{}
    var methods = [FnDecl]{}
    var inits = [InitDecl]{}
    while p.peek() != TokenKind.Dedent:
        if p.peek() == TokenKind.Eof:
            break
        match p.peek():
            TokenKind.Def:
                methods.append(parse_fn_decl(p, false, true))
            TokenKind.Req:
                methods.append(parse_fn_decl(p, false, false))
            TokenKind.Init:
                inits.append(parse_init_decl(p))
            _:
                fields.append(parse_field_decl(p))
    p.eat(TokenKind.Dedent)
    StructDecl(name: name, fields: fields, methods: methods, inits: inits, line: line, is_pub: is_pub, is_native: false, protocols: [], conversions: [], type_params: [], where_clause: [], setters: [], type_methods: [], type_vars: [], assoc_type_defs: [], attrs: [])

def FieldDecl parse_field_decl(var Parser'actor p) throws:
    let line = p.current_line()
    let mutable = p.eat(TokenKind.Var)
    let ty = parse_type(p)
    let name_tok = p.expect(TokenKind.Ident(""))
    var Expr? default = nil
    if p.eat(TokenKind.Eq):
        default = some(parse_expr(p))
    while p.eat(TokenKind.Newline):
        nil
    FieldDecl(name: name_tok.text(), ty: ty, mutable: mutable, default: default, line: line, is_pub: false, is_transient: false)

def InitDecl parse_init_decl(var Parser'actor p) throws:
    let line = p.current_line()
    p.expect(TokenKind.Init)
    p.expect(TokenKind.LParen)
    var [InitParam] params = []
    while p.peek() != TokenKind.RParen:
        let par = parse_param(p)
        params.append(InitParam(is_pub: false, mutable: par.mutable, name: par.name, ty: par.ty, default: par.default, line: par.line))
        if p.peek() != TokenKind.RParen:
            p.expect(TokenKind.Comma)
    p.expect(TokenKind.RParen)
    var [Stmt] body = []
    if p.eat(TokenKind.Colon):
        body = parse_block(p)
    else:
        while p.eat(TokenKind.Newline):
            nil
        InitDecl(params: params, body: body, line: line)

def EnumDecl parse_enum_decl(var Parser'actor p, bool is_pub) throws:
    let line = p.current_line()
    p.expect(TokenKind.Enum)
    let name_tok = p.expect(TokenKind.Ident(""))
    let name = name_tok.text()
    p.expect(TokenKind.Colon)
    p.expect(TokenKind.Newline)
    p.expect(TokenKind.Indent)
    var variants = [EnumVariant]{}
    var methods = [FnDecl]{}
    while p.peek() != TokenKind.Dedent:
        if p.peek() == TokenKind.Eof:
            break
        match p.peek():
            TokenKind.Def:
                methods.append(parse_fn_decl(p, false, true))
            TokenKind.Req:
                methods.append(parse_fn_decl(p, false, false))
            _:
                variants.append(parse_enum_variant(p))
    p.eat(TokenKind.Dedent)
    EnumDecl(name: name, variants: variants, methods: methods, line: line, is_pub: is_pub, is_native: false, type_params: [], protocols: [], setters: [], conversions: [], attrs: [])

def EnumVariant parse_enum_variant(var Parser'actor p) throws:
    let line = p.current_line()
    let name_tok = p.expect(TokenKind.Ident(""))
    let name = name_tok.text()
    var fields = [VariantField]{}
    if p.eat(TokenKind.LParen):
        while p.peek() != TokenKind.RParen:
            let ty = parse_type(p)
            fields.append(VariantField(name: nil, ty: ty))
            if p.peek() != TokenKind.RParen:
                p.expect(TokenKind.Comma)
        p.expect(TokenKind.RParen)
    while p.eat(TokenKind.Newline):
        nil
    EnumVariant(name: name, fields: fields, line: line, attrs: [])

def Item parse_item(var Parser'actor p) throws:
    match p.peek():
        TokenKind.Def:
            Item.Fn(parse_fn_decl(p, false, true))
        TokenKind.Req:
            Item.Fn(parse_fn_decl(p, false, false))
        TokenKind.Struct:
            Item.Struct(parse_struct_decl(p, false))
        TokenKind.Enum:
            Item.Enum(parse_enum_decl(p, false))
        _:
            Item.Stmt(parse_stmt(p))

def Program parse_program(var Parser'actor p) throws:
    var items = [Item]{}
    while p.eat(TokenKind.Newline):
        nil
    while p.peek() != TokenKind.Eof:
        items.append(parse_item(p))
        while p.eat(TokenKind.Newline):
            nil
    Program(items: items)

# ── Entry point ───────────────────────────────────────────────────────────────

def Program parse(string source) throws:
    let toks = lex(source)
    var p = Parser(tokens: toks, pos: 0) as Parser'actor
    parse_program(p)
# ── AST builder helpers ────────────────────────────────────────────────────────

struct ThrowsTask:
    bool can_throw
    bool is_task

def Stmt stmt_expr(Expr expr, int line):
    Stmt.Expr(expr)

def Stmt stmt_fn(FnDecl decl):
    Stmt.Fn(decl)

def Expr make_var_expr(string name, int line):
    Expr(kind: ExprKind.Var(name), line: line)

def Expr make_binop(string op_name, Expr left, Expr right, int line):
    let op = match op_name:
        "Add": BinOp.Add
        "Sub": BinOp.Sub
        "Mul": BinOp.Mul
        "Div": BinOp.Div
        "Rem": BinOp.Rem
        "Eq": BinOp.Eq
        "NotEq": BinOp.NotEq
        "Lt": BinOp.Lt
        "Gt": BinOp.Gt
        "LtEq": BinOp.LtEq
        "GtEq": BinOp.GtEq
        "And": BinOp.And
        "Or": BinOp.Or
        "BitAnd": BinOp.BitAnd
        "BitOr": BinOp.BitOr
        "BitXor": BinOp.BitXor
        "Shl": BinOp.Shl
        "Shr": BinOp.Shr
        _: BinOp.Add
    Expr(kind: ExprKind.BinOp(op, left, right), line: line)

def Expr make_unary(string op_name, Expr expr, int line):
    let op = match op_name:
        "Neg": UnaryOp.Neg
        "Not": UnaryOp.Not
        _: UnaryOp.BitNot
    Expr(kind: ExprKind.UnaryOp(op, expr), line: line)

def Expr make_assign(Expr target, Expr value, int line):
    Expr(kind: ExprKind.Assign(target, value), line: line)

def Arg make_arg(string? label, Expr value, bool spread):
    Arg(label: label, value: value, spread: spread)

def Expr make_call(Expr callee, [Arg] args, int line):
