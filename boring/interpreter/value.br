# == VALUE AND ENV ==

# ─── Signal ───────────────────────────────────────────────────────────────────

enum Signal:
    ReturnSignal(Value returnVal)
    BreakSignal(Value val)
    ContinueSignal
    ThrowSignal(Value error)
    ErrorSignal(string message, int line)
    YieldSignal(Value val, int line)

# ─── Binding ──────────────────────────────────────────────────────────────────

struct Binding:
    string name
    Value value

# ─── ObjectInner ──────────────────────────────────────────────────────────────

struct ObjectInner:
    string type_name
    var [(string, Value)] fields

    req Value? get_field(string name):
        var i = 0
        while i < self.fields.length:
            if self.fields[i].0 == name:
                return self.fields[i].1
            i = i + 1
        nil

    def void set_field(string name, Value val):
        var i = 0
        while i < self.fields.length:
            if self.fields[i].0 == name:
                self.fields[i] = (name, val)
                return
            i = i + 1
        self.fields.push((name, val))

struct TypeRef:
    string name

# ─── Value ────────────────────────────────────────────────────────────────────

enum Value:
    Nil
    Void
    Uninitialized
    Moved(string name)
    Bool(bool v)
    Int(int n)
    Float(float f)
    Str(string s)
    Array([Value] elems)
    Tuple([Value] elems)
    Dict([(Value, Value)] pairs)
    Set([Value] elems)
    Object(ObjectInner'actor inner)
    EnumVariant(string typeName, string variant, [Value] fields)
    Fn(string name, Env'actor? captured)
    Closure([Param] params, ClosureBody body, Env'actor? captured)
    NativeFn(string name, Value func)
    OverloadedFn(string name, [Value] variants)
    Range(int start, int end, bool inclusive, int step)
    Labeled(string label, Value val)
    StructDef(string name)
    EnumDef(string name)
    KernelHandle(Value result)

    req string type_name():
        match self:
            Value.Nil: "nil"
            Value.Void: "void"
            Value.Uninitialized: "uninitialized"
            Value.Moved(_): "moved"
            Value.Bool(_): "bool"
            Value.Int(_): "int"
            Value.Float(_): "float"
            Value.Str(_): "string"
            Value.Array(_): "array"
            Value.Tuple(_): "tuple"
            Value.Dict(_): "dict"
            Value.Set(_): "set"
            Value.Object(inner): inner.type_name.clone()
            Value.EnumVariant(typeName, _, _): "{typeName}"
            Value.Fn(_, _): "fn"
            Value.Closure(_, _, _): "closure"
            Value.NativeFn(_, _): "native-fn"
            Value.OverloadedFn(_, _): "overloaded-fn"
            Value.Range(_, _, _, _): "range"
            Value.Labeled(_, _): "labeled"
            Value.StructDef(n): "struct:{n}"
            Value.EnumDef(n): "enum:{n}"
            Value.KernelHandle(_): "kernel-handle"

bool is_copy_value(Value v):
    match v:
        Value.Bool(_): true
        Value.Int(_): true
        Value.Float(_): true
        Value.Nil: true
        Value.Void: true
        _: false

# ─── Env ──────────────────────────────────────────────────────────────────────

struct Env:
    var {string=Value} vars
    {string} mutable_vars
    {string} lazy_vars
    {string} owned_collections
    {string} task_safe_vars
    {string} owned_vars
    {string} shared_bindings
    Env'actor? parent

    req Value? get(string name):
        if self.vars.has(name):
            self.vars[name]
        else:
            if let p = self.parent:
                p.get(name)
            else:
                nil

    def bool set(string name, Value value):
        if self.vars.has(name):
            if self.lazy_vars.contains(name):
                self.vars.set(name, value)
                self.lazy_vars.remove(name)
                true
            elif not self.mutable_vars.contains(name):
                false
            else:
                self.vars.set(name, value)
                true
        else:
            if let p = self.parent:
                p.set(name, value)
            else:
                false

    def void define_lazy(string name):
        self.vars.set(name, Value.Uninitialized)
        self.lazy_vars.add(name)

    req bool is_lazy(string name):
        if self.vars.has(name):
            self.lazy_vars.contains(name)
        else:
            if let p = self.parent:
                p.is_lazy(name)
            else:
                false

    def void define(string name, Value value):
        self.vars.set(name, value)
        self.mutable_vars.remove(name)

    def void define_mut(string name, Value value):
        self.vars.set(name, value)
        self.mutable_vars.add(name)

    def void define_shared_mut(string name, Value value):
        self.vars.set(name, value)
        self.mutable_vars.add(name)
        self.shared_bindings.add(name)

    def bool force_set(string name, Value value):
        if self.vars.has(name):
            self.vars.set(name, value)
            true
        else:
            if let p = self.parent:
                p.force_set(name, value)
            else:
                false

    req bool is_mutable(string name):
        if self.vars.has(name):
            self.mutable_vars.contains(name)
        else:
            if let p = self.parent:
                p.is_mutable(name)
            else:
                true

    req bool is_shared(string name):
        if self.vars.has(name):
            self.shared_bindings.contains(name)
        else:
            if let p = self.parent:
                p.is_shared(name)
            else:
                false

    req bool is_task_safe_var(string name):
        if self.task_safe_vars.contains(name):
            true
        else:
            if let p = self.parent:
                p.is_task_safe_var(name)
            else:
                false

    req bool is_owned_collection(string name):
        if self.owned_collections.contains(name):
            true
        else:
            if let p = self.parent:
                p.is_owned_collection(name)
            else:
                false

    def void invalidate(string name):
        if self.vars.has(name):
            self.vars.remove(name)
            self.mutable_vars.remove(name)
            self.lazy_vars.remove(name)
            self.owned_collections.remove(name)
            self.task_safe_vars.remove(name)
            self.owned_vars.remove(name)
            self.shared_bindings.remove(name)
        else:
            if let p = self.parent:
                p.invalidate(name)

    req Env'actor? parent_opt():
        if let p = self.parent:
            p
        else:
            nil

    req [string] all_names():
        var names = self.vars.keys()
        if let p = self.parent:
            for n in p.all_names():
                names.push(n)
        names

# ─── new_env ──────────────────────────────────────────────────────────────────

def Env'actor new_env(Env? parent):
    let e'actor = Env(
        vars = {=},
        mutable_vars = {},
        lazy_vars = {},
        owned_collections = {},
        task_safe_vars = {},
        owned_vars = {},
        shared_bindings = {},
        parent = parent
    )
    e
