def Expr make_binop(string op_name, Expr left, Expr right, int line):
    let op = match op_name:
        "Add": BinOp.Add
        "Plus": BinOp.Add
        "Sub": BinOp.Sub
        "Minus": BinOp.Sub
        "Mul": BinOp.Mul
        "Star": BinOp.Mul
        "Div": BinOp.Div
        "Slash": BinOp.Div
        "Rem": BinOp.Rem
        "Percent": BinOp.Rem
        "Eq": BinOp.Eq
        "EqEq": BinOp.Eq
        "NotEq": BinOp.NotEq
        "BangEq": BinOp.NotEq
        "Lt": BinOp.Lt
        "Gt": BinOp.Gt
        "LtEq": BinOp.LtEq
        "GtEq": BinOp.GtEq
        "And": BinOp.And
        "Or": BinOp.Or
        "BitAnd": BinOp.BitAnd
        "Ampersand": BinOp.BitAnd
        "BitOr": BinOp.BitOr
        "Pipe": BinOp.BitOr
        "BitXor": BinOp.BitXor
        "Caret": BinOp.BitXor
        "Shl": BinOp.Shl
        "LtLt": BinOp.Shl
        "Shr": BinOp.Shr
        "GtGt": BinOp.Shr
        "Is": BinOp.Is
        "IsNot": BinOp.IsNot
        "Mod": BinOp.Rem
        "Percent": BinOp.Rem
        "RefEq": BinOp.RefEq
        _: throw "unknown binary operator: {op_name}"
    Expr(kind: ExprKind.BinOp(op, left, right), line: line)

def Expr make_unary(string op_name, Expr expr, int line):
    let op = match op_name:
        "Neg": UnaryOp.Neg
        "Not": UnaryOp.Not
        _: UnaryOp.BitNot
    Expr(kind: ExprKind.UnaryOp(op, expr), line: line)

