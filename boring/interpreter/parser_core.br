# == PARSER CORE ==

# ── Parser struct ─────────────────────────────────────────────────────────────

struct Parser:
    [Token] tokens
    var int pos
    var bool allow_noparen_closure = true
    var bool allow_trailing_closure = true

    req TokenKind peek():
        self.tokens[self.pos].kind

    req TokenKind peek2():
        let next = self.pos + 1
        if next < self.tokens.length:
            self.tokens[next].kind
        else:
            TokenKind.Eof

    def Token advance():
        let t = self.tokens[self.pos]
        if self.pos + 1 < self.tokens.length:
            self.pos = self.pos + 1
        t

    def bool eat(TokenKind k):
        if self.peek() == k:
            self.advance()
            true
        else:
            false

    def Token expect(TokenKind k) throws:
        if token_kind_name(self.peek()) == token_kind_name(k):
            return self.advance()
        throw "expected {token_kind_name(k)}, got {token_kind_name(self.peek())}"

    req bool at_end():
        self.peek() == TokenKind.Eof

    req int current_line():
        self.tokens[self.pos].line

# ── Parser helpers ────────────────────────────────────────────────────────────

def string token_kind_name(TokenKind k):
    match k:
        TokenKind.Int(_): "Int"
        TokenKind.Float(_): "Float"
        TokenKind.Str(_): "Str"
        TokenKind.StringInterp(_): "StringInterp"
        TokenKind.Bool(_): "Bool"
        TokenKind.Nil: "Nil"
        TokenKind.Ident(_): "Ident"
        TokenKind.Let: "Let"
        TokenKind.Lazy: "Lazy"
        TokenKind.Var: "Var"
        TokenKind.Mut: "Mut"
        TokenKind.Def: "Def"
        TokenKind.Return: "Return"
        TokenKind.If: "If"
        TokenKind.Elif: "Elif"
        TokenKind.Else: "Else"
        TokenKind.Match: "Match"
        TokenKind.While: "While"
        TokenKind.Do: "Do"
        TokenKind.Loop: "Loop"
        TokenKind.Wait: "Wait"
        TokenKind.For: "For"
        TokenKind.In: "In"
        TokenKind.Break: "Break"
        TokenKind.Continue: "Continue"
        TokenKind.Struct: "Struct"
        TokenKind.Enum: "Enum"
        TokenKind.Trait: "Trait"
        TokenKind.Use: "Use"
        TokenKind.Ext: "Ext"
        TokenKind.As: "As"
        TokenKind.And: "And"
        TokenKind.Or: "Or"
        TokenKind.Not: "Not"
        TokenKind.Is: "Is"
        TokenKind.SelfKw: "SelfKw"
        TokenKind.Throw: "Throw"
        TokenKind.Throws: "Throws"
        TokenKind.Try: "Try"
        TokenKind.Catch: "Catch"
        TokenKind.Defer: "Defer"
        TokenKind.Void: "Void"
        TokenKind.Pub: "Pub"
        TokenKind.Guard: "Guard"
        TokenKind.Task: "Task"
        TokenKind.Join: "Join"
        TokenKind.Stream: "Stream"
        TokenKind.Yield: "Yield"
        TokenKind.Static: "Static"
        TokenKind.Type: "Type"
        TokenKind.Req: "Req"
        TokenKind.Transient: "Transient"
        TokenKind.With: "With"
        TokenKind.Get: "Get"
        TokenKind.Set: "Set"
        TokenKind.Init: "Init"
        TokenKind.Pass: "Pass"
        TokenKind.Native: "Native"
        TokenKind.Mod: "Mod"
        TokenKind.Kernel: "Kernel"
        TokenKind.Plus: "Plus"
        TokenKind.Minus: "Minus"
        TokenKind.Star: "Star"
        TokenKind.Slash: "Slash"
        TokenKind.Percent: "Percent"
        TokenKind.Eq: "Eq"
        TokenKind.EqEq: "EqEq"
        TokenKind.EqEqEq: "EqEqEq"
        TokenKind.BangEq: "BangEq"
        TokenKind.Lt: "Lt"
        TokenKind.Gt: "Gt"
        TokenKind.LtEq: "LtEq"
        TokenKind.GtEq: "GtEq"
        TokenKind.Dot: "Dot"
        TokenKind.DotDot: "DotDot"
        TokenKind.DotDotEq: "DotDotEq"
        TokenKind.DotDotDot: "DotDotDot"
        TokenKind.Question: "Question"
        TokenKind.QuestionDot: "QuestionDot"
        TokenKind.Bang: "Bang"
        TokenKind.Tick: "Tick"
        TokenKind.Ampersand: "Ampersand"
        TokenKind.Pipe: "Pipe"
        TokenKind.Caret: "Caret"
        TokenKind.Tilde: "Tilde"
        TokenKind.PlusEq: "PlusEq"
        TokenKind.MinusEq: "MinusEq"
        TokenKind.StarEq: "StarEq"
        TokenKind.SlashEq: "SlashEq"
        TokenKind.PercentEq: "PercentEq"
        TokenKind.AmpersandEq: "AmpersandEq"
        TokenKind.PipeEq: "PipeEq"
        TokenKind.CaretEq: "CaretEq"
        TokenKind.QuestionEq: "QuestionEq"
        TokenKind.PipeArrow: "PipeArrow"
        TokenKind.LParen: "LParen"
        TokenKind.RParen: "RParen"
        TokenKind.LBracket: "LBracket"
        TokenKind.RBracket: "RBracket"
        TokenKind.LBrace: "LBrace"
        TokenKind.RBrace: "RBrace"
        TokenKind.Comma: "Comma"
        TokenKind.Colon: "Colon"
        TokenKind.At: "At"
        TokenKind.Newline: "Newline"
        TokenKind.Semicolon: "Semicolon"
        TokenKind.Indent: "Indent"
        TokenKind.Dedent: "Dedent"
        TokenKind.Eof: "Eof"
        TokenKind.Comment(_): "Comment"

def bool parser_check(mut Parser p, string name):
    token_kind_name(p.peek()) == name

def bool parser_check2(mut Parser p, string name):
    token_kind_name(p.peek2()) == name

def Token parser_advance(mut Parser p) throws:
    p.advance()

def bool parser_eat(mut Parser p, string name) throws:
    if parser_check(p, name):
        p.advance()
        return true
    return false

def Token parser_expect(mut Parser p, string name) throws:
    if parser_check(p, name):
        return p.advance()
    throw "expected {name}, got {token_kind_name(p.peek())}"

def string parser_expect_ident(mut Parser p) throws:
    if parser_check(p, "Ident"):
        return p.advance().text()
    throw "expected identifier, got {token_kind_name(p.peek())}"

def string parser_expect_ident_or_keyword(mut Parser p) throws:
    let k = p.peek()
    let name = token_kind_name(k)
    if name == "Ident" or name == "Let" or name == "Var" or name == "Def" or name == "Return" or name == "If" or name == "For" or name == "While" or name == "Match" or name == "Type" or name == "Set" or name == "Get" or name == "In" or name == "Is" or name == "As" or name == "Mod" or name == "Nil" or name == "Wait" or name == "Task" or name == "Use":
        return p.advance().text()
    throw "expected identifier or keyword, got {name}"

def bool parser_peek_is_ident(mut Parser p):
    parser_check(p, "Ident")

def bool parser_peek_is_int(mut Parser p):
    parser_check(p, "Int")

def bool parser_is_newline(mut Parser p):
    parser_check(p, "Newline") or parser_check(p, "Semicolon")

def int parser_line(mut Parser p):
    p.current_line()

def int parser_pos(mut Parser p):
    p.pos

def void parser_set_pos(mut Parser p, int pos):
    p.pos = pos

def void parser_skip_newlines(mut Parser p) throws:
    while parser_check(p, "Newline") or parser_check(p, "Semicolon"):
        p.advance()
        nil

def void parser_skip_newlines_and_indent(mut Parser p) throws:
    while parser_check(p, "Newline") or parser_check(p, "Indent") or parser_check(p, "Semicolon"):
        p.advance()
        nil

def void parser_expect_newline(mut Parser p) throws:
    if parser_check(p, "Newline") or parser_check(p, "Semicolon") or parser_check(p, "Eof"):
        if not parser_check(p, "Eof"):
            p.advance()
    else:
        throw "expected newline, got {token_kind_name(p.peek())}"

def void parser_expect_newline_soft(mut Parser p) throws:
    if parser_check(p, "Newline") or parser_check(p, "Semicolon"):
        p.advance()
        nil

def string parser_peek_ident(mut Parser p):
    match p.peek():
        TokenKind.Ident(name): name
        _: ""

def int parser_peek_int(mut Parser p):
    match p.peek():
        TokenKind.Int(n): n
        _: 0

def float parser_peek_float(mut Parser p):
    match p.peek():
        TokenKind.Float(f): f
        _: 0.0

def string parser_peek_str(mut Parser p):
    match p.peek():
        TokenKind.Str(s): s
        _: ""

def bool parser_peek_bool(mut Parser p):
    match p.peek():
        TokenKind.Bool(b): b
        _: false

def [RawInterpPart] parser_peek_interp_parts(mut Parser p):
    match p.peek():
        TokenKind.StringInterp(parts): parts
        _: []

def string parser_peek_comment(mut Parser p):
    match p.peek():
        TokenKind.Comment(text): text
        _: ""

def Token parser_peek_token_at(mut Parser p, int offset):
    let idx = p.pos + offset
    if idx < p.tokens.length:
        p.tokens[idx]
    else:
        Token(kind= TokenKind.Eof, line= 0)

def bool parser_token_at_is_eq(mut Parser p, int offset):
    token_kind_name(parser_peek_token_at(p, offset).kind) == "Eq"

def bool parser_token_at_offset_is(mut Parser p, int offset, string name):
    token_kind_name(parser_peek_token_at(p, offset).kind) == name

def void parser_skip_to_offset(mut Parser p, int offset) throws:
    let cur = p.pos
    p.pos = cur + offset

def bool parser_peek_next_is(mut Parser p, string name):
    parser_check2(p, name)

def bool parser_peek_next_is_colon(mut Parser p):
    parser_check2(p, "Colon")

def bool parser_peek_next_is_qualifier(mut Parser p):
    let n = token_kind_name(p.peek2())
    n == "Tick" or n == "Ampersand"

def bool parser_peek_is_macro_call(mut Parser p):
    # Detect `name!` — current token is Ident, next is Bang
    parser_token_at_offset_is(p, 1, "Bang")

def bool parser_peek_is_generic_call(mut Parser p):
    # Detect `Name<Type>(` — e.g. channel<int>(4)
    # p is positioned on the Ident; check offsets 1..4
    if token_kind_name(parser_peek_token_at(p, 1).kind) != "Lt":
        return false
    # offset 2: a type-like token (Ident for primitive or named type)
    let k2 = token_kind_name(parser_peek_token_at(p, 2).kind)
    if k2 != "Ident" and k2 != "Void":
        return false
    # offset 3: closing Gt
    if token_kind_name(parser_peek_token_at(p, 3).kind) != "Gt":
        return false
    # offset 4: LParen to confirm it's a call
    token_kind_name(parser_peek_token_at(p, 4).kind) == "LParen"

def bool parser_peek_is_trailing_closure(mut Parser p):
    # Detects `(params): body` — only fires when params look like simple identifiers
    # (not complex expressions), to avoid false positives like `.map((v): body)`
    if not p.allow_trailing_closure:
        return false
    if token_kind_name(parser_peek_token_at(p, 0).kind) != "LParen":
        return false
    # Scan inside parens; only allow Ident, Comma, LBracket-type-prefixes, Tick, Question
    # If we see nested LParen, operators, or any non-param tokens, it's a regular arg list
    var i = 1
    while true:
        let k = token_kind_name(parser_peek_token_at(p, i).kind)
        if k == "RParen":
            i = i + 1
            break
        elif k == "Newline" or k == "Eof":
            return false
        elif k == "LParen":
            # Nested paren means it's a complex expr (e.g. `f((v): body)`) — not a plain param list
            return false
        elif k == "Ident" or k == "Comma" or k == "LBracket" or k == "RBracket" or k == "LBrace" or k == "RBrace" or k == "Tick" or k == "Question" or k == "DotDotDot":
            i = i + 1
        else:
            # Operators, calls, etc. — this is an expression, not params
            return false
    # After closing RParen, skip optional modifiers (Task, Throws)
    var j = i
    while true:
        let k2 = token_kind_name(parser_peek_token_at(p, j).kind)
        if k2 == "Task" or k2 == "Throws":
            j = j + 1
        else:
            break
    let kf = token_kind_name(parser_peek_token_at(p, j).kind)
    kf == "Colon"

def bool parser_peek_is_trailing_body_no_colon(mut Parser p) throws:
    false

def bool parser_peek_is_trailing_closure_no_paren(mut Parser p):
    # Detects `ident: body` or `ident, ident: body` at current position
    if not p.allow_trailing_closure:
        return false
    if not parser_check(p, "Ident"):
        return false
    # Scan forward: Ident (Comma Ident)* Colon
    var i = 0
    while true:
        let k0 = token_kind_name(parser_peek_token_at(p, i).kind)
        if k0 != "Ident":
            return false
        i = i + 1
        let k1 = token_kind_name(parser_peek_token_at(p, i).kind)
        if k1 == "Colon":
            return true
        elif k1 == "Comma":
            i = i + 1
        else:
            return false
    false

def bool parser_peek_is_typed_closure(mut Parser p) throws:
    parser_is_type_start_before_ident(p)

def bool parser_peek_starts_expr(mut Parser p) throws:
    let name = token_kind_name(p.peek())
    name == "Int" or name == "Float" or name == "Str" or name == "StringInterp" or name == "Bool" or name == "Nil" or name == "Ident" or name == "LParen" or name == "LBracket" or name == "LBrace" or name == "Not" or name == "Minus" or name == "SelfKw"

def bool parser_allow_noparen_closure(mut Parser p) throws:
    p.allow_noparen_closure

def bool parser_get_allow_noparen_closure(mut Parser p) throws:
    p.allow_noparen_closure

def bool parser_get_allow_trailing_closure(mut Parser p) throws:
    p.allow_trailing_closure

def void parser_set_allow_noparen_closure(mut Parser p, bool v) throws:
    p.allow_noparen_closure = v

def void parser_set_allow_trailing_closure(mut Parser p, bool v) throws:
    p.allow_trailing_closure = v

def int parser_depth(mut Parser p) throws:
    0

def void parser_depth_inc(mut Parser p) throws:
    nil

def void parser_depth_dec(mut Parser p) throws:
    nil

def bool parser_is_type_start_before_ident(mut Parser p):
    # returns true when current tokens look like "Type Ident" (typed binding)
    let k0 = token_kind_name(parser_peek_token_at(p, 0).kind)
    let k1 = token_kind_name(parser_peek_token_at(p, 1).kind)
    if k0 == "LBracket" or k0 == "LBrace":
        return true
    if k0 != "Ident":
        return false
    if k1 == "Ident":
        return true
    if k1 == "Ampersand":
        let k2 = token_kind_name(parser_peek_token_at(p, 2).kind)
        return k2 == "Ident"
    if k1 == "Question":
        let k2 = token_kind_name(parser_peek_token_at(p, 2).kind)
        return k2 == "Ident"
    if k1 == "Tick":
        # T'qual Ident or T'? Ident or T'shared'weak Ident
        var scan = 2
        while true:
            let ks = token_kind_name(parser_peek_token_at(p, scan).kind)
            if ks == "Ident" or ks == "Guard":
                scan = scan + 1
                let kn = token_kind_name(parser_peek_token_at(p, scan).kind)
                if kn == "Tick":
                    scan = scan + 1
                else:
                    return kn == "Ident"
            elif ks == "Question":
                let kn = token_kind_name(parser_peek_token_at(p, scan + 1).kind)
                return kn == "Ident"
            else:
                return false
        false
    false

def bool parser_is_let_destructure(mut Parser p) throws:
    # At let/var/static. Check for `let x, y = ...` or `let (x, y) = ...`
    if parser_token_at_offset_is(p, 1, "LParen"):
        return true
    # `let x, ...` - ident then comma
    if parser_token_at_offset_is(p, 1, "Ident") and parser_token_at_offset_is(p, 2, "Comma"):
        return true
    # `let TYPE name, ...` - type ident then comma (e.g. `let string tx, rx = ...`)
    if parser_token_at_offset_is(p, 1, "Ident") and parser_token_at_offset_is(p, 2, "Ident") and parser_token_at_offset_is(p, 3, "Comma"):
        return true
    false

def bool parser_is_for_with_vars(mut Parser p) throws:
    # returns true when the for loop has explicit variable bindings: `for x in arr:`
    # check: Ident followed by In or Comma (multi-var: `for i, v in arr:`)
    if not parser_check(p, "Ident"):
        return false
    parser_token_at_offset_is(p, 1, "In") or parser_token_at_offset_is(p, 1, "Comma")

def bool parser_is_task_fn_shorthand(mut Parser p) throws:
    false

def bool parser_is_fn_shorthand(mut Parser p) throws:
    # Detect: `RetType FnName(TypedParams...):`
    # We need to distinguish `int add(int a, int b):` from `print foo(42)`
    # Key: after `(`, params should start with a type-ident followed by another ident,
    # or the parens should be empty AND followed by colon.
    # Pattern: Ident Ident LParen ...
    if parser_token_at_offset_is(p, 0, "Ident") and parser_token_at_offset_is(p, 1, "Ident") and parser_token_at_offset_is(p, 2, "LParen"):
        # Check inside parens: empty parens → might be decl if followed by colon
        if parser_token_at_offset_is(p, 3, "RParen"):
            return parser_token_at_offset_is(p, 4, "Colon") or parser_token_at_offset_is(p, 4, "Throws")
        # Non-empty: first token after ( must be type (Ident, [, or {) followed by Ident
        let p0 = token_kind_name(parser_peek_token_at(p, 3).kind)
        let p1 = token_kind_name(parser_peek_token_at(p, 4).kind)
        if p0 == "Ident" and p1 == "Ident": return true
        # [type] param — p1 must be Ident (type name), not a literal
        if p0 == "LBracket" and p1 == "Ident": return true
        if p0 == "LBrace" and p1 == "Ident": return true
        # `mut`/`var` param prefix — an expression call's arguments can never start
        # with either token, so this alone proves it's a typed parameter list.
        if p0 == "Var" or p0 == "Mut": return true
        return false
    # Pattern: [ ... ] Ident LParen → array return type
    if parser_token_at_offset_is(p, 0, "LBracket"):
        var depth = 0
        var i = 0
        var found = false
        while i < 20 and not found:
            let tok = token_kind_name(parser_peek_token_at(p, i).kind)
            if tok == "LBracket": depth = depth + 1
            if tok == "RBracket":
                depth = depth - 1
                if depth == 0:
                    found = true
                    if parser_token_at_offset_is(p, i + 1, "Ident") and parser_token_at_offset_is(p, i + 2, "LParen"):
                        let after_lparen = i + 3
                        if parser_token_at_offset_is(p, after_lparen, "RParen"):
                            return parser_token_at_offset_is(p, after_lparen + 1, "Colon")
                        # Params can start with Ident or [ (array type) or { (dict type)
                        let p0 = token_kind_name(parser_peek_token_at(p, after_lparen).kind)
                        let p1 = token_kind_name(parser_peek_token_at(p, after_lparen + 1).kind)
                        if p0 == "Ident" and p1 == "Ident": return true
                        if p0 == "LBracket" and p1 == "Ident": return true
                        if p0 == "LBrace" and p1 == "Ident": return true
                        if p0 == "Var" or p0 == "Mut": return true
                        return false
            if tok == "Eof": return false
            i = i + 1
        return false
    false

def FnDecl parse_fn_shorthand(mut Parser p) throws:
    parse_fn_decl_shorthand(p)

def bool parser_peek_dot_after_newlines(mut Parser p) throws:
    false

def string parser_peek_debug(mut Parser p) throws:
    token_kind_name(p.peek())

# ── Type parsing ──────────────────────────────────────────────────────────────

bool is_fixed_width_int_name(string s):
    s == "int8" or s == "int16" or s == "int32" or s == "int64" or s == "int128" or s == "uint16" or s == "uint32" or s == "uint64" or s == "uint128"

def Type parse_type(mut Parser p) throws:
    let base = parse_type_base(p)
    # Handle `T&` borrow syntax — consume `&` and treat as the base type
    if p.eat(TokenKind.Ampersand):
        return base
    if p.eat(TokenKind.Question):
        Type.Optional(base)
    else:
        parse_type_qualifier(p, base)

def Type parse_type_base(mut Parser p) throws:
    match p.peek():
        TokenKind.Ident(s):
            p.advance()
            match s:
                "int":   Type.Int
                "uint":  Type.Uint
                "uint8": Type.Uint8
                "int8":    Type.Int8
                "int16":   Type.Int16
                "int32":   Type.Int32
                "int64":   Type.Int64
                "int128":  Type.Int128
                "uint16":  Type.Uint16
                "uint32":  Type.Uint32
                "uint64":  Type.Uint64
                "uint128": Type.Uint128
                "float": Type.Float
                "string": Type.Str
                "bool":  Type.Bool
                "void":  Type.Void
                _:
                    # Handle generic type params: `Result<int, string>` — skip them
                    if p.peek() == TokenKind.Lt:
                        p.advance()
                        var d = 1
                        while d > 0 and p.peek() != TokenKind.Eof:
                            if p.peek() == TokenKind.Lt:
                                d = d + 1
                            elif p.peek() == TokenKind.Gt:
                                d = d - 1
                            p.advance()
                    Type.Named(s)
        TokenKind.Void:
            p.advance()
            Type.Void
        TokenKind.LBracket:
            p.advance()
            let inner = parse_type(p)
            if p.eat(TokenKind.Comma):
                if token_kind_name(p.peek()) != "Int":
                    throw "expected integer literal for fixed-size array length"
                let n = parser_peek_int(p)
                p.advance()
                p.expect(TokenKind.RBracket)
                Type.ArrayN(inner, n)
            else:
                p.expect(TokenKind.RBracket)
                Type.Array(inner)
        TokenKind.LBrace:
            p.advance()
            let first = parse_type(p)
            if p.eat(TokenKind.Eq):
                let val = parse_type(p)
                p.expect(TokenKind.RBrace)
                Type.Dict(first, val)
            else:
                p.expect(TokenKind.RBrace)
                Type.Set(first)
        TokenKind.LParen:
            p.advance()
            var types = [Type]{}
            if p.peek() != TokenKind.RParen:
                types.push(parse_type(p))
                while p.eat(TokenKind.Comma):
                    if p.peek() == TokenKind.RParen:
                        break
                    types.push(parse_type(p))
            p.expect(TokenKind.RParen)
            Type.Tuple(types)
        _:
            throw "expected type, got {token_kind_name(p.peek())} at line {p.current_line()}"

# ── Fn / struct / enum / program parsing ─────────────────────────────────────

def FnDecl parse_fn_decl_shorthand(mut Parser p) throws:
    let line = p.current_line()
    let return_ty = parse_type(p)
    let name = parser_expect_ident_or_keyword(p)
    var [Param] params = []
    p.expect(TokenKind.LParen)
    while p.peek() != TokenKind.RParen:
        params.push(parse_param(p))
        if p.peek() != TokenKind.RParen:
            p.expect(TokenKind.Comma)
    p.expect(TokenKind.RParen)
    let can_throw = p.eat(TokenKind.Throws)
    if can_throw:
        parser_eat(p, "Ident")
    p.expect(TokenKind.Colon)
    let body = parse_fn_body(p)
    FnDecl(name= name, params= params, return_ty= return_ty, can_throw= can_throw, mutating= true, is_pub= false, body= body, line= line, qualifier= nil, is_task= false, is_stream= false, stream_capacity= nil, is_native= false, throws_ty= nil, type_params= [], where_clause= [], attrs= [])

def bool token_is_fn_name_like(string n):
    n == "Ident" or n == "Get" or n == "Set" or n == "In" or n == "Mod" or n == "Nil" or n == "Is" or n == "Tick"

def FnDecl parse_fn_decl(mut Parser p, bool is_pub, bool is_def) throws:
    let line = p.current_line()
    # Consume optional `task` prefix before `def`/`req`
    p.eat(TokenKind.Task)
    var mutating = true
    if p.eat(TokenKind.Req):
        mutating = false
    else:
        p.expect(TokenKind.Def)
    var return_ty = Type.Void
    var has_ret = false
    # Early detection: `def ():` callable struct — LParen RParen Colon
    if p.peek() == TokenKind.LParen:
        let k1 = token_kind_name(parser_peek_token_at(p, 1).kind)
        if k1 == "RParen":
            let k2 = token_kind_name(parser_peek_token_at(p, 2).kind)
            if k2 == "Colon" or k2 == "Throws":
                var params = []
                p.expect(TokenKind.LParen)
                p.expect(TokenKind.RParen)
                let can_throw = p.eat(TokenKind.Throws)
                if can_throw:
                    parser_eat(p, "Ident")
                p.expect(TokenKind.Colon)
                let body = parse_fn_body(p)
                return FnDecl(name= "__call__", params= params, return_ty= Type.Void, can_throw= can_throw, mutating= mutating, is_pub= is_pub, body= body, line= line, qualifier= nil, is_task= false, is_stream= false, stream_capacity= nil, is_native= false, throws_ty= nil, type_params= [], where_clause= [], attrs= [])
    match p.peek():
        TokenKind.Ident(_):
            let next1 = token_kind_name(parser_peek_token_at(p, 1).kind)
            if token_is_fn_name_like(next1):
                has_ret = true
            elif next1 == "Ampersand":
                # `T& name(` — borrow return type
                let next2 = token_kind_name(parser_peek_token_at(p, 2).kind)
                if token_is_fn_name_like(next2):
                    has_ret = true
            elif next1 == "Dot":
                # Could be `Self.Inner fnName(` — check two more tokens ahead
                let next2 = token_kind_name(parser_peek_token_at(p, 2).kind)
                if next2 == "Ident":
                    let next3 = token_kind_name(parser_peek_token_at(p, 3).kind)
                    if token_is_fn_name_like(next3) or next3 == "LParen":
                        has_ret = true
            elif next1 == "Question":
                let next2 = token_kind_name(parser_peek_token_at(p, 2).kind)
                has_ret = token_is_fn_name_like(next2) or next2 == "LParen"
            elif next1 == "Lt":
                # Generic return type: `Result<int, string> name(` — scan past `<...>`
                var gi = 2
                var gd = 1
                while gd > 0 and gi < 50:
                    let gk = token_kind_name(parser_peek_token_at(p, gi).kind)
                    if gk == "Lt": gd = gd + 1
                    elif gk == "Gt": gd = gd - 1
                    elif gk == "Eof": gd = -1
                    gi = gi + 1
                if gd == 0:
                    let after_gt = token_kind_name(parser_peek_token_at(p, gi).kind)
                    if token_is_fn_name_like(after_gt):
                        has_ret = true
        TokenKind.Void:     has_ret = true
        TokenKind.LBracket: has_ret = true
        TokenKind.LBrace:   has_ret = true
        TokenKind.LParen:   has_ret = true
        _: nil
    # Check for callable struct: `def ():` or `req RetType ():`
    # Pattern 1: `def ():`  — LParen immediately (no return type, no name)
    # Pattern 2: `req int ():` — Ident LParen (return type followed by `(` with no name between)
    let is_callable_def = not has_ret and p.peek() == TokenKind.LParen
    let peek0k = token_kind_name(p.peek())
    let peek1k = token_kind_name(parser_peek_token_at(p, 1).kind)
    let peek0txt = parser_peek_token_at(p, 0).text()
    # Callable req only fires for known primitive return types or Void
    let peek0_is_prim_type = peek0txt == "int" or peek0txt == "float" or peek0txt == "string" or peek0txt == "bool" or peek0txt == "void" or peek0txt == "uint" or peek0txt == "uint8" or is_fixed_width_int_name(peek0txt)
    let is_callable_req = peek0k == "Ident" and peek1k == "LParen" and peek0_is_prim_type
    if is_callable_def:
        var name = "__call__"
        var [Param] params = []
        p.expect(TokenKind.LParen)
        while p.peek() != TokenKind.RParen:
            params.push(parse_param(p))
            if p.peek() != TokenKind.RParen:
                p.expect(TokenKind.Comma)
        p.expect(TokenKind.RParen)
        let can_throw = p.eat(TokenKind.Throws)
        if can_throw:
            parser_eat(p, "Ident")
        p.expect(TokenKind.Colon)
        let body = parse_fn_body(p)
        return FnDecl(name= name, params= params, return_ty= Type.Void, can_throw= can_throw, mutating= mutating, is_pub= is_pub, body= body, line= line, qualifier= nil, is_task= false, is_stream= false, stream_capacity= nil, is_native= false, throws_ty= nil, type_params= [], where_clause= [], attrs= [])
    if is_callable_req:
        return_ty = parse_type(p)
        var name = "__call__"
        var [Param] params = []
        p.expect(TokenKind.LParen)
        while p.peek() != TokenKind.RParen:
            params.push(parse_param(p))
            if p.peek() != TokenKind.RParen:
                p.expect(TokenKind.Comma)
        p.expect(TokenKind.RParen)
        let can_throw = p.eat(TokenKind.Throws)
        if can_throw:
            parser_eat(p, "Ident")
        p.expect(TokenKind.Colon)
        let body = parse_fn_body(p)
        return FnDecl(name= name, params= params, return_ty= return_ty, can_throw= can_throw, mutating= mutating, is_pub= is_pub, body= body, line= line, qualifier= nil, is_task= false, is_stream= false, stream_capacity= nil, is_native= false, throws_ty= nil, type_params= [], where_clause= [], attrs= [])
    if has_ret:
        return_ty = parse_type(p)
        # Consume dotted type qualifier: `Self.Inner` → advance past `.Inner` after type
        if p.eat(TokenKind.Dot):
            parser_expect_ident_or_keyword(p)
    var name = parser_expect_ident_or_keyword(p)
    # Handle qualified name: Protocol.method — only when return type was explicit
    if has_ret and p.eat(TokenKind.Dot):
        name = parser_expect_ident_or_keyword(p)
    if p.eat(TokenKind.Lt):
        while p.peek() != TokenKind.Gt and p.peek() != TokenKind.Eof:
            p.advance()
        p.eat(TokenKind.Gt)
    var [Param] params = []
    p.expect(TokenKind.LParen)
    while p.peek() != TokenKind.RParen:
        params.push(parse_param(p))
        if p.peek() != TokenKind.RParen:
            p.expect(TokenKind.Comma)
    p.expect(TokenKind.RParen)
    let can_throw = p.eat(TokenKind.Throws)
    if can_throw:
        parser_eat(p, "Ident")
    p.expect(TokenKind.Colon)
    let body = parse_fn_body(p)
    FnDecl(name= name, params= params, return_ty= return_ty, can_throw= can_throw, mutating= mutating, is_pub= is_pub, body= body, line= line, qualifier= nil, is_task= false, is_stream= false, stream_capacity= nil, is_native= false, throws_ty= nil, type_params= [], where_clause= [], attrs= [])

def Param parse_param(mut Parser p) throws:
    let line = p.current_line()
    var mutable = p.eat(TokenKind.Var)
    if not mutable:
        mutable = p.eat(TokenKind.Mut)
    # Consume optional function-type qualifier: `def`, `req`, `task`, `pub`
    p.eat(TokenKind.Def)
    p.eat(TokenKind.Req)
    p.eat(TokenKind.Task)
    p.eat(TokenKind.Pub)
    let base_ty = parse_type(p)
    let ty = parse_type_qualifier(p, base_ty)
    # Handle variadic: `int... args`
    var variadic = p.eat(TokenKind.DotDotDot)
    # Handle function-type param `def int(int) f` — type(args) name — skip (args) before name
    if p.peek() == TokenKind.LParen:
        p.advance()
        var depth = 1
        while depth > 0 and p.peek() != TokenKind.Eof:
            if p.peek() == TokenKind.LParen:
                depth = depth + 1
            elif p.peek() == TokenKind.RParen:
                depth = depth - 1
            p.advance()
    let name_tok = p.expect(TokenKind.Ident(""))
    # Handle function-type param: `int f(int)` — name then (args) — skip the (args) part
    if p.eat(TokenKind.LParen):
        var depth = 1
        while depth > 0 and p.peek() != TokenKind.Eof:
            if p.peek() == TokenKind.LParen:
                depth = depth + 1
            elif p.peek() == TokenKind.RParen:
                depth = depth - 1
            p.advance()
    # Consume optional post-param modifiers for function-type params: `task`, `throws`
    p.eat(TokenKind.Task)
    p.eat(TokenKind.Throws)
    var Expr? default = nil
    if p.eat(TokenKind.Eq):
        default = parse_expr(p)
    Param(name= name_tok.text(), ty= ty, mutable= mutable, owned= false, variadic= variadic, default= default, line= line)

def StructDecl parse_struct_decl(mut Parser p, bool is_pub) throws:
    let line = p.current_line()
    p.expect(TokenKind.Struct)
    let name_tok = p.expect(TokenKind.Ident(""))
    let name = name_tok.text()
    # Skip optional generic params: <A, B>
    if p.eat(TokenKind.Lt):
        while p.peek() != TokenKind.Gt and p.peek() != TokenKind.Eof:
            p.advance()
        p.eat(TokenKind.Gt)
    # Collect optional protocol conformance: as Protocol, Protocol2
    var [string] struct_protocols = []
    if p.eat(TokenKind.As):
        while p.peek() != TokenKind.Colon and p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
            if parser_check(p, "Ident"):
                struct_protocols.push(parser_expect_ident(p))
            else:
                p.advance()
    p.expect(TokenKind.Colon)
    # Allow `struct Foo: pass` for empty struct body
    if p.eat(TokenKind.Pass):
        p.eat(TokenKind.Newline)
        return StructDecl(name= name, fields= [], methods= [], inits= [], line= line, is_pub= is_pub, is_native= false, protocols= struct_protocols, conversions= [], type_params= [], where_clause= [], setters= [], type_methods= [], type_vars= [], assoc_type_defs= [], attrs= [])
    p.expect(TokenKind.Newline)
    p.expect(TokenKind.Indent)
    var fields = [FieldDecl]{}
    var methods = [FnDecl]{}
    var inits = [InitDecl]{}
    var setters = [SetDecl]{}
    var conversions = [AsDecl]{}
    while p.peek() != TokenKind.Dedent:
        if p.peek() == TokenKind.Eof:
            break
        while p.eat(TokenKind.Newline):
            nil
        if p.peek() == TokenKind.Dedent or p.peek() == TokenKind.Eof:
            break
        match p.peek():
            TokenKind.Def:
                methods.push(parse_fn_decl(p, false, true))
            TokenKind.Req:
                methods.push(parse_fn_decl(p, false, false))
            TokenKind.Init:
                inits.push(parse_init_decl(p))
            TokenKind.Pub:
                p.advance()
                if parser_check(p, "Def"):
                    methods.push(parse_fn_decl(p, true, true))
                elif parser_check(p, "Req"):
                    methods.push(parse_fn_decl(p, true, false))
                else:
                    # pub let / pub var field
                    let f = parse_field_decl(p)
                    fields.push(FieldDecl(name= f.name, is_pub= true, ty= f.ty, mutable= f.mutable, is_transient= f.is_transient, default= f.default, line= f.line))
            TokenKind.Set:
                let setter = parse_setter_decl(p)
                setters.push(setter)
            TokenKind.Transient:
                # transient field — eat qualifier and parse as regular field
                p.advance()
                let tf = parse_field_decl(p)
                fields.push(FieldDecl(name= tf.name, is_pub= tf.is_pub, ty= tf.ty, mutable= tf.mutable, is_transient= true, default= tf.default, line= tf.line))
            TokenKind.As:
                # as TypeName: body — parse conversion block
                let as_line = p.current_line()
                p.advance()
                let conv_ty = parse_type(p)
                let can_throw = p.eat(TokenKind.Throws)
                p.expect(TokenKind.Colon)
                let conv_body = parse_fn_body(p)
                conversions.push(AsDecl(is_pub= false, ty= conv_ty, can_throw= can_throw, is_task= false, body= conv_body, line= as_line))
            TokenKind.Type:
                # Associated type declaration: `type Output = int` — skip
                while p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                    p.advance()
                p.eat(TokenKind.Newline)
            TokenKind.Task:
                # `task RetType method(params): body` or `task def ...` method inside struct.
                # Both helpers are shared with non-task callers and always hardcode
                # `is_task = false` — re-wrap the result with `is_task = true` so callers
                # (e.g. the interpreter's "task methods never count as mutating" check)
                # can tell a `task` method apart from an ordinary `def`/shorthand one.
                let stk1 = token_kind_name(parser_peek_token_at(p, 1).kind)
                if stk1 == "Def" or stk1 == "Req":
                    let task_method_decl = parse_fn_decl(p, false, stk1 == "Def")
                    methods.push(FnDecl(name= task_method_decl.name, qualifier= task_method_decl.qualifier, params= task_method_decl.params, return_ty= task_method_decl.return_ty, body= task_method_decl.body, is_pub= task_method_decl.is_pub, can_throw= task_method_decl.can_throw, is_task= true, is_stream= task_method_decl.is_stream, stream_capacity= task_method_decl.stream_capacity, mutating= task_method_decl.mutating, is_native= task_method_decl.is_native, throws_ty= task_method_decl.throws_ty, type_params= task_method_decl.type_params, where_clause= task_method_decl.where_clause, attrs= task_method_decl.attrs, line= task_method_decl.line))
                else:
                    # shorthand: `task RetType name(params): body`
                    p.advance()  # consume task
                    let task_shorthand_decl = parse_fn_decl_shorthand(p)
                    methods.push(FnDecl(name= task_shorthand_decl.name, qualifier= task_shorthand_decl.qualifier, params= task_shorthand_decl.params, return_ty= task_shorthand_decl.return_ty, body= task_shorthand_decl.body, is_pub= task_shorthand_decl.is_pub, can_throw= task_shorthand_decl.can_throw, is_task= true, is_stream= task_shorthand_decl.is_stream, stream_capacity= task_shorthand_decl.stream_capacity, mutating= task_shorthand_decl.mutating, is_native= task_shorthand_decl.is_native, throws_ty= task_shorthand_decl.throws_ty, type_params= task_shorthand_decl.type_params, where_clause= task_shorthand_decl.where_clause, attrs= task_shorthand_decl.attrs, line= task_shorthand_decl.line))
            _:
                fields.push(parse_field_decl(p))
    p.eat(TokenKind.Dedent)
    StructDecl(name= name, fields= fields, methods= methods, inits= inits, line= line, is_pub= is_pub, is_native= false, protocols= struct_protocols, conversions= conversions, type_params= [], where_clause= [], setters= setters, type_methods= [], type_vars= [], assoc_type_defs= [], attrs= [])

def FieldDecl parse_field_decl(mut Parser p) throws:
    let line = p.current_line()
    # Allow optional `let` or `var` keyword before the type
    var mutable = false
    if p.eat(TokenKind.Var):
        mutable = true
    else:
        p.eat(TokenKind.Let)
    let ty = parse_type(p)
    let name_tok = p.expect(TokenKind.Ident(""))
    var Expr? default = nil
    if p.eat(TokenKind.Eq):
        default = parse_expr(p)
    while p.eat(TokenKind.Newline):
        nil
    FieldDecl(name= name_tok.text(), ty= ty, mutable= mutable, default= default, line= line, is_pub= false, is_transient= false)

def SetDecl parse_setter_decl(mut Parser p) throws:
    let line = p.current_line()
    p.expect(TokenKind.Set)
    let name = parser_expect_ident_or_keyword(p)
    p.expect(TokenKind.LParen)
    let param_ty = parse_type(p)
    let param_name = parser_expect_ident(p)
    p.expect(TokenKind.RParen)
    let can_throw = p.eat(TokenKind.Throws)
    p.expect(TokenKind.Colon)
    let body = parse_fn_body(p)
    SetDecl(name= name, param_name= param_name, param_ty= param_ty, is_pub= false, can_throw= can_throw, is_task= false, body= body, line= line)

def InitDecl parse_init_decl(mut Parser p) throws:
    let line = p.current_line()
    p.expect(TokenKind.Init)
    p.expect(TokenKind.LParen)
    var [InitParam] params = []
    while p.peek() != TokenKind.RParen:
        let is_pub = p.eat(TokenKind.Pub)
        let par = parse_param(p)
        params.push(InitParam(is_pub= is_pub, mutable= par.mutable, name= par.name, ty= par.ty, default= par.default, line= par.line))
        if p.peek() != TokenKind.RParen:
            p.expect(TokenKind.Comma)
    p.expect(TokenKind.RParen)
    var [Stmt] body = []
    if p.eat(TokenKind.Colon):
        body = parse_block(p)
    else:
        while p.eat(TokenKind.Newline):
            nil
    return InitDecl(params= params, body= body, line= line)

def EnumDecl parse_enum_decl(mut Parser p, bool is_pub) throws:
    let line = p.current_line()
    p.expect(TokenKind.Enum)
    let name_tok = p.expect(TokenKind.Ident(""))
    let name = name_tok.text()
    # Skip optional generic params and protocol conformance: <T> as Protocol
    if p.eat(TokenKind.Lt):
        while p.peek() != TokenKind.Gt and p.peek() != TokenKind.Eof:
            p.advance()
        p.eat(TokenKind.Gt)
    if p.eat(TokenKind.As):
        while p.peek() != TokenKind.Colon and p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
            p.advance()
    p.expect(TokenKind.Colon)
    # Allow `enum Foo: pass` for empty enum body
    if p.eat(TokenKind.Pass):
        p.eat(TokenKind.Newline)
        return EnumDecl(name= name, variants= [], methods= [], is_pub= is_pub, conversions= [], type_params= [], line= line, is_native= false, protocols= [], setters= [], attrs= [])
    p.expect(TokenKind.Newline)
    p.expect(TokenKind.Indent)
    var variants = [EnumVariant]{}
    var methods = [FnDecl]{}
    var enum_conversions = [AsDecl]{}
    while p.peek() != TokenKind.Dedent:
        if p.peek() == TokenKind.Eof:
            break
        while p.eat(TokenKind.Newline):
            nil
        if p.peek() == TokenKind.Dedent or p.peek() == TokenKind.Eof:
            break
        match p.peek():
            TokenKind.Def:
                methods.push(parse_fn_decl(p, false, true))
            TokenKind.Req:
                methods.push(parse_fn_decl(p, false, false))
            TokenKind.Pub:
                p.advance()
                if parser_check(p, "Def"):
                    methods.push(parse_fn_decl(p, true, true))
                elif parser_check(p, "Req"):
                    methods.push(parse_fn_decl(p, true, false))
                else:
                    variants.push(parse_enum_variant(p))
            TokenKind.As:
                # as TypeName: body — parse conversion block
                let eas_line = p.current_line()
                p.advance()
                let econv_ty = parse_type(p)
                let ecan_throw = p.eat(TokenKind.Throws)
                p.expect(TokenKind.Colon)
                let econv_body = parse_fn_body(p)
                enum_conversions.push(AsDecl(is_pub= false, ty= econv_ty, can_throw= ecan_throw, is_task= false, body= econv_body, line= eas_line))
            _:
                variants.push(parse_enum_variant(p))
    p.eat(TokenKind.Dedent)
    EnumDecl(name= name, variants= variants, methods= methods, line= line, is_pub= is_pub, is_native= false, type_params= [], protocols= [], setters= [], conversions= enum_conversions, attrs= [])

def EnumVariant parse_enum_variant(mut Parser p) throws:
    let line = p.current_line()
    let name_tok = p.expect(TokenKind.Ident(""))
    let name = name_tok.text()
    var fields = [VariantField]{}
    if p.eat(TokenKind.LParen):
        while p.peek() != TokenKind.RParen:
            let ty = parse_type(p)
            # Optional field name after type: `Circle(float r)` vs `Circle(float)`
            var string? field_name = nil
            if parser_check(p, "Ident"):
                field_name = parser_expect_ident(p)
            fields.push(VariantField(name= field_name, ty= ty))
            if p.peek() != TokenKind.RParen:
                p.expect(TokenKind.Comma)
        p.expect(TokenKind.RParen)
    while p.eat(TokenKind.Newline):
        nil
    EnumVariant(name= name, fields= fields, line= line, attrs= [])

# Returns true if the current trait method line has a body (colon before newline/dedent)
def bool trait_method_has_body(mut Parser p) throws:
    var i = 0
    var depth = 0
    while true:
        let k = token_kind_name(parser_peek_token_at(p, i).kind)
        if k == "LParen":
            depth += 1
        elif k == "RParen":
            depth -= 1
        elif k == "Colon" and depth == 0:
            return true
        elif k == "Newline" or k == "Dedent" or k == "Eof":
            return false
        i += 1
    false

def Item parse_item(mut Parser p) throws:
    match p.peek():
        TokenKind.Def:
            Item.Fn(parse_fn_decl_auto(p, false, true))
        TokenKind.Req:
            Item.Fn(parse_fn_decl_auto(p, false, false))
        TokenKind.Struct:
            Item.Struct(parse_struct_decl(p, false))
        TokenKind.Enum:
            Item.Enum(parse_enum_decl(p, false))
        TokenKind.Ext:
            # ext TypeName: block — parse as ExtDecl with methods
            p.advance()
            let ext_name_tok = p.expect(TokenKind.Ident(""))
            let ext_name = ext_name_tok.text()
            # skip optional <T> or as Protocol
            if p.eat(TokenKind.Lt):
                while p.peek() != TokenKind.Gt and p.peek() != TokenKind.Eof:
                    p.advance()
                p.eat(TokenKind.Gt)
            if p.eat(TokenKind.As):
                while p.peek() != TokenKind.Colon and p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                    p.advance()
            p.expect(TokenKind.Colon)
            p.expect(TokenKind.Newline)
            p.expect(TokenKind.Indent)
            var ext_methods = [FnDecl]{}
            while p.peek() != TokenKind.Dedent and p.peek() != TokenKind.Eof:
                while p.eat(TokenKind.Newline):
                    nil
                if p.peek() == TokenKind.Dedent or p.peek() == TokenKind.Eof:
                    break
                if parser_check(p, "Def"):
                    ext_methods.push(parse_fn_decl(p, false, true))
                elif parser_check(p, "Req"):
                    ext_methods.push(parse_fn_decl(p, false, false))
                elif parser_check(p, "Pub"):
                    p.advance()
                    if parser_check(p, "Def"):
                        ext_methods.push(parse_fn_decl(p, true, true))
                    elif parser_check(p, "Req"):
                        ext_methods.push(parse_fn_decl(p, true, false))
                    elif parser_check(p, "As"):
                        # pub as TypeName: body — parse as __as__TypeName method
                        let pub_as_line = p.current_line()
                        p.advance()
                        var pub_as_type = ""
                        while p.peek() != TokenKind.Colon and p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                            let t = p.advance()
                            pub_as_type = pub_as_type + t.text()
                        var [Stmt] pub_as_body = []
                        if p.eat(TokenKind.Colon):
                            pub_as_body = parse_fn_body(p)
                        else:
                            p.eat(TokenKind.Newline)
                        let pub_as_name = "__as__" + pub_as_type
                        ext_methods.push(FnDecl(name= pub_as_name, params= [], return_ty= Type.Void, can_throw= false, mutating= false, is_pub= true, body= pub_as_body, line= pub_as_line, qualifier= nil, is_task= false, is_stream= false, stream_capacity= nil, is_native= false, throws_ty= nil, type_params= [], where_clause= [], attrs= []))
                    elif parser_check(p, "Set"):
                        # Skip setter blocks
                        while p.peek() != TokenKind.Colon and p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                            p.advance()
                        if p.eat(TokenKind.Colon):
                            if p.eat(TokenKind.Newline):
                                if p.eat(TokenKind.Indent):
                                    var pd = 1
                                    while pd > 0 and p.peek() != TokenKind.Eof:
                                        if p.peek() == TokenKind.Indent:
                                            pd = pd + 1
                                        elif p.peek() == TokenKind.Dedent:
                                            pd = pd - 1
                                        p.advance()
                            else:
                                while p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                                    p.advance()
                                p.eat(TokenKind.Newline)
                    else:
                        p.advance()
                elif parser_check(p, "As"):
                    # Parse `as TypeName: body` as a special __as__TypeName method
                    let as_conv_line = p.current_line()
                    p.advance()
                    var as_type_name = ""
                    while p.peek() != TokenKind.Colon and p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                        if p.peek() == TokenKind.Ident(""):
                            let tok = p.advance()
                            as_type_name = as_type_name + tok.text()
                        else:
                            let tok = p.advance()
                            as_type_name = as_type_name + tok.text()
                    let conv_method_name = "__as__" + as_type_name
                    var [Stmt] conv_body = []
                    if p.eat(TokenKind.Colon):
                        conv_body = parse_fn_body(p)
                    else:
                        p.eat(TokenKind.Newline)
                    ext_methods.push(FnDecl(name= conv_method_name, params= [], return_ty= Type.Void, can_throw= false, mutating= false, is_pub= false, body= conv_body, line= as_conv_line, qualifier= nil, is_task= false, is_stream= false, stream_capacity= nil, is_native= false, throws_ty= nil, type_params= [], where_clause= [], attrs= []))
                elif parser_check(p, "Set"):
                    # Skip setter blocks: `set field(v): body`
                    while p.peek() != TokenKind.Colon and p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                        p.advance()
                    if p.eat(TokenKind.Colon):
                        if p.eat(TokenKind.Newline):
                            if p.eat(TokenKind.Indent):
                                var d = 1
                                while d > 0 and p.peek() != TokenKind.Eof:
                                    if p.peek() == TokenKind.Indent:
                                        d = d + 1
                                    elif p.peek() == TokenKind.Dedent:
                                        d = d - 1
                                    p.advance()
                        else:
                            while p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                                p.advance()
                            p.eat(TokenKind.Newline)
                else:
                    p.advance()
            p.eat(TokenKind.Dedent)
            Item.Ext(ExtDecl(type_name= ext_name, type_args= [], type_params= [], where_clause= [], traits= [], methods= ext_methods, setters= [], conversions= [], assoc_type_defs= [], line= 0))
        TokenKind.Trait:
            # Parse trait declaration — extract default method implementations
            let trait_line = p.current_line()
            p.advance()
            let trait_name_tok = p.expect(TokenKind.Ident(""))
            let trait_name = trait_name_tok.text()
            # Skip optional generic params and parent traits
            while p.peek() != TokenKind.Colon and p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                p.advance()
            p.expect(TokenKind.Colon)
            p.expect(TokenKind.Newline)
            var trait_defaults = [FnDecl]{}
            if p.eat(TokenKind.Indent):
                while p.peek() != TokenKind.Dedent and p.peek() != TokenKind.Eof:
                    while p.eat(TokenKind.Newline):
                        nil
                    if p.peek() == TokenKind.Dedent or p.peek() == TokenKind.Eof:
                        break
                    if parser_check(p, "Def"):
                        if trait_method_has_body(p):
                            trait_defaults.push(parse_fn_decl(p, false, true))
                        else:
                            while p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                                p.advance()
                            p.eat(TokenKind.Newline)
                    elif parser_check(p, "Req"):
                        if trait_method_has_body(p):
                            trait_defaults.push(parse_fn_decl(p, false, false))
                        else:
                            # Signature-only: skip to newline
                            while p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                                p.advance()
                            p.eat(TokenKind.Newline)
                    elif parser_check(p, "Type"):
                        # Skip associated type declarations: type Output = int
                        while p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                            p.advance()
                        p.eat(TokenKind.Newline)
                    else:
                        while p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                            p.advance()
                        p.eat(TokenKind.Newline)
                p.eat(TokenKind.Dedent)
            Item.Trait(TraitDecl(name= trait_name, parents= [], signatures= [], defaults= trait_defaults, type_signatures= [], type_params= [], assoc_types= [], line= trait_line))
        TokenKind.Stream:
            # `stream RetType Name(params): body` → fn shorthand marked as stream
            p.advance()  # consume stream
            let stream_decl = parse_fn_decl_shorthand(p)
            Item.Fn(FnDecl(name= stream_decl.name, params= stream_decl.params, return_ty= stream_decl.return_ty, can_throw= stream_decl.can_throw, mutating= true, is_pub= false, body= stream_decl.body, line= stream_decl.line, qualifier= nil, is_task= false, is_stream= true, stream_capacity= nil, is_native= false, throws_ty= nil, type_params= [], where_clause= [], attrs= []))
        TokenKind.Task:
            # `task TYPE Name(params): body` → function decl; `task: expr` → stmt
            let tk1 = token_kind_name(parser_peek_token_at(p, 1).kind)
            let tk2 = token_kind_name(parser_peek_token_at(p, 2).kind)
            # task RETTYPE StructName.method(params): body → ext method
            # task RETTYPE Name(params): body → fn shorthand
            # task def/req ... → fn decl
            # task: expr / task expr → stmt
            if tk1 == "Def" or tk1 == "Req":
                Item.Fn(parse_fn_decl(p, false, true))
            elif tk1 == "Ident" or tk1 == "Void":
                # Look ahead to find the function name token position
                # task RETTYPE Name( or task RETTYPE StructName.method(
                # tk1=rettype, tk2=name-or-struct
                # If tk2 is Ident/Void: check tk3 for Dot (struct.method) or LParen (fn)
                if tk2 == "Ident":
                    let tk3 = token_kind_name(parser_peek_token_at(p, 3).kind)
                    if tk3 == "Dot":
                        # task RetType StructName.methodName(params): body → ext method
                        let task_item_line = p.current_line()
                        p.advance()  # consume task
                        let task_ret_ty = parse_type(p)
                        let task_struct_name = parser_expect_ident(p)
                        p.advance()  # consume dot
                        let task_method_name = parser_expect_ident(p)
                        var [Param] task_params = []
                        p.expect(TokenKind.LParen)
                        while p.peek() != TokenKind.RParen and p.peek() != TokenKind.Eof:
                            task_params.push(parse_param(p))
                            if p.peek() != TokenKind.RParen:
                                p.eat(TokenKind.Comma)
                        p.expect(TokenKind.RParen)
                        let task_can_throw = p.eat(TokenKind.Throws)
                        if task_can_throw:
                            parser_eat(p, "Ident")
                        p.expect(TokenKind.Colon)
                        let task_body = parse_fn_body(p)
                        let task_method = FnDecl(name= task_method_name, params= task_params, return_ty= task_ret_ty, can_throw= task_can_throw, mutating= true, is_pub= false, body= task_body, line= task_item_line, qualifier= nil, is_task= true, is_stream= false, stream_capacity= nil, is_native= false, throws_ty= nil, type_params= [], where_clause= [], attrs= [])
                        Item.Ext(ExtDecl(type_name= task_struct_name, type_args= [], type_params= [], where_clause= [], traits= [], methods= [task_method], setters= [], conversions= [], assoc_type_defs= [], line= task_item_line))
                    elif tk3 == "LParen" or tk3 == "Colon" or tk3 == "Throws":
                        p.advance()  # consume task
                        Item.Fn(parse_fn_decl_shorthand(p))
                    else:
                        Item.Stmt(parse_stmt(p))
                elif tk2 == "LParen":
                    # task Name(params): body — void return task fn
                    # Distinguish from `task expr()` call by checking if `)` is followed by `:`
                    var scan_i = 3
                    var scan_depth = 1
                    while scan_depth > 0 and scan_i < 40:
                        let scan_k = token_kind_name(parser_peek_token_at(p, scan_i).kind)
                        if scan_k == "LParen": scan_depth = scan_depth + 1
                        elif scan_k == "RParen": scan_depth = scan_depth - 1
                        scan_i = scan_i + 1
                    let after_rparen = token_kind_name(parser_peek_token_at(p, scan_i).kind)
                    if after_rparen == "Colon" or after_rparen == "Throws":
                        # It's a function declaration: `task run():` or `task run() throws:`
                        let void_task_line = p.current_line()
                        p.advance()  # consume task
                        let void_task_name = parser_expect_ident(p)
                        var [Param] void_task_params = []
                        p.expect(TokenKind.LParen)
                        while p.peek() != TokenKind.RParen and p.peek() != TokenKind.Eof:
                            void_task_params.push(parse_param(p))
                            if p.peek() != TokenKind.RParen:
                                p.eat(TokenKind.Comma)
                        p.expect(TokenKind.RParen)
                        let void_task_throw = p.eat(TokenKind.Throws)
                        if void_task_throw:
                            parser_eat(p, "Ident")
                        p.expect(TokenKind.Colon)
                        let void_task_body = parse_fn_body(p)
                        Item.Fn(FnDecl(name= void_task_name, params= void_task_params, return_ty= Type.Void, can_throw= void_task_throw, mutating= true, is_pub= false, body= void_task_body, line= void_task_line, qualifier= nil, is_task= true, is_stream= false, stream_capacity= nil, is_native= false, throws_ty= nil, type_params= [], where_clause= [], attrs= []))
                    else:
                        Item.Stmt(parse_stmt(p))
                else:
                    Item.Stmt(parse_stmt(p))
            else:
                Item.Stmt(parse_stmt(p))
        TokenKind.Type:
            # type Name as BaseType — create a struct wrapper
            let nt_line = p.current_line()
            p.advance()
            let nt_name_tok = p.expect(TokenKind.Ident(""))
            let nt_name = nt_name_tok.text()
            p.expect(TokenKind.As)
            let nt_base_ty = parse_type(p)
            while p.eat(TokenKind.Newline):
                nil
            let nt_field = FieldDecl(name= "value", is_pub= true, ty= nt_base_ty, mutable= false, is_transient= false, default= nil, line= nt_line)
            Item.Struct(StructDecl(name= nt_name, fields= [nt_field], methods= [], inits= [], line= nt_line, is_pub= false, is_native= false, protocols= [], conversions= [], type_params= [], where_clause= [], setters= [], type_methods= [], type_vars= [], assoc_type_defs= [], attrs= []))
        TokenKind.Use:
            p.advance()
            # `use Name as Type` → alias; otherwise skip the line
            let use_is_alias = parser_token_at_offset_is(p, 1, "As")
            if use_is_alias:
                # Only parse as simple named-type alias (Ident after `as`), not func-type aliases (req/task/def)
                let k_after_as = token_kind_name(parser_peek_token_at(p, 2).kind)
                if k_after_as == "Ident":
                    let alias_decl = parse_alias_decl(p)
                    Item.Alias(alias_decl)
                else:
                    while p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                        p.advance()
                    Item.Stmt(Stmt.Expr(Expr(kind= ExprKind.Nil, line= 0)))
            else:
                while p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                    p.advance()
                Item.Stmt(Stmt.Expr(Expr(kind= ExprKind.Nil, line= 0)))
        TokenKind.Pub:
            p.advance()
            if parser_check(p, "Struct"):
                Item.Struct(parse_struct_decl(p, true))
            elif parser_check(p, "Enum"):
                Item.Enum(parse_enum_decl(p, true))
            elif parser_check(p, "Def"):
                Item.Fn(parse_fn_decl_auto(p, true, true))
            elif parser_check(p, "Req"):
                Item.Fn(parse_fn_decl_auto(p, true, false))
            else:
                Item.Stmt(parse_stmt(p))
        TokenKind.Lt:
            # `<Protocol> fnName(params): body` — protocol-constrained return type
            # Consume <...> and parse the rest as a normal function shorthand
            p.advance()
            while p.peek() != TokenKind.Gt and p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                p.advance()
            p.eat(TokenKind.Gt)
            # Now we're at fnName — parse as fn shorthand if possible
            if parser_is_fn_shorthand(p):
                Item.Fn(parse_fn_shorthand(p))
            elif parser_check(p, "Ident") and parser_token_at_offset_is(p, 1, "LParen"):
                # `<Protocol> fnName(params): body` — parse fnName(params): body directly
                let lt_fn_line = p.current_line()
                let lt_fn_name = parser_expect_ident(p)
                var [Param] lt_params = []
                p.expect(TokenKind.LParen)
                while p.peek() != TokenKind.RParen and p.peek() != TokenKind.Eof:
                    lt_params.push(parse_param(p))
                    if p.peek() != TokenKind.RParen:
                        p.eat(TokenKind.Comma)
                p.expect(TokenKind.RParen)
                let lt_can_throw = p.eat(TokenKind.Throws)
                p.expect(TokenKind.Colon)
                let lt_body = parse_fn_body(p)
                Item.Fn(FnDecl(name= lt_fn_name, params= lt_params, return_ty= Type.Void, can_throw= lt_can_throw, mutating= true, is_pub= false, body= lt_body, line= lt_fn_line, qualifier= nil, is_task= false, is_stream= false, stream_capacity= nil, is_native= false, throws_ty= nil, type_params= [], where_clause= [], attrs= []))
            else:
                # Skip the rest of the line
                while p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                    p.advance()
                p.eat(TokenKind.Newline)
                if p.peek() == TokenKind.Indent:
                    p.advance()
                    var depth = 1
                    while depth > 0 and p.peek() != TokenKind.Eof:
                        if p.peek() == TokenKind.Indent:
                            depth = depth + 1
                        elif p.peek() == TokenKind.Dedent:
                            depth = depth - 1
                        p.advance()
                Item.Stmt(Stmt.Expr(Expr(kind= ExprKind.Nil, line= 0)))
        _:
            # Detect fn shorthand: `RetType FnName(` or `[RetType] FnName(`
            if parser_is_fn_shorthand(p):
                Item.Fn(parse_fn_shorthand(p))
            else:
                Item.Stmt(parse_stmt(p))

def FnDecl parse_fn_decl_auto(mut Parser p, bool is_pub, bool is_def) throws:
    # Like parse_fn_decl but supports inline body (e.g. `def int f(): expr`)
    let line = p.current_line()
    var mutating = true
    if p.eat(TokenKind.Req):
        mutating = false
    else:
        p.expect(TokenKind.Def)
    var return_ty = Type.Void
    var has_ret = false
    match p.peek():
        TokenKind.Ident(_):
            let next1 = token_kind_name(parser_peek_token_at(p, 1).kind)
            if token_is_fn_name_like(next1):
                has_ret = true
            elif next1 == "Ampersand":
                let next2 = token_kind_name(parser_peek_token_at(p, 2).kind)
                if token_is_fn_name_like(next2):
                    has_ret = true
            elif next1 == "Question":
                let next2 = token_kind_name(parser_peek_token_at(p, 2).kind)
                has_ret = token_is_fn_name_like(next2) or next2 == "LParen"
            elif next1 == "Lt":
                # Generic return type: `Result<int, string> name(` — scan past `<...>`
                var gi = 2
                var gd = 1
                while gd > 0 and gi < 50:
                    let gk = token_kind_name(parser_peek_token_at(p, gi).kind)
                    if gk == "Lt": gd = gd + 1
                    elif gk == "Gt": gd = gd - 1
                    elif gk == "Eof": gd = -1
                    gi = gi + 1
                if gd == 0:
                    let after_gt = token_kind_name(parser_peek_token_at(p, gi).kind)
                    if token_is_fn_name_like(after_gt):
                        has_ret = true
        TokenKind.Void:     has_ret = true
        TokenKind.LBracket: has_ret = true
        TokenKind.LBrace:   has_ret = true
        TokenKind.LParen:   has_ret = true
        _: nil
    if has_ret:
        return_ty = parse_type(p)
    let name = parser_expect_ident_or_keyword(p)
    # Skip optional generic type params: <A, B, ...>
    if p.eat(TokenKind.Lt):
        while p.peek() != TokenKind.Gt and p.peek() != TokenKind.Eof:
            p.advance()
        p.eat(TokenKind.Gt)
    var [Param] params = []
    p.expect(TokenKind.LParen)
    while p.peek() != TokenKind.RParen:
        params.push(parse_param(p))
        if p.peek() != TokenKind.RParen:
            p.expect(TokenKind.Comma)
    p.expect(TokenKind.RParen)
    let can_throw = p.eat(TokenKind.Throws)
    if can_throw:
        parser_eat(p, "Ident")
    p.expect(TokenKind.Colon)
    let body = parse_fn_body(p)
    FnDecl(name= name, params= params, return_ty= return_ty, can_throw= can_throw, mutating= mutating, is_pub= is_pub, body= body, line= line, qualifier= nil, is_task= false, is_stream= false, stream_capacity= nil, is_native= false, throws_ty= nil, type_params= [], where_clause= [], attrs= [])

def Program parse_program(mut Parser p) throws:
    var items = [Item]{}
    while p.eat(TokenKind.Newline):
        nil
    while p.peek() != TokenKind.Eof:
        items.push(parse_item(p))
        while p.eat(TokenKind.Newline):
            nil
    Program(items= items)

# ── Entry point ───────────────────────────────────────────────────────────────

def Program parse(string source) throws:
    let toks = lex(source)
    mut p'actor = Parser(tokens= toks, pos= 0, allow_noparen_closure= true, allow_trailing_closure= true)
    parse_program(p)
# ── AST builder helpers ────────────────────────────────────────────────────────

struct ThrowsTask:
    bool can_throw
    bool is_task

def Stmt stmt_expr(Expr expr, int line):
    Stmt.Expr(expr)

def Stmt stmt_fn(FnDecl decl):
    Stmt.Fn(decl)

def Expr make_var_expr(string name, int line):
    Expr(kind= ExprKind.Var(name), line= line)

def Expr make_binop(string op_name, Expr left, Expr right, int line):
    let op = match op_name:
        "Add": BinOp.Add
        "Plus": BinOp.Add
        "Sub": BinOp.Sub
        "Minus": BinOp.Sub
        "Mul": BinOp.Mul
        "Star": BinOp.Mul
        "Div": BinOp.Div
        "Slash": BinOp.Div
        "Rem": BinOp.Rem
        "Percent": BinOp.Rem
        "Eq": BinOp.Eq
        "EqEq": BinOp.Eq
        "NotEq": BinOp.NotEq
        "BangEq": BinOp.NotEq
        "Lt": BinOp.Lt
        "Gt": BinOp.Gt
        "LtEq": BinOp.LtEq
        "GtEq": BinOp.GtEq
        "And": BinOp.And
        "Or": BinOp.Or
        "BitAnd": BinOp.BitAnd
        "Ampersand": BinOp.BitAnd
        "BitOr": BinOp.BitOr
        "Pipe": BinOp.BitOr
        "BitXor": BinOp.BitXor
        "Caret": BinOp.BitXor
        "Shl": BinOp.Shl
        "LtLt": BinOp.Shl
        "Shr": BinOp.Shr
        "GtGt": BinOp.Shr
        "Is": BinOp.Is
        "IsNot": BinOp.IsNot
        "Mod": BinOp.Rem
        "Percent": BinOp.Rem
        "RefEq": BinOp.RefEq
        _: throw "unknown binary operator: {op_name}"
    Expr(kind= ExprKind.BinOp(op, left, right), line= line)

def Expr make_unary(string op_name, Expr expr, int line):
    let op = match op_name:
        "Neg": UnaryOp.Neg
        "Not": UnaryOp.Not
        _: UnaryOp.BitNot
    Expr(kind= ExprKind.UnaryOp(op, expr), line= line)

def Expr make_assign(Expr target, Expr value, int line):
    Expr(kind= ExprKind.Assign(target, value), line= line)

def Expr make_question_assign(Expr target, Expr value, int line):
    Expr(kind= ExprKind.QuestionAssign(target, value), line= line)

def Arg make_arg(string? label, Expr value, bool spread):
    Arg(label= label, value= value, spread= spread)

def Expr make_call(Expr callee, [Arg] args, int line):
    Expr(kind= ExprKind.Call(callee, args), line= line)

def Expr make_method_call(Expr receiver, string name, [Arg] args, int line):
    Expr(kind= ExprKind.MethodCall(receiver, name, args), line= line)

def Expr make_closure([Param] params, Type? return_ty, ClosureBody body, bool can_throw, bool is_task, int line):
    Expr(kind= ExprKind.Closure(params, return_ty, body, can_throw, is_task), line= line)

def ClosureBody closure_body_block([Stmt] stmts):
    ClosureBody.Block(stmts)

def ClosureBody closure_body_expr(Expr expr):
    ClosureBody.Expr(expr)

def (bool, ClosureBody) closure_body_is_block(ClosureBody body):
    match body:
        ClosureBody.Block(stmts): (true, ClosureBody.Block(stmts))
        ClosureBody.Expr(e): (false, ClosureBody.Expr(e))

def Expr make_else_expr(Expr expr, Expr default, int line):
    Expr(kind= ExprKind.Else(expr, default), line= line)

def Expr make_do_expr([Stmt] stmts, int line):
    Expr(kind= ExprKind.Do(stmts), line= line)

def LetStmt make_let_stmt(bool mutable, bool is_pub, bool is_static, string name, Type? ty, Expr? value, int line):
    LetStmt(
        mutable: mutable,
        is_pub: is_pub,
        is_static: is_static,
        is_lazy: false,
        name: name,
        ty: ty,
        value: value,
        line: line
    )

def Param make_param(string name, Type? ty, bool mutable):
    Param(name= name, ty= ty, mutable= mutable, owned= false, variadic= false, default= nil, line= 0)

def FieldDecl make_field(string name, Type ty, bool mutable, Expr? default, int line):
    FieldDecl(name= name, is_pub= false, ty= ty, mutable= mutable, is_transient= false, default= default, line= line)

def (ThrowsTask, ClosureBody) infer_throws_task(ClosureBody body):
    var bool can_throw = false
    var bool is_task = false
    let ret_body = match body:
        ClosureBody.Block(stmts):
            for stmt in stmts:
                match stmt:
                    Stmt.Throw(_): can_throw = true
                    _: nil
            ClosureBody.Block(stmts)
        ClosureBody.Expr(e):
            ClosureBody.Expr(e)
    let tt = ThrowsTask(can_throw= can_throw, is_task= is_task)
    return (tt, ret_body)

def Expr make_try_else_block([Stmt] try_stmts, [Stmt] else_stmts, int line):
    Expr(kind= ExprKind.TryElseBlock(try_stmts, else_stmts), line= line)

def StringSegment segment_lit(string text):
    StringSegment.Lit(text)

def void check_no_return([Stmt] stmts, string context):
    for stmt in stmts:
        match stmt:
            Stmt.Return(_):
                throw "return not allowed in {context}"
            _: nil

