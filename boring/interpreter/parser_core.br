# == PARSER CORE ==

# ── Parser struct ─────────────────────────────────────────────────────────────

struct Parser:
    [Token] tokens
    var int pos
    var bool allow_noparen_closure = true
    var bool allow_trailing_closure = true

    req TokenKind peek():
        self.tokens[self.pos].kind

    req TokenKind peek2():
        let next = self.pos + 1
        if next < self.tokens.length:
            self.tokens[next].kind
        else:
            TokenKind.Eof

    def Token advance():
        let t = self.tokens[self.pos]
        if self.pos + 1 < self.tokens.length:
            self.pos = self.pos + 1
        t

    def bool eat(TokenKind k):
        if self.peek() == k:
            self.advance()
            true
        else:
            false

    def Token expect(TokenKind k) throws:
        if token_kind_name(self.peek()) == token_kind_name(k):
            return self.advance()
        throw "expected {token_kind_name(k)}, got {token_kind_name(self.peek())}"

    req bool at_end():
        self.peek() == TokenKind.Eof

    req int current_line():
        self.tokens[self.pos].line

# ── Parser helpers ────────────────────────────────────────────────────────────

def string token_kind_name(TokenKind k):
    match k:
        TokenKind.Int(_): "Int"
        TokenKind.Float(_): "Float"
        TokenKind.Str(_): "Str"
        TokenKind.StringInterp(_): "StringInterp"
        TokenKind.Bool(_): "Bool"
        TokenKind.Nil: "Nil"
        TokenKind.Ident(_): "Ident"
        TokenKind.Let: "Let"
        TokenKind.Lazy: "Lazy"
        TokenKind.Var: "Var"
        TokenKind.Def: "Def"
        TokenKind.Return: "Return"
        TokenKind.If: "If"
        TokenKind.Elif: "Elif"
        TokenKind.Else: "Else"
        TokenKind.Match: "Match"
        TokenKind.While: "While"
        TokenKind.Do: "Do"
        TokenKind.Loop: "Loop"
        TokenKind.Wait: "Wait"
        TokenKind.For: "For"
        TokenKind.In: "In"
        TokenKind.Break: "Break"
        TokenKind.Continue: "Continue"
        TokenKind.Struct: "Struct"
        TokenKind.Enum: "Enum"
        TokenKind.Trait: "Trait"
        TokenKind.Use: "Use"
        TokenKind.Ext: "Ext"
        TokenKind.As: "As"
        TokenKind.And: "And"
        TokenKind.Or: "Or"
        TokenKind.Not: "Not"
        TokenKind.Is: "Is"
        TokenKind.SelfKw: "SelfKw"
        TokenKind.Throw: "Throw"
        TokenKind.Throws: "Throws"
        TokenKind.Try: "Try"
        TokenKind.Catch: "Catch"
        TokenKind.Defer: "Defer"
        TokenKind.Void: "Void"
        TokenKind.Pub: "Pub"
        TokenKind.Guard: "Guard"
        TokenKind.Task: "Task"
        TokenKind.Join: "Join"
        TokenKind.Stream: "Stream"
        TokenKind.Yield: "Yield"
        TokenKind.Static: "Static"
        TokenKind.Type: "Type"
        TokenKind.Req: "Req"
        TokenKind.Transient: "Transient"
        TokenKind.With: "With"
        TokenKind.Get: "Get"
        TokenKind.Set: "Set"
        TokenKind.Init: "Init"
        TokenKind.Pass: "Pass"
        TokenKind.Native: "Native"
        TokenKind.Mod: "Mod"
        TokenKind.Plus: "Plus"
        TokenKind.Minus: "Minus"
        TokenKind.Star: "Star"
        TokenKind.Slash: "Slash"
        TokenKind.Percent: "Percent"
        TokenKind.Eq: "Eq"
        TokenKind.EqEq: "EqEq"
        TokenKind.EqEqEq: "EqEqEq"
        TokenKind.BangEq: "BangEq"
        TokenKind.Lt: "Lt"
        TokenKind.Gt: "Gt"
        TokenKind.LtEq: "LtEq"
        TokenKind.GtEq: "GtEq"
        TokenKind.Dot: "Dot"
        TokenKind.DotDot: "DotDot"
        TokenKind.DotDotEq: "DotDotEq"
        TokenKind.DotDotDot: "DotDotDot"
        TokenKind.Question: "Question"
        TokenKind.QuestionDot: "QuestionDot"
        TokenKind.Bang: "Bang"
        TokenKind.Tick: "Tick"
        TokenKind.Ampersand: "Ampersand"
        TokenKind.Pipe: "Pipe"
        TokenKind.Caret: "Caret"
        TokenKind.Tilde: "Tilde"
        TokenKind.PlusEq: "PlusEq"
        TokenKind.MinusEq: "MinusEq"
        TokenKind.StarEq: "StarEq"
        TokenKind.SlashEq: "SlashEq"
        TokenKind.PercentEq: "PercentEq"
        TokenKind.AmpersandEq: "AmpersandEq"
        TokenKind.PipeEq: "PipeEq"
        TokenKind.CaretEq: "CaretEq"
        TokenKind.QuestionEq: "QuestionEq"
        TokenKind.PipeArrow: "PipeArrow"
        TokenKind.LParen: "LParen"
        TokenKind.RParen: "RParen"
        TokenKind.LBracket: "LBracket"
        TokenKind.RBracket: "RBracket"
        TokenKind.LBrace: "LBrace"
        TokenKind.RBrace: "RBrace"
        TokenKind.Comma: "Comma"
        TokenKind.Colon: "Colon"
        TokenKind.At: "At"
        TokenKind.Newline: "Newline"
        TokenKind.Semicolon: "Semicolon"
        TokenKind.Indent: "Indent"
        TokenKind.Dedent: "Dedent"
        TokenKind.Eof: "Eof"
        TokenKind.Comment(_): "Comment"

def bool parser_check(mut Parser p, string name):
    token_kind_name(p.peek()) == name

def bool parser_check2(mut Parser p, string name):
    token_kind_name(p.peek2()) == name

def Token parser_advance(mut Parser p) throws:
    p.advance()

def bool parser_eat(mut Parser p, string name) throws:
    if parser_check(p, name):
        p.advance()
        return true
    return false

def Token parser_expect(mut Parser p, string name) throws:
    if parser_check(p, name):
        return p.advance()
    throw "expected {name}, got {token_kind_name(p.peek())}"

def string parser_expect_ident(mut Parser p) throws:
    if parser_check(p, "Ident"):
        return p.advance().text()
    throw "expected identifier, got {token_kind_name(p.peek())}"

def string parser_expect_ident_or_keyword(mut Parser p) throws:
    let k = p.peek()
    let name = token_kind_name(k)
    if name == "Ident" or name == "Let" or name == "Var" or name == "Def" or name == "Return" or name == "If" or name == "For" or name == "While" or name == "Match" or name == "Type" or name == "Set" or name == "Get" or name == "In" or name == "Is" or name == "As" or name == "Mod" or name == "Nil":
        return p.advance().text()
    throw "expected identifier or keyword, got {name}"

def bool parser_peek_is_ident(mut Parser p):
    parser_check(p, "Ident")

def bool parser_peek_is_int(mut Parser p):
    parser_check(p, "Int")

def bool parser_is_newline(mut Parser p):
    parser_check(p, "Newline") or parser_check(p, "Semicolon")

def int parser_line(mut Parser p):
    p.current_line()

def int parser_pos(mut Parser p):
    p.pos

def void parser_set_pos(mut Parser p, int pos):
    p.pos = pos

def void parser_skip_newlines(mut Parser p) throws:
    while parser_check(p, "Newline") or parser_check(p, "Semicolon"):
        p.advance()
        nil

def void parser_skip_newlines_and_indent(mut Parser p) throws:
    while parser_check(p, "Newline") or parser_check(p, "Indent") or parser_check(p, "Semicolon"):
        p.advance()
        nil

def void parser_expect_newline(mut Parser p) throws:
    if parser_check(p, "Newline") or parser_check(p, "Semicolon") or parser_check(p, "Eof"):
        if not parser_check(p, "Eof"):
            p.advance()
    else:
        throw "expected newline, got {token_kind_name(p.peek())}"

def void parser_expect_newline_soft(mut Parser p) throws:
    if parser_check(p, "Newline") or parser_check(p, "Semicolon"):
        p.advance()
        nil

def string parser_peek_ident(mut Parser p):
    match p.peek():
        TokenKind.Ident(name): name
        _: ""

def int parser_peek_int(mut Parser p):
    match p.peek():
        TokenKind.Int(n): n
        _: 0

def float parser_peek_float(mut Parser p):
    match p.peek():
        TokenKind.Float(f): f
        _: 0.0

def string parser_peek_str(mut Parser p):
    match p.peek():
        TokenKind.Str(s): s
        _: ""

def bool parser_peek_bool(mut Parser p):
    match p.peek():
        TokenKind.Bool(b): b
        _: false

def [RawInterpPart] parser_peek_interp_parts(mut Parser p):
    match p.peek():
        TokenKind.StringInterp(parts): parts
        _: []

def string parser_peek_comment(mut Parser p):
    match p.peek():
        TokenKind.Comment(text): text
        _: ""

def Token parser_peek_token_at(mut Parser p, int offset):
    let idx = p.pos + offset
    if idx < p.tokens.length:
        p.tokens[idx]
    else:
        Token(kind: TokenKind.Eof, line: 0)

def bool parser_token_at_is_eq(mut Parser p, int offset):
    token_kind_name(parser_peek_token_at(p, offset).kind) == "Eq"

def bool parser_token_at_offset_is(mut Parser p, int offset, string name):
    token_kind_name(parser_peek_token_at(p, offset).kind) == name

def void parser_skip_to_offset(mut Parser p, int offset) throws:
    p.pos = p.pos + offset

def bool parser_peek_next_is(mut Parser p, string name):
    parser_check2(p, name)

def bool parser_peek_next_is_colon(mut Parser p):
    parser_check2(p, "Colon")

def bool parser_peek_next_is_qualifier(mut Parser p):
    let n = token_kind_name(p.peek2())
    n == "Tick" or n == "Ampersand"

def bool parser_peek_is_macro_call(mut Parser p):
    false

def bool parser_peek_is_generic_call(mut Parser p):
    false

def bool parser_peek_is_trailing_closure(mut Parser p):
    false

def bool parser_peek_is_trailing_body_no_colon(mut Parser p) throws:
    false

def bool parser_peek_is_trailing_closure_no_paren(mut Parser p):
    false

def bool parser_peek_is_typed_closure(mut Parser p) throws:
    false

def bool parser_peek_starts_expr(mut Parser p) throws:
    let name = token_kind_name(p.peek())
    name == "Int" or name == "Float" or name == "Str" or name == "StringInterp" or name == "Bool" or name == "Nil" or name == "Ident" or name == "LParen" or name == "LBracket" or name == "LBrace" or name == "Not" or name == "Minus" or name == "SelfKw"

def bool parser_allow_noparen_closure(mut Parser p) throws:
    p.allow_noparen_closure

def bool parser_get_allow_noparen_closure(mut Parser p) throws:
    p.allow_noparen_closure

def bool parser_get_allow_trailing_closure(mut Parser p) throws:
    p.allow_trailing_closure

def void parser_set_allow_noparen_closure(mut Parser p, bool v) throws:
    p.allow_noparen_closure = v

def void parser_set_allow_trailing_closure(mut Parser p, bool v) throws:
    p.allow_trailing_closure = v

def int parser_depth(mut Parser p) throws:
    0

def void parser_depth_inc(mut Parser p) throws:
    nil

def void parser_depth_dec(mut Parser p) throws:
    nil

def bool parser_is_type_start_before_ident(mut Parser p):
    # returns true when current tokens look like "Type Ident" (typed binding)
    let k0 = token_kind_name(parser_peek_token_at(p, 0).kind)
    let k1 = token_kind_name(parser_peek_token_at(p, 1).kind)
    if k0 == "LBracket" or k0 == "LBrace":
        return true
    if k0 != "Ident":
        return false
    if k1 == "Ident":
        return true
    if k1 == "Question":
        let k2 = token_kind_name(parser_peek_token_at(p, 2).kind)
        return k2 == "Ident"
    if k1 == "Tick":
        # T'qual Ident or T'? Ident
        let k2 = token_kind_name(parser_peek_token_at(p, 2).kind)
        if k2 == "Ident":
            let k3 = token_kind_name(parser_peek_token_at(p, 3).kind)
            return k3 == "Ident"
        if k2 == "Question":
            let k3 = token_kind_name(parser_peek_token_at(p, 3).kind)
            return k3 == "Ident"
        return false
    false

def bool parser_is_let_destructure(mut Parser p) throws:
    # At let/var/static. Check for `let x, y = ...` or `let (x, y) = ...`
    if parser_token_at_offset_is(p, 1, "LParen"):
        return true
    # `let x, ...` - ident then comma
    parser_token_at_offset_is(p, 1, "Ident") and parser_token_at_offset_is(p, 2, "Comma")

def bool parser_is_for_with_vars(mut Parser p) throws:
    # returns true when the for loop has explicit variable bindings: `for x in arr:`
    # check: Ident followed by In or Comma (multi-var: `for i, v in arr:`)
    if not parser_check(p, "Ident"):
        return false
    parser_token_at_offset_is(p, 1, "In") or parser_token_at_offset_is(p, 1, "Comma")

def bool parser_is_task_fn_shorthand(mut Parser p) throws:
    false

def bool parser_is_fn_shorthand(mut Parser p) throws:
    # Detect: `RetType FnName(TypedParams...):`
    # We need to distinguish `int add(int a, int b):` from `print foo(42)`
    # Key: after `(`, params should start with a type-ident followed by another ident,
    # or the parens should be empty AND followed by colon.
    # Pattern: Ident Ident LParen ...
    if parser_token_at_offset_is(p, 0, "Ident") and parser_token_at_offset_is(p, 1, "Ident") and parser_token_at_offset_is(p, 2, "LParen"):
        # Check inside parens: empty parens → might be decl if followed by colon
        if parser_token_at_offset_is(p, 3, "RParen"):
            return parser_token_at_offset_is(p, 4, "Colon") or parser_token_at_offset_is(p, 4, "Throws")
        # Non-empty: first token after ( must be type (Ident, [, or {) followed by Ident
        let p0 = token_kind_name(parser_peek_token_at(p, 3).kind)
        let p1 = token_kind_name(parser_peek_token_at(p, 4).kind)
        if p0 == "Ident" and p1 == "Ident": return true
        # [type] param — p1 must be Ident (type name), not a literal
        if p0 == "LBracket" and p1 == "Ident": return true
        if p0 == "LBrace" and p1 == "Ident": return true
        return false
    # Pattern: [ ... ] Ident LParen → array return type
    if parser_token_at_offset_is(p, 0, "LBracket"):
        var depth = 0
        var i = 0
        var found = false
        while i < 20 and not found:
            let tok = token_kind_name(parser_peek_token_at(p, i).kind)
            if tok == "LBracket": depth = depth + 1
            if tok == "RBracket":
                depth = depth - 1
                if depth == 0:
                    found = true
                    if parser_token_at_offset_is(p, i + 1, "Ident") and parser_token_at_offset_is(p, i + 2, "LParen"):
                        let after_lparen = i + 3
                        if parser_token_at_offset_is(p, after_lparen, "RParen"):
                            return parser_token_at_offset_is(p, after_lparen + 1, "Colon")
                        # Params can start with Ident or [ (array type) or { (dict type)
                        let p0 = token_kind_name(parser_peek_token_at(p, after_lparen).kind)
                        let p1 = token_kind_name(parser_peek_token_at(p, after_lparen + 1).kind)
                        if p0 == "Ident" and p1 == "Ident": return true
                        if p0 == "LBracket" and p1 == "Ident": return true
                        if p0 == "LBrace" and p1 == "Ident": return true
                        return false
            if tok == "Eof": return false
            i = i + 1
        return false
    false

def FnDecl parse_fn_shorthand(mut Parser p) throws:
    parse_fn_decl_shorthand(p)

def bool parser_peek_dot_after_newlines(mut Parser p) throws:
    false

def string parser_peek_debug(mut Parser p) throws:
    token_kind_name(p.peek())

# ── Type parsing ──────────────────────────────────────────────────────────────

def Type parse_type(mut Parser p) throws:
    let base = parse_type_base(p)
    if p.eat(TokenKind.Question):
        Type.Optional(base)
    else:
        parse_type_qualifier(p, base)

def Type parse_type_base(mut Parser p) throws:
    match p.peek():
        TokenKind.Ident(s):
            p.advance()
            match s:
                "int":   Type.Int
                "uint":  Type.Uint
                "float": Type.Float
                "string": Type.Str
                "bool":  Type.Bool
                "void":  Type.Void
                _:       Type.Named(s)
        TokenKind.Void:
            p.advance()
            Type.Void
        TokenKind.LBracket:
            p.advance()
            let inner = parse_type(p)
            if p.eat(TokenKind.Comma):
                if token_kind_name(p.peek()) != "Int":
                    throw "expected integer literal for fixed-size array length"
                let n = parser_peek_int(p)
                p.advance()
                p.expect(TokenKind.RBracket)
                Type.ArrayN(inner, n)
            else:
                p.expect(TokenKind.RBracket)
                Type.Array(inner)
        TokenKind.LBrace:
            p.advance()
            let first = parse_type(p)
            if p.eat(TokenKind.Eq):
                let val = parse_type(p)
                p.expect(TokenKind.RBrace)
                Type.Dict(first, val)
            else:
                p.expect(TokenKind.RBrace)
                Type.Set(first)
        TokenKind.LParen:
            p.advance()
            var types = [Type]{}
            if p.peek() != TokenKind.RParen:
                types.append(parse_type(p))
                while p.eat(TokenKind.Comma):
                    if p.peek() == TokenKind.RParen:
                        break
                    types.append(parse_type(p))
            p.expect(TokenKind.RParen)
            Type.Tuple(types)
        _:
            throw "expected type, got {token_kind_name(p.peek())} at line {p.current_line()}"

# ── Fn / struct / enum / program parsing ─────────────────────────────────────

def FnDecl parse_fn_decl_shorthand(mut Parser p) throws:
    let line = p.current_line()
    let return_ty = parse_type(p)
    let name = parser_expect_ident_or_keyword(p)
    var [Param] params = []
    p.expect(TokenKind.LParen)
    while p.peek() != TokenKind.RParen:
        params.append(parse_param(p))
        if p.peek() != TokenKind.RParen:
            p.expect(TokenKind.Comma)
    p.expect(TokenKind.RParen)
    let can_throw = p.eat(TokenKind.Throws)
    if can_throw:
        parser_eat(p, "Ident")
    p.expect(TokenKind.Colon)
    let body = parse_fn_body(p)
    FnDecl(name: name, params: params, return_ty: return_ty, can_throw: can_throw, mutating: true, is_pub: false, body: body, line: line, qualifier: nil, is_task: false, is_stream: false, stream_capacity: nil, is_native: false, throws_ty: nil, type_params: [], where_clause: [], attrs: [])

def bool token_is_fn_name_like(string n):
    n == "Ident" or n == "Get" or n == "Set" or n == "In" or n == "Mod" or n == "Nil" or n == "Is"

def FnDecl parse_fn_decl(mut Parser p, bool is_pub, bool is_def) throws:
    let line = p.current_line()
    var mutating = true
    if p.eat(TokenKind.Req):
        mutating = false
    else:
        p.expect(TokenKind.Def)
    var return_ty = Type.Void
    var has_ret = false
    match p.peek():
        TokenKind.Ident(_):
            let next1 = token_kind_name(parser_peek_token_at(p, 1).kind)
            if token_is_fn_name_like(next1):
                has_ret = true
            elif next1 == "Question":
                let next2 = token_kind_name(parser_peek_token_at(p, 2).kind)
                has_ret = token_is_fn_name_like(next2) or next2 == "LParen"
        TokenKind.Void:     has_ret = true
        TokenKind.LBracket: has_ret = true
        TokenKind.LBrace:   has_ret = true
        TokenKind.LParen:   has_ret = true
        _: nil
    if has_ret:
        return_ty = parse_type(p)
    let name = parser_expect_ident_or_keyword(p)
    if p.eat(TokenKind.Lt):
        while p.peek() != TokenKind.Gt and p.peek() != TokenKind.Eof:
            p.advance()
        p.eat(TokenKind.Gt)
    var [Param] params = []
    p.expect(TokenKind.LParen)
    while p.peek() != TokenKind.RParen:
        params.append(parse_param(p))
        if p.peek() != TokenKind.RParen:
            p.expect(TokenKind.Comma)
    p.expect(TokenKind.RParen)
    let can_throw = p.eat(TokenKind.Throws)
    if can_throw:
        parser_eat(p, "Ident")
    p.expect(TokenKind.Colon)
    let body = parse_fn_body(p)
    FnDecl(name: name, params: params, return_ty: return_ty, can_throw: can_throw, mutating: mutating, is_pub: is_pub, body: body, line: line, qualifier: nil, is_task: false, is_stream: false, stream_capacity: nil, is_native: false, throws_ty: nil, type_params: [], where_clause: [], attrs: [])

def Param parse_param(mut Parser p) throws:
    let line = p.current_line()
    let mutable = p.eat(TokenKind.Var)
    let base_ty = parse_type(p)
    let ty = parse_type_qualifier(p, base_ty)
    let name_tok = p.expect(TokenKind.Ident(""))
    var Expr? default = nil
    if p.eat(TokenKind.Eq):
        default = parse_expr(p)
    Param(name: name_tok.text(), ty: ty, mutable: mutable, owned: false, variadic: false, default: default, line: line)

def StructDecl parse_struct_decl(mut Parser p, bool is_pub) throws:
    let line = p.current_line()
    p.expect(TokenKind.Struct)
    let name_tok = p.expect(TokenKind.Ident(""))
    let name = name_tok.text()
    p.expect(TokenKind.Colon)
    p.expect(TokenKind.Newline)
    p.expect(TokenKind.Indent)
    var fields = [FieldDecl]{}
    var methods = [FnDecl]{}
    var inits = [InitDecl]{}
    while p.peek() != TokenKind.Dedent:
        if p.peek() == TokenKind.Eof:
            break
        match p.peek():
            TokenKind.Def:
                methods.append(parse_fn_decl(p, false, true))
            TokenKind.Req:
                methods.append(parse_fn_decl(p, false, false))
            TokenKind.Init:
                inits.append(parse_init_decl(p))
            TokenKind.Pub:
                p.advance()
                if parser_check(p, "Def"):
                    methods.append(parse_fn_decl(p, true, true))
                elif parser_check(p, "Req"):
                    methods.append(parse_fn_decl(p, true, false))
                else:
                    # pub let / pub var field
                    let f = parse_field_decl(p)
                    fields.append(FieldDecl(name: f.name, is_pub: true, ty: f.ty, mutable: f.mutable, is_transient: f.is_transient, default: f.default, line: f.line))
            TokenKind.As:
                # as TypeName: block — skip conversion block
                p.advance()
                while p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                    p.advance()
                if p.peek() == TokenKind.Newline:
                    p.advance()
                if p.peek() == TokenKind.Indent:
                    p.advance()
                    var depth = 1
                    while depth > 0 and p.peek() != TokenKind.Eof:
                        if p.peek() == TokenKind.Indent:
                            depth = depth + 1
                        elif p.peek() == TokenKind.Dedent:
                            depth = depth - 1
                        p.advance()
            _:
                fields.append(parse_field_decl(p))
    p.eat(TokenKind.Dedent)
    StructDecl(name: name, fields: fields, methods: methods, inits: inits, line: line, is_pub: is_pub, is_native: false, protocols: [], conversions: [], type_params: [], where_clause: [], setters: [], type_methods: [], type_vars: [], assoc_type_defs: [], attrs: [])

def FieldDecl parse_field_decl(mut Parser p) throws:
    let line = p.current_line()
    # Allow optional `let` or `var` keyword before the type
    var mutable = false
    if p.eat(TokenKind.Var):
        mutable = true
    else:
        p.eat(TokenKind.Let)
    let ty = parse_type(p)
    let name_tok = p.expect(TokenKind.Ident(""))
    var Expr? default = nil
    if p.eat(TokenKind.Eq):
        default = parse_expr(p)
    while p.eat(TokenKind.Newline):
        nil
    FieldDecl(name: name_tok.text(), ty: ty, mutable: mutable, default: default, line: line, is_pub: false, is_transient: false)

def InitDecl parse_init_decl(mut Parser p) throws:
    let line = p.current_line()
    p.expect(TokenKind.Init)
    p.expect(TokenKind.LParen)
    var [InitParam] params = []
    while p.peek() != TokenKind.RParen:
        let par = parse_param(p)
        params.append(InitParam(is_pub: false, mutable: par.mutable, name: par.name, ty: par.ty, default: par.default, line: par.line))
        if p.peek() != TokenKind.RParen:
            p.expect(TokenKind.Comma)
    p.expect(TokenKind.RParen)
    var [Stmt] body = []
    if p.eat(TokenKind.Colon):
        body = parse_block(p)
    else:
        while p.eat(TokenKind.Newline):
            nil
    return InitDecl(params: params, body: body, line: line)

def EnumDecl parse_enum_decl(mut Parser p, bool is_pub) throws:
    let line = p.current_line()
    p.expect(TokenKind.Enum)
    let name_tok = p.expect(TokenKind.Ident(""))
    let name = name_tok.text()
    p.expect(TokenKind.Colon)
    p.expect(TokenKind.Newline)
    p.expect(TokenKind.Indent)
    var variants = [EnumVariant]{}
    var methods = [FnDecl]{}
    while p.peek() != TokenKind.Dedent:
        if p.peek() == TokenKind.Eof:
            break
        match p.peek():
            TokenKind.Def:
                methods.append(parse_fn_decl(p, false, true))
            TokenKind.Req:
                methods.append(parse_fn_decl(p, false, false))
            TokenKind.Pub:
                p.advance()
                if parser_check(p, "Def"):
                    methods.append(parse_fn_decl(p, true, true))
                elif parser_check(p, "Req"):
                    methods.append(parse_fn_decl(p, true, false))
                else:
                    variants.append(parse_enum_variant(p))
            TokenKind.As:
                # as TypeName: block — skip conversion block
                p.advance()
                while p.peek() != TokenKind.Newline and p.peek() != TokenKind.Eof:
                    p.advance()
                if p.peek() == TokenKind.Newline:
                    p.advance()
                if p.peek() == TokenKind.Indent:
                    p.advance()
                    var depth = 1
                    while depth > 0 and p.peek() != TokenKind.Eof:
                        if p.peek() == TokenKind.Indent:
                            depth = depth + 1
                        elif p.peek() == TokenKind.Dedent:
                            depth = depth - 1
                        p.advance()
            _:
                variants.append(parse_enum_variant(p))
    p.eat(TokenKind.Dedent)
    EnumDecl(name: name, variants: variants, methods: methods, line: line, is_pub: is_pub, is_native: false, type_params: [], protocols: [], setters: [], conversions: [], attrs: [])

def EnumVariant parse_enum_variant(mut Parser p) throws:
    let line = p.current_line()
    let name_tok = p.expect(TokenKind.Ident(""))
    let name = name_tok.text()
    var fields = [VariantField]{}
    if p.eat(TokenKind.LParen):
        while p.peek() != TokenKind.RParen:
            let ty = parse_type(p)
            # Optional field name after type: `Circle(float r)` vs `Circle(float)`
            var string? field_name = nil
            if parser_check(p, "Ident"):
                field_name = parser_expect_ident(p)
            fields.append(VariantField(name: field_name, ty: ty))
            if p.peek() != TokenKind.RParen:
                p.expect(TokenKind.Comma)
        p.expect(TokenKind.RParen)
    while p.eat(TokenKind.Newline):
        nil
    EnumVariant(name: name, fields: fields, line: line, attrs: [])

def Item parse_item(mut Parser p) throws:
    match p.peek():
        TokenKind.Def:
            Item.Fn(parse_fn_decl_auto(p, false, true))
        TokenKind.Req:
            Item.Fn(parse_fn_decl_auto(p, false, false))
        TokenKind.Struct:
            Item.Struct(parse_struct_decl(p, false))
        TokenKind.Enum:
            Item.Enum(parse_enum_decl(p, false))
        _:
            # Detect fn shorthand: `RetType FnName(` or `[RetType] FnName(`
            if parser_is_fn_shorthand(p):
                Item.Fn(parse_fn_shorthand(p))
            else:
                Item.Stmt(parse_stmt(p))

def FnDecl parse_fn_decl_auto(mut Parser p, bool is_pub, bool is_def) throws:
    # Like parse_fn_decl but supports inline body (e.g. `def int f(): expr`)
    let line = p.current_line()
    var mutating = true
    if p.eat(TokenKind.Req):
        mutating = false
    else:
        p.expect(TokenKind.Def)
    var return_ty = Type.Void
    var has_ret = false
    match p.peek():
        TokenKind.Ident(_):
            let next1 = token_kind_name(parser_peek_token_at(p, 1).kind)
            if token_is_fn_name_like(next1):
                has_ret = true
            elif next1 == "Question":
                let next2 = token_kind_name(parser_peek_token_at(p, 2).kind)
                has_ret = token_is_fn_name_like(next2) or next2 == "LParen"
        TokenKind.Void:     has_ret = true
        TokenKind.LBracket: has_ret = true
        TokenKind.LBrace:   has_ret = true
        TokenKind.LParen:   has_ret = true
        _: nil
    if has_ret:
        return_ty = parse_type(p)
    let name = parser_expect_ident_or_keyword(p)
    # Skip optional generic type params: <A, B, ...>
    if p.eat(TokenKind.Lt):
        while p.peek() != TokenKind.Gt and p.peek() != TokenKind.Eof:
            p.advance()
        p.eat(TokenKind.Gt)
    var [Param] params = []
    p.expect(TokenKind.LParen)
    while p.peek() != TokenKind.RParen:
        params.append(parse_param(p))
        if p.peek() != TokenKind.RParen:
            p.expect(TokenKind.Comma)
    p.expect(TokenKind.RParen)
    let can_throw = p.eat(TokenKind.Throws)
    if can_throw:
        parser_eat(p, "Ident")
    p.expect(TokenKind.Colon)
    let body = parse_fn_body(p)
    FnDecl(name: name, params: params, return_ty: return_ty, can_throw: can_throw, mutating: mutating, is_pub: is_pub, body: body, line: line, qualifier: nil, is_task: false, is_stream: false, stream_capacity: nil, is_native: false, throws_ty: nil, type_params: [], where_clause: [], attrs: [])

def Program parse_program(mut Parser p) throws:
    var items = [Item]{}
    while p.eat(TokenKind.Newline):
        nil
    while p.peek() != TokenKind.Eof:
        items.append(parse_item(p))
        while p.eat(TokenKind.Newline):
            nil
    Program(items: items)

# ── Entry point ───────────────────────────────────────────────────────────────

def Program parse(string source) throws:
    let toks = lex(source)
    let p'actor = Parser(tokens: toks, pos: 0, allow_noparen_closure: true, allow_trailing_closure: true)
    parse_program(p)
