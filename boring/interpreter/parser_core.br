# == PARSER CORE ==

# ── Parser struct ─────────────────────────────────────────────────────────────

struct Parser:
    [Token] tokens
    int pos

    req TokenKind peek():
        self.tokens[self.pos].kind

    req TokenKind peek2():
        let next = self.pos + 1
        if next < self.tokens.length:
            self.tokens[next].kind
        else:
            TokenKind.Eof

    def Token advance():
        let t = self.tokens[self.pos]
        if self.pos + 1 < self.tokens.length:
            self.pos = self.pos + 1
        t

    def bool eat(TokenKind k):
        if self.peek() == k:
            self.advance()
            true
        else:
            false

    def Token expect(TokenKind k) throws:
        if token_kind_name(self.peek()) == token_kind_name(k):
            return self.advance()
        throw "expected {token_kind_name(k)}, got {token_kind_name(self.peek())}"

    req bool at_end():
        self.peek() == TokenKind.Eof

    req int current_line():
        self.tokens[self.pos].line

# ── Parser helpers ────────────────────────────────────────────────────────────

def string token_kind_name(TokenKind k):
    match k:
        TokenKind.Int(_): "Int"
        TokenKind.Float(_): "Float"
        TokenKind.Str(_): "Str"
        TokenKind.StringInterp(_): "StringInterp"
        TokenKind.Bool(_): "Bool"
        TokenKind.Nil: "Nil"
        TokenKind.Ident(_): "Ident"
        TokenKind.Let: "Let"
        TokenKind.Var: "Var"
        TokenKind.Def: "Def"
        TokenKind.Return: "Return"
        TokenKind.If: "If"
        TokenKind.Elif: "Elif"
        TokenKind.Else: "Else"
        TokenKind.Match: "Match"
        TokenKind.While: "While"
        TokenKind.Do: "Do"
        TokenKind.Loop: "Loop"
        TokenKind.Wait: "Wait"
        TokenKind.For: "For"
        TokenKind.In: "In"
        TokenKind.Break: "Break"
        TokenKind.Continue: "Continue"
        TokenKind.Struct: "Struct"
        TokenKind.Enum: "Enum"
        TokenKind.Trait: "Trait"
        TokenKind.Use: "Use"
        TokenKind.Ext: "Ext"
        TokenKind.As: "As"
        TokenKind.And: "And"
        TokenKind.Or: "Or"
        TokenKind.Not: "Not"
        TokenKind.Is: "Is"
        TokenKind.SelfKw: "SelfKw"
        TokenKind.Throw: "Throw"
        TokenKind.Throws: "Throws"
        TokenKind.Try: "Try"
        TokenKind.Catch: "Catch"
        TokenKind.Defer: "Defer"
        TokenKind.Void: "Void"
        TokenKind.Pub: "Pub"
        TokenKind.Guard: "Guard"
        TokenKind.Task: "Task"
        TokenKind.Join: "Join"
        TokenKind.Stream: "Stream"
        TokenKind.Yield: "Yield"
        TokenKind.Static: "Static"
        TokenKind.Type: "Type"
        TokenKind.Req: "Req"
        TokenKind.Transient: "Transient"
        TokenKind.With: "With"
        TokenKind.Get: "Get"
        TokenKind.Set: "Set"
        TokenKind.Init: "Init"
        TokenKind.Pass: "Pass"
        TokenKind.Native: "Native"
        TokenKind.Mod: "Mod"
        TokenKind.Plus: "Plus"
        TokenKind.Minus: "Minus"
        TokenKind.Star: "Star"
        TokenKind.Slash: "Slash"
        TokenKind.Percent: "Percent"
        TokenKind.Eq: "Eq"
        TokenKind.EqEq: "EqEq"
        TokenKind.EqEqEq: "EqEqEq"
        TokenKind.BangEq: "BangEq"
        TokenKind.Lt: "Lt"
        TokenKind.Gt: "Gt"
        TokenKind.LtEq: "LtEq"
        TokenKind.GtEq: "GtEq"
        TokenKind.Dot: "Dot"
        TokenKind.DotDot: "DotDot"
        TokenKind.DotDotEq: "DotDotEq"
        TokenKind.DotDotDot: "DotDotDot"
        TokenKind.Question: "Question"
        TokenKind.QuestionDot: "QuestionDot"
        TokenKind.Bang: "Bang"
        TokenKind.Tick: "Tick"
        TokenKind.Ampersand: "Ampersand"
        TokenKind.Pipe: "Pipe"
        TokenKind.Caret: "Caret"
        TokenKind.Tilde: "Tilde"
        TokenKind.PlusEq: "PlusEq"
        TokenKind.MinusEq: "MinusEq"
        TokenKind.StarEq: "StarEq"
        TokenKind.SlashEq: "SlashEq"
        TokenKind.PercentEq: "PercentEq"
        TokenKind.AmpersandEq: "AmpersandEq"
        TokenKind.PipeEq: "PipeEq"
        TokenKind.CaretEq: "CaretEq"
        TokenKind.QuestionEq: "QuestionEq"
        TokenKind.PipeArrow: "PipeArrow"
        TokenKind.LParen: "LParen"
        TokenKind.RParen: "RParen"
        TokenKind.LBracket: "LBracket"
        TokenKind.RBracket: "RBracket"
        TokenKind.LBrace: "LBrace"
        TokenKind.RBrace: "RBrace"
        TokenKind.Comma: "Comma"
        TokenKind.Colon: "Colon"
        TokenKind.At: "At"
        TokenKind.Newline: "Newline"
        TokenKind.Semicolon: "Semicolon"
        TokenKind.Indent: "Indent"
        TokenKind.Dedent: "Dedent"
        TokenKind.Eof: "Eof"
        TokenKind.Comment(_): "Comment"

def bool parser_check(var Parser p, string name):
    token_kind_name(p.peek()) == name

def bool parser_check2(var Parser p, string name):
    token_kind_name(p.peek2()) == name

def Token parser_advance(var Parser p) throws:
    p.advance()

def bool parser_eat(var Parser p, string name) throws:
    if parser_check(p, name):
        p.advance()
        return true
    return false

def Token parser_expect(var Parser p, string name) throws:
    if parser_check(p, name):
        return p.advance()
    throw "expected {name}, got {token_kind_name(p.peek())}"

def string parser_expect_ident(var Parser p) throws:
    if parser_check(p, "Ident"):
        return p.advance().text()
    throw "expected identifier, got {token_kind_name(p.peek())}"

def string parser_expect_ident_or_keyword(var Parser p) throws:
    let k = p.peek()
    let name = token_kind_name(k)
    if name == "Ident" or name == "Let" or name == "Var" or name == "Def" or name == "Return" or name == "If" or name == "For" or name == "While" or name == "Match" or name == "Type":
        return p.advance().text()
    throw "expected identifier or keyword, got {name}"

def bool parser_peek_is_ident(var Parser p):
    parser_check(p, "Ident")

def bool parser_peek_is_int(var Parser p):
    parser_check(p, "Int")

def bool parser_is_newline(var Parser p):
    parser_check(p, "Newline") or parser_check(p, "Semicolon")

def int parser_line(var Parser p):
    p.current_line()

def int parser_pos(var Parser p):
    p.pos

def void parser_set_pos(var Parser p, int pos):
    p.pos = pos

def void parser_skip_newlines(var Parser p) throws:
    while parser_check(p, "Newline") or parser_check(p, "Semicolon"):
        p.advance()
        nil

def void parser_skip_newlines_and_indent(var Parser p) throws:
    while parser_check(p, "Newline") or parser_check(p, "Indent") or parser_check(p, "Semicolon"):
        p.advance()
        nil

def void parser_expect_newline(var Parser p) throws:
    if parser_check(p, "Newline") or parser_check(p, "Semicolon") or parser_check(p, "Eof"):
        if not parser_check(p, "Eof"):
            p.advance()
    else:
        throw "expected newline, got {token_kind_name(p.peek())}"

def void parser_expect_newline_soft(var Parser p) throws:
    if parser_check(p, "Newline") or parser_check(p, "Semicolon"):
        p.advance()
        nil

def string parser_peek_ident(var Parser p):
    match p.peek():
        TokenKind.Ident(name): name
        _: ""

def int parser_peek_int(var Parser p):
    match p.peek():
        TokenKind.Int(n): n
        _: 0

def float parser_peek_float(var Parser p):
    match p.peek():
        TokenKind.Float(f): f
        _: 0.0

def string parser_peek_str(var Parser p):
    match p.peek():
        TokenKind.Str(s): s
        _: ""

def bool parser_peek_bool(var Parser p):
    match p.peek():
        TokenKind.Bool(b): b
        _: false

def [RawInterpPart] parser_peek_interp_parts(var Parser p):
    match p.peek():
        TokenKind.StringInterp(parts): parts
        _: []

def string parser_peek_comment(var Parser p):
    match p.peek():
        TokenKind.Comment(text): text
        _: ""

def Token parser_peek_token_at(var Parser p, int offset):
    let idx = p.pos + offset
    if idx < p.tokens.length:
        p.tokens[idx]
    else:
        Token(kind: TokenKind.Eof, line: 0)

def bool parser_token_at_is_eq(var Parser p, int offset):
    token_kind_name(parser_peek_token_at(p, offset).kind) == "Eq"

def bool parser_token_at_offset_is(var Parser p, int offset, string name):
    token_kind_name(parser_peek_token_at(p, offset).kind) == name

def void parser_skip_to_offset(var Parser p, int offset) throws:
    p.pos = p.pos + offset

def bool parser_peek_next_is(var Parser p, string name):
    parser_check2(p, name)

def bool parser_peek_next_is_colon(var Parser p):
    parser_check2(p, "Colon")

def bool parser_peek_next_is_qualifier(var Parser p):
    let n = token_kind_name(p.peek2())
    n == "Tick" or n == "Ampersand"

def bool parser_peek_is_macro_call(var Parser p):
    false

def bool parser_peek_is_generic_call(var Parser p):
    false

def bool parser_peek_is_trailing_closure(var Parser p):
    false

def bool parser_peek_is_trailing_body_no_colon(var Parser p) throws:
    false

def bool parser_peek_is_trailing_closure_no_paren(var Parser p):
    false

def bool parser_peek_is_typed_closure(var Parser p) throws:
    false

def bool parser_peek_starts_expr(var Parser p) throws:
    let name = token_kind_name(p.peek())
    name == "Int" or name == "Float" or name == "Str" or name == "Bool" or name == "Nil" or name == "Ident" or name == "LParen" or name == "LBracket" or name == "LBrace" or name == "Not" or name == "Minus" or name == "SelfKw"

def bool parser_allow_noparen_closure(var Parser p) throws:
    true

def bool parser_get_allow_noparen_closure(var Parser p) throws:
    true

def bool parser_get_allow_trailing_closure(var Parser p) throws:
    true

def void parser_set_allow_noparen_closure(var Parser p, bool v) throws:
    nil

def void parser_set_allow_trailing_closure(var Parser p, bool v) throws:
    nil

def int parser_depth(var Parser p) throws:
    0

def void parser_depth_inc(var Parser p) throws:
    nil

def void parser_depth_dec(var Parser p) throws:
    nil

def bool parser_is_type_start_before_ident(var Parser p):
    false

def bool parser_is_let_destructure(var Parser p) throws:
    false

def bool parser_is_for_with_vars(var Parser p) throws:
    false

def bool parser_is_task_fn_shorthand(var Parser p) throws:
    false

def bool parser_peek_dot_after_newlines(var Parser p) throws:
    false

def string parser_peek_debug(var Parser p) throws:
    token_kind_name(p.peek())

# ── Type parsing ──────────────────────────────────────────────────────────────

def Type parse_type(var Parser p) throws:
    let base = parse_type_base(p)
    if p.eat(TokenKind.Question):
        Type.Optional(base)
    else:
        base

def Type parse_type_base(var Parser p) throws:
    match p.peek():
        TokenKind.Ident(s):
            p.advance()
            match s:
                "int":   Type.Int
                "uint":  Type.Uint
                "float": Type.Float
                "string": Type.Str
                "bool":  Type.Bool
                "void":  Type.Void
                _:       Type.Named(s)
        TokenKind.Void:
            p.advance()
            Type.Void
        TokenKind.LBracket:
            p.advance()
            let inner = parse_type(p)
            p.expect(TokenKind.RBracket)
            Type.Array(inner)
        TokenKind.LBrace:
            p.advance()
            let key = parse_type(p)
            p.expect(TokenKind.Eq)
            let val = parse_type(p)
            p.expect(TokenKind.RBrace)
            Type.Dict(key, val)
        TokenKind.LParen:
            p.advance()
            var types = [Type]{}
            if p.peek() != TokenKind.RParen:
                types.append(parse_type(p))
                while p.eat(TokenKind.Comma):
                    if p.peek() == TokenKind.RParen:
                        break
                    types.append(parse_type(p))
            p.expect(TokenKind.RParen)
            Type.Tuple(types)
        _:
            throw "expected type, got {token_kind_name(p.peek())} at line {p.current_line()}"

# ── Fn / struct / enum / program parsing ─────────────────────────────────────

def FnDecl parse_fn_decl(var Parser p, bool is_pub, bool is_def) throws:
    let line = p.current_line()
    var mutating = true
    if p.eat(TokenKind.Req):
        mutating = false
    else:
        p.expect(TokenKind.Def)
    var return_ty = Type.Void
    var has_ret = false
    match p.peek():
        TokenKind.Ident(_): has_ret = true
        TokenKind.Void:     has_ret = true
        TokenKind.LBracket: has_ret = true
        TokenKind.LBrace:   has_ret = true
        TokenKind.LParen:   has_ret = true
        _: nil
    if has_ret:
        return_ty = parse_type(p)
    let name = p.expect(TokenKind.Ident(""))
    var [Param] params = []
    p.expect(TokenKind.LParen)
    while p.peek() != TokenKind.RParen:
        params.append(parse_param(p))
        if p.peek() != TokenKind.RParen:
            p.expect(TokenKind.Comma)
    p.expect(TokenKind.RParen)
    let can_throw = p.eat(TokenKind.Throws)
    p.expect(TokenKind.Colon)
    let body = parse_block(p)
    FnDecl(name: name.text(), params: params, return_ty: return_ty, can_throw: can_throw, mutating: mutating, is_pub: is_pub, body: body, line: line, qualifier: nil, is_task: false, is_stream: false, stream_capacity: nil, is_native: false, throws_ty: nil, type_params: [], where_clause: [], attrs: [])

def Param parse_param(var Parser p) throws:
    let line = p.current_line()
    let mutable = p.eat(TokenKind.Var)
    let ty = parse_type(p)
    let name_tok = p.expect(TokenKind.Ident(""))
    Param(name: name_tok.text(), ty: ty, mutable: mutable, owned: false, variadic: false, default: nil, line: line)

def StructDecl parse_struct_decl(var Parser p, bool is_pub) throws:
    let line = p.current_line()
    p.expect(TokenKind.Struct)
    let name_tok = p.expect(TokenKind.Ident(""))
    let name = name_tok.text()
    p.expect(TokenKind.Colon)
    p.expect(TokenKind.Newline)
    p.expect(TokenKind.Indent)
    var fields = [FieldDecl]{}
    var methods = [FnDecl]{}
    var inits = [InitDecl]{}
    while p.peek() != TokenKind.Dedent:
        if p.peek() == TokenKind.Eof:
            break
        match p.peek():
            TokenKind.Def:
                methods.append(parse_fn_decl(p, false, true))
            TokenKind.Req:
                methods.append(parse_fn_decl(p, false, false))
            TokenKind.Init:
                inits.append(parse_init_decl(p))
            _:
                fields.append(parse_field_decl(p))
    p.eat(TokenKind.Dedent)
    StructDecl(name: name, fields: fields, methods: methods, inits: inits, line: line, is_pub: is_pub, is_native: false, protocols: [], conversions: [], type_params: [], where_clause: [], setters: [], type_methods: [], type_vars: [], assoc_type_defs: [], attrs: [])

def FieldDecl parse_field_decl(var Parser p) throws:
    let line = p.current_line()
    let mutable = p.eat(TokenKind.Var)
    let ty = parse_type(p)
    let name_tok = p.expect(TokenKind.Ident(""))
    var Expr? default = nil
    if p.eat(TokenKind.Eq):
        default = some(parse_expr(p))
    while p.eat(TokenKind.Newline):
        nil
    FieldDecl(name: name_tok.text(), ty: ty, mutable: mutable, default: default, line: line, is_pub: false, is_transient: false)

def InitDecl parse_init_decl(var Parser p) throws:
    let line = p.current_line()
    p.expect(TokenKind.Init)
    p.expect(TokenKind.LParen)
    var [InitParam] params = []
    while p.peek() != TokenKind.RParen:
        let par = parse_param(p)
        params.append(InitParam(is_pub: false, mutable: par.mutable, name: par.name, ty: par.ty, default: par.default, line: par.line))
        if p.peek() != TokenKind.RParen:
            p.expect(TokenKind.Comma)
    p.expect(TokenKind.RParen)
    var [Stmt] body = []
    if p.eat(TokenKind.Colon):
        body = parse_block(p)
    else:
        while p.eat(TokenKind.Newline):
            nil
    return InitDecl(params: params, body: body, line: line)

def EnumDecl parse_enum_decl(var Parser p, bool is_pub) throws:
    let line = p.current_line()
    p.expect(TokenKind.Enum)
    let name_tok = p.expect(TokenKind.Ident(""))
    let name = name_tok.text()
    p.expect(TokenKind.Colon)
    p.expect(TokenKind.Newline)
    p.expect(TokenKind.Indent)
    var variants = [EnumVariant]{}
    var methods = [FnDecl]{}
    while p.peek() != TokenKind.Dedent:
        if p.peek() == TokenKind.Eof:
            break
        match p.peek():
            TokenKind.Def:
                methods.append(parse_fn_decl(p, false, true))
            TokenKind.Req:
                methods.append(parse_fn_decl(p, false, false))
            _:
                variants.append(parse_enum_variant(p))
    p.eat(TokenKind.Dedent)
    EnumDecl(name: name, variants: variants, methods: methods, line: line, is_pub: is_pub, is_native: false, type_params: [], protocols: [], setters: [], conversions: [], attrs: [])

def EnumVariant parse_enum_variant(var Parser p) throws:
    let line = p.current_line()
    let name_tok = p.expect(TokenKind.Ident(""))
    let name = name_tok.text()
    var fields = [VariantField]{}
    if p.eat(TokenKind.LParen):
        while p.peek() != TokenKind.RParen:
            let ty = parse_type(p)
            fields.append(VariantField(name: nil, ty: ty))
            if p.peek() != TokenKind.RParen:
                p.expect(TokenKind.Comma)
        p.expect(TokenKind.RParen)
    while p.eat(TokenKind.Newline):
        nil
    EnumVariant(name: name, fields: fields, line: line, attrs: [])

def Item parse_item(var Parser p) throws:
    match p.peek():
        TokenKind.Def:
            Item.Fn(parse_fn_decl(p, false, true))
        TokenKind.Req:
            Item.Fn(parse_fn_decl(p, false, false))
        TokenKind.Struct:
            Item.Struct(parse_struct_decl(p, false))
        TokenKind.Enum:
            Item.Enum(parse_enum_decl(p, false))
        _:
            Item.Stmt(parse_stmt(p))

def Program parse_program(var Parser p) throws:
    var items = [Item]{}
    while p.eat(TokenKind.Newline):
        nil
    while p.peek() != TokenKind.Eof:
        items.append(parse_item(p))
        while p.eat(TokenKind.Newline):
            nil
    Program(items: items)

# ── Entry point ───────────────────────────────────────────────────────────────

def Program parse(string source) throws:
    let toks = lex(source)
    var p = Parser(tokens: toks, pos: 0)
    parse_program(p)
# ── AST builder helpers ────────────────────────────────────────────────────────

struct ThrowsTask:
    bool can_throw
    bool is_task

def Stmt stmt_expr(Expr expr, int line):
    Stmt.Expr(expr)

def Stmt stmt_fn(FnDecl decl):
    Stmt.Fn(decl)

def Expr make_var_expr(string name, int line):
    Expr(kind: ExprKind.Var(name), line: line)

def Expr make_binop(string op_name, Expr left, Expr right, int line):
    let op = match op_name:
        "Add": BinOp.Add
        "Plus": BinOp.Add
        "Sub": BinOp.Sub
        "Minus": BinOp.Sub
        "Mul": BinOp.Mul
        "Star": BinOp.Mul
        "Div": BinOp.Div
        "Slash": BinOp.Div
        "Rem": BinOp.Rem
        "Percent": BinOp.Rem
        "Eq": BinOp.Eq
        "EqEq": BinOp.Eq
        "NotEq": BinOp.NotEq
        "BangEq": BinOp.NotEq
        "Lt": BinOp.Lt
        "Gt": BinOp.Gt
        "LtEq": BinOp.LtEq
        "GtEq": BinOp.GtEq
        "And": BinOp.And
        "Or": BinOp.Or
        "BitAnd": BinOp.BitAnd
        "Ampersand": BinOp.BitAnd
        "BitOr": BinOp.BitOr
        "Pipe": BinOp.BitOr
        "BitXor": BinOp.BitXor
        "Caret": BinOp.BitXor
        "Shl": BinOp.Shl
        "LtLt": BinOp.Shl
        "Shr": BinOp.Shr
        "GtGt": BinOp.Shr
        _: throw "unknown binary operator: {op_name}"
    Expr(kind: ExprKind.BinOp(op, left, right), line: line)

def Expr make_unary(string op_name, Expr expr, int line):
    let op = match op_name:
        "Neg": UnaryOp.Neg
        "Not": UnaryOp.Not
        _: UnaryOp.BitNot
    Expr(kind: ExprKind.UnaryOp(op, expr), line: line)

def Expr make_assign(Expr target, Expr value, int line):
    Expr(kind: ExprKind.Assign(target, value), line: line)

def Arg make_arg(string? label, Expr value, bool spread):
    Arg(label: label, value: value, spread: spread)

def Expr make_call(Expr callee, [Arg] args, int line):
    Expr(kind: ExprKind.Call(callee, args), line: line)

def Expr make_method_call(Expr receiver, string name, [Arg] args, int line):
    Expr(kind: ExprKind.MethodCall(receiver, name, args), line: line)

def Expr make_closure([Param] params, Type? return_ty, ClosureBody body, bool can_throw, bool is_task, int line):
    Expr(kind: ExprKind.Closure(params, return_ty, body, can_throw, is_task), line: line)

def ClosureBody closure_body_block([Stmt] stmts):
    ClosureBody.Block(stmts)

def ClosureBody closure_body_expr(Expr expr):
    ClosureBody.Expr(expr)

def (bool, ClosureBody) closure_body_is_block(ClosureBody body):
    match body:
        ClosureBody.Block(stmts): (true, ClosureBody.Block(stmts))
        ClosureBody.Expr(e): (false, ClosureBody.Expr(e))

def Expr make_else_expr(Expr expr, Expr default, int line):
    Expr(kind: ExprKind.Else(expr, default), line: line)

def Expr make_do_expr([Stmt] stmts, int line):
    Expr(kind: ExprKind.Do(stmts), line: line)

def LetStmt make_let_stmt(bool mutable, bool is_pub, bool is_static, string name, Type? ty, Expr? value, bool is_move, int line):
    LetStmt(
        mutable: mutable,
        is_pub: is_pub,
        is_static: is_static,
        name: name,
        ty: ty,
        value: value,
        is_move: is_move,
        line: line
    )

def Param make_param(string name, Type? ty, bool mutable):
    Param(name: name, ty: ty, mutable: mutable, owned: false, variadic: false, default: nil, line: 0)

def FieldDecl make_field(string name, Type ty, bool mutable, Expr? default, int line):
    FieldDecl(name: name, is_pub: false, ty: ty, mutable: mutable, is_transient: false, default: default, line: line)

def (ThrowsTask, ClosureBody) infer_throws_task(ClosureBody body):
    var bool can_throw = false
    var bool is_task = false
    let ret_body = match body:
        ClosureBody.Block(stmts):
            for stmt in stmts:
                match stmt:
                    Stmt.Throw(_): can_throw = true
                    _: nil
            ClosureBody.Block(stmts)
        ClosureBody.Expr(e):
            ClosureBody.Expr(e)
    let tt = ThrowsTask(can_throw: can_throw, is_task: is_task)
    return (tt, ret_body)

def Expr make_try_else_block([Stmt] try_stmts, [Stmt] else_stmts, int line):
