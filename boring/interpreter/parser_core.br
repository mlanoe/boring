    Type.Named(name)

static let int MAX_EXPR_DEPTH = 200

def TryStmt make_try_stmt([Stmt] body, [CatchClause] catch_clauses, int line):
    TryStmt(body: body, catch_clauses: catch_clauses, line: line)

def [Arg] map_args([Expr] exprs):
    var result = []
    for e in exprs:
        result.append(make_arg(nil, e, false))
    result

def [Param] elems_to_params([Expr] elems, int line):
    var result = []
    for e in elems:
        result.append(expr_to_param(e, line))
    result

def Param expr_to_param(Expr expr, int line):
    match expr.kind:
        ExprKind.Var(name): make_param(name, nil, false)
        _: make_param("_", nil, false)

def [Stmt] unwrap_block_or_wrap(Expr expr):
    match expr.kind:
        ExprKind.Block(stmts): stmts
        _: [stmt_expr(expr, expr.line)]

def string? shorthand_binop_from_peek(var Parser p):
    let k = parser_peek_kind(p)
    match k:
        "PlusEq": some("Plus")
        "MinusEq": some("Minus")
        "StarEq": some("Star")
        "SlashEq": some("Slash")
        "PercentEq": some("Percent")
        "AmpersandEq": some("Ampersand")
        "PipeEq": some("Pipe")
        "CaretEq": some("Caret")
        _: nil

def bool parser_is_newline2(var Parser p):
    let k = parser_peek_kind(p)
    k == "Newline" or k == "Eof"

struct SkipResult:
    int offset
    int indents

def SkipResult? peek_pipe_after_newlines(var Parser p):
    nil

def SkipResult? peek_dot_after_newlines_and_indents(var Parser p):
    nil

def Parser make_parser([Token] tokens):
    var par = Parser(tokens: tokens, pos: 0)
    par

def LoopStmt parse_loop_stmt(var Parser p) throws:
    let body = parse_block(p)
    LoopStmt(body: body, line: p.pos)

def Pattern parse_pattern(var Parser p) throws:
    let name = parser_expect_ident(p)
    Pattern.Bind(name)

def [MatchArm] parse_inline_match_arms(var Parser p) throws:
    var arms = []
    while not parser_check(p, "Newline") and not parser_check(p, "Eof"):
        let arm = parse_match_arm(p)
        arms.append(arm)
    arms

def MatchArm parse_match_arm(var Parser p) throws:
    let pat = parse_pattern(p)
    parser_expect(p, "Colon")
    let body = parse_expr(p)
    let body_line = body.line
    let stmt = stmt_expr(body, body_line)
    make_match_arm([pat], nil, MatchBody.Block([stmt]), p.pos)

def ModDecl parse_mod_decl(var Parser p, bool is_pub) throws:
    let name = parser_expect_ident(p)
    parser_expect_newline(p)
    ModDecl(name: name, items: [], line: p.pos)

def AliasDecl parse_alias_decl(var Parser p) throws:
    let name = parser_expect_ident(p)
    parser_expect(p, "As")
    let ty = parse_type(p)
    AliasDecl(name: name, ty: ty, type_params: [], newtype: false, line: p.pos)

def GuardStmt parse_guard_stmt(var Parser p) throws:
    let cond = parse_expr(p)
    parser_expect(p, "Else")
    let body = parse_block(p)
    GuardStmt(cond: GuardCond.Expr(cond), else_body: body, line: p.pos)

def [Stmt] parse_defer_stmt(var Parser p) throws:
    parse_block(p)

def IfLetStmt parse_if_let_stmt(var Parser p) throws:
    let name = parser_expect_ident(p)
    parser_expect(p, "Eq")
    let expr = parse_expr(p)
    let then_body = parse_block(p)
    IfLetStmt(clauses: [CondClause.Let(name, expr)], then_body: then_body, else_body: nil, line: p.pos)

def WhileLetStmt parse_while_let_stmt(var Parser p) throws:
    let name = parser_expect_ident(p)
    parser_expect(p, "Eq")
    let expr = parse_expr(p)
    let body = parse_block(p)
    WhileLetStmt(name: name, pattern: nil, value: expr, body: body, line: p.pos)

def [Expr] parse_macro_args(var Parser p) throws:
    var args = []
    while not parser_check(p, "RParen") and not parser_check(p, "Newline") and not parser_check(p, "Eof"):
        let e = parse_expr(p)
        args.append(e)
        parser_eat(p, "Comma")
    args

def Type apply_var_to_borrow(Type ty):
    Type.Qualified(ty, OwnerQual.BorrowMut)

def Type infer_type_from_constructor(Type qualified, Expr value):
    qualified

def FnDecl lookup_fn_decl(var Interpreter'actor interp, string name):
    let decl_opt = interp.get_fn_decl(name)
    if let decl = decl_opt:
        return decl
    throw "lookup_fn_decl: function '{name}' not found"

def Value resolve_overload(var Interpreter'actor interp, [Value] variants, [Value] args):
    match variants.length:
        0: throw "no overloads for call"
        _: variants[0]

def Value call_native(var Interpreter'actor interp, string name, Value func, [Value] args):
    if name == "print" or name == "println":
        var int i = 0
        while i < args.length:
            if i > 0:
                print " "
            print value_to_string(args[i])
            i += 1
        print "\n"
        return Value.Void
    if name == "read_line":
        return Value.Str(readLine())
    throw "call_native: native function '{name}' not supported"

def ThrowsTask parse_closure_modifiers(var Parser p) throws:
    let can_throw = p.eat(TokenKind.Throws)
    let is_task = p.eat(TokenKind.Task)
    ThrowsTask(can_throw: can_throw, is_task: is_task)

def bool parser_allow_trailing_closure(var Parser p):
    true

def Type parse_type_qualifier(var Parser p, Type base) throws:
    if not p.eat(TokenKind.Tick):
        return base
    let qual_name = parser_expect_ident(p)
    let qual = match qual_name:
        "actor": OwnerQual.Actor
        "shared": OwnerQual.Shared
        "guard": OwnerQual.Guard
        "stack": OwnerQual.Stack
        "heap": OwnerQual.Owned
        "weak": OwnerQual.Weak
        _: OwnerQual.Actor
    Type.Qualified(base, qual)
