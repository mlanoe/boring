def (ThrowsTask, ClosureBody) infer_throws_task(ClosureBody body):
    var bool can_throw = false
    var bool is_task = false
    let ret_body = match body:
        ClosureBody.Block(stmts):
            for stmt in stmts:
                match stmt:
                    Stmt.Throw(_): can_throw = true
                    _: nil
            ClosureBody.Block(stmts)
        ClosureBody.Expr(e):
            ClosureBody.Expr(e)
    let tt = ThrowsTask(can_throw: can_throw, is_task: is_task)
    return (tt, ret_body)

