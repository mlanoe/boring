def string? shorthand_binop_from_peek(mut Parser p):
    let k = parser_peek_kind(p)
    match k:
        "PlusEq": "Plus"
        "MinusEq": "Minus"
        "StarEq": "Star"
        "SlashEq": "Slash"
        "PercentEq": "Percent"
        "AmpersandEq": "Ampersand"
        "PipeEq": "Pipe"
        "CaretEq": "Caret"
        _: nil

# Binary-operator continuation for `:field op expr` colon closures, e.g. `:length > 3`.
def string? colon_closure_binop_from_peek(mut Parser p):
    let k = parser_peek_kind(p)
    match k:
        "EqEqEq": "RefEq"
        "EqEq": "Eq"
        "BangEq": "NotEq"
        "LtEq": "LtEq"
        "GtEq": "GtEq"
        "Lt": "Lt"
        "Gt": "Gt"
        "Plus": "Plus"
        "Minus": "Minus"
        "Star": "Star"
        "Slash": "Slash"
        "Percent": "Percent"
        _: nil

def bool parser_is_newline2(mut Parser p):
    let k = token_kind_name(p.peek2())
    k == "Newline" or k == "Eof"

struct SkipResult:
    int offset
    int indents

def SkipResult? peek_pipe_after_newlines(mut Parser p):
    var i = 0
    var indents = 0
    var SkipResult? result = nil
    var scanning = true
    while scanning:
        let k = token_kind_name(parser_peek_token_at(p, i).kind)
        if k == "Newline":
            i = i + 1
        elif k == "Indent":
            indents = indents + 1
            i = i + 1
        elif k == "PipeArrow":
            result = SkipResult(offset= i, indents= indents)
            scanning = false
        else:
            scanning = false
    result

def SkipResult? peek_dot_after_newlines_and_indents(mut Parser p):
    var i = 0
    var indents = 0
    var SkipResult? result = nil
    var scanning = true
    while scanning:
        let k = token_kind_name(parser_peek_token_at(p, i).kind)
        if k == "Newline":
            i = i + 1
        elif k == "Indent":
            indents = indents + 1
            i = i + 1
        elif k == "Dot":
            result = SkipResult(offset= i, indents= indents)
            scanning = false
        else:
            scanning = false
    result

def Parser'actor make_parser([Token] tokens):
    let p'actor = Parser(tokens= tokens, pos= 0, allow_noparen_closure= true, allow_trailing_closure= true)
    p

def LoopStmt parse_loop_stmt(mut Parser p) throws:
    let line = p.current_line()
    p.expect(TokenKind.Loop)
    p.expect(TokenKind.Colon)
    let body = parse_block(p)
    LoopStmt(body= body, line= line)

def bool ident_is_capitalized(string name):
    if name.length == 0:
        return false
    let first = name.slice(0, 1)
    first >= "A" and first <= "Z"

def Pattern parse_pattern(mut Parser p) throws:
    # Wildcard
    if parser_peek_ident(p) == "_":
        parser_advance(p)
        return Pattern.Wildcard
    # Parenthesized tuple pattern: (1, 2) or (x, y)
    if parser_eat(p, "LParen"):
        let field_pats = parse_pattern_fields(p)
        parser_expect(p, "RParen")
        if field_pats.length == 1:
            return field_pats[0]
        return Pattern.Tuple(field_pats)
    # Nil literal
    if parser_eat(p, "Nil"):
        return Pattern.Lit(LitPattern.Nil)
    # Bool literals
    if parser_check(p, "Bool"):
        let b = parser_peek_bool(p)
        parser_advance(p)
        return Pattern.Lit(LitPattern.Bool(b))
    # Integer literal (possibly negated)
    if parser_check(p, "Int"):
        let n = parser_peek_int(p)
        parser_advance(p)
        return Pattern.Lit(LitPattern.Int(n))
    if parser_check(p, "Minus"):
        parser_advance(p)
        if parser_check(p, "Int"):
            let n = parser_peek_int(p)
            parser_advance(p)
            return Pattern.Lit(LitPattern.Int(-n))
        if parser_check(p, "Float"):
            let f = parser_peek_float(p)
            parser_advance(p)
            return Pattern.Lit(LitPattern.Float(-f))
    # String literal
    if parser_check(p, "Str"):
        let s = parser_peek_str(p)
        parser_advance(p)
        return Pattern.Lit(LitPattern.Str(s))
    # Identifier — binding, enum variant, or qualified variant
    let name = parser_expect_ident(p)
    # Some/None/some/none are special optional patterns (must come before generic LParen check)
    if name == "Some" or name == "some":
        if parser_eat(p, "LParen"):
            let inner = parse_pattern(p)
            parser_expect(p, "RParen")
            return Pattern.Some(inner)
        return Pattern.Some(Pattern.Wildcard)
    if name == "None" or name == "none":
        return Pattern.None
    # Qualified: Name.Variant or Name.Variant(fields)
    if parser_eat(p, "Dot"):
        let variant = parser_expect_ident(p)
        if parser_eat(p, "LParen"):
            let field_pats = parse_pattern_fields(p)
            parser_expect(p, "RParen")
            return Pattern.Variant("{name}.{variant}", field_pats)
        return Pattern.Variant("{name}.{variant}", [])
    # Variant with fields: Variant(fields)
    if parser_eat(p, "LParen"):
        let field_pats = parse_pattern_fields(p)
        parser_expect(p, "RParen")
        return Pattern.Variant(name, field_pats)
    # Bare uppercase name → enum variant with no fields (e.g. `North:`)
    if ident_is_capitalized(name):
        return Pattern.Variant(name, [])
    Pattern.Bind(name)

def [Pattern] parse_pattern_fields(mut Parser p) throws:
    var pats = []
    while not parser_check(p, "RParen") and not parser_check(p, "Eof"):
        pats.push(parse_pattern(p))
        if not parser_eat(p, "Comma"):
            break
    pats

def Pattern parse_match_single_pattern(mut Parser p) throws:
    let first = parse_pattern(p)
    # Comma → tuple pattern (e.g. `1, 2:`)
    if not parser_check(p, "Comma"):
        return first
    var pats = [first]
    while parser_eat(p, "Comma"):
        pats.push(parse_pattern(p))
    Pattern.Tuple(pats)

def [MatchArm] parse_inline_match_arms(mut Parser p) throws:
    var arms = []
    while true:
        let arm = parse_match_arm(p)
        arms.push(arm)
        if not parser_eat(p, "Comma"):
            break
        parser_skip_newlines(p)
    arms

def MatchArm parse_match_arm(mut Parser p) throws:
    let line = parser_line(p)
    # Parse first pattern (may be tuple via commas)
    let first_pat = parse_match_single_pattern(p)
    var patterns = [first_pat]
    # Or-patterns with |
    while parser_eat(p, "Pipe"):
        patterns.push(parse_match_single_pattern(p))
    # Match guard: `if expr`
    var Expr? guard_expr = nil
    if parser_eat(p, "If"):
        guard_expr = parse_or(p)
    parser_expect(p, "Colon")
    # Body: inline or indented block
    var body = MatchBody.Block([])
    if parser_is_newline(p):
        parser_expect_newline(p)
        body = MatchBody.Block(parse_block(p))
    else:
        let stmts = parse_inline_stmts(p)
        parser_expect_newline_soft(p)
        body = MatchBody.Block(stmts)
    make_match_arm(patterns, guard_expr, body, line)

def ModDecl parse_mod_decl(mut Parser p, bool is_pub) throws:
    let line = p.current_line()
    p.expect(TokenKind.Mod)
    let name = parser_expect_ident(p)
    p.expect(TokenKind.Colon)
    p.expect(TokenKind.Newline)
    p.expect(TokenKind.Indent)
    var items = [Item]{}
    while p.peek() != TokenKind.Dedent and p.peek() != TokenKind.Eof:
        while p.eat(TokenKind.Newline):
            nil
        if p.peek() == TokenKind.Dedent or p.peek() == TokenKind.Eof:
            break
        items.push(parse_item(p))
    p.eat(TokenKind.Dedent)
    ModDecl(name= name, items= items, line= line)

def AliasDecl parse_alias_decl(mut Parser p) throws:
    let name = parser_expect_ident(p)
    parser_expect(p, "As")
    let ty = parse_type(p)
    AliasDecl(name= name, ty= ty, type_params= [], newtype= false, line= p.pos)

def GuardStmt parse_guard_stmt(mut Parser p) throws:
    let line = p.current_line()
    p.expect(TokenKind.Guard)
    var GuardCond cond = GuardCond.Expr(make_bool_expr(true, line))
    if p.eat(TokenKind.Let):
        var clauses = []
        var parsing = true
        while parsing:
            let name = parser_expect_ident(p)
            if parser_check(p, "Else") or parser_check(p, "Colon") or parser_is_newline(p):
                let self_expr = make_var_expr(name, p.current_line())
                clauses.push(CondClause.Let(name, self_expr))
            else:
                p.expect(TokenKind.Eq)
                let expr = parse_or(p)
                clauses.push(CondClause.Let(name, expr))
            if parser_eat(p, "Comma"):
                if parser_check(p, "Let"):
                    p.advance()
                elif parser_check(p, "Else") or parser_check(p, "Colon") or parser_is_newline(p):
                    parsing = false
                else:
                    let guard_expr = parse_or(p)
                    clauses.push(CondClause.Expr(guard_expr))
                    parsing = false
            else:
                parsing = false
        cond = GuardCond.Clauses(clauses)
    else:
        let expr = parse_or(p)
        cond = GuardCond.Expr(expr)
    parser_expect(p, "Else")
    p.eat(TokenKind.Colon)
    let body = parse_fn_body(p)
    GuardStmt(cond= cond, else_body= body, line= line)

def [Stmt] parse_defer_stmt(mut Parser p) throws:
    parser_expect(p, "Defer")
    if parser_check(p, "Colon"):
        parser_expect(p, "Colon")
    parse_fn_body(p)

def IfLetStmt parse_if_let_stmt_rest(mut Parser p, int line) throws:
    var clauses = []
    var parsing_clauses = true
    while parsing_clauses:
        let pat = parse_pattern(p)
        if parser_check(p, "Colon") or parser_check(p, "Comma") or parser_check(p, "Newline"):
            match pat:
                Pattern.Bind(name):
                    let self_expr = make_var_expr(name, p.current_line())
                    clauses.push(CondClause.Let(name, self_expr))
                _:
                    clauses.push(CondClause.LetPat(pat, make_nil_expr(p.current_line())))
            if parser_check(p, "Colon") or parser_check(p, "Newline"):
                parsing_clauses = false
            else:
                parser_eat(p, "Comma")
                if parser_eat(p, "Let"):
                    nil
                else:
                    let guard_expr = parse_or(p)
                    clauses.push(CondClause.Expr(guard_expr))
                    parsing_clauses = false
        else:
            parser_expect(p, "Eq")
            let saved = parser_get_allow_noparen_closure(p)
            parser_set_allow_noparen_closure(p, false)
            parser_set_allow_trailing_closure(p, false)
            let expr = parse_or(p)
            parser_set_allow_noparen_closure(p, saved)
            parser_set_allow_trailing_closure(p, true)
            match pat:
                Pattern.Bind(name): clauses.push(CondClause.Let(name, expr))
                _: clauses.push(CondClause.LetPat(pat, expr))
        if parser_eat(p, "Comma"):
            if parser_eat(p, "Let"):
                nil
            else:
                let guard_expr = parse_or(p)
                clauses.push(CondClause.Expr(guard_expr))
                parsing_clauses = false
        else:
            parsing_clauses = false
    parser_expect(p, "Colon")
    let then_body = parse_fn_body(p)
    var [Stmt]? else_body = nil
    parser_skip_newlines(p)
    if parser_check(p, "Elif"):
        p.advance()
        if parser_eat(p, "Let"):
            let int rest_line = p.current_line()
            let elif_stmt = parse_if_let_stmt_rest(p, rest_line)
            else_body = [stmt_if_let(elif_stmt)]
        else:
            let cond = parse_or(p)
            parser_expect(p, "Colon")
            let elif_body = parse_fn_body(p)
            var [Stmt]? elif_else = nil
            parser_skip_newlines(p)
            if parser_eat(p, "Else"):
                elif_else = parse_else_body_stmts(p)
            let elif_branch = IfBranch(cond= cond, body= elif_body)
            let elif_if_stmt = make_if_stmt([elif_branch], elif_else, p.current_line())
            else_body = [Stmt.If(elif_if_stmt)]
    elif parser_eat(p, "Else"):
        else_body = parse_else_body_stmts(p)
    IfLetStmt(clauses= clauses, then_body= then_body, else_body= else_body, line= line)

def IfLetStmt parse_if_let_stmt(mut Parser p) throws:
    let line = p.current_line()
    parser_expect(p, "If")
    parser_expect(p, "Let")
    var clauses = []
    var parsing_clauses = true
    while parsing_clauses:
        let pat = parse_pattern(p)
        # Shorthand: `if let v:` expands to `if let v = v:`
        if parser_check(p, "Colon") or parser_check(p, "Comma") or parser_check(p, "Newline"):
            match pat:
                Pattern.Bind(name):
                    let self_expr = make_var_expr(name, p.current_line())
                    clauses.push(CondClause.Let(name, self_expr))
                _:
                    clauses.push(CondClause.LetPat(pat, make_nil_expr(p.current_line())))
            if parser_check(p, "Colon") or parser_check(p, "Newline"):
                parsing_clauses = false
            else:
                parser_eat(p, "Comma")
                if parser_eat(p, "Let"):
                    nil
                else:
                    let guard_expr = parse_or(p)
                    clauses.push(CondClause.Expr(guard_expr))
                    parsing_clauses = false
        else:
            parser_expect(p, "Eq")
            let saved = parser_get_allow_noparen_closure(p)
            parser_set_allow_noparen_closure(p, false)
            parser_set_allow_trailing_closure(p, false)
            let expr = parse_or(p)
            parser_set_allow_noparen_closure(p, saved)
            parser_set_allow_trailing_closure(p, true)
            match pat:
                Pattern.Bind(name): clauses.push(CondClause.Let(name, expr))
                _: clauses.push(CondClause.LetPat(pat, expr))
        # comma-separated additional clauses or bool guards
        if parser_eat(p, "Comma"):
            if parser_eat(p, "Let"):
                nil
            else:
                let guard_expr = parse_or(p)
                clauses.push(CondClause.Expr(guard_expr))
                parsing_clauses = false
        else:
            parsing_clauses = false
    parser_expect(p, "Colon")
    let then_body = parse_fn_body(p)
    var [Stmt]? else_body = nil
    parser_skip_newlines(p)
    if parser_check(p, "Elif"):
        p.advance()
        if parser_eat(p, "Let"):
            let int rest_line = p.current_line()
            let elif_stmt = parse_if_let_stmt_rest(p, rest_line)
            else_body = [stmt_if_let(elif_stmt)]
        else:
            let cond = parse_or(p)
            parser_expect(p, "Colon")
            let elif_body = parse_fn_body(p)
            var [Stmt]? elif_else = nil
            parser_skip_newlines(p)
            if parser_eat(p, "Else"):
                elif_else = parse_else_body_stmts(p)
            let elif_branch = IfBranch(cond= cond, body= elif_body)
            let elif_if_stmt = make_if_stmt([elif_branch], elif_else, p.current_line())
            else_body = [Stmt.If(elif_if_stmt)]
    elif parser_eat(p, "Else"):
        else_body = parse_else_body_stmts(p)
    IfLetStmt(clauses= clauses, then_body= then_body, else_body= else_body, line= line)

def WhileLetStmt parse_while_let_stmt(mut Parser p) throws:
    let line = p.current_line()
    parser_expect(p, "While")
    parser_expect(p, "Let")
    let pat = parse_pattern(p)
    parser_expect(p, "Eq")
    let saved = parser_get_allow_noparen_closure(p)
    parser_set_allow_noparen_closure(p, false)
    parser_set_allow_trailing_closure(p, false)
    let expr = parse_or(p)
    parser_set_allow_noparen_closure(p, saved)
    parser_set_allow_trailing_closure(p, true)
    parser_expect(p, "Colon")
    let body = parse_block(p)
    WhileLetStmt(name= "_", pattern= pat, value= expr, body= body, line= line)

def [Expr] parse_macro_args(mut Parser p) throws:
    # Consume opening delimiter: `(` or `[`
    var close = "RParen"
    if parser_check(p, "LBracket"):
        parser_advance(p)
        close = "RBracket"
    elif parser_check(p, "LParen"):
        parser_advance(p)
    var args = []
    while not parser_check(p, close) and not parser_check(p, "Newline") and not parser_check(p, "Eof"):
        let e = parse_expr(p)
        args.push(e)
        parser_eat(p, "Comma")
    parser_eat(p, close)
    args

def Type apply_var_to_borrow(Type ty):
    Type.Qualified(ty, OwnerQual.BorrowMut)

def Type infer_type_from_constructor(Type qualified, Expr value):
    qualified

def FnDecl lookup_fn_decl(Interpreter interp, string name):
    let decl_opt = interp.get_fn_decl(name)
    if let decl = decl_opt:
        return decl
    throw "lookup_fn_decl: function '{name}' not found"

def Value resolve_overload(Interpreter interp, [Value] variants, [Value] args):
    match variants.length:
        0: throw "no overloads for call"
        _: variants[0]

def Value call_native(Interpreter interp, string name, Value func, [Value] args):
    if name == "write":
        var string output = ""
        var int i = 0
        while i < args.length:
            if i > 0:
                output = output + " "
            output = output + display_value(interp, args[i])
            i += 1
        write output
        return Value.Void
    if name == "print" or name == "println":
        var string output = ""
        var int i = 0
        while i < args.length:
            if i > 0:
                output = output + " "
            output = output + display_value(interp, args[i])
            i += 1
        print output
        return Value.Void
    if name == "read_line":
        let ln = readLine()
        if let s = ln:
            return Value.Str(s)
        return Value.Nil
    if name == "assert":
        let v = args[0] else Value.Nil
        if not val_to_bool(v):
            throw "assertion failed"
        return Value.Void
    if name == "assert_eq":
        let a = args[0] else Value.Nil
        let b = args[1] else Value.Nil
        if not values_equal(a, b):
            throw "assert_eq failed"
        return Value.Void
    if name == "assert_neq":
        let a = args[0] else Value.Nil
        let b = args[1] else Value.Nil
        if values_equal(a, b):
            throw "assert_neq failed"
        return Value.Void
    if name == "len":
        let v = args[0] else Value.Nil
        match v:
            Value.Array(items): return Value.Int(items.length)
            Value.Str(s): return Value.Int(s.length)
            Value.Dict(pairs): return Value.Int(pairs.length)
            _: throw "len: unsupported type"
    if name == "int":
        let v = args[0] else Value.Nil
        match v:
            Value.Int(n): return Value.Int(n)
            Value.Uint(n): return Value.Int(n as int)
            Value.Uint8(n): return Value.Int(n as int)
            Value.Float(f): return Value.Int(int(f))
            Value.Bool(b): return if b: Value.Int(1) else Value.Int(0)
            _:
                if let g = cast_numeric_generic(v, "int"):
                    return g
                return Value.Nil
    if name == "uint":
        let v = args[0] else Value.Nil
        match v:
            Value.Uint(n): return Value.Uint(n)
            Value.Uint8(n): return Value.Uint(n as uint)
            Value.Int(n): return Value.Uint(n as uint)
            Value.Float(f): return Value.Uint(f as uint)
            _:
                if let g = cast_numeric_generic(v, "uint"):
                    return g
                return Value.Nil
    if name == "uint8":
        let v = args[0] else Value.Nil
        match v:
            Value.Uint8(n): return Value.Uint8(n)
            Value.Uint(n): return Value.Uint8(n as uint8)
            Value.Int(n): return Value.Uint8(n as uint8)
            Value.Float(f): return Value.Uint8(f as uint8)
            _:
                if let g = cast_numeric_generic(v, "uint8"):
                    return g
                return Value.Nil
    if name == "float":
        let v = args[0] else Value.Nil
        match v:
            Value.Float(f): return Value.Float(f)
            Value.Int(n): return Value.Float(float(n))
            Value.Uint(n): return Value.Float(n as float)
            Value.Uint8(n): return Value.Float(n as float)
            _:
                if let iv = value_as_i128(v):
                    return Value.Float(iv as float)
                return Value.Nil
    if is_fixed_width_int_name(name):
        let v = args[0] else Value.Nil
        if let g = cast_numeric_generic(v, name):
            return g
        return Value.Nil
    if name == "string":
        let v = args[0] else Value.Nil
        return Value.Str(val_to_string(v))
    if name == "bool":
        let v = args[0] else Value.Nil
        return Value.Bool(val_to_bool(v))
    if name == "sqrt":
        let v = args[0] else Value.Nil
        match v:
            Value.Float(f): return Value.Float(f.sqrt())
            Value.Int(n): return Value.Float(float(n).sqrt())
            _: throw "sqrt: expected number"
    if name == "abs":
        let v = args[0] else Value.Nil
        match v:
            Value.Float(f): return Value.Float(f.abs())
            Value.Int(n): return Value.Int(if n < 0: -n else n)
            _: throw "abs: expected number"
    if name == "min":
        let a = args[0] else Value.Nil
        let b = args[1] else Value.Nil
        match a:
            Value.Int(x):
                match b:
                    Value.Int(y): return if x < y: Value.Int(x) else Value.Int(y)
                    _: throw "min: type mismatch"
            Value.Float(x):
                match b:
                    Value.Float(y): return if x < y: Value.Float(x) else Value.Float(y)
                    _: throw "min: type mismatch"
            _: throw "min: expected numbers"
    if name == "max":
        let a = args[0] else Value.Nil
        let b = args[1] else Value.Nil
        match a:
            Value.Int(x):
                match b:
                    Value.Int(y): return if x > y: Value.Int(x) else Value.Int(y)
                    _: throw "max: type mismatch"
            Value.Float(x):
                match b:
                    Value.Float(y): return if x > y: Value.Float(x) else Value.Float(y)
                    _: throw "max: type mismatch"
            _: throw "max: expected numbers"
    if name == "exit":
        let v = args[0] else Value.Int(0)
        match v:
            Value.Int(code): exit(code)
            _: exit(0)
        Value.Void
    if name == "args":
        var [Value] out = []
        for a in interp.cli_args:
            out.push(Value.Str(a))
        return Value.Array(out)
    if name == "error":
        let v = args[0] else Value.Nil
        throw val_to_string(v)
    if name == "HashMap":
        return Value.Dict([])
    if name == "HashSet":
        return Value.Set([])
    if name == "Vec":
        return Value.Array([])
    if name == "sin":
        let v = args[0] else Value.Nil
        match v:
            Value.Float(f): return Value.Float(f.sin())
            Value.Int(n): return Value.Float(float(n).sin())
            _: throw "sin: expected number"
    if name == "cos":
        let v = args[0] else Value.Nil
        match v:
            Value.Float(f): return Value.Float(f.cos())
            Value.Int(n): return Value.Float(float(n).cos())
            _: throw "cos: expected number"
    if name == "tan":
        let v = args[0] else Value.Nil
        match v:
            Value.Float(f): return Value.Float(f.tan())
            Value.Int(n): return Value.Float(float(n).tan())
            _: throw "tan: expected number"
    if name == "round":
        let v = args[0] else Value.Nil
        match v:
            Value.Float(f): return Value.Int(int(f.round()))
            Value.Int(n): return Value.Int(n)
            _: throw "round: expected number"
    if name == "floor":
        let v = args[0] else Value.Nil
        match v:
            Value.Float(f): return Value.Int(int(f.floor()))
            Value.Int(n): return Value.Int(n)
            _: throw "floor: expected number"
    if name == "ceil":
        let v = args[0] else Value.Nil
        match v:
            Value.Float(f): return Value.Int(int(f.ceil()))
            Value.Int(n): return Value.Int(n)
            _: throw "ceil: expected number"
    if name == "pow":
        let base = args[0] else Value.Nil
        let exp = args[1] else Value.Nil
        match base:
            Value.Float(b):
                match exp:
                    Value.Float(e): return Value.Float(b.powf(e))
                    Value.Int(e): return Value.Float(b.powf(float(e)))
                    _: throw "pow: expected number"
            Value.Int(b):
                match exp:
                    Value.Int(e): return Value.Int(int(float(b).powf(float(e))))
                    Value.Float(e): return Value.Float(float(b).powf(e))
                    _: throw "pow: expected number"
            _: throw "pow: expected number"
    if name == "log" or name == "ln":
        let v = args[0] else Value.Nil
        match v:
            Value.Float(f): return Value.Float(f.ln())
            Value.Int(n): return Value.Float(float(n).ln())
            _: throw "{name}: expected number"
    if name == "log2":
        let v = args[0] else Value.Nil
        match v:
            Value.Float(f): return Value.Float(f.log2())
            Value.Int(n): return Value.Float(float(n).log2())
            _: throw "log2: expected number"
    if name == "log10":
        let v = args[0] else Value.Nil
        match v:
            Value.Float(f): return Value.Float(f.log10())
            Value.Int(n): return Value.Float(float(n).log10())
            _: throw "log10: expected number"
    if name == "type":
        let v = args[0] else Value.Nil
        return Value.Str(v.type_name())
    if name == "native-new-ok" or name == "native-shadow-ok" or name == "print2" or name == "myRuntimeFn":
        return Value.Nil
    if name == "drop":
        # drop is a no-op in the interpreter
        return Value.Nil
    if name == "channel":
        # Synchronous channel emulation via interpreter-global channel registry
        let ch_id = interp.next_channel_id
        interp.next_channel_id = ch_id + 1
        let ch_key = int_to_string(ch_id)
        var {string=[Value]} cq = interp.channel_queues
        cq[ch_key] = []
        interp.channel_queues = cq
        let tx_obj = make_object("__ChannelTx__", [("__ch_id__", Value.Str(ch_key))])
        let rx_obj = make_object("__ChannelRx__", [("__ch_id__", Value.Str(ch_key))])
        return Value.Tuple([Value.Object(tx_obj), Value.Object(rx_obj)])
    throw "call_native: native function '{name}' not supported"

def ThrowsTask parse_closure_modifiers(mut Parser p) throws:
    var can_throw = false
    var is_task = false
    # Accept `task` and `throws` in any order
    while true:
        if p.eat(TokenKind.Task):
            is_task = true
        elif p.eat(TokenKind.Throws):
            can_throw = true
            parser_eat(p, "Ident")
        else:
            break
    ThrowsTask(can_throw= can_throw, is_task= is_task)

def bool parser_allow_trailing_closure(mut Parser p):
    p.allow_trailing_closure

def Type parse_type_qualifier(mut Parser p, Type base) throws:
    if not p.eat(TokenKind.Tick):
        return base
    # 'T'?' means Optional<T>
    if p.eat(TokenKind.Question):
        return Type.Optional(base)
    # Handle `guard` as a keyword token
    if p.eat(TokenKind.Guard):
        let qualified = Type.Qualified(base, OwnerQual.Guard)
        if p.eat(TokenKind.Question):
            return Type.Optional(qualified)
        return qualified
    # Bare tick with no qualifier (e.g. `EColorB'`) — treat as just the base type
    if not parser_check(p, "Ident"):
        return base
    # Only consume the ident if it's a known qualifier keyword
    let peeked_name = parser_peek_ident(p)
    if peeked_name != "actor" and peeked_name != "shared" and peeked_name != "guard" and peeked_name != "stack" and peeked_name != "heap" and peeked_name != "weak" and peeked_name != "new":
        return base
    let qual_name = parser_expect_ident(p)
    let qual = match qual_name:
        "actor": OwnerQual.Actor
        "shared": OwnerQual.Shared
        "guard": OwnerQual.Guard
        "stack": OwnerQual.Stack
        "heap": OwnerQual.Owned
        "new": OwnerQual.Owned
        "weak": OwnerQual.Weak
        _: OwnerQual.Actor
    var qualified = Type.Qualified(base, qual)
    # Allow chained qualifiers: 'T'shared'weak
    while parser_check(p, "Tick"):
        let next_k = token_kind_name(parser_peek_token_at(p, 1).kind)
        if next_k == "Guard":
            p.eat(TokenKind.Tick)
            p.eat(TokenKind.Guard)
            qualified = Type.Qualified(qualified, OwnerQual.Guard)
        elif next_k == "Ident":
            let peek_q = parser_peek_token_at(p, 1).text()
            if peek_q != "actor" and peek_q != "shared" and peek_q != "guard" and peek_q != "stack" and peek_q != "heap" and peek_q != "weak" and peek_q != "new":
                break
            p.eat(TokenKind.Tick)
            let q2_name = parser_expect_ident(p)
            let q2 = match q2_name:
                "actor": OwnerQual.Actor
                "shared": OwnerQual.Shared
                "guard": OwnerQual.Guard
                "stack": OwnerQual.Stack
                "heap": OwnerQual.Owned
                "new": OwnerQual.Owned
                "weak": OwnerQual.Weak
                _: OwnerQual.Weak
            qualified = Type.Qualified(qualified, q2)
        else:
            break
    # Allow 'T'qual?' for optional qualified type
    if p.eat(TokenKind.Question):
        Type.Optional(qualified)
    else:
        qualified
