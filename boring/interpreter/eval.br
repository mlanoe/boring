# == EVAL EXPR ==

# Environment helpers

def Value env_get(Interpreter interp, string name):
    let env = interp.current_env
    let result = env.get(name)
    if let val = result:
        val
    else:
        throw "undefined variable '{name}'"

def void env_set(Interpreter interp, string name, Value val):
    let env = interp.current_env
    let ok = env.set(name, val)
    if not ok:
        throw "cannot assign to undefined variable '{name}'"

def void env_define(Interpreter interp, string name, Value val, bool is_mutable):
    if is_mutable:
        interp.current_env.define_mut(name, val)
    else:
        interp.current_env.define(name, val)

def Env'actor push_scope(mut Interpreter interp):
    let child = new_env(interp.current_env)
    interp.current_env = child.clone()
    child

def void pop_scope(mut Interpreter interp):
    let cur = interp.current_env
    let p_opt = cur.parent_opt()
    if let p = p_opt:
        interp.current_env = p

# Main expression evaluator

def Value eval_expr(Interpreter interp, Expr expr):
    match expr.kind:
        # Literals
        ExprKind.Int(n):
            Value.Int(n)
        ExprKind.Float(f):
            Value.Float(f)
        ExprKind.Str(s):
            Value.Str(s)
        ExprKind.Bool(b):
            Value.Bool(b)
        ExprKind.Nil:
            Value.Nil

        # Variable lookup
        ExprKind.Var(name):
            let result = interp.current_env.get(name)
            if let val = result:
                match val:
                    Value.Uninitialized:
                        throw "variable '{name}' used before being assigned"
                    _:
                        val
            else:
                # Check implicit self field access
                let self_opt = interp.current_env.get("self")
                if let self_val = self_opt:
                    match self_val:
                        Value.Object(obj):
                            let field_opt = obj.get_field(name)
                            if let fval = field_opt:
                                fval
                            else:
                                throw "undefined variable '{name}'"
                        _:
                            throw "undefined variable '{name}'"
                else:
                    throw "undefined variable '{name}'"

        # Binary operations
        ExprKind.BinOp(op, left, right):
            eval_binop(interp, op, left, right)

        # Unary operations
        ExprKind.UnaryOp(op, inner):
            let val = eval_expr(interp, inner)
            match op:
                UnaryOp.Neg:
                    match val:
                        Value.Int(n):
                            Value.Int(0 - n)
                        Value.Float(f):
                            Value.Float(0.0 - f)
                        _:
                            throw "cannot negate {val.type_name()}"
                UnaryOp.Not:
                    match val:
                        Value.Bool(b):
                            Value.Bool(not b)
                        _:
                            throw "expected bool for 'not', got {val.type_name()}"
                _:
                    throw "unhandled unary op"

        # Function/constructor call
        ExprKind.Call(callee_expr, args):
            let callee = eval_expr(interp, callee_expr)
            let arg_vals = eval_args(interp, args)
            call_value(interp, callee, arg_vals)

        # Method call
        ExprKind.MethodCall(recv_expr, method, args):
            let recv = eval_expr(interp, recv_expr)
            let arg_vals = eval_args(interp, args)
            let result = call_method(interp, recv, method, arg_vals)
            # Write back mutating array methods to their source lvalue
            if method == "pop":
                match recv:
                    Value.Array(arr):
                        let n = arr.length
                        if n > 0:
                            var new_arr = arr
                            new_arr.remove(n - 1)
                            assign_target(interp, recv_expr, Value.Array(new_arr))
                    _: nil
            elif method == "remove":
                match recv:
                    Value.Array(arr):
                        let arr_len = arr.length
                        let idx_val = arg_vals[0] else Value.Int(0)
                        match idx_val:
                            Value.Int(idx):
                                let actual_idx = if idx < 0: arr_len + idx else idx
                                var new_arr = arr
                                new_arr.remove(actual_idx)
                                assign_target(interp, recv_expr, Value.Array(new_arr))
                            _: nil
                    _: nil
            elif method == "push" or method == "append":
                match result:
                    Value.Array(_): assign_target(interp, recv_expr, result)
                    _: nil
            elif method == "insert":
                match result:
                    Value.Array(_): assign_target(interp, recv_expr, result)
                    _: nil
            result

        # Field access
        ExprKind.Field(obj_expr, field_name):
            let obj = eval_expr(interp, obj_expr)
            get_field(interp, obj, field_name)

        # Index access
        ExprKind.Index(obj_expr, idx_expr):
            let obj = eval_expr(interp, obj_expr)
            let idx = eval_expr(interp, idx_expr)
            get_index(interp, obj, idx)

        # Array literal
        ExprKind.Array(elems):
            var vals = []
            for item in elems:
                vals.append(eval_expr(interp, item))
            Value.Array(vals)

        ExprKind.ArrayFill(value_expr, count_expr):
            let count_val = eval_expr(interp, count_expr)
            let n = match count_val:
                Value.Int(n): n
                _: throw "array fill count must be int, got {count_val.type_name()}"
            let v = eval_expr(interp, value_expr)
            var result = []
            for _ in 0..n:
                result.append(v)
            Value.Array(result)

        ExprKind.ArrayComp(comp_expr, var_name, count_expr):
            let count_val = eval_expr(interp, count_expr)
            let n = match count_val:
                Value.Int(n): n
                _: throw "array comp count must be int, got {count_val.type_name()}"
            var result = []
            for i in 0..n:
                env_define(interp, var_name, Value.Int(i), false)
                result.append(eval_expr(interp, comp_expr))
            Value.Array(result)

        # Tuple literal
        ExprKind.Tuple(elems):
            var vals = []
            for item in elems:
                vals.append(eval_expr(interp, item))
            Value.Tuple(vals)

        # Do block (inline block expression)
        ExprKind.Do(stmts):
            let child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block_do(interp, stmts)
            interp.current_env = prev
            if interp.has_pending_return:
                return Value.Nil
            match sig:
                YieldSignal(v, _): v
                ReturnSignal(v):
                    interp.set_pending_return(v)
                    Value.Nil
                BreakSignal(v): v
                _: Value.Nil

        # Dict literal
        ExprKind.Dict(pairs):
            var entries = []
            for pair in pairs:
                let k = eval_expr(interp, pair.0)
                let v = eval_expr(interp, pair.1)
                entries.append((k, v))
            Value.Dict(entries)

        # Set literal
        ExprKind.Set(elems):
            var vals = []
            for item in elems:
                let v = eval_expr(interp, item)
                if not vals.contains(v):
                    vals.append(v)
            Value.Set(vals)

        # String interpolation
        ExprKind.StringInterp(segments):
            var result = ""
            for seg in segments:
                match seg:
                    StringSegment.Lit(text):
                        result = result + text
                    StringSegment.Expr(e):
                        let v = eval_expr(interp, e)
                        result = result + display_value(interp, v)
                    StringSegment.FormattedExpr(e, _):
                        let v = eval_expr(interp, e)
                        result = result + display_value(interp, v)
            Value.Str(result)

        # Closure
        ExprKind.Closure(params, _, body, _, _):
            Value.Closure(params, body, interp.current_env)

        # Type cast
        ExprKind.Cast(inner_expr, ty):
            let val = eval_expr(interp, inner_expr)
            cast_value(interp, val, ty)

        # Range
        ExprKind.Range(start_expr, end_expr, inclusive):
            let s = eval_expr(interp, start_expr)
            let e = eval_expr(interp, end_expr)
            match s:
                Value.Int(a):
                    match e:
                        Value.Int(b):
                            Value.Range(a, b, inclusive, 1)
                        _:
                            throw "range end must be Int, got {e.type_name()}"
                _:
                    throw "range start must be Int, got {s.type_name()}"

        # If expression
        ExprKind.If(s):
            var result_val = Value.Nil
            var handled = false
            for branch in s.branches:
                if not handled:
                    let cond_val = eval_expr(interp, branch.cond)
                    match cond_val:
                        Value.Bool(b):
                            if b:
                                let child = push_scope(interp)
                                result_val = eval_block(interp, branch.body)
                                pop_scope(interp)
                                handled = true
                        _:
                            throw "condition must be bool"
            if not handled:
                if let else_body = s.else_body:
                    let child = push_scope(interp)
                    result_val = eval_block(interp, else_body)
                    pop_scope(interp)
            result_val

        ExprKind.Assign(target, val_expr):
            let val = eval_expr(interp, val_expr)
            assign_target(interp, target, val)
            Value.Nil

        ExprKind.QuestionAssign(target, rhs_expr):
            match target.kind:
                ExprKind.Var(name):
                    if interp.current_env.is_lazy(name):
                        let cur = interp.current_env.get(name)
                        let needs_init = match cur:
                            Value.Uninitialized: true
                            nil: true
                            _: false
                        if needs_init:
                            let rhs_val = eval_expr(interp, rhs_expr)
                            let ok = interp.current_env.set(name, rhs_val)
                            if not ok:
                                throw "cannot initialize lazy variable '{name}'"
                        Value.Nil
                    else:
                        let cur_val = eval_expr(interp, target.clone())
                        match cur_val:
                            Value.Nil:
                                let rhs_val = eval_expr(interp, rhs_expr)
                                assign_target(interp, target, rhs_val)
                            _: nil
                        Value.Nil
                _:
                    let cur_val = eval_expr(interp, target.clone())
                    match cur_val:
                        Value.Nil:
                            let rhs_val = eval_expr(interp, rhs_expr)
                            assign_target(interp, target, rhs_val)
                        _: nil
                    Value.Nil

        ExprKind.Else(inner, default_expr):
            let v = eval_expr(interp, inner)
            match v:
                Value.Nil: eval_expr(interp, default_expr)
                _: v

        ExprKind.TryElse(inner, default_expr):
            let v = eval_expr(interp, inner)
            if interp.has_pending_throw:
                interp.has_pending_throw = false
                interp.pending_throw_val = Value.Nil
                eval_expr(interp, default_expr)
            else:
                match v:
                    Value.Nil: eval_expr(interp, default_expr)
                    _: v

        ExprKind.TryElseBlock(try_stmts, else_stmts):
            let child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block_fn(interp, try_stmts)
            interp.current_env = prev
            var threw_val = Value.Nil
            var has_throw = false
            match sig:
                ThrowSignal(v):
                    threw_val = v
                    has_throw = true
                _: nil
            if not has_throw and interp.has_pending_throw:
                threw_val = interp.take_pending_throw()
                has_throw = true
            if has_throw:
                let child2 = new_env(interp.current_env)
                child2.define("error", threw_val)
                let prev2 = interp.current_env
                interp.current_env = child2
                let sig2 = exec_block_fn(interp, else_stmts)
                interp.current_env = prev2
                match sig2:
                    ReturnSignal(v2): v2
                    _: Value.Nil
            else:
                match sig:
                    ReturnSignal(v): v
                    _: Value.Nil

        ExprKind.Loop(s):
            var break_val = Value.Nil
            while true:
                let child = new_env(interp.current_env)
                let prev = interp.current_env
                interp.current_env = child
                let sig = exec_block(interp, s.body)
                interp.current_env = prev
                match sig:
                    BreakSignal(v):
                        break_val = v
                        break
                    ReturnSignal(v): return v
                    ThrowSignal(v): return v
                    _: nil
            break_val

        ExprKind.DotIdent(variant_name):
            eval_dot_ident(interp, variant_name)

        ExprKind.Match(s):
            let subject = eval_expr(interp, s.subject)
            if interp.has_pending_throw:
                return Value.Nil
            eval_match(interp, subject, s.arms)

        ExprKind.Block(stmts):
            eval_block(interp, stmts)

        _:
            throw "unhandled expression kind"

# DotIdent: .Variant — search all known enums for a matching variant
def Value eval_dot_ident(Interpreter interp, string variant_name):
    for pair in interp.enum_decls.pairs():
        let ename = pair.0
        let decl = pair.1
        for variant in decl.variants:
            if variant.name == variant_name:
                return Value.EnumVariant(ename, variant_name, [])
    throw "unknown dot-prefix variant '.{variant_name}'"

# Evaluate a list of call arguments
def [Value] eval_args(Interpreter interp, [Arg] args):
    var vals = []
    for arg in args:
        let v = eval_expr(interp, arg.value)
        if let label = arg.label:
            vals.append(Value.Labeled(label, v))
        else:
            vals.append(v)
    vals

# Binary operation dispatch
def Value eval_binop(Interpreter interp, BinOp op, Expr lhs, Expr rhs):
    # Short-circuit logical ops
    match op:
        BinOp.And:
            let l = eval_expr(interp, lhs)
            match l:
                Value.Bool(false):
                    Value.Bool(false)
                Value.Bool(true):
                    let r = eval_expr(interp, rhs)
                    match r:
                        Value.Bool(b):
                            Value.Bool(b)
                        _:
                            throw "right side of 'and' must be bool"
                _:
                    throw "left side of 'and' must be bool"
        BinOp.Or:
            let l = eval_expr(interp, lhs)
            match l:
                Value.Bool(true):
                    Value.Bool(true)
                Value.Bool(false):
                    let r = eval_expr(interp, rhs)
                    match r:
                        Value.Bool(b):
                            Value.Bool(b)
                        _:
                            throw "right side of 'or' must be bool"
                _:
                    throw "left side of 'or' must be bool"
        _:
            let l = eval_expr(interp, lhs)
            let r = eval_expr(interp, rhs)
            apply_binop(op, l, r)

# Apply a binary operator to two already-evaluated values
def Value apply_binop(BinOp op, Value l, Value r):
    match op:
        BinOp.Add:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            Value.Int(a + b)
                        Value.Float(b):
                            Value.Float(a as float + b)
                        _:
                            throw "cannot add Int and {r.type_name()}"
                Value.Float(a):
                    match r:
                        Value.Float(b):
                            Value.Float(a + b)
                        Value.Int(b):
                            Value.Float(a + b as float)
                        _:
                            throw "cannot add Float and {r.type_name()}"
                Value.Str(a):
                    match r:
                        Value.Str(b):
                            Value.Str(a + b)
                        _:
                            throw "cannot add String and {r.type_name()}"
                Value.Array(a):
                    match r:
                        Value.Array(b):
                            var merged = a
                            for item in b:
                                merged.append(item)
                            Value.Array(merged)
                        _:
                            throw "cannot add Array and {r.type_name()}"
                _:
                    throw "cannot add {l.type_name()} and {r.type_name()}"
        BinOp.Sub:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            Value.Int(a - b)
                        Value.Float(b):
                            Value.Float(a as float - b)
                        _:
                            throw "cannot subtract {r.type_name()} from Int"
                Value.Float(a):
                    match r:
                        Value.Float(b):
                            Value.Float(a - b)
                        Value.Int(b):
                            Value.Float(a - b as float)
                        _:
                            throw "cannot subtract {r.type_name()} from Float"
                _:
                    throw "cannot subtract {r.type_name()} from {l.type_name()}"
        BinOp.Mul:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            Value.Int(a * b)
                        Value.Float(b):
                            Value.Float(a as float * b)
                        _:
                            throw "cannot multiply Int by {r.type_name()}"
                Value.Float(a):
                    match r:
                        Value.Float(b):
                            Value.Float(a * b)
                        Value.Int(b):
                            Value.Float(a * b as float)
                        _:
                            throw "cannot multiply Float by {r.type_name()}"
                _:
                    throw "cannot multiply {l.type_name()} and {r.type_name()}"
        BinOp.Div:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            if b == 0:
                                throw "division by zero"
                            Value.Int(a / b)
                        Value.Float(b):
                            Value.Float(a as float / b)
                        _:
                            throw "cannot divide Int by {r.type_name()}"
                Value.Float(a):
                    match r:
                        Value.Float(b):
                            Value.Float(a / b)
                        Value.Int(b):
                            Value.Float(a / b as float)
                        _:
                            throw "cannot divide Float by {r.type_name()}"
                _:
                    throw "cannot divide {l.type_name()} by {r.type_name()}"
        BinOp.Rem:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            if b == 0:
                                throw "remainder by zero"
                            Value.Int(a % b)
                        Value.Float(b):
                            Value.Float(a as float % b)
                        _:
                            throw "cannot remainder Int by {r.type_name()}"
                Value.Float(a):
                    match r:
                        Value.Float(b):
                            Value.Float(a % b)
                        Value.Int(b):
                            Value.Float(a % b as float)
                        _:
                            throw "cannot remainder Float by {r.type_name()}"
                _:
                    throw "cannot remainder {l.type_name()} by {r.type_name()}"
        BinOp.Eq:
            Value.Bool(l == r)
        BinOp.NotEq:
            Value.Bool(l != r)
        BinOp.Lt:
            Value.Bool(compare_values(l, r) < 0)
        BinOp.Gt:
            Value.Bool(compare_values(l, r) > 0)
        BinOp.LtEq:
            Value.Bool(compare_values(l, r) <= 0)
        BinOp.GtEq:
            Value.Bool(compare_values(l, r) >= 0)
        BinOp.BitAnd:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            Value.Int(a & b)
                        _:
                            throw "bitwise-and requires Int operands"
                _:
                    throw "bitwise-and requires Int operands"
        BinOp.BitOr:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            Value.Int(a | b)
                        _:
                            throw "bitwise-or requires Int operands"
                _:
                    throw "bitwise-or requires Int operands"
        BinOp.BitXor:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            Value.Int(a ^ b)
                        _:
                            throw "bitwise-xor requires Int operands"
                _:
                    throw "bitwise-xor requires Int operands"
        BinOp.Shl:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            if b < 0:
                                throw "shift amount cannot be negative"
                            Value.Int(a << b)
                        _:
                            throw "shift requires Int operands"
                _:
                    throw "shift requires Int operands"
        BinOp.Shr:
            match l:
                Value.Int(a):
                    match r:
                        Value.Int(b):
                            if b < 0:
                                throw "shift amount cannot be negative"
                            Value.Int(a >> b)
                        _:
                            throw "shift requires Int operands"
                _:
                    throw "shift requires Int operands"
        BinOp.Is:
            match r:
                Value.Nil:
                    Value.Bool(l == Value.Nil)
                Value.StructDef(type_name):
                    Value.Bool(l.type_name() == type_name)
                Value.EnumDef(type_name):
                    Value.Bool(l.type_name() == type_name)
                _:
                    Value.Bool(l.type_name() == r.type_name())
        BinOp.IsNot:
            match r:
                Value.Nil:
                    Value.Bool(l != Value.Nil)
                Value.StructDef(type_name):
                    Value.Bool(l.type_name() != type_name)
                Value.EnumDef(type_name):
                    Value.Bool(l.type_name() != type_name)
                _:
                    Value.Bool(l.type_name() != r.type_name())
        BinOp.RefEq:
            Value.Bool(l == r)
        BinOp.And:
            throw "And handled by short-circuit path"
        BinOp.Or:
            throw "Or handled by short-circuit path"

# Compare two values: returns negative/zero/positive
req int compare_values(Value l, Value r):
    match l:
        Value.Int(a):
            match r:
                Value.Int(b):
                    if a < b: -1
                    else if a > b: 1
                    else: 0
                Value.Float(b):
                    let af = a as float
                    if af < b: -1
                    else if af > b: 1
                    else: 0
                _:
                    throw "cannot compare Int and {r.type_name()}"
        Value.Float(a):
            match r:
                Value.Float(b):
                    if a < b: -1
                    else if a > b: 1
                    else: 0
                Value.Int(b):
                    let bf = b as float
                    if a < bf: -1
                    else if a > bf: 1
                    else: 0
                _:
                    throw "cannot compare Float and {r.type_name()}"
        Value.Str(a):
            match r:
                Value.Str(b):
                    if a < b: -1
                    else if a > b: 1
                    else: 0
                _:
                    throw "cannot compare String and {r.type_name()}"
        _:
            throw "cannot compare {l.type_name()} and {r.type_name()}"

# Field access on a value
def Value get_tuple_field([Value] elems, string field_name):
    if field_name == "length":
        return Value.Int(elems.length)
    if field_name == "0": return elems[0] else Value.Nil
    if field_name == "1": return elems[1] else Value.Nil
    if field_name == "2": return elems[2] else Value.Nil
    if field_name == "3": return elems[3] else Value.Nil
    if field_name == "4": return elems[4] else Value.Nil
    if field_name == "5": return elems[5] else Value.Nil
    if field_name == "6": return elems[6] else Value.Nil
    if field_name == "7": return elems[7] else Value.Nil
    throw "no field '{field_name}' on tuple"

def Value get_field(Interpreter interp, Value obj, string field_name):
    match obj:
        Value.Object(inner):
            let val_opt = inner.get_field(field_name)
            if let v = val_opt:
                v
            else:
                # Try calling as a zero-arg method
                let method_opt = interp.find_method(inner.type_name, field_name)
                if let _ = method_opt:
                    call_method(interp, Value.Object(inner), field_name, [])
                else:
                    throw "no field '{field_name}' on object of type {inner.type_name}"
        Value.EnumDef(type_name):
            # EnumDef.Variant → either a bare variant or a constructor fn
            Value.EnumVariant(type_name, field_name, [])
        Value.EnumVariant(type_name, variant, fields):
            if field_name == "type":
                Value.Str(type_name)
            else if field_name == "variant":
                Value.Str(variant)
            else:
                # Try calling as a zero-arg enum method
                let method_opt = interp.find_method(type_name, field_name)
                if let _ = method_opt:
                    call_method(interp, Value.EnumVariant(type_name, variant, fields), field_name, [])
                else:
                    throw "cannot access field '{field_name}' on enum variant"
        Value.Str(s):
            if field_name == "length":
                Value.Int(s.length)
            else:
                throw "no field '{field_name}' on string"
        Value.Array(items):
            if field_name == "length":
                Value.Int(items.length)
            else:
                throw "no field '{field_name}' on array"
        Value.Tuple(elems):
            get_tuple_field(elems, field_name)
        Value.Nil:
            throw "field access on nil"
        _:
            throw "cannot access field '{field_name}' on {obj.type_name()}"

# Index access on a value
def Value get_index(Interpreter interp, Value obj, Value idx):
    match obj:
        Value.Array(items):
            match idx:
                Value.Int(i):
                    if i < 0 or i >= items.length:
                        throw "array index {i} out of bounds (length {items.length})"
                    items[i]
                _:
                    throw "array index must be Int, got {idx.type_name()}"
        Value.Dict(entries):
            for entry in entries:
                if entry.0 == idx:
                    return entry.1
            throw "key not found in dict"
        Value.Str(s):
            match idx:
                Value.Int(i):
                    if i < 0 or i >= s.length:
                        throw "string index {i} out of bounds"
                    Value.Str(s.slice(i, i + 1))
                _:
                    throw "string index must be Int, got {idx.type_name()}"
        Value.Range(start, end, inclusive, _):
            match idx:
                Value.Int(i):
                    let actual = start + i
                    let limit = if inclusive: end + 1 else end
                    if actual >= limit:
                        throw "range index {i} out of bounds"
                    Value.Int(actual)
                _:
                    throw "range index must be Int"
        _:
            throw "cannot index into {obj.type_name()}"

# Call a value (function, closure, constructor)
def Value call_value(Interpreter interp, Value callee, [Value] args):
    match callee:
        Value.Fn(decl, captured_env):
            call_fn(interp, decl, captured_env, args)
        Value.Closure(params, body, captured_env):
            call_closure(interp, params, body, captured_env, args)
        Value.Struct(decl, captured_env):
            instantiate_struct(interp, decl, args)
        Value.EnumVariant(type_name, variant, _):
            Value.EnumVariant(type_name, variant, args)
        Value.NativeFn(func):
            func(args)
        _:
            throw "'{callee.type_name()}' is not callable"

# Call a method on a receiver value
def Value call_method(Interpreter interp, Value recv, string method, [Value] args):
    let recv_type2 = recv.type_name()
    match recv:
        Value.Object(obj):
            call_object_method(interp, obj, method, args)
        Value.EnumDef(type_name):
            # EnumDef.Variant(args) → construct enum variant
            Value.EnumVariant(type_name, method, args)
        Value.EnumVariant(type_name, variant, fields):
            # Delegate to struct-like enum methods
            call_enum_method(interp, type_name, variant, fields, method, args)
        Value.Array(items):
            call_array_method(interp, items, method, args)
        Value.Str(s):
            call_string_method(s, method, args)
        Value.Dict(entries):
            call_dict_method(interp, entries, method, args)
        Value.Set(items):
            call_set_method(interp, items, method, args)
        Value.Int(n):
            call_int_method(n, method, args)
        Value.Float(f):
            call_float_method(f, method, args)
        _:
            throw "no method '{method}' on {recv_type2}"

def bool string_gt(string a, string b):
    a > b

# Call built-in array methods
def Value call_array_method(Interpreter interp, var [Value] items, string method, [Value] args):
    match method:
        "length":
            Value.Int(items.length)
        "append":
            if args.length != 1:
                throw "append takes 1 argument"
            items.append(args[0])
            Value.Nil
        "pop":
            if items.length == 0:
                throw "pop on empty array"
            let last_idx = items.length - 1
            let last_val = items[last_idx]
            items.remove(last_idx)
            last_val
        "get":
            if args.length == 0:
                throw "get requires index argument"
            match args[0]:
                Value.Int(i):
                    if i < 0 or i >= items.length:
                        Value.Nil
                    else:
                        items[i]
                _:
                    throw "get index must be Int"
        "contains":
            if args.length != 1:
                throw "contains takes 1 argument"
            Value.Bool(items.contains(args[0]))
        "first":
            if items.length == 0:
                Value.Nil
            else:
                items[0]
        "last":
            if items.length == 0:
                Value.Nil
            else:
                items[items.length - 1]
        "reverse":
            var rev = []
            var i = items.length - 1
            while i >= 0:
                rev.append(items[i])
                i = i - 1
            Value.Array(rev)
        "join":
            let sep = if args.length > 0:
                match args[0]:
                    Value.Str(s): s
                    _: ""
            else:
                ""
            var result = ""
            var idx = 0
            while idx < items.length:
                if idx > 0:
                    result = result + sep
                match items[idx]:
                    Value.Str(s):
                        result = result + s
                    other:
                        result = result + display_value(interp, other)
                idx = idx + 1
            Value.Str(result)
        _:
            throw "no method '{method}' on Array"

# Call built-in string methods
def Value call_string_method(string s, string method, [Value] args):
    match method:
        "length":
            Value.Int(s.length)
        "contains":
            if args.length != 1:
                throw "contains takes 1 argument"
            match args[0]:
                Value.Str(sub):
                    Value.Bool(s.contains(sub))
                _:
                    throw "contains argument must be string"
        "starts_with":
            if args.length != 1:
                throw "starts_with takes 1 argument"
            match args[0]:
                Value.Str(prefix):
                    Value.Bool(s.startsWith(prefix))
                _:
                    throw "starts_with argument must be string"
        "ends_with":
            if args.length != 1:
                throw "ends_with takes 1 argument"
            match args[0]:
                Value.Str(suffix):
                    Value.Bool(s.endsWith(suffix))
                _:
                    throw "ends_with argument must be string"
        "to_upper":
            Value.Str(s.to_upper())
        "upper":
            Value.Str(s.to_upper())
        "to_lower":
            Value.Str(s.to_lower())
        "lower":
            Value.Str(s.to_lower())
        "trim":
            Value.Str(s.trim())
        "split":
            if args.length != 1:
                throw "split takes 1 argument"
            match args[0]:
                Value.Str(sep):
                    let parts = s.split(sep)
                    var result = []
                    for p in parts:
                        result.append(Value.Str(p))
                    Value.Array(result)
                _:
                    throw "split argument must be string"
        "replace":
            if args.length != 2:
                throw "replace takes 2 arguments"
            match args[0]:
                Value.Str(from):
                    match args[1]:
                        Value.Str(to):
                            Value.Str(s.replace(from, to))
                        _:
                            throw "replace second argument must be string"
                _:
                    throw "replace first argument must be string"
        "parse_int":
            let n = s.parse_int()
            if let v = n:
                Value.Int(v)
            else:
                Value.Nil
        "parse_float":
            let f = s.parse_float()
            if let v = f:
                Value.Float(v)
            else:
                Value.Nil
        _:
            throw "no method '{method}' on String"

# Call built-in dict methods
def Value call_dict_method(Interpreter interp, var [(Value, Value)] entries, string method, [Value] args):
    match method:
        "get":
            if args.length < 1:
                throw "get requires key argument"
            let key = args[0]
            let default_val = if args.length > 1: args[1] else: Value.Nil
            for entry in entries:
                if entry.0 == key:
                    entry.1
            default_val
        "set":
            if args.length != 2:
                throw "set requires key and value"
            let key = args[0]
            let val = args[1]
            var found = false
            var i = 0
            while i < entries.length and not found:
                if entries[i].0 == key:
                    entries[i] = (key, val)
                    found = true
                i = i + 1
            if not found:
                entries.append((key, val))
            Value.Nil
        "contains_key":
            if args.length != 1:
                throw "contains_key takes 1 argument"
            let key = args[0]
            var result = false
            for entry in entries:
                if entry.0 == key:
                    result = true
            Value.Bool(result)
        "keys":
            var result = []
            for entry in entries:
                result.append(entry.0)
            Value.Array(result)
        "values":
            var result = []
            for entry in entries:
                result.append(entry.1)
            Value.Array(result)
        "length":
            Value.Int(entries.length)
        _:
            throw "no method '{method}' on Dict"

# Call built-in set methods
def Value call_set_method(Interpreter interp, var [Value] items, string method, [Value] args):
    match method:
        "contains":
            if args.length != 1:
                throw "contains takes 1 argument"
            Value.Bool(items.contains(args[0]))
        "insert":
            if args.length != 1:
                throw "insert takes 1 argument"
            if not items.contains(args[0]):
                items.append(args[0])
            Value.Nil
        "remove":
            if args.length != 1:
                throw "remove takes 1 argument"
            var result = []
            for item in items:
                if item != args[0]:
                    result.append(item)
            items = result
            Value.Nil
        "length":
            Value.Int(items.length)
        _:
            throw "no method '{method}' on Set"

# Call built-in int methods
def Value call_int_method(int n, string method, [Value] args):
    match method:
        "abs":
            if n < 0:
                Value.Int(0 - n)
            else:
                Value.Int(n)
        "to_string":
            Value.Str("{n}")
        "as_float":
            Value.Float(n as float)
        _:
            throw "no method '{method}' on Int"

# Call built-in float methods
def Value call_float_method(float f, string method, [Value] args):
    match method:
        "abs":
            if f < 0.0:
                Value.Float(0.0 - f)
            else:
                Value.Float(f)
        "floor":
            Value.Int(f.floor() as int)
        "ceil":
            Value.Int(f.ceil() as int)
        "round":
            Value.Int(f.round() as int)
        "to_string":
            Value.Str("{f}")
        "sqrt":
            Value.Float(f.sqrt())
        _:
            throw "no method '{method}' on Float"

# Type cast
def Value cast_value(Interpreter interp, Value val, Type ty):
    let type_name = match ty:
        Type.Named(name): name
        Type.Int: "int"
        Type.Float: "float"
        Type.Bool: "bool"
        Type.Str: "string"
        Type.Uint: "uint"
        _: "unknown"
    match type_name:
        "int":
            match val:
                Value.Int(n): Value.Int(n)
                Value.Float(f): Value.Int(f as int)
                Value.Bool(b): if b: Value.Int(1) else: Value.Int(0)
                Value.Str(s):
                    let n = s.parse_int()
                    if let v = n:
                        Value.Int(v)
                    else:
                        throw "cannot cast string to int"
                _: throw "cannot cast {val.type_name()} to int"
        "float":
            match val:
                Value.Float(f): Value.Float(f)
                Value.Int(n): Value.Float(n as float)
                Value.Str(s):
                    let f = s.parse_float()
                    if let v = f:
                        Value.Float(v)
                    else:
                        throw "cannot cast string to float"
                _: throw "cannot cast {val.type_name()} to float"
        "string":
            Value.Str(display_value(interp, val))
        "bool":
            match val:
                Value.Bool(b): Value.Bool(b)
                Value.Int(n): Value.Bool(n != 0)
                Value.Nil: Value.Bool(false)
                _: Value.Bool(true)
        _:
            throw "unknown cast target type '{type_name}'"

# Runtime type check
req bool value_is_type(Interpreter interp, Value val, TypeRef ty) throws:
    let type_name = ty.name
    match type_name:
        "int":
            match val:
                Value.Int(_): true
                _: false
        "float":
            match val:
                Value.Float(_): true
                _: false
        "string":
            match val:
                Value.Str(_): true
                _: false
        "bool":
            match val:
                Value.Bool(_): true
                _: false
        "nil":
            match val:
                Value.Nil: true
                _: false
        _:
            val.type_name() == type_name

# Display a value as string for interpolation
req string display_value(Interpreter interp, Value val):
    match val:
        Value.Nil: "nil"
        Value.Bool(b): if b: "true" else: "false"
        Value.Int(n): "{n}"
        Value.Float(f): "{f}"
        Value.Str(s): s
        Value.Array(items):
            var result = "["
            var i = 0
            while i < items.length:
                if i > 0:
                    result = result + ", "
                result = result + display_value(interp, items[i])
                i = i + 1
            result + "]"
        Value.Dict(entries):
            var result = "{{"
            var i = 0
            while i < entries.length:
                if i > 0:
                    result = result + ", "
                result = result + display_value(interp, entries[i].0) + ": " + display_value(interp, entries[i].1)
                i = i + 1
            result + "}}"
        Value.Object(obj):
            obj.type_name.clone()
        Value.EnumVariant(type_name, variant, fields):
            if fields.length == 0:
                "{type_name}.{variant}"
            else:
                var result = "{type_name}.{variant}("
                var i = 0
                while i < fields.length:
                    if i > 0:
                        result = result + ", "
                    result = result + display_value(interp, fields[i])
                    i = i + 1
                result + ")"
        _:
            "<value>"

# Call a method on a struct object
def Value call_enum_method(Interpreter interp, string type_name, string variant, [Value] fields, string method, [Value] args):
    let method_decl_opt = interp.find_method(type_name, method)
    if let method_decl = method_decl_opt:
        let self_val = Value.EnumVariant(type_name, variant, fields)
        let child_env = push_scope(interp)
        env_define(interp, "self", self_val, false)
        var i = 0
        while i < method_decl.params.length and i < args.length:
            let param = method_decl.params[i]
            env_define(interp, param.name, args[i], param.mutable)
            i = i + 1
        let result = eval_block(interp, method_decl.body)
        pop_scope(interp)
        result
    else:
        throw "no method '{method}' on enum '{type_name}'"

def Value call_object_method(Interpreter interp, ObjectInner obj, string method, [Value] args):
    let type_name = obj.type_name
    let method_decl_opt = interp.find_method(type_name, method)
    if let method_decl = method_decl_opt:
        let child_env = push_scope(interp)
        env_define(interp, "self", Value.Object(obj), false)
        var i = 0
        while i < method_decl.params.length and i < args.length:
            let param = method_decl.params[i]
            env_define(interp, param.name, args[i], param.mutable)
            i = i + 1
        let result = eval_block(interp, method_decl.body)
        pop_scope(interp)
        result
    else:
        throw "no method '{method}' on type '{type_name}'"

# Evaluate a function call
def Value call_fn(mut Interpreter interp, FnDecl decl, Env? captured_env, [Value] args):
    let saved_env = interp.current_env
    interp.current_env = new_env(captured_env)
    var i = 0
    while i < decl.params.length and i < args.length:
        let param = decl.params[i]
        env_define(interp, param.name, args[i], param.mutable)
        i = i + 1
    let result = eval_block(interp, decl.body)
    interp.current_env = saved_env
    result

# Evaluate a closure call
def Value call_closure(mut Interpreter interp, [string] params, [Stmt] body, Env? captured_env, [Value] args):
    let saved_env = interp.current_env
    interp.current_env = new_env(captured_env)
    var i = 0
    while i < params.length and i < args.length:
        env_define(interp, params[i], args[i], false)
        i = i + 1
    let sig = exec_block_fn(interp, body)
    interp.current_env = saved_env
    match sig:
        ReturnSignal(v): v
        BreakSignal(v): v
        _: Value.Nil

# Evaluate a block of statements, returning the last expression value
def Value eval_block(Interpreter interp, [Stmt] stmts):
    var last = Value.Nil
    var i = 0
    while i < stmts.length:
        let stmt = stmts[i]
        if i == stmts.length - 1:
            last = eval_stmt_as_expr(interp, stmt)
        else:
            exec_stmt(interp, stmt)
        i = i + 1
    last

# Execute a statement (side-effects only)
def void exec_stmt(Interpreter interp, Stmt stmt):
    match stmt:
        Stmt.Expr(e):
            eval_expr(interp, e)
        Stmt.Let(name, expr, is_mutable, is_lazy):
            if is_lazy:
                interp.current_env.define_lazy(name)
            else:
                let val = eval_expr(interp, expr)
                env_define(interp, name, val, is_mutable)
        Stmt.Return(expr_opt):
            if let e = expr_opt:
                let val = eval_expr(interp, e)
                throw ReturnSignal(val)
            else:
                throw ReturnSignal(Value.Nil)
        Stmt.While(cond, body):
            var running = true
            while running:
                let cond_val = eval_expr(interp, cond)
                match cond_val:
                    Value.Bool(b):
                        if b:
                            let child = push_scope(interp)
                            eval_block(interp, body)
                            pop_scope(interp)
                        else:
                            running = false
                    _:
                        throw "while condition must be bool"
        Stmt.For(var_name, iter_expr, body):
            let iter_val = eval_expr(interp, iter_expr)
            match iter_val:
                Value.Array(items):
                    for item in items:
                        let child = push_scope(interp)
                        env_define(interp, var_name, item, false)
                        eval_block(interp, body)
                        pop_scope(interp)
                Value.Range(start, end, inclusive, _):
                    let limit = if inclusive: end + 1 else: end
                    var n = start
                    while n < limit:
                        let child = push_scope(interp)
                        env_define(interp, var_name, Value.Int(n), false)
                        eval_block(interp, body)
                        pop_scope(interp)
                        n = n + 1
                _:
                    throw "for loop requires iterable, got {iter_val.type_name()}"
        Stmt.Assign(target, expr):
            let val = eval_expr(interp, expr)
            assign_target(interp, target, val)
        Stmt.Throw(expr):
            let val = eval_expr(interp, expr)
            throw ExceptionSignal(val)
        _:
            throw "unhandled statement kind"

# Evaluate the last statement as an expression (for implicit return)
def Value eval_stmt_as_expr(Interpreter interp, Stmt stmt):
    match stmt:
        Stmt.Expr(e):
            eval_expr(interp, e)
        Stmt.If(s):
            exec_stmt(interp, Stmt.If(s))
            Value.Nil
        Stmt.Match(s):
            let subject = eval_expr(interp, s.subject)
            eval_match(interp, subject, s.arms)
        _:
            exec_stmt(interp, stmt)
            Value.Nil

# Match evaluation
def Value eval_match_body(Interpreter interp, MatchBody body):
    match body:
        MatchBody.Expr(e): eval_expr(interp, e)
        MatchBody.Block(stmts): eval_block(interp, stmts)

def Value eval_match(Interpreter interp, Value subject, [MatchArm] arms):
    for arm in arms:
        let [Binding]? matched = try_match_pattern(interp, subject, arm.patterns[0])
        if let bindings = matched:
            if let guard_cond = arm.match_guard:
                let child = push_scope(interp)
                for binding in bindings:
                    env_define(interp, binding.name, binding.value, false)
                let guard_val = eval_expr(interp, guard_cond)
                pop_scope(interp)
                match guard_val:
                    Value.Bool(true):
                        let child2 = push_scope(interp)
                        for binding in bindings:
                            env_define(interp, binding.name, binding.value, false)
                        let result = eval_match_body(interp, arm.body)
                        pop_scope(interp)
                        return result
                    _:
                        continue
            else:
                let child = push_scope(interp)
                for binding in bindings:
                    env_define(interp, binding.name, binding.value, false)
                let result = eval_match_body(interp, arm.body)
                pop_scope(interp)
                return result
    Value.Nil

# Try to match a value against a pattern, returning bindings or nil
req [Binding]? try_match_pattern(Interpreter interp, Value subject, Pattern pat):
    match pat:
        Pattern.Wildcard:
            []
        Pattern.Lit(lit):
            let lit_val = match lit:
                LitPattern.Int(n): Value.Int(n)
                LitPattern.Float(f): Value.Float(f)
                LitPattern.Str(s): Value.Str(s)
                LitPattern.Bool(b): Value.Bool(b)
                LitPattern.Nil: Value.Nil
            if value_equals(subject, lit_val):
                []
            else:
                nil
        Pattern.Bind(name):
            [Binding(name, subject)]
        Pattern.Variant(variant, sub_patterns):
            match subject:
                Value.EnumVariant(stype, svariant, sfields):
                    let unqualified = if variant.contains("."): variant.split(".")[1] else variant
                    if svariant == variant or svariant == unqualified:
                        if sub_patterns.length == 0:
                            []
                        else if sub_patterns.length == sfields.length:
                            var [Binding] all_bindings = []
                            var ok = true
                            var i = 0
                            while i < sub_patterns.length:
                                let [Binding]? sub_match = try_match_pattern(interp, sfields[i], sub_patterns[i])
                                if let sb = sub_match:
                                    for b in sb:
                                        all_bindings.append(b)
                                else:
                                    ok = false
                                i = i + 1
                            if ok: all_bindings else: nil
                        else:
                            nil
                    else:
                        nil
                Value.Object(inner):
                    # Struct destructure: MPoint(x, y) pattern on an object
                    if inner.type_name == variant:
                        if sub_patterns.length == 0:
                            []
                        else if sub_patterns.length == inner.fields.length:
                            var [Binding] all_bindings = []
                            var ok = true
                            var i = 0
                            while i < sub_patterns.length:
                                let fv = inner.fields[i].1
                                let [Binding]? sub_match = try_match_pattern(interp, fv, sub_patterns[i])
                                if let sb = sub_match:
                                    for b in sb:
                                        all_bindings.append(b)
                                else:
                                    ok = false
                                i = i + 1
                            if ok: all_bindings else: nil
                        else:
                            nil
                    else:
                        nil
                _:
                    nil
        Pattern.Tuple(sub_patterns):
            match subject:
                Value.Tuple(items):
                    if items.length == sub_patterns.length:
                        var [Binding] all_bindings = []
                        var ok = true
                        var i = 0
                        while i < sub_patterns.length:
                            let [Binding]? sub_match = try_match_pattern(interp, items[i], sub_patterns[i])
                            if let sb = sub_match:
                                for b in sb:
                                    all_bindings.append(b)
                            else:
                                ok = false
                            i = i + 1
                        if ok: all_bindings else: nil
                    else:
                        nil
                _:
                    nil
        Pattern.None:
            match subject:
                Value.Nil: []
                Value.EnumVariant(stype, svariant, sfields):
                    if svariant == "None" or svariant == "none": [] else nil
                _: nil
        Pattern.Some(inner):
            match subject:
                Value.Nil: nil
                Value.EnumVariant(stype, svariant, sfields):
                    # Match Some(inner) against an enum variant named Some/some
                    if svariant == "Some" or svariant == "some":
                        if sfields.length == 1:
                            try_match_pattern(interp, sfields[0], inner)
                        else:
                            # Multiple fields: match inner as a tuple
                            try_match_pattern(interp, Value.Tuple(sfields), inner)
                    else:
                        nil
                _: try_match_pattern(interp, subject, inner)
        _:
            nil

# Assignment to a target expression
def void assign_target(Interpreter interp, Expr target, Value val):
    match target.kind:
        ExprKind.Var(name):
            if interp.current_env.is_lazy(name):
                throw "cannot use '=' on lazy binding '{name}' — use '?=' instead"
            let ok = interp.current_env.set(name, val)
            if not ok:
                throw "cannot assign to immutable variable '{name}'"
        ExprKind.Field(obj_expr, field_name):
            let obj = eval_expr(interp, obj_expr)
            match obj:
                Value.Object(inner):
                    inner.set_field(field_name, val)
                _:
                    throw "cannot assign field on non-object"
        ExprKind.Index(obj_expr, idx_expr):
            let obj = eval_expr(interp, obj_expr)
            let idx = eval_expr(interp, idx_expr)
            match obj:
                Value.Array(items):
                    match idx:
                        Value.Int(i):
                            if i < 0 or i >= items.length:
                                throw "array index {i} out of bounds"
                            items[i] = val
                        _:
                            throw "array index must be Int"
                _:
                    throw "cannot index-assign into {obj.type_name()}"
        _:
            throw "invalid assignment target"

# Instantiate a struct from constructor args
def Value instantiate_struct(Interpreter interp, StructDecl decl, [Value] args):
    # Separate labeled and positional args
    var {string=Value} labeled = {}
    var positional = []
    for arg in args:
        match arg:
            Value.Labeled(label, v): labeled.set(label, v)
            _: positional.append(arg)
    var fields = []
    var pos_idx = 0
    for field in decl.fields:
        if labeled.has(field.name):
            fields.append((field.name, labeled[field.name]))
        elif pos_idx < positional.length:
            fields.append((field.name, positional[pos_idx]))
            pos_idx = pos_idx + 1
        else:
            var fval = Value.Nil
            if let default_expr = field.default:
                fval = eval_expr(interp, default_expr)
            fields.append((field.name, fval))
    let obj = ObjectInner(type_name: decl.name, fields: fields)
    Value.Object(obj)
