# == EVAL EXPR ==

# Environment helpers

def void env_define(mut Interpreter interp, string name, Value val, bool is_mutable):
    if is_mutable:
        interp.current_env.define_mut(name, val)
    else:
        interp.current_env.define(name, val)

def Env'actor push_scope(mut Interpreter interp):
    mut child = new_env(interp.current_env)
    interp.current_env = child.clone()
    child

def void pop_scope(mut Interpreter interp):
    let cur = interp.current_env
    let p_opt = cur.parent_opt()
    if let p = p_opt:
        interp.current_env = p

# Main expression evaluator

def Value eval_expr(mut Interpreter interp, Expr expr):
    match expr.kind:
        # Literals
        ExprKind.Int(n):
            Value.Int(n)
        ExprKind.Float(f):
            Value.Float64(f)
        ExprKind.Str(s):
            Value.Str(s)
        ExprKind.Bool(b):
            Value.Bool(b)
        ExprKind.Nil:
            Value.Nil

        ExprKind.Void:
            Value.Nil

        # Macro calls: format!, vec!, etc.
        ExprKind.MacroCall(macro_name, macro_args):
            let evaled_args = macro_args.map((a): eval_expr(interp, a))
            if macro_name == "vec":
                Value.Array(evaled_args)
            elif macro_name == "format" or macro_name == "println" or macro_name == "print":
                var formatted = ""
                if macro_args.length == 0:
                    formatted = ""
                else:
                    match macro_args[0].kind:
                        ExprKind.StringInterp(segments):
                            var arg_idx = 1
                            for seg in segments:
                                match seg:
                                    StringSegment.Lit(text):
                                        if text == "{}":
                                            if arg_idx < evaled_args.length:
                                                formatted = formatted + display_value(interp, evaled_args[arg_idx])
                                                arg_idx = arg_idx + 1
                                        elif text.length > 2 and text.slice(1, 2) == ":":
                                            if arg_idx < evaled_args.length:
                                                let spec = text.slice(2, text.length - 1)
                                                formatted = formatted + format_value(interp, evaled_args[arg_idx], spec)
                                                arg_idx = arg_idx + 1
                                        else:
                                            formatted = formatted + text
                                    StringSegment.Expr(e):
                                        formatted = formatted + display_value(interp, eval_expr(interp, e))
                                    StringSegment.FormattedExpr(e, fmt_spec):
                                        formatted = formatted + format_value(interp, eval_expr(interp, e), fmt_spec)
                        _:
                            formatted = display_value(interp, evaled_args[0])
                if macro_name == "format":
                    Value.Str(formatted)
                elif macro_name == "println":
                    print formatted
                    Value.Nil
                else:
                    write formatted
                    Value.Nil
            elif macro_name == "concat":
                var result = ""
                for v in evaled_args:
                    result = result + display_value(interp, v)
                Value.Str(result)
            elif macro_name == "assert":
                if evaled_args.length > 0:
                    let cond = evaled_args[0]
                    match cond:
                        Value.Bool(false): throw "assertion failed"
                        _: nil
                Value.Nil
            elif macro_name == "assert_eq":
                if evaled_args.length >= 2:
                    if not values_equal(evaled_args[0], evaled_args[1]):
                        throw "assert_eq failed"
                Value.Nil
            elif macro_name == "assert_ne":
                if evaled_args.length >= 2:
                    if values_equal(evaled_args[0], evaled_args[1]):
                        throw "assert_ne failed"
                Value.Nil
            elif macro_name == "panic":
                let msg = if evaled_args.length > 0: display_value(interp, evaled_args[0]) else: "panic"
                throw msg
            elif macro_name == "todo":
                throw "not implemented"
            elif macro_name == "dbg":
                if evaled_args.length > 0:
                    evaled_args[0]
                else:
                    Value.Nil
            else:
                Value.Nil

        # Variable lookup
        ExprKind.Var(name):
            let result = interp.current_env.get(name)
            if let val = result:
                match val:
                    Value.Uninitialized:
                        throw "variable '{name}' used before being assigned"
                    _:
                        val
            else:
                # Check implicit self field access
                let self_opt = interp.current_env.get("self")
                if let self_val = self_opt:
                    match self_val:
                        Value.Object(obj):
                            let field_opt = obj.get_field(name)
                            if let fval = field_opt:
                                fval
                            else:
                                throw "undefined variable '{name}'"
                        _:
                            throw "undefined variable '{name}'"
                else:
                    throw "undefined variable '{name}'"

        # Binary operations
        ExprKind.BinOp(op, left, right):
            eval_binop(interp, op, left, right)

        # Unary operations
        ExprKind.UnaryOp(op, inner):
            let val = eval_expr(interp, inner)
            match op:
                UnaryOp.Neg:
                    match val:
                        Value.Int(n):
                            Value.Int(0 - n)
                        Value.Float64(f):
                            Value.Float64(0.0 - f)
                        Value.Float32(f):
                            Value.Float32(0.0 - f)
                        Value.Object(neg_inner):
                            let neg_method_opt = interp.find_best_method(neg_inner.type_name, "neg", [])
                            if let _ = neg_method_opt:
                                call_method(interp, Value.Object(neg_inner), "neg", [])
                            else:
                                throw "cannot negate {neg_inner.type_name}"
                        _:
                            throw "cannot negate {val.type_name()}"
                UnaryOp.Not:
                    match val:
                        Value.Bool(b):
                            Value.Bool(not b)
                        _:
                            throw "expected bool for 'not', got {val.type_name()}"
                _:
                    throw "unhandled unary op"

        # Function/constructor call
        ExprKind.Call(callee_expr, args):
            let callee = eval_expr(interp, callee_expr)
            let hints = call_hint_types(interp, callee, args.length)
            let arg_vals = eval_args_with_hints(interp, args, hints)
            call_value(interp, callee, arg_vals)

        ExprKind.GenericCall(callee_expr2, _type_args, gen_args):
            # Ignore type args — evaluate as a regular call
            let gen_callee = eval_expr(interp, callee_expr2)
            let gen_hints = call_hint_types(interp, gen_callee, gen_args.length)
            let gen_arg_vals = eval_args_with_hints(interp, gen_args, gen_hints)
            call_value(interp, gen_callee, gen_arg_vals)

        # Pipe: `lhs |> name(args)` — free function if one exists, else method call.
        ExprKind.Pipe(left, method, args):
            let obj = eval_expr(interp, left)
            let fn_decl_opt = interp.get_fn_decl(method)
            if let fn_decl = fn_decl_opt:
                # `obj` is prepended as the first positional arg below, so its hint slot
                # (params[0]) doesn't apply to `args` — shift the hint list by one to line
                # params[1..] up with args[0..].
                let all_hints = fn_decl.params.map((p): p.ty)
                let extra_hints = if all_hints.length > 0: all_hints.slice(1, all_hints.length) else []
                let extra_args = eval_args_with_hints(interp, args, extra_hints)
                var all_args = [obj]
                for a in extra_args:
                    all_args.push(a)
                call_fn(interp, fn_decl, all_args, nil)
            else:
                let hints = method_hint_types(interp, obj, method, args.length)
                let extra_args = eval_args_with_hints(interp, args, hints)
                call_method(interp, obj, method, extra_args)

        # Method call
        ExprKind.MethodCall(recv_expr, method, args):
            let recv = eval_expr(interp, recv_expr)
            check_mutating_method_call(interp, recv_expr, recv, method)
            let hints = method_hint_types(interp, recv, method, args.length)
            let arg_vals = eval_args_with_hints(interp, args, hints)
            let result = call_method(interp, recv, method, arg_vals)
            # Write back mutating array methods to their source lvalue
            if method == "pop":
                match recv:
                    Value.Array(arr):
                        let n = arr.length
                        if n > 0:
                            var new_arr = arr
                            new_arr.remove(n - 1)
                            assign_target(interp, recv_expr, Value.Array(new_arr))
                    _: nil
            elif method == "remove":
                match recv:
                    Value.Array(arr):
                        let arr_len = arr.length
                        let idx_val = arg_vals[0] else Value.Int(0)
                        match idx_val:
                            Value.Int(idx):
                                let actual_idx = if idx < 0: arr_len + idx else idx
                                var new_arr = arr
                                new_arr.remove(actual_idx)
                                assign_target(interp, recv_expr, Value.Array(new_arr))
                            _: nil
                    Value.Dict(_):
                        assign_target(interp, recv_expr, result)
                    Value.Set(_):
                        assign_target(interp, recv_expr, result)
                    _: nil
            elif method == "push" or method == "append":
                match result:
                    Value.Array(_): assign_target(interp, recv_expr, result)
                    _: nil
            elif method == "insert":
                match result:
                    Value.Array(_): assign_target(interp, recv_expr, result)
                    _: nil
            elif method == "set" or method == "put":
                match result:
                    Value.Dict(_): assign_target(interp, recv_expr, result)
                    _: nil
            elif method == "add":
                match result:
                    Value.Set(_): assign_target(interp, recv_expr, result)
                    _: nil
            result

        # Field access
        ExprKind.Field(obj_expr, field_name):
            let obj = eval_expr(interp, obj_expr)
            get_field(interp, obj, field_name)

        ExprKind.OptionalField(obj_expr, field_name):
            let obj = eval_expr(interp, obj_expr)
            match obj:
                Value.Nil: Value.Nil
                _: get_field(interp, obj, field_name)

        ExprKind.OptionalMethodCall(recv_expr, method, args):
            let recv = eval_expr(interp, recv_expr)
            match recv:
                Value.Nil: Value.Nil
                _:
                    let hints = method_hint_types(interp, recv, method, args.length)
                    let arg_vals = eval_args_with_hints(interp, args, hints)
                    call_method(interp, recv, method, arg_vals)

        # Index access
        ExprKind.Index(obj_expr, idx_expr):
            match idx_expr.kind:
                # Slice: a[M..N], a[..N], a[M..], a[..]
                ExprKind.SliceRange(start_expr, end_expr, inclusive):
                    let obj = eval_expr(interp, obj_expr)
                    let items = match obj:
                        Value.Array(v): v
                        _: throw "slice requires an array, got {obj.type_name()}"
                    let len = items.length
                    var lo = 0
                    if not (start_expr.kind == ExprKind.Hole):
                        let sv = eval_expr(interp, start_expr)
                        let i = match sv:
                            Value.Int(n): n
                            _: throw "slice start must be int"
                        lo = if i < 0: (len + i).max(0) else i.min(len)
                    var hi = len
                    if not (end_expr.kind == ExprKind.Hole):
                        let ev = eval_expr(interp, end_expr)
                        let i = match ev:
                            Value.Int(n): n
                            _: throw "slice end must be int"
                        let adj = if inclusive: i + 1 else i
                        hi = if adj < 0: (len + adj).max(0) else adj.min(len)
                    if lo >= len or lo >= hi:
                        Value.Array([])
                    else:
                        var result = []
                        var k = lo
                        while k < hi:
                            result.push(items[k])
                            k += 1
                        Value.Array(result)
                _:
                    let obj = eval_expr(interp, obj_expr)
                    let idx = eval_expr(interp, idx_expr)
                    get_index(interp, obj, idx)

        # Labeled multi-dim array indexing: a[width = w, height = h]
        # (docs/array-multidim-types.md). Order-free at the use site — labels
        # are matched by name against the value's own axes, not by argument
        # position.
        ExprKind.LabeledIndex(obj_expr, args):
            let obj = eval_expr(interp, obj_expr)
            match obj:
                Value.LabeledArray(elems, axes):
                    let offset = labeled_flat_offset(interp, args, axes)
                    if offset < 0 or offset >= elems.length:
                        throw "labeled array index out of bounds (length {elems.length})"
                    elems[offset]
                _:
                    throw "labeled index requires a labeled array, got {obj.type_name()}"

        # Array literal
        ExprKind.Array(elems):
            var vals = []
            for item in elems:
                vals.push(eval_expr(interp, item))
            Value.Array(vals)

        ExprKind.ArrayFill(value_expr, count_expr):
            let count_val = eval_expr(interp, count_expr)
            let n = match count_val:
                Value.Int(n): n
                _: throw "array fill count must be int, got {count_val.type_name()}"
            let v = eval_expr(interp, value_expr)
            var result = []
            for _ in 0..n:
                result.push(v)
            Value.Array(result)

        ExprKind.ArrayComp(comp_expr, var_name, count_expr):
            let count_val = eval_expr(interp, count_expr)
            let n = match count_val:
                Value.Int(n): n
                _: throw "array comp count must be int, got {count_val.type_name()}"
            var result = []
            for i in 0..n:
                env_define(interp, var_name, Value.Int(i), false)
                result.push(eval_expr(interp, comp_expr))
            Value.Array(result)

        ExprKind.ArrayCompIter(comp_expr, var_name, iter_expr):
            let col_val = eval_expr(interp, iter_expr)
            let elems = match col_val:
                Value.Array(v): v
                _: throw "array comprehension source must be an array, got {col_val.type_name()}"
            var result = []
            for item in elems:
                env_define(interp, var_name, item, false)
                result.push(eval_expr(interp, comp_expr))
            Value.Array(result)

        # Labeled multi-dim array comprehension (docs/array-multidim-types.md)
        # — both the chained-for form (`for w in ..W for h in ..H`) and the
        # shape-only fill shorthand (`for width = w, height = h`) parse to
        # this same node; clauses[0] is axis 0 (fastest-varying, matching
        # row-major storage).
        ExprKind.LabeledArrayComp(comp_expr, clauses):
            var sizes = []
            for c in clauses:
                let cv = eval_expr(interp, c.1)
                match cv:
                    Value.Int(n): sizes.push(n)
                    _: throw "labeled array comprehension count for '{c.0}' must be int, got {cv.type_name()}"
            var total = 1
            var si = 0
            while si < sizes.length:
                total = total * sizes[si]
                si = si + 1
            var elems = []
            var flat = 0
            while flat < total:
                # Decompose the flat index back into per-axis indices —
                # axis 0 fastest-varying — and bind each as the clause's own
                # loop variable before evaluating one element.
                var rem = flat
                var ci = 0
                while ci < clauses.length:
                    let ax_size = sizes[ci]
                    let ax_idx = rem % ax_size
                    rem = rem / ax_size
                    env_define(interp, clauses[ci].0, Value.Int(ax_idx), false)
                    ci = ci + 1
                elems.push(eval_expr(interp, comp_expr))
                flat = flat + 1
            var axes = []
            var ai = 0
            while ai < clauses.length:
                axes.push((clauses[ai].0, sizes[ai]))
                ai = ai + 1
            Value.LabeledArray(elems, axes)

        # Cross-label relabeling: `a as [line = width, column = height]`
        # (docs/array-multidim-types.md, "Cross-label compatibility"). Shape
        # is threaded positionally (matched against the SOURCE label, kept in
        # the mapping's own target-label order) — never a copy, same buffer.
        ExprKind.RelabelCast(inner_expr, pairs):
            let inner = eval_expr(interp, inner_expr)
            match inner:
                Value.LabeledArray(elems, axes):
                    var new_axes = []
                    for pair in pairs:
                        var found = false
                        for ax in axes:
                            if ax.0 == pair.1:
                                new_axes.push((pair.0, ax.1))
                                found = true
                        if not found:
                            throw "relabel cast: source label '{pair.1}' not found on array"
                    Value.LabeledArray(elems, new_axes)
                _:
                    throw "relabel cast (`as [...]`) requires a labeled array, got {inner.type_name()}"

        # Tuple literal
        ExprKind.Tuple(elems):
            var vals = []
            for item in elems:
                vals.push(eval_expr(interp, item))
            Value.Tuple(vals)

        # Do block (inline block expression)
        ExprKind.Do(stmts):
            mut child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block_do(interp, stmts)
            interp.current_env = prev
            if interp.has_pending_return:
                return Value.Nil
            match sig:
                YieldSignal(v, _): v
                ReturnSignal(v):
                    interp.set_pending_return(v)
                    Value.Nil
                BreakSignal(v): v
                _: Value.Nil

        # Dict literal
        ExprKind.Dict(pairs):
            var entries = []
            for pair in pairs:
                let k = eval_expr(interp, pair.0)
                let v = eval_expr(interp, pair.1)
                entries.push((k, v))
            Value.Dict(entries)

        # Set literal
        ExprKind.Set(elems):
            var vals = []
            for item in elems:
                let v = eval_expr(interp, item)
                if not vals.contains(v):
                    vals.push(v)
            Value.Set(vals)

        # String interpolation
        ExprKind.StringInterp(segments):
            var result = ""
            for seg in segments:
                match seg:
                    StringSegment.Lit(text):
                        result = result + text
                    StringSegment.Expr(e):
                        let v = eval_expr(interp, e)
                        result = result + display_value(interp, v)
                    StringSegment.FormattedExpr(e, fmt_spec):
                        let v = eval_expr(interp, e)
                        result = result + format_value(interp, v, fmt_spec)
            Value.Str(result)

        # Closure
        ExprKind.Closure(params, _, body, _, _):
            Value.Closure(params, body, interp.current_env)

        # Type cast
        ExprKind.Cast(inner_expr, ty):
            let val = eval_expr(interp, inner_expr)
            cast_value(interp, val, ty)

        # Range
        ExprKind.Range(start_expr, end_expr, inclusive):
            let s = eval_expr(interp, start_expr)
            let e = eval_expr(interp, end_expr)
            match s:
                Value.Int(a):
                    match e:
                        Value.Int(b):
                            Value.Range(a, b, inclusive, 1)
                        _:
                            throw "range end must be Int, got {e.type_name()}"
                _:
                    throw "range start must be Int, got {s.type_name()}"

        # If expression
        ExprKind.If(s):
            var result_val = Value.Nil
            var handled = false
            for branch in s.branches:
                if not handled:
                    let cond_val = eval_expr(interp, branch.cond)
                    match cond_val:
                        Value.Bool(b):
                            if b:
                                let child = push_scope(interp)
                                result_val = eval_block(interp, branch.body)
                                pop_scope(interp)
                                handled = true
                        _:
                            throw "condition must be bool"
            if not handled:
                if let else_body = s.else_body:
                    let child = push_scope(interp)
                    result_val = eval_block(interp, else_body)
                    pop_scope(interp)
            result_val

        ExprKind.Assign(target, val_expr):
            let val = eval_expr(interp, val_expr)
            assign_target(interp, target, val)
            Value.Nil

        ExprKind.QuestionAssign(target, rhs_expr):
            match target.kind:
                ExprKind.Var(name):
                    if interp.current_env.is_lazy(name):
                        let cur = interp.current_env.get(name)
                        var needs_init = cur == nil
                        if let cur_val = cur:
                            if cur_val == Value.Uninitialized:
                                needs_init = true
                        if needs_init:
                            let rhs_val = eval_expr(interp, rhs_expr)
                            let ok = interp.current_env.set(name, rhs_val)
                            if not ok:
                                throw "cannot initialize lazy variable '{name}'"
                        Value.Nil
                    else:
                        let cur_val = eval_expr(interp, target.clone())
                        match cur_val:
                            Value.Nil:
                                let rhs_val = eval_expr(interp, rhs_expr)
                                assign_target(interp, target, rhs_val)
                            _: nil
                        Value.Nil
                _:
                    let cur_val = eval_expr(interp, target.clone())
                    match cur_val:
                        Value.Nil:
                            let rhs_val = eval_expr(interp, rhs_expr)
                            assign_target(interp, target, rhs_val)
                        _: nil
                    Value.Nil

        ExprKind.Else(inner, default_expr):
            let v = eval_expr(interp, inner)
            match v:
                Value.Nil: eval_expr(interp, default_expr)
                _: v

        ExprKind.TryElse(inner, default_expr):
            let v = eval_expr(interp, inner)
            if interp.has_pending_throw:
                interp.has_pending_throw = false
                interp.pending_throw_val = Value.Nil
                eval_expr(interp, default_expr)
            else:
                match v:
                    Value.Nil: eval_expr(interp, default_expr)
                    _: v

        ExprKind.TryElseBlock(try_stmts, else_stmts):
            mut child = new_env(interp.current_env)
            let prev = interp.current_env
            interp.current_env = child
            let sig = exec_block_fn(interp, try_stmts)
            interp.current_env = prev
            var threw_val = Value.Nil
            var has_throw = false
            match sig:
                ThrowSignal(v):
                    threw_val = v
                    has_throw = true
                _: nil
            if not has_throw and interp.has_pending_throw:
                threw_val = interp.take_pending_throw()
                has_throw = true
            if has_throw:
                mut child2 = new_env(interp.current_env)
                child2.define("error", threw_val)
                let prev2 = interp.current_env
                interp.current_env = child2
                let sig2 = exec_block_fn(interp, else_stmts)
                interp.current_env = prev2
                match sig2:
                    ReturnSignal(v2): v2
                    _: Value.Nil
            else:
                match sig:
                    ReturnSignal(v): v
                    _: Value.Nil

        ExprKind.Loop(s):
            var break_val = Value.Nil
            while true:
                mut child = new_env(interp.current_env)
                let prev = interp.current_env
                interp.current_env = child
                let sig = exec_block(interp, s.body)
                interp.current_env = prev
                match sig:
                    BreakSignal(v):
                        break_val = v
                        break
                    ReturnSignal(v): return v
                    ThrowSignal(v): return v
                    _: nil
            break_val

        ExprKind.DotIdent(variant_name):
            eval_dot_ident(interp, variant_name)

        ExprKind.Match(s):
            let subject = eval_expr(interp, s.subject)
            if interp.has_pending_throw:
                return Value.Nil
            eval_match(interp, subject, s.arms)

        ExprKind.Block(stmts):
            eval_block(interp, stmts)

        ExprKind.Task(inner):
            # Synchronous task: evaluate immediately, wrap in {value: result, wait: nil}
            let task_val = eval_expr(interp, inner)
            let task_obj = make_object("__Task__", [("value", task_val), ("wait", Value.Nil)])
            Value.Object(task_obj)

        ExprKind.TaskWithTimeout(timeout_expr, inner):
            let task_val2 = eval_expr(interp, inner)
            let task_obj2 = make_object("__Task__", [("value", task_val2), ("wait", Value.Nil)])
            Value.Object(task_obj2)

        ExprKind.JoinAll(exprs):
            var results = [Value]{}
            for e in exprs:
                let join_val = eval_expr(interp, e)
                # Extract .value from task objects synchronously
                let tn = task_obj_type_name(join_val)
                if tn == "__Task__":
                    results.push(task_obj_get_value(join_val))
                else:
                    results.push(join_val)
            Value.Array(results)

        _:
            throw "unhandled expression kind"

# DotIdent: .Variant — search all known enums for a matching variant. Ambiguous when more
# than one enum defines the same variant name — mirrors the Rust interpreter's ambiguous-
# scan error (src/interpreter/eval_expr.rs) instead of silently returning whichever enum
# happens to be registered first, which could resolve to the wrong enum with no warning.
def Value eval_dot_ident(mut Interpreter interp, string variant_name):
    var found = Value.Nil
    var has_found = false
    var ambiguous = false
    for ename, decl in interp.enum_decls:
        for variant in decl.variants:
            if variant.name == variant_name:
                if has_found:
                    ambiguous = true
                found = Value.EnumVariant(ename, variant_name, [])
                has_found = true
    if ambiguous:
        throw "ambiguous dot-prefix '.{variant_name}': multiple enums define this variant; use EnumName.{variant_name} instead"
    if has_found:
        return found
    throw "unknown dot-prefix variant '.{variant_name}'"

# Extracts the base struct/enum name from a type, stripping any ownership qualifier —
# mirrors Interpreter::type_base_name (src/interpreter/exec.rs). Returns nil for anything
# that isn't a (possibly `'qualified`) Named type.
def string? type_base_name(Type ty):
    match ty:
        Type.Named(n): some(n)
        Type.Qualified(inner, _):
            match inner:
                Type.Named(n2): some(n2)
                _: nil
        _: nil

# Resolve `.Variant` against a known expected type — a function/method parameter's
# declared type, or the enclosing function's declared return type (see
# Interpreter.current_return_ty) — instead of eval_dot_ident's ambiguous-scan default.
# Returns nil when `hint_ty` doesn't name a known enum with this variant; callers fall
# back to eval_dot_ident in that case, which still resolves the unambiguous case and
# throws on a genuine unresolved collision. Mirrors resolve_dot_ident_hint
# (src/interpreter/exec.rs).
def Value? eval_dot_ident_hint(mut Interpreter interp, string variant_name, Type hint_ty):
    let base_opt = type_base_name(hint_ty)
    if let base = base_opt:
        let decl_opt = interp.get_enum_decl(base)
        if let decl = decl_opt:
            for variant in decl.variants:
                if variant.name == variant_name:
                    # decl.name rather than reusing `base` — get_enum_decl takes its
                    # `name` param by value, and decl.name is a distinct fresh read.
                    return some(Value.EnumVariant(decl.name, variant_name, []))
    nil

# Same as `eval_args`, but resolves a `.Variant` argument against a per-position expected
# type (matched positionally, via eval_dot_ident_hint) instead of falling straight to
# eval_expr's ambiguous-scan default. `hints` shorter than `args` (or empty, as eval_args
# passes) just means later/all args get no hint and fall back to the plain path — mirrors
# eval_args_with_hints (src/interpreter/eval_expr.rs).
def [Value] eval_args_with_hints(mut Interpreter interp, [Arg] args, [Type?] hints):
    var vals = []
    var i = 0
    while i < args.length:
        let arg = args[i]
        if arg.default_rest:
            # Bare `_` — carries no value of its own (`arg.value` is an unused
            # placeholder, see `Arg.default_rest`'s doc), so skip evaluating it
            # entirely and pass a sentinel through instead. Picked up by
            # `instantiate_struct`, which fills every field the call didn't
            # otherwise provide with its declared per-type default — the
            # interpreter's analog of the transpiler's `..Default::default()`.
            vals.push(Value.Labeled("..default_rest..", Value.Nil))
            i += 1
            continue
        var v = Value.Nil
        var hinted = false
        if i < hints.length:
            let hint_opt = hints[i]
            if let hint = hint_opt:
                match arg.value.kind:
                    ExprKind.DotIdent(variant_name):
                        let resolved = eval_dot_ident_hint(interp, variant_name, hint)
                        if let rv = resolved:
                            v = rv
                            hinted = true
                    _: nil
        if not hinted:
            v = eval_expr(interp, arg.value)
        if arg.spread:
            # Spread: expand struct fields as labeled args
            match v:
                Value.Object(spread_inner):
                    for field in spread_inner.fields:
                        vals.push(Value.Labeled(field.0, field.1))
                _: vals.push(v)
        else:
            let label_opt = arg.label
            if let label = label_opt:
                vals.push(Value.Labeled(label, v))
            else:
                vals.push(v)
        i += 1
    vals

# Per-position `.Variant` hints (see eval_dot_ident_hint) for a free-function call, built
# from the callee's own declared param types. `Value.OverloadedFn` doesn't have one
# settled FnDecl — the real overload is only picked by resolve_overload once the args
# are evaluated — so it collects every arity-compatible variant's FnDecl and defers to
# merged_overload_hint_types for the same arity-filtered, enum-only-consensus hint
# struct/enum method overloads already get via method_hint_types. Closures, native fns,
# and constructors get no hints, same as before this existed.
def [Type?] call_hint_types(mut Interpreter interp, Value callee, int arg_count):
    match callee:
        Value.Fn(name, _):
            let decl_opt = interp.get_fn_decl(name)
            if let decl = decl_opt:
                return decl.params.map((p): p.ty)
            []
        Value.OverloadedFn(_, variants):
            var [FnDecl] candidates = []
            for v in variants:
                match v:
                    Value.Fn(vname, _):
                        let d_opt = interp.get_fn_decl(vname)
                        if let d = d_opt:
                            candidates.push(d)
                    _: nil
            if candidates.length == 1:
                return candidates[0].params.map((p): p.ty)
            if candidates.length > 1:
                return merged_overload_hint_types(interp, candidates, arg_count)
            []
        _: []

# For an overloaded call (several same-named candidate FnDecls — a struct/enum method
# resolved via find_best_method, or in principle a free-function OverloadedFn once
# resolve_overload becomes argument-type-aware), build a per-position `.Variant` hint —
# mirrors merged_overload_param_hints (src/interpreter/exec.rs). The real overload is
# only picked once the args are evaluated (find_best_method needs runtime `[Value]`s),
# so position i only gets a hint when every arity-compatible candidate agrees on a
# single *enum* there: a candidate whose declared type at `i` isn't a known enum (an
# `int` overload alongside a `TrafficLight` one) is simply irrelevant — a `.Variant`
# argument could never resolve against it anyway, so it doesn't block the hint. Two
# *different* enums at the same position is genuine ambiguity — picking one would
# silently guess which overload gets called — so that still yields no hint, falling
# back to eval_dot_ident's ambiguous-scan default exactly as for a non-overloaded call.
def [Type?] merged_overload_hint_types(mut Interpreter interp, [FnDecl] candidates, int arg_count):
    var applicable = [FnDecl]{}
    for d in candidates:
        var min_a = 0
        var pi = 0
        while pi < d.params.length:
            if d.params[pi].default == nil:
                min_a = min_a + 1
            pi += 1
        if arg_count >= min_a and arg_count <= d.params.length:
            applicable.push(d)
    var [Type?] hints = []
    var i = 0
    while i < arg_count:
        var [string] distinct_bases = []
        var Type? chosen = nil
        for d in applicable:
            if i < d.params.length:
                let ty_opt = d.params[i].ty
                if let ty = ty_opt:
                    let base_opt = type_base_name(ty)
                    if let base = base_opt:
                        if not distinct_bases.contains(base):
                            let decl_opt = interp.get_enum_decl(base)
                            if let decl = decl_opt:
                                # decl.name rather than reusing `base` — get_enum_decl
                                # moves its `name` param (see eval_dot_ident_hint).
                                distinct_bases.push(decl.name)
                                chosen = ty
        var Type? hint = nil
        if distinct_bases.length == 1:
            hint = chosen
        hints.push(hint)
        i += 1
    hints

# Per-position `.Variant` hints for a method call, from the receiver's own type — see
# call_hint_types / merged_overload_hint_types. Collects every same-named candidate on
# the receiver's type (a type may have several — overloads, now resolved by
# find_best_method at the actual call_method dispatch below) rather than find_method's
# "first match", so an overloaded method gets the same merged-consensus hint a free
# OverloadedFn call does.
def [Type?] method_hint_types(mut Interpreter interp, Value recv, string method_name, int arg_count):
    let type_name = recv.type_name()
    let methods_opt = interp.struct_methods.get(type_name)
    if let methods = methods_opt:
        var candidates = [FnDecl]{}
        for m in methods:
            if m.name == method_name:
                candidates.push(m)
        if candidates.length == 1:
            return candidates[0].params.map((p): p.ty)
        if candidates.length > 1:
            return merged_overload_hint_types(interp, candidates, arg_count)
    []

# Binary operation dispatch
def Value eval_binop(mut Interpreter interp, BinOp op, Expr lhs, Expr rhs):
    # Short-circuit logical ops
    match op:
        BinOp.And:
            let l = eval_expr(interp, lhs)
            match l:
                Value.Bool(false):
                    Value.Bool(false)
                Value.Bool(true):
                    let r = eval_expr(interp, rhs)
                    match r:
                        Value.Bool(b):
                            Value.Bool(b)
                        _:
                            throw "right side of 'and' must be bool"
                _:
                    throw "left side of 'and' must be bool"
        BinOp.Or:
            let l = eval_expr(interp, lhs)
            match l:
                Value.Bool(true):
                    Value.Bool(true)
                Value.Bool(false):
                    let r = eval_expr(interp, rhs)
                    match r:
                        Value.Bool(b):
                            Value.Bool(b)
                        _:
                            throw "right side of 'or' must be bool"
                _:
                    throw "left side of 'or' must be bool"
        _:
            var l = eval_expr(interp, lhs)
            var r = eval_expr(interp, rhs)
            let coerced = coerce_float_literal_pair(l, r, lhs, rhs)
            l = coerced.0
            r = coerced.1
            # Operator overloading: dispatch to struct methods
            var string? ov_method = nil
            if op == BinOp.Add: ov_method = "add"
            elif op == BinOp.Sub: ov_method = "sub"
            elif op == BinOp.Mul: ov_method = "mul"
            elif op == BinOp.Div: ov_method = "div"
            elif op == BinOp.Rem: ov_method = "rem"
            elif op == BinOp.Eq or op == BinOp.NotEq: ov_method = "eq"
            elif op == BinOp.Lt: ov_method = "lt"
            elif op == BinOp.Gt: ov_method = "gt"
            elif op == BinOp.LtEq: ov_method = "le"
            elif op == BinOp.GtEq: ov_method = "ge"
            if let mname = ov_method:
                match l:
                    Value.Object(ov_inner):
                        let ov_found = interp.find_best_method(ov_inner.type_name, mname, [r.clone()])
                        if let _ = ov_found:
                            # Recompute the method name to avoid a move issue
                            var string ov_call_name = "eq"
                            if op == BinOp.Add: ov_call_name = "add"
                            elif op == BinOp.Sub: ov_call_name = "sub"
                            elif op == BinOp.Mul: ov_call_name = "mul"
                            elif op == BinOp.Div: ov_call_name = "div"
                            elif op == BinOp.Rem: ov_call_name = "rem"
                            elif op == BinOp.Lt: ov_call_name = "lt"
                            elif op == BinOp.Gt: ov_call_name = "gt"
                            elif op == BinOp.LtEq: ov_call_name = "le"
                            elif op == BinOp.GtEq: ov_call_name = "ge"
                            let raw = call_method(interp, Value.Object(ov_inner), ov_call_name, [r])
                            if op == BinOp.NotEq:
                                match raw:
                                    Value.Bool(b): Value.Bool(not b)
                                    _: raw
                            else:
                                raw
                        else:
                            apply_binop(op, Value.Object(ov_inner), r)
                    _:
                        apply_binop(op, l, r)
            else:
                apply_binop(op, l, r)

# ─── Generic numeric kind model ──────────────────────────────────────────────
#
# Same-kind arithmetic and mixing a fixed-width kind with the flexible bare
# Int/Uint kind are handled generically here instead of one hand-written match
# arm per pair — with 12 numeric kinds that would mean up to 144 arms per
# operator. Mixing two *distinct* explicit fixed-width kinds directly
# (`a_uint16 + a_int32`) is unsupported — falls through to the caller's
# "cannot <op> X and Y" error, requiring an explicit `as` cast first, mirroring
# Rust's own refusal to implicitly coerce between distinct integer types.

enum NumKind:
    Int
    Uint
    Uint8
    Int8
    Int16
    Int32
    Int64
    Int128
    Uint16
    Uint32
    Uint64
    Uint128

NumKind? num_kind_of(Value v):
    match v:
        Value.Int(_): NumKind.Int
        Value.Uint(_): NumKind.Uint
        Value.Uint8(_): NumKind.Uint8
        Value.Int8(_): NumKind.Int8
        Value.Int16(_): NumKind.Int16
        Value.Int32(_): NumKind.Int32
        Value.Int64(_): NumKind.Int64
        Value.Int128(_): NumKind.Int128
        Value.Uint16(_): NumKind.Uint16
        Value.Uint32(_): NumKind.Uint32
        Value.Uint64(_): NumKind.Uint64
        Value.Uint128(_): NumKind.Uint128
        _: nil

int num_kind_bits(NumKind k):
    match k:
        NumKind.Int8: 8
        NumKind.Uint8: 8
        NumKind.Int16: 16
        NumKind.Uint16: 16
        NumKind.Int32: 32
        NumKind.Uint32: 32
        NumKind.Int128: 128
        NumKind.Uint128: 128
        _: 64

bool num_kind_signed(NumKind k):
    match k:
        NumKind.Int: true
        NumKind.Int8: true
        NumKind.Int16: true
        NumKind.Int32: true
        NumKind.Int64: true
        NumKind.Int128: true
        _: false

bool num_kind_is_bare(NumKind k):
    k == NumKind.Int or k == NumKind.Uint

string num_kind_name(NumKind k):
    match k:
        NumKind.Int: "int"
        NumKind.Uint: "uint"
        NumKind.Uint8: "uint8"
        NumKind.Int8: "int8"
        NumKind.Int16: "int16"
        NumKind.Int32: "int32"
        NumKind.Int64: "int64"
        NumKind.Int128: "int128"
        NumKind.Uint16: "uint16"
        NumKind.Uint32: "uint32"
        NumKind.Uint64: "uint64"
        NumKind.Uint128: "uint128"

NumKind? type_to_num_kind(Type t):
    match t:
        Type.Int: NumKind.Int
        Type.Uint: NumKind.Uint
        Type.Uint8: NumKind.Uint8
        Type.Int8: NumKind.Int8
        Type.Int16: NumKind.Int16
        Type.Int32: NumKind.Int32
        Type.Int64: NumKind.Int64
        Type.Int128: NumKind.Int128
        Type.Uint16: NumKind.Uint16
        Type.Uint32: NumKind.Uint32
        Type.Uint64: NumKind.Uint64
        Type.Uint128: NumKind.Uint128
        _: nil

# Reconstructs a fresh `Type` literal from one of the 9 fixed-width names —
# used instead of reusing a `Type` value that might already be partially
# moved (e.g. a preceding `match ty: Type.Named(name): name ...` moves `name`
# out of `ty`, and Rust's borrow checker then forbids using `ty` again).
Type num_kind_type_of_name(string name):
    match name:
        "int8": Type.Int8
        "int16": Type.Int16
        "int32": Type.Int32
        "int64": Type.Int64
        "int128": Type.Int128
        "uint16": Type.Uint16
        "uint32": Type.Uint32
        "uint64": Type.Uint64
        "uint128": Type.Uint128
        _: Type.Void

NumKind? num_kind_from_name(string name):
    match name:
        "int": NumKind.Int
        "uint": NumKind.Uint
        "uint8": NumKind.Uint8
        "int8": NumKind.Int8
        "int16": NumKind.Int16
        "int32": NumKind.Int32
        "int64": NumKind.Int64
        "int128": NumKind.Int128
        "uint16": NumKind.Uint16
        "uint32": NumKind.Uint32
        "uint64": NumKind.Uint64
        "uint128": NumKind.Uint128
        _: nil

# Generic `as <numeric type>` cast from any Value — used by cast_value for the
# 9 fixed-width kinds beyond int/uint/uint8 (which keep their own hand-written
# branches, unchanged, since they also handle string-parsing/Object-conversion
# cases this generic path doesn't need to replicate).
Value? cast_numeric_generic(Value val, string type_name):
    guard let tk = num_kind_from_name(type_name) else: return nil
    match val:
        Value.Float64(f):
            if not num_kind_signed(tk) and f < 0.0:
                i128_to_kind(tk, 0)
            else:
                i128_to_kind(tk, f as int128)
        Value.Float32(f):
            if not num_kind_signed(tk) and f < 0.0:
                i128_to_kind(tk, 0)
            else:
                i128_to_kind(tk, f as int128)
        _:
            if let iv = value_as_i128(val):
                i128_to_kind(tk, iv)
            else:
                nil

# Result kind when mixing two *different* kinds where at least one is bare
# (`Int`/`Uint`). Returns nil when neither is bare (unsupported direct mix).
# Rule: the wider kind wins. On a tied width with mixed signs: unsigned wins
# for every op except Sub, whose existing Int/Uint precedent is order-dependent
# (`Uint - Int` stays Uint, `Int - Uint` stays Int) — generalized here as "the
# LHS's kind wins on a tied-width sign mismatch".
NumKind? promote_kind(NumKind ka, NumKind kb, bool is_sub):
    if not num_kind_is_bare(ka) and not num_kind_is_bare(kb):
        return nil
    let abits = num_kind_bits(ka)
    let bbits = num_kind_bits(kb)
    if abits != bbits:
        if abits > bbits:
            return ka
        else:
            return kb
    if num_kind_signed(ka) == num_kind_signed(kb):
        if num_kind_is_bare(ka):
            return kb
        else:
            return ka
    if is_sub:
        return ka
    if num_kind_signed(ka):
        kb
    else:
        ka

# Widen any of the 12 numeric kinds into int128 staging space. Rust's `as`
# between integer types truncates/extends but never panics (unlike bare
# `+`/`-`/`*`, which panic on overflow) — this is why every op below stages
# through int128 and narrows back with `as` rather than operating on the
# narrow types directly. Returns nil for a `Uint128` value above `int128`'s
# range — that ultra-wide corner case only affects mixed-kind ops; same-kind
# `Uint128 op Uint128` still works fully since it goes through this same
# staging with both operands already the same (in-range or not) width.
int128? value_as_i128(Value v):
    match v:
        Value.Int(n): n as int128
        Value.Uint(n): n as int128
        Value.Uint8(n): n as int128
        Value.Int8(n): n as int128
        Value.Int16(n): n as int128
        Value.Int32(n): n as int128
        Value.Int64(n): n as int128
        Value.Int128(n): n
        Value.Uint16(n): n as int128
        Value.Uint32(n): n as int128
        Value.Uint64(n): n as int128
        Value.Uint128(n): n as int128
        _: nil

float64? value_as_float_numeric(Value v):
    match v:
        Value.Float64(f): f
        _:
            if let iv = value_as_i128(v):
                iv as float64
            else:
                nil

float32? value_as_f32_numeric(Value v):
    match v:
        Value.Float32(f): f
        _:
            if let iv = value_as_i128(v):
                iv as float32
            else:
                nil

# Like `value_as_float_numeric`, but also accepts Float32 (widened to
# float64) — used only by comparison/equality, which are deliberately more
# permissive than arithmetic about mixing the two float widths.
float64? value_as_float64_widened(Value v):
    match v:
        Value.Float32(f): f as float64
        _: value_as_float_numeric(v)

# Narrow an int128 staging value back into `k`'s native Value (truncating,
# matching the wrapping semantics the old per-pair arms computed by hand).
Value i128_to_kind(NumKind k, int128 x):
    match k:
        NumKind.Int: Value.Int(x as int)
        NumKind.Uint: Value.Uint(x as uint)
        NumKind.Uint8: Value.Uint8(x as uint8)
        NumKind.Int8: Value.Int8(x as int8)
        NumKind.Int16: Value.Int16(x as int16)
        NumKind.Int32: Value.Int32(x as int32)
        NumKind.Int64: Value.Int64(x as int64)
        NumKind.Int128: Value.Int128(x)
        NumKind.Uint16: Value.Uint16(x as uint16)
        NumKind.Uint32: Value.Uint32(x as uint32)
        NumKind.Uint64: Value.Uint64(x as uint64)
        NumKind.Uint128: Value.Uint128(x as uint128)

# Add/Sub/Mul/Div/Rem between two numeric (int-kind) values — same-kind and
# bare-mixed pairs. Returns nil when the pair isn't numeric or isn't a
# supported combination (the caller falls through to its own error/float path).
Value? apply_binop_numeric(BinOp op, Value l, Value r):
    guard let ka = num_kind_of(l) else: return nil
    guard let kb = num_kind_of(r) else: return nil
    let is_sub = op == BinOp.Sub
    var NumKind result_kind
    if ka == kb:
        result_kind = ka
    else:
        guard let pk = promote_kind(ka, kb, is_sub) else: return nil
        result_kind = pk
    guard let lv = value_as_i128(l) else: return nil
    guard let rv = value_as_i128(r) else: return nil
    let signed = num_kind_signed(result_kind)
    if not signed:
        if num_kind_signed(ka) and lv < 0:
            throw "cannot combine negative {l.type_name()} with unsigned type"
        if num_kind_signed(kb) and rv < 0 and not is_sub:
            throw "cannot combine negative {r.type_name()} with unsigned type"
    match op:
        BinOp.Add:
            i128_to_kind(result_kind, lv + rv)
        BinOp.Sub:
            if not signed and rv >= 0 and rv > lv:
                throw "{num_kind_name(result_kind)} subtraction underflow"
            i128_to_kind(result_kind, lv - rv)
        BinOp.Mul:
            i128_to_kind(result_kind, lv * rv)
        BinOp.Div:
            if rv == 0:
                throw "division by zero"
            i128_to_kind(result_kind, lv / rv)
        BinOp.Rem:
            if rv == 0:
                throw "remainder by zero"
            i128_to_kind(result_kind, lv % rv)
        _: nil

# ─── float32 / float64 literal mixing ────────────────────────────────────────
#
# Mirrors the Rust interpreter's `coerce_float_literal_pair` / `eval_expr.rs`
# exactly (docs/float-width-types.md §3 and §8): `float` has no independent
# flexible kind of its own the way `int`/`uint` do, so a bare untyped literal
# is the only thing that mixes freely with either float32 or float64 — two
# already-resolved values of the two widths must not mix implicitly. Since a
# literal and a resolved value are otherwise indistinguishable once evaluated
# to a `Value`, this looks at the *source expression* before dispatch.

bool is_untyped_numeric_literal(Expr e):
    match e.kind:
        ExprKind.Float(_): true
        ExprKind.Int(_): true
        ExprKind.UnaryOp(op, inner):
            if op == UnaryOp.Neg:
                is_untyped_numeric_literal(inner)
            else:
                false
        _: false

(Value, Value) coerce_float_literal_pair(Value l, Value r, Expr lhs, Expr rhs):
    match l:
        Value.Float32(_):
            match r:
                Value.Float64(f):
                    if is_untyped_numeric_literal(rhs):
                        return (l, Value.Float32(f as float32))
                    else:
                        return (l, r)
                _: nil
        Value.Float64(f):
            match r:
                Value.Float32(_):
                    if is_untyped_numeric_literal(lhs):
                        return (Value.Float32(f as float32), r)
                    else:
                        return (l, r)
                _: nil
        _: nil
    (l, r)

# Add/Sub/Mul/Div/Rem between two float64 values, or a float64 and any
# numeric int-kind (the bare int/uint kind mixes freely, same precedent as
# the int-kind model above). float32 has its own sibling below — the two
# widths never mix here (docs/float-width-types.md §3): `apply_binop_f32`
# runs first (see `apply_binop`) and only falls through to this function when
# neither operand is a `Value.Float32`, so a genuine float32/float64 mismatch
# falls all the way through both to the caller's "cannot <op> X and Y" error.
Value? apply_binop_float_mixed(BinOp op, Value l, Value r):
    let l_is_float = match l:
        Value.Float64(_): true
        _: false
    let r_is_float = match r:
        Value.Float64(_): true
        _: false
    if not (l_is_float or r_is_float):
        return nil
    guard let lf = value_as_float_numeric(l) else: return nil
    guard let rf = value_as_float_numeric(r) else: return nil
    match op:
        BinOp.Add: Value.Float64(lf + rf)
        BinOp.Sub: Value.Float64(lf - rf)
        BinOp.Mul: Value.Float64(lf * rf)
        BinOp.Div: Value.Float64(lf / rf)
        BinOp.Rem: Value.Float64(lf % rf)
        _: nil

# float32 sibling of `apply_binop_float_mixed` — same shape, f32 precision
# throughout. Bare `int`/`uint` values mix in freely here too.
Value? apply_binop_f32_mixed(BinOp op, Value l, Value r):
    let l_is_f32 = match l:
        Value.Float32(_): true
        _: false
    let r_is_f32 = match r:
        Value.Float32(_): true
        _: false
    if not (l_is_f32 or r_is_f32):
        return nil
    # Reject a genuine float64 on the other side outright — no implicit
    # widening either direction (the literal-coercion pass in `eval_binop`
    # is what makes a *literal* on the other side work; a real float64 value
    # reaching here means the mix was never resolved and should error).
    match l:
        Value.Float64(_): return nil
        _: nil
    match r:
        Value.Float64(_): return nil
        _: nil
    guard let lf = value_as_f32_numeric(l) else: return nil
    guard let rf = value_as_f32_numeric(r) else: return nil
    match op:
        BinOp.Add: Value.Float32(lf + rf)
        BinOp.Sub: Value.Float32(lf - rf)
        BinOp.Mul: Value.Float32(lf * rf)
        BinOp.Div: Value.Float32(lf / rf)
        BinOp.Rem: Value.Float32(lf % rf)
        _: nil

# BitAnd/BitOr/BitXor — same-kind only (matches the existing, stricter policy:
# unlike arithmetic, bitwise ops never mix with the bare Int/Uint kind either).
Value? apply_binop_bitwise_samekind(BinOp op, Value l, Value r):
    guard let ka = num_kind_of(l) else: return nil
    guard let kb = num_kind_of(r) else: return nil
    if ka != kb:
        return nil
    guard let lv = value_as_i128(l) else: return nil
    guard let rv = value_as_i128(r) else: return nil
    match op:
        BinOp.BitAnd: i128_to_kind(ka, lv & rv)
        BinOp.BitOr: i128_to_kind(ka, lv | rv)
        BinOp.BitXor: i128_to_kind(ka, lv ^ rv)
        _: nil

# Shl/Shr — result kind always follows the *left* operand's own kind (shifting
# never changes a value's declared width); the right operand is just consumed
# as a shift count via `value_as_i128`, masked to the left kind's bit width to
# avoid Rust panicking on a shift amount >= that width.
Value? apply_binop_shift(BinOp op, Value l, Value r):
    guard let ka = num_kind_of(l) else: return nil
    guard let rv = value_as_i128(r) else: return nil
    if rv < 0:
        throw "shift amount cannot be negative"
    guard let lv = value_as_i128(l) else: return nil
    let width = num_kind_bits(ka) as int128
    let count = rv % width
    match op:
        BinOp.Shl: i128_to_kind(ka, lv << count)
        BinOp.Shr: i128_to_kind(ka, lv >> count)
        _: nil

# Apply a binary operator to two already-evaluated values
def Value apply_binop(BinOp op, Value l, Value r):
    match op:
        BinOp.Add:
            if let result = apply_binop_numeric(op, l, r):
                result
            elif let result2 = apply_binop_float_mixed(op, l, r):
                result2
            elif let result3 = apply_binop_f32_mixed(op, l, r):
                result3
            else:
                match l:
                    Value.Str(a):
                        match r:
                            Value.Str(b):
                                Value.Str(a + b)
                            _:
                                throw "cannot add String and {r.type_name()}"
                    Value.Array(a):
                        match r:
                            Value.Array(b):
                                var merged = a
                                for item in b:
                                    merged.push(item)
                                Value.Array(merged)
                            _:
                                throw "cannot add Array and {r.type_name()}"
                    _:
                        throw "cannot add {l.type_name()} and {r.type_name()}"
        BinOp.Sub:
            if let result = apply_binop_numeric(op, l, r):
                result
            elif let result2 = apply_binop_float_mixed(op, l, r):
                result2
            elif let result3 = apply_binop_f32_mixed(op, l, r):
                result3
            else:
                throw "cannot subtract {r.type_name()} from {l.type_name()}"
        BinOp.Mul:
            if let result = apply_binop_numeric(op, l, r):
                result
            elif let result2 = apply_binop_float_mixed(op, l, r):
                result2
            elif let result3 = apply_binop_f32_mixed(op, l, r):
                result3
            else:
                throw "cannot multiply {l.type_name()} and {r.type_name()}"
        BinOp.Div:
            if let result = apply_binop_numeric(op, l, r):
                result
            elif let result2 = apply_binop_float_mixed(op, l, r):
                result2
            elif let result3 = apply_binop_f32_mixed(op, l, r):
                result3
            else:
                throw "cannot divide {l.type_name()} by {r.type_name()}"
        BinOp.Rem:
            if let result = apply_binop_numeric(op, l, r):
                result
            elif let result2 = apply_binop_float_mixed(op, l, r):
                result2
            elif let result3 = apply_binop_f32_mixed(op, l, r):
                result3
            else:
                throw "cannot remainder {l.type_name()} by {r.type_name()}"
        BinOp.Eq:
            Value.Bool(values_equal(l, r))
        BinOp.NotEq:
            Value.Bool(not values_equal(l, r))
        BinOp.Lt:
            Value.Bool(compare_values(l, r) < 0)
        BinOp.Gt:
            Value.Bool(compare_values(l, r) > 0)
        BinOp.LtEq:
            Value.Bool(compare_values(l, r) <= 0)
        BinOp.GtEq:
            Value.Bool(compare_values(l, r) >= 0)
        BinOp.BitAnd:
            if let result = apply_binop_bitwise_samekind(op, l, r):
                result
            else:
                throw "bitwise-and requires matching operand types (got {l.type_name()} and {r.type_name()})"
        BinOp.BitOr:
            if let result = apply_binop_bitwise_samekind(op, l, r):
                result
            else:
                throw "bitwise-or requires matching operand types (got {l.type_name()} and {r.type_name()})"
        BinOp.BitXor:
            if let result = apply_binop_bitwise_samekind(op, l, r):
                result
            else:
                throw "bitwise-xor requires matching operand types (got {l.type_name()} and {r.type_name()})"
        BinOp.Shl:
            if let result = apply_binop_shift(op, l, r):
                result
            else:
                throw "shift requires numeric operands (got {l.type_name()} and {r.type_name()})"
        BinOp.Shr:
            if let result = apply_binop_shift(op, l, r):
                result
            else:
                throw "shift requires numeric operands (got {l.type_name()} and {r.type_name()})"
        BinOp.Is:
            match r:
                Value.Nil:
                    Value.Bool(l == Value.Nil)
                Value.StructDef(type_name):
                    Value.Bool(l.type_name() == type_name)
                Value.EnumDef(type_name):
                    Value.Bool(l.type_name() == type_name)
                Value.Object(r_inner):
                    match l:
                        Value.Object(l_inner):
                            let lid_val = l_inner.get_field("__ref_id")
                            let rid_val = r_inner.get_field("__ref_id")
                            if let lid = lid_val:
                                if let rid = rid_val:
                                    match lid:
                                        Value.Int(li):
                                            match rid:
                                                Value.Int(ri): Value.Bool(li == ri)
                                                _: Value.Bool(false)
                                        _: Value.Bool(false)
                                else:
                                    Value.Bool(false)
                            else:
                                Value.Bool(false)
                        _: Value.Bool(false)
                _:
                    Value.Bool(l.type_name() == r.type_name())
        BinOp.IsNot:
            match r:
                Value.Nil:
                    Value.Bool(l != Value.Nil)
                Value.StructDef(type_name):
                    Value.Bool(l.type_name() != type_name)
                Value.EnumDef(type_name):
                    Value.Bool(l.type_name() != type_name)
                Value.Object(r_inner):
                    match l:
                        Value.Object(l_inner):
                            let lid_val2 = l_inner.get_field("__ref_id")
                            let rid_val2 = r_inner.get_field("__ref_id")
                            if let lid2 = lid_val2:
                                if let rid2 = rid_val2:
                                    match lid2:
                                        Value.Int(li2):
                                            match rid2:
                                                Value.Int(ri2): Value.Bool(li2 != ri2)
                                                _: Value.Bool(true)
                                        _: Value.Bool(true)
                                else:
                                    Value.Bool(true)
                            else:
                                Value.Bool(true)
                        _: Value.Bool(true)
                _:
                    Value.Bool(l.type_name() != r.type_name())
        BinOp.RefEq:
            match l:
                Value.Object(l_inner):
                    match r:
                        Value.Object(r_inner):
                            let lid = l_inner.get_field("__ref_id")
                            let rid = r_inner.get_field("__ref_id")
                            if let lv = lid:
                                if let rv = rid:
                                    Value.Bool(lv == rv)
                                else:
                                    Value.Bool(false)
                            else:
                                Value.Bool(false)
                        _: Value.Bool(false)
                _: Value.Bool(l == r)
        BinOp.And:
            throw "And handled by short-circuit path"
        BinOp.Or:
            throw "Or handled by short-circuit path"

# Compare two values: returns negative/zero/positive
req int compare_values(Value l, Value r):
    # float32/float64 compare freely against each other and against any int
    # kind (widened to float64) — deliberately more permissive than
    # arithmetic's strict float32/float64 mixing rule, mirroring the existing
    # precedent for comparing two distinct fixed-width int kinds below
    # (docs/float-width-types.md §3).
    let l_is_float = match l:
        Value.Float64(_): true
        Value.Float32(_): true
        _: false
    let r_is_float = match r:
        Value.Float64(_): true
        Value.Float32(_): true
        _: false
    if l_is_float or r_is_float:
        guard let lf = value_as_float64_widened(l) else: throw "cannot compare {l.type_name()} and {r.type_name()}"
        guard let rf = value_as_float64_widened(r) else: throw "cannot compare {l.type_name()} and {r.type_name()}"
        if lf < rf: -1
        elif lf > rf: 1
        else: 0
    else:
        match l:
            Value.Str(a):
                match r:
                    Value.Str(b):
                        if a < b: -1
                        elif a > b: 1
                        else: 0
                    _:
                        throw "cannot compare String and {r.type_name()}"
            Value.NativeFn(_, _): 0
            Value.Fn(_, _): 0
            Value.Closure(_, _, _): 0
            _:
                guard let av = value_as_i128(l) else: throw "cannot compare {l.type_name()} and {r.type_name()}"
                guard let bv = value_as_i128(r) else: throw "cannot compare {l.type_name()} and {r.type_name()}"
                if av < bv: -1
                elif av > bv: 1
                else: 0

# Field access on a value
# Row-major flat offset for a `LabeledIndex`'s labeled arguments into
# `axes` (axis 0 fastest-varying) — throws if a label is missing or its
# index value isn't an Int (no static checker here to catch it earlier).
def int labeled_flat_offset(mut Interpreter interp, [Arg] args, [(string, int)] axes):
    var offset = 0
    var stride = 1
    var i = 0
    while i < axes.length:
        let axis_label = axes[i].0
        let axis_size = axes[i].1
        var found = false
        var idx_val = 0
        for a in args:
            if let al = a.label:
                if al == axis_label:
                    let v = eval_expr(interp, a.value)
                    match v:
                        Value.Int(n):
                            idx_val = n
                            found = true
                        _:
                            throw "labeled array index for '{axis_label}' must be int, got {v.type_name()}"
        if not found:
            throw "missing label '{axis_label}' in labeled array index"
        offset = offset + idx_val * stride
        stride = stride * axis_size
        i = i + 1
    offset

def Value get_tuple_field([Value] elems, string field_name):
    if field_name == "length":
        return Value.Int(elems.length)
    if field_name == "0": return elems[0] else Value.Nil
    if field_name == "1": return elems[1] else Value.Nil
    if field_name == "2": return elems[2] else Value.Nil
    if field_name == "3": return elems[3] else Value.Nil
    if field_name == "4": return elems[4] else Value.Nil
    if field_name == "5": return elems[5] else Value.Nil
    if field_name == "6": return elems[6] else Value.Nil
    if field_name == "7": return elems[7] else Value.Nil
    throw "no field '{field_name}' on tuple"

def Value get_field(mut Interpreter interp, Value obj, string field_name):
    match obj:
        Value.Object(inner):
            let val_opt = inner.get_field(field_name)
            if let v = val_opt:
                v
            else:
                # Try calling as a zero-arg method — find_best_method (not
                # find_method) so a zero-arg overload is picked correctly
                # even when other overloads of the same name take args.
                let method_opt = interp.find_best_method(inner.type_name, field_name, [])
                if let _ = method_opt:
                    call_method(interp, Value.Object(inner), field_name, [])
                else:
                    throw "no field '{field_name}' on object of type {inner.type_name}"
        Value.EnumDef(type_name):
            # EnumDef.Variant → either a bare variant or a constructor fn
            Value.EnumVariant(type_name, field_name, [])
        Value.EnumVariant(type_name, variant, fields):
            if field_name == "type":
                Value.Str(type_name)
            else if field_name == "variant":
                Value.Str(variant)
            else:
                # Try named field on enum variant
                let edecl_opt = interp.get_enum_decl(type_name)
                var named_field_val = Value.Nil
                var named_field_found = false
                if let edecl = edecl_opt:
                    var vi = 0
                    while vi < edecl.variants.length:
                        let ev = edecl.variants[vi]
                        if ev.name == variant:
                            var fi = 0
                            while fi < ev.fields.length:
                                let vf = ev.fields[fi]
                                let vf_name_opt = vf.name
                                if let vf_name = vf_name_opt:
                                    if vf_name == field_name and fi < fields.length:
                                        named_field_val = fields[fi]
                                        named_field_found = true
                                fi = fi + 1
                        vi = vi + 1
                if named_field_found:
                    named_field_val
                else:
                    # Try calling as a zero-arg enum method (find_best_method,
                    # same reasoning as the struct-field case above)
                    let method_opt = interp.find_best_method(type_name, field_name, [])
                    if let _ = method_opt:
                        call_method(interp, Value.EnumVariant(type_name, variant, fields), field_name, [])
                    else:
                        throw "cannot access field '{field_name}' on enum variant"
        Value.Str(s):
            if field_name == "length":
                Value.Int(s.length)
            else:
                throw "no field '{field_name}' on string"
        Value.Array(items):
            if field_name == "length":
                Value.Int(items.length)
            else:
                throw "no field '{field_name}' on array"
        Value.LabeledArray(items, axes):
            if field_name == "length":
                Value.Int(items.length)
            else:
                # a.width / a.height — read-only shape-query property, one
                # per declared axis label (docs/array-multidim-types.md,
                # "Shape queries").
                var found = false
                var found_size = 0
                for ax in axes:
                    if ax.0 == field_name:
                        found_size = ax.1
                        found = true
                if found:
                    Value.Int(found_size)
                else:
                    throw "no field '{field_name}' on labeled array"
        Value.Set(items):
            if field_name == "length":
                Value.Int(items.length)
            else:
                throw "no field '{field_name}' on set"
        Value.Dict(entries):
            if field_name == "length":
                Value.Int(entries.length)
            else:
                throw "no field '{field_name}' on dict"
        Value.Tuple(elems):
            get_tuple_field(elems, field_name)
        Value.Nil:
            throw "field access on nil"
        _:
            throw "cannot access field '{field_name}' on {obj.type_name()}"

# Index access on a value
def Value get_index(mut Interpreter interp, Value obj, Value idx):
    match obj:
        Value.Array(items):
            match idx:
                Value.Int(i):
                    if i < 0 or i >= items.length:
                        throw "array index {i} out of bounds (length {items.length})"
                    items[i]
                _:
                    throw "array index must be Int, got {idx.type_name()}"
        Value.LabeledArray(_, _):
            # Labels are mandatory for a labeled array — no positional
            # fallback (docs/array-multidim-types.md, "Indexing"). Reaching
            # here means a bare `a[i]` was used instead of `a[label = i, ...]`.
            throw "labeled array requires labeled indexing (a[width = w, ...]), not a bare index — use .flatten() first for positional access"
        Value.Dict(entries):
            for entry in entries:
                if entry.0 == idx:
                    return entry.1
            throw "key not found in dict"
        Value.Str(s):
            match idx:
                Value.Int(i):
                    if i < 0 or i >= s.length:
                        throw "string index {i} out of bounds"
                    Value.Str(s.slice(i, i + 1))
                _:
                    throw "string index must be Int, got {idx.type_name()}"
        Value.Range(start, end, inclusive, _):
            match idx:
                Value.Int(i):
                    let actual = start + i
                    let limit = if inclusive: end + 1 else end
                    if actual >= limit:
                        throw "range index {i} out of bounds"
                    Value.Int(actual)
                _:
                    throw "range index must be Int"
        _:
            throw "cannot index into {obj.type_name()}"

def bool string_gt(string a, string b):
    a > b

# Try calling __as__<typename> method for explicit type conversions
def Value? try_call_conversion_method(mut Interpreter interp, Value val, string type_name):
    let method_name = "__as__" + type_name
    match val:
        Value.Object(inner):
            let methods_opt = interp.struct_methods.get(inner.type_name)
            if let methods = methods_opt:
                var mi = 0
                while mi < methods.length:
                    let m = methods[mi]
                    if m.name == method_name:
                        let child_env = push_scope(interp)
                        env_define(interp, "self", Value.Object(inner.clone()), false)
                        for field in inner.fields:
                            env_define(interp, field.0, field.1, false)
                        let result = eval_block(interp, m.body)
                        pop_scope(interp)
                        return result
                    mi = mi + 1
            nil
        _: nil

# Type cast
def Value cast_value(mut Interpreter interp, Value val, Type ty):
    let type_name = match ty:
        Type.Named(name): name
        Type.Int: "int"
        Type.Float32: "float32"
        Type.Float64: "float64"
        Type.Bool: "bool"
        Type.Str: "string"
        Type.Uint: "uint"
        Type.Uint8: "uint8"
        Type.Int8: "int8"
        Type.Int16: "int16"
        Type.Int32: "int32"
        Type.Int64: "int64"
        Type.Int128: "int128"
        Type.Uint16: "uint16"
        Type.Uint32: "uint32"
        Type.Uint64: "uint64"
        Type.Uint128: "uint128"
        _: "unknown"
    match type_name:
        "int":
            match val:
                Value.Int(n): Value.Int(n)
                Value.Uint(n): Value.Int(n as int)
                Value.Uint8(n): Value.Int(n as int)
                Value.Float64(f): Value.Int(f as int)
                Value.Float32(f): Value.Int(f as int)
                Value.Bool(b): if b: Value.Int(1) else: Value.Int(0)
                Value.Str(s):
                    let n = s.parse_int()
                    if let v = n:
                        Value.Int(v)
                    else:
                        Value.Nil
                _:
                    if let g = cast_numeric_generic(val, "int"):
                        g
                    else:
                        Value.Nil
        "float64":
            match val:
                Value.Float64(f): Value.Float64(f)
                Value.Float32(f): Value.Float64(f as float64)
                Value.Int(n): Value.Float64(n as float64)
                Value.Uint(n): Value.Float64(n as float64)
                Value.Uint8(n): Value.Float64(n as float64)
                Value.Str(s):
                    let f = s.parse_float()
                    if let v = f:
                        Value.Float64(v)
                    else:
                        Value.Nil
                Value.Object(finner):
                    # Try __as__float conversion method
                    let fconv_opt = try_call_conversion_method(interp, Value.Object(finner), "float")
                    if let fv = fconv_opt:
                        fv
                    else:
                        Value.Nil
                _:
                    if let g = cast_numeric_generic(val, "float64"):
                        g
                    else:
                        Value.Nil
        # float32 sibling of the float64 branch above — real f32 narrowing
        # (Rust `as f32` semantics, silent precision loss, inherited unchanged
        # per docs/float-width-types.md §4), not a label over float64.
        "float32":
            match val:
                Value.Float32(f): Value.Float32(f)
                Value.Float64(f): Value.Float32(f as float32)
                Value.Int(n): Value.Float32(n as float32)
                Value.Uint(n): Value.Float32(n as float32)
                Value.Uint8(n): Value.Float32(n as float32)
                Value.Str(s):
                    let f = s.parse_float()
                    if let v = f:
                        Value.Float32(v as float32)
                    else:
                        Value.Nil
                Value.Object(f32inner):
                    let f32conv_opt = try_call_conversion_method(interp, Value.Object(f32inner), "float32")
                    if let f32v = f32conv_opt:
                        f32v
                    else:
                        Value.Nil
                _:
                    if let g = cast_numeric_generic(val, "float32"):
                        g
                    else:
                        Value.Nil
        "string":
            # Check for as string: conversion block on objects or enums
            match val:
                Value.Object(inner):
                    let obj_type = inner.type_name
                    let decl_opt = interp.get_struct_decl(obj_type)
                    var conv_result = Value.Nil
                    var found_conv = false
                    if let decl = decl_opt:
                        var ci = 0
                        while ci < decl.conversions.length:
                            let conv = decl.conversions[ci]
                            let conv_type_name = match conv.ty:
                                Type.Str: "string"
                                Type.Named(n): n
                                _: ""
                            if conv_type_name == "string":
                                let child_env = push_scope(interp)
                                env_define(interp, "self", Value.Object(inner), false)
                                for field in inner.fields:
                                    env_define(interp, field.0, field.1, false)
                                conv_result = eval_block(interp, conv.body)
                                pop_scope(interp)
                                found_conv = true
                                break
                            ci = ci + 1
                    if found_conv:
                        conv_result
                    else:
                        # Also check for __as__string extension method
                        let str_ext_opt = try_call_conversion_method(interp, Value.Object(inner), "string")
                        if let str_ext_val = str_ext_opt:
                            str_ext_val
                        else:
                            Value.Str(display_value(interp, Value.Object(inner)))
                Value.EnumVariant(enum_type_name, variant, enum_fields):
                    let self_enum_val = Value.EnumVariant(enum_type_name, variant, enum_fields)
                    let edecl_opt = interp.get_enum_decl(enum_type_name)
                    var efound_conv = false
                    var econv_result = Value.Nil
                    if let edecl = edecl_opt:
                        var eci = 0
                        while eci < edecl.conversions.length:
                            let econv = edecl.conversions[eci]
                            let econv_type_name = match econv.ty:
                                Type.Str: "string"
                                Type.Named(n): n
                                _: ""
                            if econv_type_name == "string" and not efound_conv:
                                efound_conv = true
                                let echild_env = push_scope(interp)
                                env_define(interp, "self", self_enum_val, false)
                                econv_result = eval_block(interp, econv.body)
                                pop_scope(interp)
                            eci = eci + 1
                    if efound_conv:
                        econv_result
                    else:
                        Value.Str("{enum_type_name}.{variant}")
                _:
                    Value.Str(display_value(interp, val))
        "uint":
            match val:
                Value.Uint(n): Value.Uint(n)
                Value.Uint8(n): Value.Uint(n as uint)
                Value.Int(n): Value.Uint(n as uint)
                Value.Float64(f): Value.Uint(f as uint)
                Value.Float32(f): Value.Uint(f as uint)
                Value.Object(uint_inner):
                    let uv_opt = uint_inner.get_field("value")
                    if let uv = uv_opt:
                        cast_value(interp, uv, Type.Uint)
                    else:
                        throw "cannot cast {uint_inner.type_name} to uint"
                _:
                    if let g = cast_numeric_generic(val, "uint"):
                        g
                    else:
                        throw "cannot cast to uint"
        "uint8":
            match val:
                Value.Uint8(n): Value.Uint8(n)
                Value.Uint(n): Value.Uint8(n as uint8)
                Value.Int(n): Value.Uint8(n as uint8)
                Value.Float64(f): Value.Uint8(f as uint8)
                Value.Float32(f): Value.Uint8(f as uint8)
                Value.Object(uint8_inner):
                    let u8v_opt = uint8_inner.get_field("value")
                    if let u8v = u8v_opt:
                        cast_value(interp, u8v, Type.Uint8)
                    else:
                        throw "cannot cast {uint8_inner.type_name} to uint8"
                _:
                    if let g = cast_numeric_generic(val, "uint8"):
                        g
                    else:
                        throw "cannot cast to uint8"
        "int8" | "int16" | "int32" | "int64" | "int128" | "uint16" | "uint32" | "uint64" | "uint128":
            match val:
                Value.Object(fw_inner):
                    let fwv_opt = fw_inner.get_field("value")
                    if let fwv = fwv_opt:
                        # Reconstruct the target Type from `type_name` rather than reusing
                        # `ty` — `ty` was already partially moved by the `Type.Named(name)`
                        # arm above (`name` moves out of it) when this function's first
                        # `match ty:` computed `type_name`.
                        cast_value(interp, fwv, num_kind_type_of_name(type_name))
                    else:
                        throw "cannot cast {fw_inner.type_name} to {type_name}"
                _:
                    if let g = cast_numeric_generic(val, type_name):
                        g
                    else:
                        throw "cannot cast to {type_name}"
        "bool":
            match val:
                Value.Bool(b): Value.Bool(b)
                _: Value.Nil
        _:
            # Named type cast: check if val is already that type or has a field of that type
            let val_type = val.type_name()
            if val_type == type_name:
                return val
            match val:
                Value.Object(inner):
                    # Try field named "base" or "value" (for newtypes), with recursive cast
                    let base_opt = inner.get_field("base")
                    if let bv = base_opt:
                        if bv.type_name() == type_name:
                            return bv
                    let value_opt = inner.get_field("value")
                    if let vv = value_opt:
                        if vv.type_name() == type_name:
                            return vv
                        # Try casting the underlying value to the target named type
                        return cast_value(interp, vv, Type.Named(type_name))
                    throw "cannot cast {val_type} to {type_name}"
                _:
                    throw "unknown cast target type '{type_name}'"

# Apply a format spec string to a value
req string format_value(Interpreter interp, Value val, string spec):
    if spec == "":
        return display_value(interp, val)
    let chars = spec.chars()
    let n = chars.length
    var i = 0
    var flag_plus = false
    var flag_zero = false
    var width = 0
    var precision = -1
    var type_char = ""
    # Parse flags
    if i < n and chars[i] == "+":
        flag_plus = true
        i += 1
    if i < n and chars[i] == "0":
        flag_zero = true
        i += 1
    # Parse width
    while i < n and chars[i] >= "0" and chars[i] <= "9":
        width = width * 10 + (ord(chars[i]) - ord("0"))
        i += 1
    # Parse precision
    if i < n and chars[i] == ".":
        i += 1
        precision = 0
        while i < n and chars[i] >= "0" and chars[i] <= "9":
            precision = precision * 10 + (ord(chars[i]) - ord("0"))
            i += 1
    # Parse type
    if i < n:
        type_char = chars[i]
        i += 1
    # Format the value
    var raw = ""
    match val:
        Value.Int(nv):
            if type_char == "x":
                raw = int_to_hex(nv)
            else:
                raw = "{nv}"
            if flag_plus and nv >= 0:
                raw = "+" + raw
        Value.Float64(fv):
            if type_char == "e":
                raw = float_to_scientific(fv, precision)
            elif precision >= 0:
                raw = float_to_fixed(fv, precision)
            else:
                raw = "{fv}"
            if flag_plus and fv >= 0.0:
                raw = "+" + raw
        Value.Float32(fv32):
            let fv = fv32 as float64
            if type_char == "e":
                raw = float_to_scientific(fv, precision)
            elif precision >= 0:
                raw = float_to_fixed(fv, precision)
            else:
                raw = "{fv32}"
            if flag_plus and fv >= 0.0:
                raw = "+" + raw
        _:
            raw = display_value(interp, val)
    # Apply width padding
    if width > raw.length:
        let pad_count = width - raw.length
        var pad = ""
        var pi = 0
        while pi < pad_count:
            if flag_zero:
                pad = pad + "0"
            else:
                pad = pad + " "
            pi += 1
        if flag_zero and (raw.startsWith("-") or raw.startsWith("+")):
            raw = raw.slice(0, 1) + pad + raw.slice(1, raw.length)
        else:
            raw = pad + raw
    raw

req string int_to_hex(int n):
    if n == 0:
        return "0"
    var result = ""
    var v = n
    if v < 0:
        v = 0 - v
    while v > 0:
        let digit = v % 16
        if digit < 10:
            result = "{digit}" + result
        elif digit == 10: result = "a" + result
        elif digit == 11: result = "b" + result
        elif digit == 12: result = "c" + result
        elif digit == 13: result = "d" + result
        elif digit == 14: result = "e" + result
        else: result = "f" + result
        v = v / 16
    if n < 0:
        result = "-" + result
    result

req string float_to_fixed(float f, int prec):
    if prec == 0:
        let rounded = float_round_int(f)
        return "{rounded}"
    let factor = int_pow10(prec)
    let shifted = float_round_int(f * (factor as float))
    let int_part = shifted / factor
    var frac_part = shifted % factor
    if frac_part < 0:
        frac_part = 0 - frac_part
    var frac_str = "{frac_part}"
    while frac_str.length < prec:
        frac_str = "0" + frac_str
    if int_part < 0 and shifted > 0 - factor:
        "0.{frac_str}"
    else:
        "{int_part}.{frac_str}"

req int float_round_int(float f):
    let fi = f as int
    let diff = f - (fi as float)
    if diff >= 0.5:
        fi + 1
    else:
        fi

req int int_pow10(int exp):
    var result = 1
    var i = 0
    while i < exp:
        result = result * 10
        i += 1
    result

req string float_to_scientific(float f, int prec):
    if f == 0.0:
        if prec > 0:
            var zeros = ""
            var zi = 0
            while zi < prec:
                zeros = zeros + "0"
                zi += 1
            return "0.{zeros}e0"
        return "0e0"
    var v = f
    var exp = 0
    while v >= 10.0:
        v = v / 10.0
        exp += 1
    while v > 0.0 and v < 1.0:
        v = v * 10.0
        exp -= 1
    let mantissa = if prec >= 0: float_to_fixed(v, prec) else: "{v}"
    "{mantissa}e{exp}"

# Display a value as string for interpolation
req string display_value(Interpreter interp, Value val):
    match val:
        Value.Nil: "nil"
        Value.Bool(b): if b: "true" else: "false"
        Value.Int(n): "{n}"
        Value.Uint(n): "{n}"
        Value.Uint8(n): "{n}"
        Value.Int8(n): "{n}"
        Value.Int16(n): "{n}"
        Value.Int32(n): "{n}"
        Value.Int64(n): "{n}"
        Value.Int128(n): "{n}"
        Value.Uint16(n): "{n}"
        Value.Uint32(n): "{n}"
        Value.Uint64(n): "{n}"
        Value.Uint128(n): "{n}"
        Value.Float64(f): "{f}"
        Value.Float32(f): "{f}"
        Value.Str(s): s
        Value.Array(items):
            var result = "["
            var i = 0
            while i < items.length:
                if i > 0:
                    result = result + ", "
                result = result + display_value(interp, items[i])
                i = i + 1
            result + "]"
        Value.LabeledArray(items, _):
            var result = "["
            var i = 0
            while i < items.length:
                if i > 0:
                    result = result + ", "
                result = result + display_value(interp, items[i])
                i = i + 1
            result + "]"
        Value.Dict(entries):
            var result = "{{"
            var i = 0
            while i < entries.length:
                if i > 0:
                    result = result + ", "
                result = result + display_value(interp, entries[i].0) + ": " + display_value(interp, entries[i].1)
                i = i + 1
            result + "}}"
        Value.Object(obj):
            # Newtype: single visible 'value' field → display underlying value
            var visible_obj_fields = []
            for f in obj.fields:
                if not f.0.starts_with("__"):
                    visible_obj_fields.push(f)
            if visible_obj_fields.length == 1 and visible_obj_fields[0].0 == "value":
                display_value(interp, visible_obj_fields[0].1)
            else:
                obj.type_name.clone()
        Value.EnumVariant(type_name, variant, fields):
            if fields.length == 0:
                "{type_name}.{variant}"
            else:
                var result = "{type_name}.{variant}("
                var i = 0
                while i < fields.length:
                    if i > 0:
                        result = result + ", "
                    result = result + display_value(interp, fields[i])
                    i = i + 1
                result + ")"
        _:
            "<value>"

def ObjectInner make_object(string type_name, [(string, Value)] fields):
    ObjectInner(type_name= type_name, fields= fields)

def string task_obj_type_name(Value v):
    match v:
        Value.Object(inner): inner.type_name
        _: ""

def Value task_obj_get_value(Value v):
    match v:
        Value.Object(inner):
            let vopt = inner.get_field("value")
            if let fv = vopt: fv else: Value.Nil
        _: v

# Evaluate a block of statements, returning the last expression value
def Value eval_block(mut Interpreter interp, [Stmt] stmts):
    var last = Value.Nil
    var i = 0
    while i < stmts.length:
        let stmt = stmts[i]
        if i == stmts.length - 1:
            last = eval_stmt_as_expr(interp, stmt)
        else:
            exec_stmt(interp, stmt)
        i = i + 1
    last

# Execute a statement (side-effects only)
def void exec_stmt(mut Interpreter interp, Stmt stmt):
    match stmt:
        Stmt.Expr(e):
            eval_expr(interp, e)
        Stmt.Let(name, expr, is_mutable, is_lazy):
            if is_lazy:
                interp.current_env.define_lazy(name)
            else:
                let val = eval_expr(interp, expr)
                env_define(interp, name, val, is_mutable)
        Stmt.Return(expr_opt):
            if let e = expr_opt:
                let val = eval_expr(interp, e)
                throw ReturnSignal(val)
            else:
                throw ReturnSignal(Value.Nil)
        Stmt.While(cond, body):
            var running = true
            while running:
                let cond_val = eval_expr(interp, cond)
                match cond_val:
                    Value.Bool(b):
                        if b:
                            let child = push_scope(interp)
                            eval_block(interp, body)
                            pop_scope(interp)
                        else:
                            running = false
                    _:
                        throw "while condition must be bool"
        Stmt.For(var_name, iter_expr, body):
            let iter_val = eval_expr(interp, iter_expr)
            match iter_val:
                Value.Array(items):
                    for item in items:
                        let child = push_scope(interp)
                        env_define(interp, var_name, item, false)
                        eval_block(interp, body)
                        pop_scope(interp)
                Value.Range(start, end, inclusive, _):
                    let limit = if inclusive: end + 1 else: end
                    var n = start
                    while n < limit:
                        let child = push_scope(interp)
                        env_define(interp, var_name, Value.Int(n), false)
                        eval_block(interp, body)
                        pop_scope(interp)
                        n = n + 1
                Value.Object(rx_inner):
                    # ChannelRx iteration — drain the channel queue
                    if rx_inner.type_name != "__ChannelRx__":
                        throw "for loop requires iterable, got {iter_val.type_name()}"
                    eval_channel_rx_for(interp, rx_inner, var_name, body)
                _:
                    throw "for loop requires iterable, got {iter_val.type_name()}"
        Stmt.Assign(target, expr):
            let val = eval_expr(interp, expr)
            assign_target(interp, target, val)
        Stmt.Throw(expr):
            let val = eval_expr(interp, expr)
            throw ExceptionSignal(val)
        _:
            throw "unhandled statement kind"

# Evaluate the last statement as an expression (for implicit return)
def Value eval_stmt_as_expr(mut Interpreter interp, Stmt stmt):
    match stmt:
        Stmt.Expr(e):
            eval_expr(interp, e)
        Stmt.Return(ret_stmt):
            if let e = ret_stmt.value:
                eval_expr(interp, e)
            else:
                Value.Nil
        Stmt.If(s):
            exec_stmt(interp, Stmt.If(s))
            Value.Nil
        Stmt.Match(s):
            let subject = eval_expr(interp, s.subject)
            eval_match(interp, subject, s.arms)
        _:
            exec_stmt(interp, stmt)
            Value.Nil

# Match evaluation
def Value eval_match_body(mut Interpreter interp, MatchBody body):
    match body:
        MatchBody.Expr(e): eval_expr(interp, e)
        MatchBody.Block(stmts): eval_block(interp, stmts)

def Value eval_match(mut Interpreter interp, Value subject, [MatchArm] arms):
    for arm in arms:
        # Try all or-patterns
        var [Binding]? matched = nil
        for pat in arm.patterns:
            let m = try_match_pattern(interp, subject, pat)
            if let _ = m:
                matched = m
                break
        if let bindings = matched:
            if let guard_cond = arm.match_guard:
                let child = push_scope(interp)
                for binding in bindings:
                    env_define(interp, binding.name, binding.value, binding.is_mut)
                let guard_val = eval_expr(interp, guard_cond)
                pop_scope(interp)
                match guard_val:
                    Value.Bool(true):
                        let child2 = push_scope(interp)
                        for binding in bindings:
                            env_define(interp, binding.name, binding.value, binding.is_mut)
                        let result = eval_match_body(interp, arm.body)
                        pop_scope(interp)
                        return result
                    _:
                        continue
            else:
                let child = push_scope(interp)
                for binding in bindings:
                    env_define(interp, binding.name, binding.value, binding.is_mut)
                let result = eval_match_body(interp, arm.body)
                pop_scope(interp)
                return result
    Value.Nil

# Try to match a value against a pattern, returning bindings or nil
req [Binding]? try_match_pattern(Interpreter interp, Value subject, Pattern pat):
    match pat:
        Pattern.Wildcard:
            []
        Pattern.Lit(lit):
            let lit_val = match lit:
                LitPattern.Int(n): Value.Int(n)
                LitPattern.Float(f): Value.Float64(f)
                LitPattern.Str(s): Value.Str(s)
                LitPattern.Bool(b): Value.Bool(b)
                LitPattern.Nil: Value.Nil
            if value_equals(subject, lit_val):
                []
            else:
                nil
        Pattern.Bind(name):
            [Binding(name, subject, false)]
        Pattern.Variant(variant, sub_patterns):
            match subject:
                Value.EnumVariant(stype, svariant, sfields):
                    let unqualified = if variant.contains("."): variant.split(".")[1] else variant
                    if svariant == variant or svariant == unqualified:
                        if sub_patterns.length == 0:
                            []
                        else if sub_patterns.length == sfields.length:
                            # Declared field types for this variant, if the enum is known —
                            # used to flag a `mut`-qualified field (VariantField.is_mut,
                            # docs/mut-type-modifier.md) bound directly at this level, so
                            # `eval_match`/its callers `env_define` it content-mutable.
                            # Resolved once, as a plain `[bool]` (one per field), rather than
                            # re-deriving from `EnumVariant?` on every loop iteration — that
                            # Optional-of-struct doesn't get automatic by-ref parameter
                            # passing the way a bare struct/enum does, so re-passing it into a
                            # helper on each iteration moves it and fails to transpile past the
                            # first iteration.
                            let field_muts = enum_variant_field_mut_flags(find_enum_variant_decl(interp, stype, svariant))
                            var [Binding] all_bindings = []
                            var ok = true
                            var i = 0
                            while i < sub_patterns.length:
                                let field_is_mut = if i < field_muts.length: field_muts[i] else: false
                                match sub_patterns[i]:
                                    Pattern.Bind(bname):
                                        all_bindings.push(Binding(bname, sfields[i], is_mut= field_is_mut))
                                    _:
                                        let sub_match = try_match_pattern(interp, sfields[i], sub_patterns[i])
                                        if let sb = sub_match:
                                            for b in sb:
                                                all_bindings.push(b)
                                        else:
                                            ok = false
                                i = i + 1
                            if ok: all_bindings else: nil
                        else:
                            nil
                    else:
                        nil
                Value.Object(inner):
                    # Struct destructure: MPoint(x, y) pattern on an object
                    if inner.type_name == variant:
                        # Filter out hidden fields (prefixed with __)
                        var visible_fields = []
                        for f in inner.fields:
                            if not f.0.starts_with("__"):
                                visible_fields.push(f)
                        if sub_patterns.length == 0:
                            []
                        else if sub_patterns.length == visible_fields.length:
                            var [Binding] all_bindings = []
                            var ok = true
                            var i = 0
                            while i < sub_patterns.length:
                                let fv = visible_fields[i].1
                                let [Binding]? sub_match = try_match_pattern(interp, fv, sub_patterns[i])
                                if let sb = sub_match:
                                    for b in sb:
                                        all_bindings.push(b)
                                else:
                                    ok = false
                                i = i + 1
                            if ok: all_bindings else: nil
                        else:
                            nil
                    else:
                        nil
                _:
                    nil
        Pattern.Tuple(sub_patterns):
            match subject:
                Value.Tuple(items):
                    if items.length == sub_patterns.length:
                        var [Binding] all_bindings = []
                        var ok = true
                        var i = 0
                        while i < sub_patterns.length:
                            let [Binding]? sub_match = try_match_pattern(interp, items[i], sub_patterns[i])
                            if let sb = sub_match:
                                for b in sb:
                                    all_bindings.push(b)
                            else:
                                ok = false
                            i = i + 1
                        if ok: all_bindings else: nil
                    else:
                        nil
                _:
                    nil
        Pattern.None:
            match subject:
                Value.Nil: []
                Value.EnumVariant(stype, svariant, sfields):
                    if svariant == "None" or svariant == "none": [] else nil
                _: nil
        Pattern.Some(inner):
            match subject:
                Value.Nil: nil
                Value.EnumVariant(stype, svariant, sfields):
                    # Match Some(inner) against an enum variant named Some/some
                    if svariant == "Some" or svariant == "some":
                        if sfields.length == 1:
                            try_match_pattern(interp, sfields[0], inner)
                        else:
                            # Multiple fields: match inner as a tuple
                            try_match_pattern(interp, Value.Tuple(sfields), inner)
                    else:
                        nil
                _: try_match_pattern(interp, subject, inner)
        _:
            nil

# Enforce: a mutating method cannot be called on an immutable (`let`) binding.
# Qualifiers ('actor/'guard/'shared) are not tracked by this interpreter — every
# binding is treated the same regardless of qualifier, which is enough for
# prototyping. Only checked when the receiver is a plain variable reference
# (`recv_expr` is `ExprKind.Var`) and resolves to a struct instance whose
# called method is a `def` (mutating, non-`task`) method.
# Runs before args are evaluated (see the ExprKind.MethodCall case above), so
# there is no argument list yet to pick the right overload with — uses
# find_method's "first match" rule, same simplification the Rust reference
# interpreter's equivalent check makes (src/interpreter/eval_expr.rs, the
# `cannot call mutating method` check, also does a plain `.find()` by name).
def void check_mutating_method_call(mut Interpreter interp, Expr recv_expr, Value recv, string method):
    match recv_expr.kind:
        ExprKind.Var(name):
            match recv:
                Value.Object(inner):
                    let method_decl_opt = interp.find_method(inner.type_name, method)
                    if let method_decl = method_decl_opt:
                        if method_decl.mutating and not method_decl.is_task and not interp.current_env.is_mutable(name):
                            throw "cannot call mutating method '{method}' on let binding '{name}'"
                _: nil
        _: nil

# Assignment to a target expression
def void assign_target(mut Interpreter interp, Expr target, Value val):
    match target.kind:
        ExprKind.Var(name):
            if name == "_":
                nil  # discard binding — ignore
            elif interp.current_env.is_lazy(name):
                throw "cannot use '=' on lazy binding '{name}' — use '?=' instead"
            else:
                let ok = interp.current_env.set(name, val)
                if not ok:
                    throw "cannot assign to immutable variable '{name}'"
        ExprKind.Field(obj_expr, field_name):
            let obj = eval_expr(interp, obj_expr)
            match obj:
                Value.Object(inner):
                    # Check for a setter method
                    let type_name = inner.type_name
                    let decl_opt = interp.get_struct_decl(type_name)
                    var setter_called = false
                    if let decl = decl_opt:
                        var si = 0
                        while si < decl.setters.length:
                            let s = decl.setters[si]
                            if s.name == field_name:
                                let child_env = push_scope(interp)
                                env_define(interp, "self", Value.Object(inner), true)
                                env_define(interp, s.param_name, val, true)
                                eval_block(interp, s.body)
                                pop_scope(interp)
                                setter_called = true
                                break
                            si = si + 1
                    if not setter_called:
                        inner.set_field(field_name, val)
                        # Also sync the env var copy (injected by method dispatch)
                        interp.current_env.set(field_name, val)
                _:
                    throw "cannot assign field on non-object"
        ExprKind.Index(obj_expr, idx_expr):
            let obj = eval_expr(interp, obj_expr)
            let idx = eval_expr(interp, idx_expr)
            match obj:
                Value.Array(items):
                    match idx:
                        Value.Int(i):
                            if i < 0 or i >= items.length:
                                throw "array index {i} out of bounds"
                            items[i] = val
                        _:
                            throw "array index must be Int"
                    assign_target(interp, obj_expr, Value.Array(items))
                Value.Dict(entries):
                    var new_entries = entries
                    var found = false
                    var di = 0
                    while di < new_entries.length:
                        if new_entries[di].0 == idx:
                            new_entries[di] = (idx, val)
                            found = true
                        di = di + 1
                    if not found:
                        new_entries.push((idx, val))
                    assign_target(interp, obj_expr, Value.Dict(new_entries))
                _:
                    throw "cannot index-assign into {obj.type_name()}"
        ExprKind.LabeledIndex(obj_expr, args):
            let obj = eval_expr(interp, obj_expr)
            match obj:
                Value.LabeledArray(items, axes):
                    let offset = labeled_flat_offset(interp, args, axes)
                    if offset < 0 or offset >= items.length:
                        throw "labeled array index out of bounds (length {items.length})"
                    items[offset] = val
                    assign_target(interp, obj_expr, Value.LabeledArray(items, axes))
                _:
                    throw "labeled index requires a labeled array, got {obj.type_name()}"
        _:
            throw "invalid assignment target"

# Interpreter-side analog of the transpiler's `..Default::default()`: the
# per-type "zero" value used by `instantiate_struct` to fill a struct field
# the caller left unset via the `_` fill-rest marker (`Arg.default_rest`).
# Falls back to `Value.Nil` for named/compound types this interpreter can't
# meaningfully default-construct on its own (matching what an unset field
# already got before `_` existed).
def Value default_value_for_type(Type ty):
    match ty:
        Type.Int: Value.Int(0)
        Type.Int8: Value.Int8(0)
        Type.Int16: Value.Int16(0)
        Type.Int32: Value.Int32(0)
        Type.Int64: Value.Int64(0)
        Type.Int128: Value.Int128(0)
        Type.Uint: Value.Uint(0)
        Type.Uint8: Value.Uint8(0)
        Type.Uint16: Value.Uint16(0)
        Type.Uint32: Value.Uint32(0)
        Type.Uint64: Value.Uint64(0)
        Type.Uint128: Value.Uint128(0)
        Type.Float32: Value.Float32(0.0)
        Type.Float64: Value.Float64(0.0)
        Type.Bool: Value.Bool(false)
        Type.Str: Value.Str("")
        Type.Optional(_): Value.Nil
        Type.Array(_): Value.Array([])
        Type.ArrayN(_, _): Value.Array([])
        Type.Dict(_, _): Value.Dict([])
        Type.Set(_): Value.Set([])
        Type.Tuple(elems): Value.Tuple(elems.map((e): default_value_for_type(e)))
        Type.Qualified(inner, _): default_value_for_type(inner)
        _: Value.Nil

# Instantiate a struct from constructor args
def Value instantiate_struct(mut Interpreter interp, StructDecl decl, [Value] args):
    # Separate labeled and positional args
    var {string=Value} labeled = {}
    var positional = []
    for arg in args:
        match arg:
            Value.Labeled(label, v): labeled.set(label, v)
            _: positional.push(arg)
    # `_` fill-rest marker (see `Arg.default_rest`) — smuggled through
    # `eval_args_with_hints` as a sentinel-labeled value. Its only effect is
    # to switch the "no value provided" fallback below from the universal
    # `Value.Nil` sentinel to a type-appropriate default.
    let default_rest = labeled.has("..default_rest..")
    var fields = []
    var pos_idx = 0
    for field in decl.fields:
        if labeled.has(field.name):
            fields.push((field.name, labeled[field.name]))
        elif pos_idx < positional.length:
            fields.push((field.name, positional[pos_idx]))
            pos_idx = pos_idx + 1
        else:
            var fval = Value.Nil
            if let default_expr = field.default:
                fval = eval_expr(interp, default_expr)
            elif default_rest:
                fval = default_value_for_type(field.ty)
            fields.push((field.name, fval))
    # Handle init declarations: pub params become fields
    if decl.inits.length > 0:
        let init_decl = decl.inits[0]
        var ipos = 0
        for param in init_decl.params:
            var pval = Value.Nil
            if labeled.has(param.name):
                pval = labeled[param.name]
            elif ipos < positional.length:
                pval = positional[ipos]
                ipos = ipos + 1
            else:
                let param_default = param.default
                if let default_expr = param_default:
                    pval = eval_expr(interp, default_expr)
            fields.push((param.name, pval))
    let ref_id = interp.next_ref_id
    interp.next_ref_id = ref_id + 1
    fields.push(("__ref_id", Value.Int(ref_id)))
    let inner = ObjectInner(type_name= decl.name, fields= fields)
    let result = Value.Object(inner)
    # Run init body if present
    if decl.inits.length > 0:
        let init_decl = decl.inits[0]
        if init_decl.body.length > 0:
            match result:
                Value.Object(init_inner):
                    let child_env = push_scope(interp)
                    env_define(interp, "self", Value.Object(init_inner), true)
                    for field in init_inner.fields:
                        env_define(interp, field.0, field.1, true)
                    var ipos2 = 0
                    for param in init_decl.params:
                        var pval = Value.Nil
                        if labeled.has(param.name):
                            pval = labeled[param.name]
                        elif ipos2 < positional.length:
                            pval = positional[ipos2]
                            ipos2 = ipos2 + 1
                        else:
                            let param_default2 = param.default
                            if let default_expr2 = param_default2:
                                pval = eval_expr(interp, default_expr2)
                        env_define(interp, param.name, pval, param.mutable)
                    eval_block(interp, init_decl.body)
                    for field in init_inner.fields:
                        let updated_opt = interp.current_env.get(field.0)
                        if let updated_val = updated_opt:
                            init_inner.set_field(field.0, updated_val)
                    pop_scope(interp)
                    return Value.Object(init_inner)
                _: nil
    result
