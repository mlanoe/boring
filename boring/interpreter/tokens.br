# == TOKENS ==

enum RawInterpPart:
    Lit(string s)
    Hole(string expr)
    HoleFormatted(string expr, string fmt)

enum TokenKind:
    # Literals
    Int(int n)
    Float(float f)
    Str(string s)
    StringInterp([RawInterpPart] parts)
    Bool(bool b)
    Nil

    # Identifier
    Ident(string name)

    # Keywords
    Let
    Lazy
    Var
    Mut
    Def
    Return
    If
    Elif
    Else
    Match
    While
    Do
    Loop
    Wait
    For
    In
    Break
    Continue
    Struct
    Enum
    Trait
    Use
    Ext
    As
    And
    Or
    Not
    Is
    SelfKw
    Throw
    Throws
    Try
    Catch
    Defer
    Void
    Pub
    Guard
    Task
    Join
    Stream
    Yield
    Static
    Type
    Req
    Transient
    With
    Get
    Set
    Init
    Pass
    Native
    Mod
    Kernel

    # Operators
    Plus
    Minus
    Star
    Slash
    Percent
    Eq
    EqEq
    EqEqEq
    BangEq
    Lt
    Gt
    LtEq
    GtEq
    Dot
    DotDot
    DotDotEq
    DotDotDot
    Question
    QuestionDot
    Bang
    Tick

    # Bitwise operators
    Ampersand
    Pipe
    Caret
    Tilde

    # Compound assignment
    PlusEq
    MinusEq
    StarEq
    SlashEq
    PercentEq
    AmpersandEq
    PipeEq
    CaretEq
    QuestionEq
    PipeArrow

    # Delimiters
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Comma
    Colon
    At

    # Layout
    Newline
    Semicolon
    Indent
    Dedent
    Eof

    # Comment
    Comment(string text)

struct Token:
    TokenKind kind
    int line

    req string text():
        let kind = self.kind
        match kind:
            TokenKind.Ident(s): s
            TokenKind.Let: "let"
            TokenKind.Lazy: "lazy"
            TokenKind.Var: "var"
            TokenKind.Mut: "mut"
            TokenKind.Def: "def"
            TokenKind.Return: "return"
            TokenKind.If: "if"
            TokenKind.Elif: "elif"
            TokenKind.Else: "else"
            TokenKind.Match: "match"
            TokenKind.While: "while"
            TokenKind.Do: "do"
            TokenKind.For: "for"
            TokenKind.In: "in"
            TokenKind.Break: "break"
            TokenKind.Continue: "continue"
            TokenKind.Struct: "struct"
            TokenKind.Enum: "enum"
            TokenKind.Trait: "trait"
            TokenKind.Use: "use"
            TokenKind.As: "as"
            TokenKind.And: "and"
            TokenKind.Or: "or"
            TokenKind.Not: "not"
            TokenKind.Is: "is"
            TokenKind.Throw: "throw"
            TokenKind.Try: "try"
            TokenKind.Type: "type"
            TokenKind.Req: "req"
            TokenKind.Get: "get"
            TokenKind.Set: "set"
            TokenKind.Init: "init"
            TokenKind.Mod: "mod"
            TokenKind.Nil: "nil"
            TokenKind.SelfKw: "self"
            TokenKind.Static: "static"
            TokenKind.Pub: "pub"
            TokenKind.Native: "native"
            TokenKind.Pass: "pass"
            TokenKind.Kernel: "kernel"
            TokenKind.With: "with"
            TokenKind.Wait: "wait"
            TokenKind.Task: "task"
            TokenKind.Void: "void"
            _: ""
