# == FIXED-POINT (fixedN_M / ufixedN_M) ==
#
# Boring port of the reference semantics in the Rust interpreter's `src/fixed.rs`
# (docs/fixed-point-types.md). A fixed-point value is `Value.Fixed(raw, signed, n, m)`:
# a raw storage integer `raw` of width `n + m` bits whose real value is `raw / 2^m`.
#
# Supported widths are 8/16/32/64 (the 128-bit formats need a 256-bit intermediate
# for `*` and `/`, docs Phasing §4). Every operation returns `nil` on overflow and
# the caller turns that into a runtime error.
#
# The 2W-bit intermediate of `*` and `/` is computed on *magnitudes* in `uint128`
# (|ra| * |rb| < 2^128 for every width up to 64), then the sign is re-applied, so
# the result truncates toward zero exactly like the Rust interpreter and the
# generated Rust newtype.

struct FixedFmt:
    bool signed
    int n
    int m

    req int width():
        self.n + self.m

    # Canonical spelling: `fixed16_16`, `ufixed8_8`.
    req string name():
        if self.signed:
            "fixed{self.n}_{self.m}"
        else:
            "ufixed{self.n}_{self.m}"

# Canonical spelling from the raw `Value.Fixed` payload fields.
string fixed_type_name(bool signed, int n, int m):
    if signed:
        "fixed{n}_{m}"
    else:
        "ufixed{n}_{m}"

bool fixed_all_digits(string s):
    if s.length == 0 or s.length > 3:
        return false
    # `i08_8`-style zero padding is not a spelling of the type.
    if s.length > 1 and s.startsWith("0"):
        return false
    for c in s.chars():
        if not "0123456789".contains(c):
            return false
    true

# `fixed16_16`, `ufixed8_8` and the aliases `i16_16` / `u8_8` -> their format;
# nil for any other name (including a fixed-shaped name that is not valid).
FixedFmt? fixed_fmt_of_name(string name):
    var signed = true
    var rest = ""
    if name.startsWith("ufixed"):
        signed = false
        rest = name.slice(6, name.length)
    elif name.startsWith("fixed"):
        rest = name.slice(5, name.length)
    elif name.startsWith("i"):
        rest = name.slice(1, name.length)
    elif name.startsWith("u"):
        signed = false
        rest = name.slice(1, name.length)
    else:
        return nil
    let parts = rest.split("_")
    if parts.length != 2:
        return nil
    if not fixed_all_digits(parts[0]) or not fixed_all_digits(parts[1]):
        return nil
    let n = ((parts[0] as int) else -1)
    let m = ((parts[1] as int) else -1)
    if n < 0 or m < 0:
        return nil
    let w = n + m
    if not (w == 8 or w == 16 or w == 32 or w == 64 or w == 128):
        return nil
    if signed and n == 0:
        return nil
    FixedFmt(signed = signed, n = n, m = m)

int128 fixed_one():
    1 as int128

int128 fixed_pow2(int k):
    fixed_one() << k

# The widest supported storage is 64 bits: min/max always fit an int128.
int128 fixed_min_raw(FixedFmt f):
    if f.signed:
        0 - fixed_pow2(f.width() - 1)
    else:
        0 as int128

int128 fixed_max_raw(FixedFmt f):
    if f.signed:
        fixed_pow2(f.width() - 1) - fixed_one()
    else:
        fixed_pow2(f.width()) - fixed_one()

bool fixed_supported(FixedFmt f):
    f.width() <= 64

int128? fixed_checked(FixedFmt f, int128 raw):
    if raw < fixed_min_raw(f) or raw > fixed_max_raw(f):
        return nil
    raw

uint128 fixed_abs(int128 a):
    if a < 0:
        (0 - a) as uint128
    else:
        a as uint128

# magnitude + sign -> int128, nil if it cannot be represented or is out of range.
int128? fixed_apply_sign(FixedFmt f, uint128 mag, bool neg):
    let limit = (fixed_one() << 126) as uint128
    if mag > limit:
        return nil
    let v = mag as int128
    if neg:
        fixed_checked(f, 0 - v)
    else:
        fixed_checked(f, v)

int128? fixed_add(FixedFmt f, int128 a, int128 b):
    fixed_checked(f, a + b)

int128? fixed_sub(FixedFmt f, int128 a, int128 b):
    fixed_checked(f, a - b)

int128? fixed_neg(FixedFmt f, int128 a):
    fixed_checked(f, 0 - a)

# (ra * rb) >> m, truncating toward zero.
int128? fixed_mul(FixedFmt f, int128 a, int128 b):
    let neg = (a < 0) != (b < 0)
    let prod = fixed_abs(a) * fixed_abs(b)
    fixed_apply_sign(f, prod >> f.m, neg)

# (ra << m) / rb, truncating toward zero. The caller reports division by zero.
int128? fixed_div(FixedFmt f, int128 a, int128 b):
    let neg = (a < 0) != (b < 0)
    let num = fixed_abs(a) << f.m
    fixed_apply_sign(f, num / fixed_abs(b), neg)

int128? fixed_rem(FixedFmt f, int128 a, int128 b):
    fixed_checked(f, a % b)

# integer -> raw, exact; nil if it does not fit.
int128? fixed_from_int(FixedFmt f, int128 i):
    let bound = fixed_pow2(64)
    if i > bound or i < 0 - bound:
        return nil
    fixed_checked(f, i * fixed_pow2(f.m))

# A decimal literal as written, rounded to nearest (ties away from zero) with
# exact integer arithmetic — never through an f64.
int128? fixed_from_decimal(FixedFmt f, string text):
    var body = text
    var neg = false
    if body.startsWith("-"):
        neg = true
        body = body.slice(1, body.length)
    elif body.startsWith("+"):
        body = body.slice(1, body.length)
    var int_part = ""
    var frac_part = ""
    if body.contains("."):
        let halves = body.split(".")
        int_part = halves[0]
        frac_part = halves[1]
    else:
        int_part = body
    if int_part.length == 0 and frac_part.length == 0:
        return nil
    if frac_part.length > 36:
        return nil
    let digits = int_part + frac_part
    let half_range = (fixed_one() << 126) as uint128
    let u128_max = half_range + half_range + half_range + (half_range - (1 as uint128))
    let scale = (fixed_one() << f.m) as uint128
    var num = 0 as uint128
    for c in digits.chars():
        let d = ((c as int) else -1)
        if d < 0:
            return nil
        if num > (u128_max - (d as uint128)) / (10 as uint128):
            return nil
        num = num * (10 as uint128) + (d as uint128)
    if num > u128_max / scale:
        return nil
    var den = 1 as uint128
    var k = 0
    while k < frac_part.length:
        den = den * (10 as uint128)
        k += 1
    let scaled = num * scale
    var q = scaled / den
    let r = scaled % den
    if r >= den - r:
        q = q + (1 as uint128)
    fixed_apply_sign(f, q, neg)

# fixed -> int, truncating toward zero.
int128 fixed_to_int(FixedFmt f, int128 raw):
    let mag = (fixed_abs(raw) >> f.m) as int128
    if raw < 0:
        0 - mag
    else:
        mag

float64 fixed_pow2_f64(int k):
    var r = 1.0
    var i = 0
    while i < k:
        r = r * 2.0
        i += 1
    r

float64 fixed_to_f64(FixedFmt f, int128 raw):
    (raw as float64) / fixed_pow2_f64(f.m)

# float -> fixed, truncating toward zero; nil for NaN/inf or out of range.
int128? fixed_from_f64_trunc(FixedFmt f, float64 x):
    if x != x:
        return nil
    if x > 1.0e30 or x < -1.0e30:
        return nil
    let scaled = x * fixed_pow2_f64(f.m)
    fixed_checked(f, scaled as int128)

# fixed -> other fixed: shift by the difference of m, truncating toward zero;
# nil if the integer part does not fit the target.
int128? fixed_convert(FixedFmt from, int128 raw, FixedFmt to):
    let mag = fixed_abs(raw)
    let neg = raw < 0
    if to.m >= from.m:
        let k = to.m - from.m
        # |raw| < 2^64, so anything under 2^(127-k) cannot overflow the shift.
        if mag >= (fixed_one() << (127 - k)) as uint128:
            return nil
        fixed_apply_sign(to, mag << k, neg)
    else:
        fixed_apply_sign(to, mag >> (from.m - to.m), neg)

string fixed_digit_str(int d):
    "{d}"

# Exact decimal expansion with trailing zeros trimmed (`1.5`, `-3`), or rounded to
# `places` decimals (ties away from zero) when `places >= 0`.
string fixed_format(FixedFmt f, int128 raw, int places):
    let neg = raw < 0
    let mag = fixed_abs(raw)
    let mask = (fixed_pow2(f.m) - fixed_one()) as uint128
    var int_part = mag >> f.m
    var frac = mag & mask
    mut [int] digits = []
    var round_up = false
    let ten = 10 as uint128
    if places >= 0:
        var count = 0
        while count < places:
            frac = frac * ten
            digits.push((frac >> f.m) as int)
            frac = frac & mask
            count += 1
        round_up = f.m > 0 and frac >= (fixed_pow2(f.m - 1) as uint128)
    else:
        while frac != (0 as uint128):
            frac = frac * ten
            digits.push((frac >> f.m) as int)
            frac = frac & mask
    if round_up:
        var i = digits.length
        var carrying = true
        while carrying:
            if i == 0:
                int_part = int_part + (1 as uint128)
                carrying = false
            else:
                i -= 1
                if digits[i] == 9:
                    digits[i] = 0
                else:
                    digits[i] = digits[i] + 1
                    carrying = false
    var all_zero = int_part == (0 as uint128)
    for d in digits:
        if d != 0:
            all_zero = false
    var out = ""
    if neg and not all_zero:
        out = "-"
    out = out + "{int_part}"
    if digits.length > 0:
        out = out + "."
        for d in digits:
            out = out + fixed_digit_str(d)
    out

# ---- rounding / sign helpers (docs: Members); nil = not representable ----

int128? fixed_trunc(FixedFmt f, int128 raw):
    fixed_checked(f, fixed_to_int(f, raw) * fixed_pow2(f.m))

int128? fixed_floor(FixedFmt f, int128 raw):
    guard let t = fixed_trunc(f, raw) else: return nil
    if raw < t:
        fixed_checked(f, t - fixed_pow2(f.m))
    else:
        t

int128? fixed_ceil(FixedFmt f, int128 raw):
    guard let t = fixed_trunc(f, raw) else: return nil
    if raw > t:
        fixed_checked(f, t + fixed_pow2(f.m))
    else:
        t

# Nearest integer, ties away from zero.
int128? fixed_round(FixedFmt f, int128 raw):
    if f.m == 0:
        return raw
    let mag = fixed_abs(raw)
    let mask = (fixed_pow2(f.m) - fixed_one()) as uint128
    var ip = mag >> f.m
    if (mag & mask) >= (fixed_pow2(f.m - 1) as uint128):
        ip = ip + (1 as uint128)
    fixed_apply_sign(f, ip << f.m, raw < 0)

int128? fixed_fract(FixedFmt f, int128 raw):
    guard let t = fixed_trunc(f, raw) else: return nil
    fixed_checked(f, raw - t)

int128? fixed_abs_checked(FixedFmt f, int128 raw):
    if raw < 0:
        fixed_checked(f, 0 - raw)
    else:
        raw

int128? fixed_signum(FixedFmt f, int128 raw):
    if raw < 0:
        fixed_from_int(f, -1 as int128)
    elif raw == 0:
        0 as int128
    else:
        fixed_from_int(f, 1 as int128)

# ---- overflow policies: wrapping / saturating / checked, mulRound / divRound ----

# Exact `a op b` as (magnitude, negative), truncated toward zero or rounded to
# nearest (ties away from zero) when `round`. op: 0 add, 1 sub, 2 mul, 3 div.
(uint128, bool) fixed_exact(FixedFmt f, int op, int128 a, int128 b, bool round):
    if op == 0:
        let v = a + b
        return (fixed_abs(v), v < 0)
    if op == 1:
        let v = a - b
        return (fixed_abs(v), v < 0)
    let neg = (a < 0) != (b < 0)
    if op == 2:
        let prod = fixed_abs(a) * fixed_abs(b)
        var q = prod >> f.m
        let mask = (fixed_pow2(f.m) - fixed_one()) as uint128
        if round and f.m > 0 and (prod & mask) >= (fixed_pow2(f.m - 1) as uint128):
            q = q + (1 as uint128)
        return (q, neg)
    let den = fixed_abs(b)
    let num = fixed_abs(a) << f.m
    var q = num / den
    if round and (num % den) * (2 as uint128) >= den:
        q = q + (1 as uint128)
    (q, neg)

# Two's-complement truncation to the storage width.
int128 fixed_wrapping_from(FixedFmt f, uint128 mag, bool neg):
    let w = f.width()
    let modulus = fixed_pow2(w) as uint128
    let mask = modulus - (1 as uint128)
    var low = mag & mask
    if neg:
        low = (modulus - low) & mask
    var out = low as int128
    if f.signed and low >= (fixed_pow2(w - 1) as uint128):
        out = out - fixed_pow2(w)
    out

int128 fixed_saturating_from(FixedFmt f, uint128 mag, bool neg):
    if let v = fixed_apply_sign(f, mag, neg):
        v
    elif neg:
        fixed_min_raw(f)
    else:
        fixed_max_raw(f)

# ---- integer math: sqrt / sin / cos / tan / exp / ln (Phase 5) ----
#
# Port of src/fixed_math_core.rs (same algorithms, same constants, bit-for-bit the
# same results): 60 internal fractional bits, CORDIC for sin/cos, a Taylor series for
# exp, an atanh series for ln, then rounded to the target format's m bits.

int128 fxm_one():
    (1 as int128) << 60

int128 fxm_half_pi():
    1811004864519280711 as int128

int128 fxm_ln2():
    799144290325165979 as int128

int128 fxm_cordic_k():
    700114967507363238 as int128

[int128] fxm_atan_table():
    [
        905502432259640355 as int128, 534549298976576474 as int128, 282441168888798124 as int128,
        143371547418228444 as int128, 71963988336308046 as int128, 36017075762092179 as int128,
        18012932708689205 as int128, 9007016009513623 as int128, 4503576721087964 as int128,
        2251796950380271 as int128, 1125899548928887 as int128, 562949908682076 as int128,
        281474971118251 as int128, 140737487656277 as int128, 70368744090283 as int128,
        35184372077909 as int128, 17592186043051 as int128, 8796093022037 as int128,
        4398046511083 as int128, 2199023255549 as int128, 1099511627776 as int128,
        549755813888 as int128, 274877906944 as int128, 137438953472 as int128,
        68719476736 as int128, 34359738368 as int128, 17179869184 as int128,
        8589934592 as int128, 4294967296 as int128, 2147483648 as int128,
        1073741824 as int128, 536870912 as int128, 268435456 as int128,
        134217728 as int128, 67108864 as int128, 33554432 as int128,
        16777216 as int128, 8388608 as int128, 4194304 as int128,
        2097152 as int128, 1048576 as int128, 524288 as int128,
        262144 as int128, 131072 as int128, 65536 as int128,
        32768 as int128, 16384 as int128, 8192 as int128,
        4096 as int128, 2048 as int128, 1024 as int128,
        512 as int128, 256 as int128, 128 as int128,
        64 as int128, 32 as int128, 16 as int128,
        8 as int128, 4 as int128, 2 as int128
    ]

# floor(a / b) for b > 0 (the integer `/` truncates toward zero).
int128 fxm_floor_div(int128 a, int128 b):
    var q = a / b
    if a % b < 0:
        q = q - 1
    q

int128 fxm_up(int128 raw, int m):
    if m <= 60:
        raw << (60 - m)
    else:
        raw >> (m - 60)

# F-bit value -> m fractional bits, rounded to nearest (ties away from zero); nil on overflow.
int128? fxm_down(int128 v, int m):
    if m >= 60:
        let lim = (1 as int128) << (127 - (m - 60))
        if v >= lim or v < 0 - lim:
            return nil
        return v << (m - 60)
    let s = 60 - m
    let q = ((fixed_abs(v) + ((1 as uint128) << (s - 1))) >> s) as int128
    if v < 0:
        0 - q
    else:
        q

uint128 fxm_isqrt(uint128 n0):
    var n = n0
    var x = 0 as uint128
    var bit = (1 as uint128) << 126
    while bit > n:
        bit = bit >> 2
    while bit != (0 as uint128):
        if n >= x + bit:
            n = n - (x + bit)
            x = (x >> 1) + bit
        else:
            x = x >> 1
        bit = bit >> 2
    x

int128? fxm_sqrt(int128 raw, int m):
    if raw < 0:
        return nil
    (fxm_isqrt((raw as uint128) << m)) as int128

# (sin, cos) of raw / 2^m radians in 60 fractional bits.
(int128, int128) fxm_sincos(int128 raw, int m):
    let a = fxm_up(raw, m)
    let hp = fxm_half_pi()
    let q = fxm_floor_div(a + hp / 2, hp)
    let table = fxm_atan_table()
    var x = fxm_cordic_k()
    var y = 0 as int128
    var z = a - q * hp
    var i = 0
    while i < 60:
        let dx = y >> i
        let dy = x >> i
        if z >= 0:
            x = x - dx
            y = y + dy
            z = z - table[i]
        else:
            x = x + dx
            y = y - dy
            z = z + table[i]
        i += 1
    var qm = q % 4
    if qm < 0:
        qm = qm + 4
    if qm == 0:
        (y, x)
    elif qm == 1:
        (x, 0 - y)
    elif qm == 2:
        (0 - y, 0 - x)
    else:
        (0 - x, y)

int128? fxm_sin(int128 raw, int m):
    fxm_down(fxm_sincos(raw, m).0, m)

int128? fxm_cos(int128 raw, int m):
    fxm_down(fxm_sincos(raw, m).1, m)

int128? fxm_tan(int128 raw, int m):
    let sc = fxm_sincos(raw, m)
    if sc.1 == 0:
        return nil
    fxm_down((sc.0 << 60) / sc.1, m)

int128? fxm_exp(int128 raw, int m):
    let x = fxm_up(raw, m)
    if x > ((45 as int128) << 60):
        return nil
    if x < 0 - ((43 as int128) << 60):
        return 0 as int128
    let ln2 = fxm_ln2()
    let k = fxm_floor_div(x + ln2 / 2, ln2)
    let r = x - k * ln2
    var term = fxm_one()
    var sum = fxm_one()
    var n = 1 as int128
    while n <= 24:
        term = (term * r) >> 60
        term = term / n
        sum = sum + term
        n = n + 1
    var v = sum
    if k >= 0:
        v = sum << (k as int)
    else:
        v = sum >> ((0 - k) as int)
    fxm_down(v, m)

int128? fxm_ln(int128 raw, int m):
    let x = fxm_up(raw, m)
    if x <= 0:
        return nil
    let one = fxm_one()
    var e = 0 as int128
    var v = x
    while v >= ((2 as int128) << 60):
        v = v >> 1
        e = e + 1
    while v < one:
        v = v << 1
        e = e - 1
    let z = ((v - one) << 60) / (v + one)
    let z2 = (z * z) >> 60
    var term = z
    var sum = z
    var n = 3 as int128
    while n <= 61:
        term = (term * z2) >> 60
        sum = sum + term / n
        n = n + 2
    fxm_down(e * fxm_ln2() + 2 * sum, m)
