# == FIXED-POINT (fixedN_M / ufixedN_M) ==
#
# Boring port of the reference semantics in the Rust interpreter's `src/fixed.rs`
# (docs/fixed-point-types.md). A fixed-point value is `Value.Fixed(raw, signed, n, m)`:
# a raw storage integer `raw` of width `n + m` bits whose real value is `raw / 2^m`.
#
# Supported widths are 8/16/32/64 and, for SIGNED formats with at most 126 fractional
# bits, 128 (docs Phase 4). Every operation returns `nil` on overflow and the caller
# turns that into a runtime error.
#
# `*`, `/`, `+`, `-` and the literal/format helpers work on *magnitudes* in `uint128`
# (plus a sign flag and an "overflowed 128 bits" flag) through the 256-bit helpers
# `fxw_*` below, a line-for-line port of src/fixed_wide_core.rs. The sign is
# re-applied at the end, so results truncate toward zero exactly like the Rust
# interpreter and the generated Rust newtype.

struct FixedFmt:
    bool signed
    int n
    int m

    req int width():
        self.n + self.m

    # Canonical spelling: `fixed16_16`, `ufixed8_8`.
    req string name():
        if self.signed:
            "fixed{self.n}_{self.m}"
        else:
            "ufixed{self.n}_{self.m}"

# Canonical spelling from the raw `Value.Fixed` payload fields.
string fixed_type_name(bool signed, int n, int m):
    if signed:
        "fixed{n}_{m}"
    else:
        "ufixed{n}_{m}"

bool fixed_all_digits(string s):
    if s.length == 0 or s.length > 3:
        return false
    # `i08_8`-style zero padding is not a spelling of the type.
    if s.length > 1 and s.startsWith("0"):
        return false
    for c in s.chars():
        if not "0123456789".contains(c):
            return false
    true

# `fixed16_16`, `ufixed8_8` and the aliases `i16_16` / `u8_8` -> their format;
# nil for any other name (including a fixed-shaped name that is not valid).
FixedFmt? fixed_fmt_of_name(string name):
    var signed = true
    var rest = ""
    if name.startsWith("ufixed"):
        signed = false
        rest = name.slice(6, name.length)
    elif name.startsWith("fixed"):
        rest = name.slice(5, name.length)
    elif name.startsWith("i"):
        rest = name.slice(1, name.length)
    elif name.startsWith("u"):
        signed = false
        rest = name.slice(1, name.length)
    else:
        return nil
    let parts = rest.split("_")
    if parts.length != 2:
        return nil
    if not fixed_all_digits(parts[0]) or not fixed_all_digits(parts[1]):
        return nil
    let n = ((parts[0] as int) else -1)
    let m = ((parts[1] as int) else -1)
    if n < 0 or m < 0:
        return nil
    let w = n + m
    if not (w == 8 or w == 16 or w == 32 or w == 64 or w == 128):
        return nil
    if signed and n == 0:
        return nil
    if w == 128 and (not signed or m > 126):
        return nil
    FixedFmt(signed = signed, n = n, m = m)

int128 fixed_one():
    1 as int128

int128 fixed_pow2(int k):
    fixed_one() << k

int128 fixed_i128_min():
    let half = fixed_pow2(126)
    (0 - half) - half

int128 fixed_i128_max():
    let half = fixed_pow2(126)
    (half - fixed_one()) + half

int128 fixed_min_raw(FixedFmt f):
    if f.signed:
        if f.width() == 128:
            return fixed_i128_min()
        0 - fixed_pow2(f.width() - 1)
    else:
        0 as int128

int128 fixed_max_raw(FixedFmt f):
    if f.signed:
        if f.width() == 128:
            return fixed_i128_max()
        fixed_pow2(f.width() - 1) - fixed_one()
    else:
        fixed_pow2(f.width()) - fixed_one()

int128? fixed_checked(FixedFmt f, int128 raw):
    if raw < fixed_min_raw(f) or raw > fixed_max_raw(f):
        return nil
    raw

uint128 fixed_abs(int128 a):
    if a < 0:
        ((0 - (a + 1)) as uint128) + (1 as uint128)
    else:
        a as uint128

# magnitude + sign -> int128, nil if it cannot be represented or is out of range.
int128? fixed_apply_sign(FixedFmt f, uint128 mag, bool neg):
    let half = (fixed_one() << 126) as uint128
    let limit = half + half
    if neg:
        if mag > limit:
            return nil
        if mag == limit:
            return fixed_checked(f, fixed_i128_min())
        fixed_checked(f, 0 - (mag as int128))
    else:
        if mag >= limit:
            return nil
        fixed_checked(f, mag as int128)

int128? fixed_add(FixedFmt f, int128 a, int128 b):
    let r = fxw_add(a, b)
    if r.2:
        return nil
    fixed_apply_sign(f, r.0, r.1)

int128? fixed_sub(FixedFmt f, int128 a, int128 b):
    let r = fxw_sub(a, b)
    if r.2:
        return nil
    fixed_apply_sign(f, r.0, r.1)

int128? fixed_neg(FixedFmt f, int128 a):
    fixed_apply_sign(f, fixed_abs(a), a >= 0)

# (ra * rb) >> m, truncating toward zero.
int128? fixed_mul(FixedFmt f, int128 a, int128 b):
    let r = fxw_mul(a, b, f.m, false)
    if r.2:
        return nil
    fixed_apply_sign(f, r.0, r.1)

# (ra << m) / rb, truncating toward zero. The caller reports division by zero.
int128? fixed_div(FixedFmt f, int128 a, int128 b):
    let r = fxw_div(a, b, f.m, false)
    if r.2:
        return nil
    fixed_apply_sign(f, r.0, r.1)

int128? fixed_rem(FixedFmt f, int128 a, int128 b):
    if a == fixed_i128_min() and b == (0 - 1) as int128:
        return nil
    fixed_checked(f, a % b)

# integer -> raw, exact; nil if it does not fit.
int128? fixed_from_int(FixedFmt f, int128 i):
    let mag = fixed_abs(i)
    let sh = mag << f.m
    if (sh >> f.m) != mag:
        return nil
    fixed_apply_sign(f, sh, i < 0)

# A decimal literal as written, rounded to nearest (ties away from zero) with
# exact integer arithmetic — never through an f64.
int128? fixed_from_decimal(FixedFmt f, string text):
    var body = text
    var neg = false
    if body.startsWith("-"):
        neg = true
        body = body.slice(1, body.length)
    elif body.startsWith("+"):
        body = body.slice(1, body.length)
    var int_part = ""
    var frac_part = ""
    if body.contains("."):
        let halves = body.split(".")
        int_part = halves[0]
        frac_part = halves[1]
    else:
        int_part = body
    if int_part.length == 0 and frac_part.length == 0:
        return nil
    if frac_part.length > 38:
        return nil
    let digits = int_part + frac_part
    let half_range = (fixed_one() << 126) as uint128
    let u128_max = half_range + half_range + half_range + (half_range - (1 as uint128))
    var num = 0 as uint128
    for c in digits.chars():
        let d = ((c as int) else -1)
        if d < 0:
            return nil
        if num > (u128_max - (d as uint128)) / (10 as uint128):
            return nil
        num = num * (10 as uint128) + (d as uint128)
    var den = 1 as uint128
    var k = 0
    while k < frac_part.length:
        den = den * (10 as uint128)
        k += 1
    guard let q = fxw_scale_decimal(num, den, f.m) else: return nil
    fixed_apply_sign(f, q, neg)

# fixed -> int, truncating toward zero.
int128 fixed_to_int(FixedFmt f, int128 raw):
    let mag = fixed_abs(raw) >> f.m
    if raw < 0:
        if mag == ((fixed_one() << 126) as uint128) + ((fixed_one() << 126) as uint128):
            return fixed_i128_min()
        0 - (mag as int128)
    else:
        mag as int128

float64 fixed_pow2_f64(int k):
    var r = 1.0
    var i = 0
    while i < k:
        r = r * 2.0
        i += 1
    r

float64 fixed_to_f64(FixedFmt f, int128 raw):
    (raw as float64) / fixed_pow2_f64(f.m)

# float -> fixed, truncating toward zero; nil for NaN/inf or out of range.
int128? fixed_from_f64_trunc(FixedFmt f, float64 x):
    if x != x:
        return nil
    let scaled = x * fixed_pow2_f64(f.m)
    let lim = fixed_pow2_f64(127)
    if scaled >= lim or scaled < 0.0 - lim:
        return nil
    fixed_checked(f, scaled as int128)

# fixed -> other fixed: shift by the difference of m, truncating toward zero;
# nil if the integer part does not fit the target.
int128? fixed_convert(FixedFmt from, int128 raw, FixedFmt to):
    let mag = fixed_abs(raw)
    let neg = raw < 0
    if to.m >= from.m:
        let k = to.m - from.m
        let sh = mag << k
        if (sh >> k) != mag:
            return nil
        fixed_apply_sign(to, sh, neg)
    else:
        fixed_apply_sign(to, mag >> (from.m - to.m), neg)

string fixed_digit_str(int d):
    "{d}"

# Exact decimal expansion with trailing zeros trimmed (`1.5`, `-3`), or rounded to
# `places` decimals (ties away from zero) when `places >= 0`.
string fixed_format(FixedFmt f, int128 raw, int places):
    let parts = fxw_digits(fixed_abs(raw), f.m, places)
    let int_part = parts.0
    let digits = parts.1
    var all_zero = int_part == (0 as uint128)
    for d in digits:
        if d != 0:
            all_zero = false
    var out = ""
    if raw < 0 and not all_zero:
        out = "-"
    out = out + "{int_part}"
    var want = digits.length
    if places >= 0:
        want = places
    if want > 0:
        out = out + "."
        for d in digits:
            out = out + fixed_digit_str(d)
        var extra = digits.length
        while extra < want:
            out = out + "0"
            extra += 1
    out

# ---- rounding / sign helpers (docs: Members); nil = not representable ----

int128? fixed_trunc(FixedFmt f, int128 raw):
    fixed_checked(f, fixed_to_int(f, raw) * fixed_pow2(f.m))

int128? fixed_floor(FixedFmt f, int128 raw):
    guard let t = fixed_trunc(f, raw) else: return nil
    if raw < t:
        fixed_checked(f, t - fixed_pow2(f.m))
    else:
        t

int128? fixed_ceil(FixedFmt f, int128 raw):
    guard let t = fixed_trunc(f, raw) else: return nil
    if raw > t:
        if t > fixed_max_raw(f) - fixed_pow2(f.m):
            return nil
        fixed_checked(f, t + fixed_pow2(f.m))
    else:
        t

# Nearest integer, ties away from zero.
int128? fixed_round(FixedFmt f, int128 raw):
    if f.m == 0:
        return raw
    let mag = fixed_abs(raw)
    let mask = (fixed_pow2(f.m) - fixed_one()) as uint128
    var ip = mag >> f.m
    if (mag & mask) >= (fixed_pow2(f.m - 1) as uint128):
        ip = ip + (1 as uint128)
    fixed_apply_sign(f, ip << f.m, raw < 0)

int128? fixed_fract(FixedFmt f, int128 raw):
    guard let t = fixed_trunc(f, raw) else: return nil
    fixed_checked(f, raw - t)

int128? fixed_abs_checked(FixedFmt f, int128 raw):
    if raw < 0:
        fixed_apply_sign(f, fixed_abs(raw), false)
    else:
        raw

int128? fixed_signum(FixedFmt f, int128 raw):
    if raw < 0:
        fixed_from_int(f, -1 as int128)
    elif raw == 0:
        0 as int128
    else:
        fixed_from_int(f, 1 as int128)

# ---- overflow policies: wrapping / saturating / checked, mulRound / divRound ----

# Exact `a op b` as (magnitude, negative, overflowed 128 bits), truncated toward zero
# or rounded to nearest (ties away from zero) when `round`. op: 0 add, 1 sub, 2 mul,
# 3 div. The magnitude is the low 128 bits when the flag is set.
(uint128, bool, bool) fixed_exact(FixedFmt f, int op, int128 a, int128 b, bool round):
    if op == 0:
        return fxw_add(a, b)
    if op == 1:
        return fxw_sub(a, b)
    if op == 2:
        return fxw_mul(a, b, f.m, round)
    fxw_div(a, b, f.m, round)

# Two's-complement truncation to the storage width.
int128 fixed_wrapping_from(FixedFmt f, uint128 mag, bool neg):
    let w = f.width()
    if w == 128:
        var whole = mag
        if neg and mag != (0 as uint128):
            whole = (fxw_umax() - mag) + (1 as uint128)
        return whole as int128
    let modulus = fixed_pow2(w) as uint128
    let mask = modulus - (1 as uint128)
    var low = mag & mask
    if neg:
        low = (modulus - low) & mask
    var out = low as int128
    if f.signed and low >= (fixed_pow2(w - 1) as uint128):
        out = out - fixed_pow2(w)
    out

int128 fixed_saturating_from(FixedFmt f, uint128 mag, bool neg, bool ovf):
    if not ovf:
        if let v = fixed_apply_sign(f, mag, neg):
            return v
    if neg:
        fixed_min_raw(f)
    else:
        fixed_max_raw(f)

# ---- 256-bit intermediates (128-bit formats): port of src/fixed_wide_core.rs ----

uint128 fxw_umax():
    let half = (1 as uint128) << 127
    (half - (1 as uint128)) + half

uint128 fxw_m64():
    ((1 as uint128) << 64) - (1 as uint128)

# Full 256-bit product (hi, lo).
(uint128, uint128) fxw_mul_full(uint128 a, uint128 b):
    let mk = fxw_m64()
    let a0 = a & mk
    let a1 = a >> 64
    let b0 = b & mk
    let b1 = b >> 64
    let p00 = a0 * b0
    let p01 = a0 * b1
    let p10 = a1 * b0
    let p11 = a1 * b1
    let mid = (p00 >> 64) + (p01 & mk) + (p10 & mk)
    let lo = (p00 & mk) | ((mid & mk) << 64)
    let hi = p11 + (p01 >> 64) + (p10 >> 64) + (mid >> 64)
    (hi, lo)

# (hi, lo) >> s for s < 128.
(uint128, uint128) fxw_shr(uint128 hi, uint128 lo, int s):
    if s == 0:
        (hi, lo)
    else:
        (hi >> s, (lo >> s) | (hi << (128 - s)))

# x << s as 256 bits, for s < 128.
(uint128, uint128) fxw_shl(uint128 x, int s):
    if s == 0:
        (0 as uint128, x)
    else:
        (x >> (128 - s), x << s)

(uint128, uint128) fxw_inc(uint128 hi, uint128 lo):
    if lo == fxw_umax():
        (hi + (1 as uint128), 0 as uint128)
    else:
        (hi, lo + (1 as uint128))

# 256-by-128-bit long division: (quotient hi, quotient lo, remainder).
(uint128, uint128, uint128) fxw_divrem(uint128 hi, uint128 lo, uint128 den):
    if den == (0 as uint128):
        throw "division by zero"
    if hi == (0 as uint128):
        return (0 as uint128, lo / den, lo % den)
    var qh = 0 as uint128
    var ql = 0 as uint128
    var r = 0 as uint128
    var i = 256
    while i > 0:
        i -= 1
        var bit = 0 as uint128
        if i >= 128:
            bit = (hi >> (i - 128)) & (1 as uint128)
        else:
            bit = (lo >> i) & (1 as uint128)
        let carry = r >> 127
        r = (r << 1) | bit
        qh = (qh << 1) | (ql >> 127)
        ql = ql << 1
        if carry == (1 as uint128):
            r = r + ((fxw_umax() - den) + (1 as uint128))
            ql = ql | (1 as uint128)
        elif r >= den:
            r = r - den
            ql = ql | (1 as uint128)
    (qh, ql, r)

# Sign-magnitude a + b: (low 128 bits of the magnitude, negative, overflowed).
(uint128, bool, bool) fxw_addsm(uint128 ma, bool na, uint128 mb, bool nb):
    if na == nb:
        if ma > fxw_umax() - mb:
            return ((ma - (fxw_umax() - mb)) - (1 as uint128), na, true)
        return (ma + mb, na, false)
    if ma >= mb:
        return (ma - mb, na and ma != mb, false)
    (mb - ma, nb, false)

(uint128, bool, bool) fxw_add(int128 a, int128 b):
    fxw_addsm(fixed_abs(a), a < 0, fixed_abs(b), b < 0)

(uint128, bool, bool) fxw_sub(int128 a, int128 b):
    fxw_addsm(fixed_abs(a), a < 0, fixed_abs(b), not (b < 0))

(uint128, bool, bool) fxw_mul(int128 a, int128 b, int m, bool round):
    let pr = fxw_mul_full(fixed_abs(a), fixed_abs(b))
    var q = fxw_shr(pr.0, pr.1, m)
    if round and m > 0 and ((pr.1 >> (m - 1)) & (1 as uint128)) == (1 as uint128):
        q = fxw_inc(q.0, q.1)
    (q.1, (a < 0) != (b < 0), q.0 != (0 as uint128))

# b must be non-zero.
(uint128, bool, bool) fxw_div(int128 a, int128 b, int m, bool round):
    let den = fixed_abs(b)
    let nm = fxw_shl(fixed_abs(a), m)
    let dr = fxw_divrem(nm.0, nm.1, den)
    var q = (dr.0, dr.1)
    if round and dr.2 >= den - dr.2:
        q = fxw_inc(q.0, q.1)
    (q.1, (a < 0) != (b < 0), q.0 != (0 as uint128))

# round(num * 2^m / den) (ties up); nil if it does not fit 128 bits.
uint128? fxw_scale_decimal(uint128 num, uint128 den, int m):
    let nm = fxw_shl(num, m)
    let dr = fxw_divrem(nm.0, nm.1, den)
    var q = (dr.0, dr.1)
    if dr.2 >= den - dr.2:
        q = fxw_inc(q.0, q.1)
    if q.0 != (0 as uint128):
        return nil
    q.1

int fxw_digit(uint128 h, uint128 l, int m):
    if m == 0:
        0
    else:
        ((h << (128 - m)) | (l >> m)) as int

# Decimal digits of mag / 2^m: (integer part, fraction digits). `places < 0` is the
# exact expansion with trailing zeros trimmed; otherwise cut to `places` digits
# (at most 128) and rounded to nearest, ties away from zero.
(uint128, [int]) fxw_digits(uint128 mag, int m, int places):
    let mask = ((1 as uint128) << m) - (1 as uint128)
    var int_part = mag >> m
    var frac = mag & mask
    mut [int] digits = []
    var round_up = false
    let ten = 10 as uint128
    if places >= 0:
        var p = places
        if p > 128:
            p = 128
        var count = 0
        while count < p:
            let hl = fxw_mul_full(frac, ten)
            digits.push(fxw_digit(hl.0, hl.1, m))
            frac = hl.1 & mask
            count += 1
        round_up = m > 0 and frac >= ((1 as uint128) << (m - 1))
    else:
        while frac != (0 as uint128):
            let hl = fxw_mul_full(frac, ten)
            digits.push(fxw_digit(hl.0, hl.1, m))
            frac = hl.1 & mask
    if round_up:
        var i = digits.length
        var carrying = true
        while carrying:
            if i == 0:
                int_part = int_part + (1 as uint128)
                carrying = false
            else:
                i -= 1
                if digits[i] == 9:
                    digits[i] = 0
                else:
                    digits[i] = digits[i] + 1
                    carrying = false
    (int_part, digits)

# ---- integer math: sqrt / sin / cos / tan / exp / ln (Phase 5) ----
#
# Port of src/fixed_math_core.rs (same algorithms, same constants, bit-for-bit the
# same results): 60 internal fractional bits, CORDIC for sin/cos, a Taylor series for
# exp, an atanh series for ln, then rounded to the target format's m bits.

int128 fxm_one():
    (1 as int128) << 60

int128 fxm_half_pi():
    1811004864519280711 as int128

int128 fxm_ln2():
    799144290325165979 as int128

int128 fxm_cordic_k():
    700114967507363238 as int128

[int128] fxm_atan_table():
    [
        905502432259640355 as int128, 534549298976576474 as int128, 282441168888798124 as int128,
        143371547418228444 as int128, 71963988336308046 as int128, 36017075762092179 as int128,
        18012932708689205 as int128, 9007016009513623 as int128, 4503576721087964 as int128,
        2251796950380271 as int128, 1125899548928887 as int128, 562949908682076 as int128,
        281474971118251 as int128, 140737487656277 as int128, 70368744090283 as int128,
        35184372077909 as int128, 17592186043051 as int128, 8796093022037 as int128,
        4398046511083 as int128, 2199023255549 as int128, 1099511627776 as int128,
        549755813888 as int128, 274877906944 as int128, 137438953472 as int128,
        68719476736 as int128, 34359738368 as int128, 17179869184 as int128,
        8589934592 as int128, 4294967296 as int128, 2147483648 as int128,
        1073741824 as int128, 536870912 as int128, 268435456 as int128,
        134217728 as int128, 67108864 as int128, 33554432 as int128,
        16777216 as int128, 8388608 as int128, 4194304 as int128,
        2097152 as int128, 1048576 as int128, 524288 as int128,
        262144 as int128, 131072 as int128, 65536 as int128,
        32768 as int128, 16384 as int128, 8192 as int128,
        4096 as int128, 2048 as int128, 1024 as int128,
        512 as int128, 256 as int128, 128 as int128,
        64 as int128, 32 as int128, 16 as int128,
        8 as int128, 4 as int128, 2 as int128
    ]

# floor(a / b) for b > 0 (the integer `/` truncates toward zero).
int128 fxm_floor_div(int128 a, int128 b):
    var q = a / b
    if a % b < 0:
        q = q - 1
    q

int128 fxm_up(int128 raw, int m):
    if m <= 60:
        raw << (60 - m)
    else:
        raw >> (m - 60)

# F-bit value -> m fractional bits, rounded to nearest (ties away from zero); nil on overflow.
int128? fxm_down(int128 v, int m):
    if m >= 60:
        let lim = (1 as int128) << (127 - (m - 60))
        if v >= lim or v < 0 - lim:
            return nil
        return v << (m - 60)
    let s = 60 - m
    let q = ((fixed_abs(v) + ((1 as uint128) << (s - 1))) >> s) as int128
    if v < 0:
        0 - q
    else:
        q

uint128 fxm_isqrt(uint128 n0):
    var n = n0
    var x = 0 as uint128
    var bit = (1 as uint128) << 126
    while bit > n:
        bit = bit >> 2
    while bit != (0 as uint128):
        if n >= x + bit:
            n = n - (x + bit)
            x = (x >> 1) + bit
        else:
            x = x >> 1
        bit = bit >> 2
    x

int128? fxm_sqrt(int128 raw, int m):
    if raw < 0:
        return nil
    (fxm_isqrt((raw as uint128) << m)) as int128

# (sin, cos) of raw / 2^m radians in 60 fractional bits.
(int128, int128) fxm_sincos(int128 raw, int m):
    let a = fxm_up(raw, m)
    let hp = fxm_half_pi()
    let q = fxm_floor_div(a + hp / 2, hp)
    let table = fxm_atan_table()
    var x = fxm_cordic_k()
    var y = 0 as int128
    var z = a - q * hp
    var i = 0
    while i < 60:
        let dx = y >> i
        let dy = x >> i
        if z >= 0:
            x = x - dx
            y = y + dy
            z = z - table[i]
        else:
            x = x + dx
            y = y - dy
            z = z + table[i]
        i += 1
    var qm = q % 4
    if qm < 0:
        qm = qm + 4
    if qm == 0:
        (y, x)
    elif qm == 1:
        (x, 0 - y)
    elif qm == 2:
        (0 - y, 0 - x)
    else:
        (0 - x, y)

int128? fxm_sin(int128 raw, int m):
    fxm_down(fxm_sincos(raw, m).0, m)

int128? fxm_cos(int128 raw, int m):
    fxm_down(fxm_sincos(raw, m).1, m)

int128? fxm_tan(int128 raw, int m):
    let sc = fxm_sincos(raw, m)
    if sc.1 == 0:
        return nil
    fxm_down((sc.0 << 60) / sc.1, m)

int128? fxm_exp(int128 raw, int m):
    let x = fxm_up(raw, m)
    if x > ((45 as int128) << 60):
        return nil
    if x < 0 - ((43 as int128) << 60):
        return 0 as int128
    let ln2 = fxm_ln2()
    let k = fxm_floor_div(x + ln2 / 2, ln2)
    let r = x - k * ln2
    var term = fxm_one()
    var sum = fxm_one()
    var n = 1 as int128
    while n <= 24:
        term = (term * r) >> 60
        term = term / n
        sum = sum + term
        n = n + 1
    var v = sum
    if k >= 0:
        v = sum << (k as int)
    else:
        v = sum >> ((0 - k) as int)
    fxm_down(v, m)

int128? fxm_ln(int128 raw, int m):
    let x = fxm_up(raw, m)
    if x <= 0:
        return nil
    let one = fxm_one()
    var e = 0 as int128
    var v = x
    while v >= ((2 as int128) << 60):
        v = v >> 1
        e = e + 1
    while v < one:
        v = v << 1
        e = e - 1
    let z = ((v - one) << 60) / (v + one)
    let z2 = (z * z) >> 60
    var term = z
    var sum = z
    var n = 3 as int128
    while n <= 61:
        term = (term * z2) >> 60
        sum = sum + term / n
        n = n + 2
    fxm_down(e * fxm_ln2() + 2 * sum, m)
