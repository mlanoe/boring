# == STDLIB AND INTERPRETER ==

# ─── Interpreter struct ────────────────────────────────────────────────────────

struct Interpreter:
    var Env'actor global_env
    Env'actor current_env
    var {string=[FnDecl]} struct_methods
    var {string=FnDecl} fn_decls
    var {string=StructDecl} struct_decls
    var {string=EnumDecl} enum_decls
    var bool has_pending_return
    var Value pending_return_val
    var bool has_pending_throw
    var Value pending_throw_val
    var int next_ref_id = 0
    var {string=[Value]} channel_queues = {}
    var int next_channel_id = 0
    var bool in_stream_fn = false
    var [Value] stream_yields = []
    var bool in_kernel_context = false
    var [string] cli_args = []
    # Stack of the currently executing function/method's declared return type (one frame
    # per call_fn invocation, pushed/popped around body execution — see push_return_ty/
    # pop_return_ty below, defined as free functions just after this struct). Lets
    # exec_stmt's Stmt.Return case resolve a `.Variant` return value via
    # eval_dot_ident_hint instead of eval_dot_ident's ambiguous-scan default — mirrors the
    # Rust interpreter's return_ty_stack (src/interpreter/mod.rs). Elements are `Type`,
    # not `Type?`, using `Type.Void` as the "no declared return type" sentinel (see
    # push_return_ty) — the transpiler's Optional-return auto-wrap heuristic doesn't
    # recognize an `[T?]` index expression as already-Optional, so indexing a genuinely
    # `[Type?]` stack double-wraps every read in `Some(...)`; `[Type]` sidesteps that
    # entirely (current_return_ty converts the sentinel back to a real `nil` explicitly).
    var [Type] return_ty_stack = []

    def void set_pending_return(Value v):
        has_pending_return = true
        pending_return_val = v

    def void set_pending_throw(Value v):
        has_pending_throw = true
        pending_throw_val = v

    def Value take_pending_throw():
        has_pending_throw = false
        let v = pending_throw_val
        pending_throw_val = Value.Nil
        v

    req FnDecl? find_method(string type_name, string method_name):
        let methods_opt = struct_methods.get(type_name)
        if let methods = methods_opt:
            for m in methods:
                if m.name == method_name:
                    return m
        nil

    # Overload-aware lookup — mirrors src/interpreter/methods.rs::find_best_method.
    # `find_method` above always returns the *first* declaration named
    # `method_name`, which is wrong as soon as a type has more than one method
    # sharing that name (overloads). This variant collects every candidate,
    # returns it directly when there is only one, and otherwise picks the
    # first candidate whose arity (accounting for default params) and static
    # param types all match the given runtime `args` — falling back to the
    # first candidate when none match exactly, same as the Rust reference.
    req FnDecl? find_best_method(string type_name, string method_name, [Value] args):
        let methods_opt = struct_methods.get(type_name)
        if let methods = methods_opt:
            var [FnDecl] candidates = []
            for m in methods:
                if m.name == method_name:
                    candidates.push(m)
            if candidates.length == 0:
                return nil
            if candidates.length == 1:
                return candidates[0]
            for decl in candidates:
                let max_args = decl.params.length
                var min_args = 0
                var pi = 0
                while pi < decl.params.length:
                    let p = decl.params[pi]
                    if p.default == nil:
                        min_args = min_args + 1
                    pi = pi + 1
                if args.length >= min_args and args.length <= max_args:
                    var all_match = true
                    var i = 0
                    while i < decl.params.length and i < args.length:
                        let p = decl.params[i]
                        if let pty = p.ty:
                            if not value_matches_type_static(args[i], pty):
                                all_match = false
                        i = i + 1
                    if all_match:
                        return decl
            return candidates[0]
        nil

    def void set_method_decls(string name, [FnDecl] methods):
        struct_methods.set(name, methods)

    def void set_fn_decl(string name, FnDecl decl):
        fn_decls.set(name, decl)

    req FnDecl? get_fn_decl(string name):
        let result = fn_decls.get(name)
        if let decl = result:
            return decl
        nil

    def void set_struct_decl(string name, StructDecl decl):
        struct_decls.set(name, decl)

    req StructDecl? get_struct_decl(string name):
        let r = struct_decls.get(name)
        if let d = r:
            return d
        nil

    def void set_enum_decl(string name, EnumDecl decl):
        enum_decls.set(name, decl)

    req EnumDecl? get_enum_decl(string name):
        let r = enum_decls.get(name)
        if let d = r:
            return d
        nil

# ─── return_ty_stack helpers ──────────────────────────────────────────────────
#
# Free functions rather than Interpreter methods: collection-typed fields aren't
# auto-cloned on an implicit-self read (in-place mutation via method calls is the norm
# for them — see the "Do NOT clone collections" note in the Rust interpreter's
# emit_expr.rs), so the copy-out/mutate/reassign pattern below needs an *explicit*
# `interp.return_ty_stack` read, exactly like channel_queues is handled elsewhere in
# this file — not the bare field name a `def`/`req` method on Interpreter would give.

def void push_return_ty(mut Interpreter interp, Type? ty):
    let resolved = ty else Type.Void
    var stack = interp.return_ty_stack
    stack.push(resolved)
    interp.return_ty_stack = stack

def void pop_return_ty(mut Interpreter interp):
    var stack = interp.return_ty_stack
    if stack.length > 0:
        stack.remove(stack.length - 1)
    interp.return_ty_stack = stack

def Type? current_return_ty(Interpreter interp):
    let stack = interp.return_ty_stack
    let n = stack.length
    var Type? result = nil
    if n > 0:
        let top = stack[n - 1]
        match top:
            Type.Void: nil
            _: result = some(top)
    result

# ─── val_to_string ────────────────────────────────────────────────────────────

def string val_to_string(Value v):
    match v:
        Value.Nil: "nil"
        Value.Void: "void"
        Value.Uninitialized: "<uninitialized>"
        Value.Bool(b): if b: "true" else "false"
        Value.Int(n): int_to_string(n)
        Value.Uint(n): "{n}"
        Value.Uint8(n): "{n}"
        Value.Int8(n): "{n}"
        Value.Int16(n): "{n}"
        Value.Int32(n): "{n}"
        Value.Int64(n): "{n}"
        Value.Int128(n): "{n}"
        Value.Uint16(n): "{n}"
        Value.Uint32(n): "{n}"
        Value.Uint64(n): "{n}"
        Value.Uint128(n): "{n}"
        Value.Float64(f): "{f}"
        Value.Float32(f): "{f}"
        Value.Str(s): s
        Value.Array(elems):
            var parts = ["["]
            var first = true
            for e in elems:
                if not first:
                    parts.push(", ")
                parts.push(val_to_string(e))
                first = false
            parts.push("]")
            var string result = ""
            for p in parts:
                result = "{result}{p}"
            result
        Value.LabeledArray(elems, _):
            var parts = ["["]
            var first = true
            for e in elems:
                if not first:
                    parts.push(", ")
                parts.push(val_to_string(e))
                first = false
            parts.push("]")
            var string result = ""
            for p in parts:
                result = "{result}{p}"
            result
        Value.Tuple(elems):
            var parts = ["("]
            var first = true
            for e in elems:
                if not first:
                    parts.push(", ")
                parts.push(val_to_string(e))
                first = false
            parts.push(")")
            var string result = ""
            for p in parts:
                result = "{result}{p}"
            result
        Value.Dict(pairs):
            var parts = ["{{"]
            var first = true
            for pair in pairs:
                if not first:
                    parts.push(", ")
                parts.push(val_to_string(pair.0))
                parts.push(": ")
                parts.push(val_to_string(pair.1))
                first = false
            parts.push("}}")
            var string result = ""
            for p in parts:
                result = "{result}{p}"
            result
        Value.Set(elems):
            var parts = ["{{"]
            var first = true
            for e in elems:
                if not first:
                    parts.push(", ")
                parts.push(val_to_string(e))
                first = false
            parts.push("}}")
            var string result = ""
            for p in parts:
                result = "{result}{p}"
            result
        Value.EnumVariant(typeName, variant, fields):
            if fields.length == 0:
                variant
            else:
                var parts = ["{variant}("]
                var first = true
                for f in fields:
                    if not first:
                        parts.push(", ")
                    parts.push(val_to_string(f))
                    first = false
                parts.push(")")
                var result = ""
                for p in parts:
                    result = "{result}{p}"
                result
        Value.NativeFn(name, _): "<fn {name}>"
        Value.Fn(name, _): "<fn {name}>"
        Value.OverloadedFn(name, _): "<overloaded fn {name}>"
        Value.Closure(_, _, _): "<closure>"
        Value.Range(start, end, inclusive, _):
            if inclusive:
                "{start}..{end}"
            else:
                "{start}..<{end}"
        Value.Labeled(label, val): "{label}={val_to_string(val)}"
        Value.Object(inner): "<object>"
        _: "<value>"

# ─── val_to_bool ──────────────────────────────────────────────────────────────

def bool val_to_bool(Value v):
    match v:
        Value.Nil: false
        Value.Void: false
        Value.Uninitialized: false
        Value.Bool(b): b
        Value.Int(n): n != 0
        Value.Float64(f): f != 0.0
        Value.Float32(f): f != 0.0
        Value.Str(s): s != ""
        Value.Array(elems): elems.length != 0
        Value.Dict(pairs): pairs.length != 0
        Value.Set(elems): elems.length != 0
        Value.Tuple(elems): elems.length != 0
        _: true

# ─── values_equal ─────────────────────────────────────────────────────────────

def bool values_equal(Value a, Value b):
    match a:
        Value.Nil:
            match b:
                Value.Nil: true
                _: false
        Value.Void:
            match b:
                Value.Void: true
                _: false
        Value.Bool(x):
            match b:
                Value.Bool(y): x == y
                _: false
        # float32/float64 compare freely against each other and against any
        # int kind (widened to float64) — deliberately more permissive than
        # arithmetic's strict mixing rule, same precedent as the int-kind
        # cross-comparison in the fallback arm below
        # (docs/float-width-types.md §3).
        Value.Float64(x):
            match b:
                Value.Float64(y): x == y
                _:
                    if let yv = value_as_float64_widened(b): x == yv else: false
        Value.Float32(x):
            match b:
                Value.Float32(y): x == y
                _:
                    if let yv = value_as_float64_widened(b): (x as float64) == yv else: false
        Value.Str(x):
            match b:
                Value.Str(y): x == y
                _: false
        Value.Array(xs):
            match b:
                Value.Array(ys):
                    if xs.length != ys.length:
                        false
                    else:
                        var i = 0
                        var eq = true
                        while i < xs.length:
                            if not values_equal(xs[i], ys[i]):
                                eq = false
                            i = i + 1
                        eq
                _: false
        Value.LabeledArray(xs, xaxes):
            match b:
                Value.LabeledArray(ys, yaxes):
                    if xaxes.length != yaxes.length or xs.length != ys.length:
                        false
                    else:
                        var eq = true
                        var ai = 0
                        while ai < xaxes.length:
                            if xaxes[ai].0 != yaxes[ai].0 or xaxes[ai].1 != yaxes[ai].1:
                                eq = false
                            ai = ai + 1
                        var ei = 0
                        while ei < xs.length:
                            if not values_equal(xs[ei], ys[ei]):
                                eq = false
                            ei = ei + 1
                        eq
                _: false
        Value.Tuple(xs):
            match b:
                Value.Tuple(ys):
                    if xs.length != ys.length:
                        false
                    else:
                        var i = 0
                        var eq = true
                        while i < xs.length:
                            if not values_equal(xs[i], ys[i]):
                                eq = false
                            i = i + 1
                        eq
                _: false
        Value.EnumVariant(tn1, v1, f1):
            match b:
                Value.EnumVariant(tn2, v2, f2):
                    if tn1 != tn2 or v1 != v2 or f1.length != f2.length:
                        false
                    else:
                        var i = 0
                        var eq = true
                        while i < f1.length:
                            if not values_equal(f1[i], f2[i]):
                                eq = false
                            i = i + 1
                        eq
                _: false
        Value.Range(s1, e1, inc1, _):
            match b:
                Value.Range(s2, e2, inc2, _): s1 == s2 and e1 == e2 and inc1 == inc2
                _: false
        # Any of the 12 numeric int-kinds (Int/Uint/Uint8/Int8../Uint128) — same-kind
        # and cross-kind (including vs. Float) numeric equality, generalized instead
        # of one hand-written match arm per pair.
        # Set/Dict/Object/closures/etc. — no cross-type numeric coercion applies,
        # so defer to native structural equality (this is also what set-literal
        # normalization relies on for order-independent set equality).
        _:
            guard let ka = num_kind_of(a) else: return a == b
            guard let av = value_as_i128(a) else: return false
            if let bv = value_as_i128(b):
                av == bv
            elif let bf = value_as_float64_widened(b):
                (av as float64) == bf
            else:
                false

# ─── env_define ───────────────────────────────────────────────────────────────

def void env_define(mut Env'actor env, string name, Value val, bool mutable):
    if mutable:
        env.define_mut(name, val)
    else:
        env.define(name, val)

# ─── register_stdlib ──────────────────────────────────────────────────────────

def void register_stdlib(mut Interpreter interp):
    mut env = interp.global_env

    let print_fn = Value.NativeFn("print", Value.Nil)
    env_define(env, "print", print_fn, false)

    let println_fn = Value.NativeFn("println", Value.Nil)
    env_define(env, "println", println_fn, false)

    let write_fn = Value.NativeFn("write", Value.Nil)
    env_define(env, "write", write_fn, false)

    let len_fn = Value.NativeFn("len", Value.Nil)
    env_define(env, "len", len_fn, false)

    let int_fn = Value.NativeFn("int", Value.Nil)
    env_define(env, "int", int_fn, false)

    let uint_fn = Value.NativeFn("uint", Value.Nil)
    env_define(env, "uint", uint_fn, false)

    let uint8_fn = Value.NativeFn("uint8", Value.Nil)
    env_define(env, "uint8", uint8_fn, false)

    for name in ["int8", "int16", "int32", "int64", "int128", "uint16", "uint32", "uint64", "uint128"]:
        env_define(env, name, Value.NativeFn(name, Value.Nil), false)

    let float_fn = Value.NativeFn("float", Value.Nil)
    env_define(env, "float", float_fn, false)

    let string_fn = Value.NativeFn("string", Value.Nil)
    env_define(env, "string", string_fn, false)

    let bool_fn = Value.NativeFn("bool", Value.Nil)
    env_define(env, "bool", bool_fn, false)

    let type_fn = Value.NativeFn("type", Value.Nil)
    env_define(env, "type", type_fn, false)

    let sqrt_fn = Value.NativeFn("sqrt", Value.Nil)
    env_define(env, "sqrt", sqrt_fn, false)

    let abs_fn = Value.NativeFn("abs", Value.Nil)
    env_define(env, "abs", abs_fn, false)

    let floor_fn = Value.NativeFn("floor", Value.Nil)
    env_define(env, "floor", floor_fn, false)

    let ceil_fn = Value.NativeFn("ceil", Value.Nil)
    env_define(env, "ceil", ceil_fn, false)

    let round_fn = Value.NativeFn("round", Value.Nil)
    env_define(env, "round", round_fn, false)

    let sin_fn = Value.NativeFn("sin", Value.Nil)
    env_define(env, "sin", sin_fn, false)

    let cos_fn = Value.NativeFn("cos", Value.Nil)
    env_define(env, "cos", cos_fn, false)

    let tan_fn = Value.NativeFn("tan", Value.Nil)
    env_define(env, "tan", tan_fn, false)

    let log_fn = Value.NativeFn("log", Value.Nil)
    env_define(env, "log", log_fn, false)

    let log2_fn = Value.NativeFn("log2", Value.Nil)
    env_define(env, "log2", log2_fn, false)

    let exp_fn = Value.NativeFn("exp", Value.Nil)
    env_define(env, "exp", exp_fn, false)

    let pow_fn = Value.NativeFn("pow", Value.Nil)
    env_define(env, "pow", pow_fn, false)

    let min_fn = Value.NativeFn("min", Value.Nil)
    env_define(env, "min", min_fn, false)

    let max_fn = Value.NativeFn("max", Value.Nil)
    env_define(env, "max", max_fn, false)

    let range_fn = Value.NativeFn("range", Value.Nil)
    env_define(env, "range", range_fn, false)

    let assert_fn = Value.NativeFn("assert", Value.Nil)
    env_define(env, "assert", assert_fn, false)

    let read_line_fn = Value.NativeFn("read_line", Value.Nil)
    env_define(env, "read_line", read_line_fn, false)

    let exit_fn = Value.NativeFn("exit", Value.Nil)
    env_define(env, "exit", exit_fn, false)

    let args_fn = Value.NativeFn("args", Value.Nil)
    env_define(env, "args", args_fn, false)

    let input_fn = Value.NativeFn("input", Value.Nil)
    env_define(env, "input", input_fn, false)

    let error_fn = Value.NativeFn("error", Value.Nil)
    env_define(env, "error", error_fn, false)

    let ord_fn = Value.NativeFn("ord", Value.Nil)
    env_define(env, "ord", ord_fn, false)

    let chr_fn = Value.NativeFn("chr", Value.Nil)
    env_define(env, "chr", chr_fn, false)

    let zip_fn = Value.NativeFn("zip", Value.Nil)
    env_define(env, "zip", zip_fn, false)

    let enumerate_fn = Value.NativeFn("enumerate", Value.Nil)
    env_define(env, "enumerate", enumerate_fn, false)

    let map_fn = Value.NativeFn("map", Value.Nil)
    env_define(env, "map", map_fn, false)

    let filter_fn = Value.NativeFn("filter", Value.Nil)
    env_define(env, "filter", filter_fn, false)

    let reduce_fn = Value.NativeFn("reduce", Value.Nil)
    env_define(env, "reduce", reduce_fn, false)

    let sorted_fn = Value.NativeFn("sorted", Value.Nil)
    env_define(env, "sorted", sorted_fn, false)

    let reversed_fn = Value.NativeFn("reversed", Value.Nil)
    env_define(env, "reversed", reversed_fn, false)

    let sum_fn = Value.NativeFn("sum", Value.Nil)
    env_define(env, "sum", sum_fn, false)

    let any_fn = Value.NativeFn("any", Value.Nil)
    env_define(env, "any", any_fn, false)

    let all_fn = Value.NativeFn("all", Value.Nil)
    env_define(env, "all", all_fn, false)

    let assert_eq_fn = Value.NativeFn("assert_eq", Value.Nil)
    env_define(env, "assert_eq", assert_eq_fn, false)

    let assert_neq_fn = Value.NativeFn("assert_neq", Value.Nil)
    env_define(env, "assert_neq", assert_neq_fn, false)

    env_define(env, "PI", Value.Float64(3.141592653589793), false)
    env_define(env, "E", Value.Float64(2.718281828459045), false)

    for math_fn in ["sin", "cos", "tan", "round", "floor", "ceil", "pow", "log", "ln", "log2", "log10"]:
        env_define(env, math_fn, Value.NativeFn(math_fn, Value.Nil), false)

    let hashmap_fn = Value.NativeFn("HashMap", Value.Nil)
    env_define(env, "HashMap", hashmap_fn, false)

    let hashset_fn = Value.NativeFn("HashSet", Value.Nil)
    env_define(env, "HashSet", hashset_fn, false)

    let vec_fn = Value.NativeFn("Vec", Value.Nil)
    env_define(env, "Vec", vec_fn, false)

    env_define(env, "channel", Value.NativeFn("channel", Value.Nil), false)
    env_define(env, "drop", Value.NativeFn("drop", Value.Nil), false)

    # Result constructors: Ok(v) and Err(e)
    env_define(env, "Ok", Value.EnumVariant("Result", "Ok", []), false)
    env_define(env, "Err", Value.EnumVariant("Result", "Err", []), false)
    # Option constructors: Some(v)
    env_define(env, "Some", Value.EnumVariant("Option", "Some", []), false)
    env_define(env, "None", Value.EnumVariant("Option", "None", []), false)

# ─── new_interpreter ──────────────────────────────────────────────────────────

def Interpreter'actor new_interpreter():
    mut global = new_env(nil)
    var interp'actor = Interpreter(
        global_env = global,
        current_env = global,
        struct_methods = {},
        fn_decls = {},
        struct_decls = {},
        enum_decls = {},
        has_pending_return = false,
        pending_return_val = Value.Nil,
        next_ref_id = 0,
        has_pending_throw = false,
        pending_throw_val = Value.Nil,
        channel_queues = {},
        next_channel_id = 0,
        in_stream_fn = false,
        stream_yields = [],
        in_kernel_context = false,
        cli_args = [],
        return_ty_stack = []
    )
    register_stdlib(interp)
    interp

# ─── register_free_fn ──────────────────────────────────────────────────────────
#
# Registers a free-function `decl` under `decl.name` in `target_env`'s *local* scope
# (never a parent scope — `target_env.vars.has` rather than `.get`, so a nested `def`
# never accidentally merges into an unrelated same-named function further up the
# environment chain). If the name is already bound to a plain `Value.Fn` (or to a
# `Value.OverloadedFn` from an earlier call to this function), upgrades/extends it into
# a `Value.OverloadedFn` instead of silently overwriting — mirrors the "upgrade to
# OverloadedFn" step in src/interpreter/mod.rs's `Item::Fn` handling, bringing free
# functions to parity with struct/enum method overloads (find_best_method).
#
# Each overload variant needs its own independently-resolvable FnDecl, but `fn_decls`
# is a single-value `{string=FnDecl}` map (one entry per name) and `Value.Fn` only
# carries a name string (no embedded decl, unlike the Rust reference's
# `Value::Fn { decl, captured }`) — so each variant beyond the first is registered
# under a synthesized `"{name}#{index}"` key instead of the bare name. `#` can't appear
# in a real identifier (the lexer reads it as a comment), so these keys never collide
# with an actual declared function. `fn_decls[name]` itself is left pointing at the
# first-declared variant for callers that look functions up by bare name outside the
# OverloadedFn path (e.g. the `|>` pipe operator's `interp.get_fn_decl(method)`).
def void register_free_fn(mut Interpreter interp, mut Env'actor target_env, FnDecl decl):
    let fn_name = decl.name
    let existing_opt = target_env.get_local(fn_name)
    if let existing = existing_opt:
        match existing:
            Value.Fn(_, existing_captured):
                let existing_decl_opt = interp.get_fn_decl(fn_name)
                if let existing_decl = existing_decl_opt:
                    let key0 = "{fn_name}#0"
                    let key1 = "{fn_name}#1"
                    interp.set_fn_decl(key0, existing_decl)
                    interp.set_fn_decl(key1, decl)
                    let variants = [Value.Fn(key0, existing_captured), Value.Fn(key1, target_env.clone())]
                    target_env.define(fn_name, Value.OverloadedFn(fn_name, variants))
                else:
                    interp.set_fn_decl(fn_name, decl)
                    target_env.define(fn_name, Value.Fn(fn_name, target_env.clone()))
            Value.OverloadedFn(_, existing_variants):
                let idx = existing_variants.length
                let key = "{fn_name}#{idx}"
                interp.set_fn_decl(key, decl)
                var new_variants = [Value]{}
                for v in existing_variants:
                    new_variants.push(v)
                new_variants.push(Value.Fn(key, target_env.clone()))
                target_env.define(fn_name, Value.OverloadedFn(fn_name, new_variants))
            _:
                interp.set_fn_decl(fn_name, decl)
                target_env.define(fn_name, Value.Fn(fn_name, target_env.clone()))
    else:
        interp.set_fn_decl(fn_name, decl)
        target_env.define(fn_name, Value.Fn(fn_name, target_env.clone()))

# ─── exec_item ────────────────────────────────────────────────────────────────

def void exec_item(mut Interpreter interp, Item item):
    match item:
        Item.Fn(decl):
            # `interp.global_env` is read into its own statement first, not inlined as a
            # call argument — the transpiled Rust temporary MutexGuard from reading a
            # `mut Interpreter` field lives for the whole enclosing statement, and
            # register_free_fn separately locks `interp` internally; inlining the two
            # would self-deadlock on Interpreter's own mutex.
            mut genv = interp.global_env
            register_free_fn(interp, genv, decl)
        Item.Struct(decl):
            let sname = decl.name
            interp.set_struct_decl(sname, decl)
            # Collect own methods into final list; build a comma-separated name index
            var all_struct_methods = [FnDecl]{}
            var own_names_str = ","
            for m in decl.methods:
                own_names_str = own_names_str + m.name + ","
                all_struct_methods.push(m)
            # Merge trait default implementations for each declared protocol
            for proto_name in decl.protocols:
                let trait_key = "__trait__" + proto_name
                let trait_methods_opt = interp.struct_methods.get(trait_key)
                if let trait_methods = trait_methods_opt:
                    for tm in trait_methods:
                        if not own_names_str.contains("," + tm.name + ","):
                            all_struct_methods.push(tm)
            interp.set_method_decls(sname, all_struct_methods)
            env_define(interp.global_env, sname, Value.StructDef(sname), false)
        Item.Enum(decl):
            let ename = decl.name
            interp.set_enum_decl(ename, decl)
            interp.set_method_decls(ename, decl.methods)
            env_define(interp.global_env, ename, Value.EnumDef(ename), false)
        Item.Trait(decl):
            env_define(interp.global_env, decl.name, Value.Nil, false)
            # Store default implementations under a special key for later lookup
            if decl.defaults.length > 0:
                interp.set_method_decls("__trait__" + decl.name, decl.defaults)
        Item.Let(stmt):
            if stmt.is_lazy:
                interp.current_env.define_lazy(stmt.name)
            else:
                env_define(interp.current_env, stmt.name, Value.Uninitialized, true)
        Item.Alias(decl):
            # Resolve the aliased type — look up the base type name in the env
            let alias_type_name = match decl.ty:
                Type.Named(n): n
                Type.Qualified(inner, _):
                    match inner:
                        Type.Named(n2): n2
                        _: ""
                _: ""
            let alias_val = if alias_type_name.length > 0:
                let found = interp.global_env.get(alias_type_name)
                found else Value.Nil
            else:
                Value.Nil
            env_define(interp.global_env, decl.name, alias_val, false)
        Item.Stmt(stmt):
            exec_stmt(interp, stmt)
        Item.Use(decl):
            env_define(interp.current_env, "__use__", Value.Nil, true)
        Item.Ext(decl):
            # Register extension methods on the target type. An `ext` method
            # overrides an *existing* method only when they share the same
            # signature (same name + same param shapes, via
            # params_same_signature) — a same-named method with a different
            # signature is a separate overload and both must survive (book.md
            # "Struct methods can also be overloaded within ext blocks").
            # Name-only dedup here would silently drop every other overload
            # of that name the moment any single ext method shared its name.
            let existing_methods_opt = interp.struct_methods.get(decl.type_name)
            var all_methods = [FnDecl]{}
            var di = 0
            while di < decl.methods.length:
                all_methods.push(decl.methods[di])
                di = di + 1
            if let existing = existing_methods_opt:
                for em in existing:
                    var overridden = false
                    var dj = 0
                    while dj < decl.methods.length:
                        let m = decl.methods[dj]
                        if em.name == m.name and params_same_signature(em.clone(), m):
                            overridden = true
                        dj = dj + 1
                    if not overridden:
                        all_methods.push(em)
            interp.set_method_decls(decl.type_name, all_methods)
        Item.Mod(decl):
            for sub_item in decl.items:
                exec_item(interp, sub_item)

# ─── run_program ──────────────────────────────────────────────────────────────

def void run_program(mut Interpreter interp, Program prog):
    for item in prog.items:
        exec_item(interp, item)
    # Auto-invoke `main` after registering all top-level items, mirroring the
    # Rust interpreter's entry point — a `.br` program that only declares
    # `def main():` (the standard idiom) must actually run it.
    let main_decl_opt = interp.get_fn_decl("main")
    if let main_decl = main_decl_opt:
        _ = call_fn(interp, main_decl, [], nil)

