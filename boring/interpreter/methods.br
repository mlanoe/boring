# == BUILT-IN METHODS ==

# Generalized instead of one hand-written match arm per numeric-kind pair —
# see the NumKind model in eval.br (num_kind_of/value_as_i128/etc.).
def bool value_lt(Value a, Value b):
    # float32/float64 compare freely against each other and against any int
    # kind (widened to float64) — same permissive precedent as elsewhere
    # (docs/float-width-types.md §3).
    let a_is_float = match a:
        Value.Float64(_): true
        Value.Float32(_): true
        _: false
    let b_is_float = match b:
        Value.Float64(_): true
        Value.Float32(_): true
        _: false
    if a_is_float or b_is_float:
        guard let af = value_as_float64_widened(a) else: return false
        guard let bf = value_as_float64_widened(b) else: return false
        af < bf
    else:
        match a:
            Value.Str(x):
                match b:
                    Value.Str(y): x < y
                    _: false
            _:
                guard let av = value_as_i128(a) else: return false
                guard let bv = value_as_i128(b) else: return false
                av < bv

def string val_type_name(Value v):
    match v:
        Value.Int(_): "int"
        Value.Uint(_): "uint"
        Value.Uint8(_): "uint8"
        Value.Int8(_): "int8"
        Value.Int16(_): "int16"
        Value.Int32(_): "int32"
        Value.Int64(_): "int64"
        Value.Int128(_): "int128"
        Value.Uint16(_): "uint16"
        Value.Uint32(_): "uint32"
        Value.Uint64(_): "uint64"
        Value.Uint128(_): "uint128"
        Value.Float64(_): "float"
        Value.Float32(_): "float32"
        Value.Str(_): "string"
        Value.Bool(_): "bool"
        Value.Array(_): "array"
        Value.LabeledArray(_, _): "array"
        Value.Dict(_): "dict"
        Value.Set(_): "set"
        Value.Nil: "nil"
        Value.Void: "void"
        Value.Tuple(_): "tuple"
        Value.Range(_, _, _, _): "range"
        Value.Object(inner): inner.type_name.clone()
        Value.EnumVariant(type_name, _, _): type_name
        _: "unknown"

# Simplified static type check used for method-overload resolution — mirrors
# src/interpreter/methods.rs::value_matches_type_static. Every recognized
# primitive `Type` variant compares its keyword against `val_type_name(val)`,
# which already uses the identical keyword spellings ("int", "float" for
# Float64, "float32" for Float32, etc.) — see val_type_name above. A `Named`
# type that isn't one of those keywords is a custom struct/enum name; it is
# always accepted without checking the value's actual type name, the same
# simplification the Rust reference implementation makes (find_best_method's
# job is picking *an* overload, not fully type-checking the call).
def bool value_matches_named_type_static(Value val, string name):
    let vt = val_type_name(val)
    match name:
        "int": vt == "int"
        "uint": vt == "uint"
        "uint8": vt == "uint8"
        "int8": vt == "int8"
        "int16": vt == "int16"
        "int32": vt == "int32"
        "int64": vt == "int64"
        "int128": vt == "int128"
        "uint16": vt == "uint16"
        "uint32": vt == "uint32"
        "uint64": vt == "uint64"
        "uint128": vt == "uint128"
        "float32": vt == "float32"
        "f32": vt == "float32"
        "float": vt == "float"
        "float64": vt == "float"
        "f64": vt == "float"
        "bool": vt == "bool"
        "string": vt == "string"
        _: true

def bool value_matches_type_static(Value val, Type ty):
    let vt = val_type_name(val)
    match ty:
        Type.Int: vt == "int"
        Type.Uint: vt == "uint"
        Type.Uint8: vt == "uint8"
        Type.Int8: vt == "int8"
        Type.Int16: vt == "int16"
        Type.Int32: vt == "int32"
        Type.Int64: vt == "int64"
        Type.Int128: vt == "int128"
        Type.Uint16: vt == "uint16"
        Type.Uint32: vt == "uint32"
        Type.Uint64: vt == "uint64"
        Type.Uint128: vt == "uint128"
        Type.Float32: vt == "float32"
        Type.Float64: vt == "float"
        Type.Str: vt == "string"
        Type.Bool: vt == "bool"
        Type.Qualified(inner, _): value_matches_type_static(val, inner)
        Type.Named(name): value_matches_named_type_static(val, name)
        Type.Optional(_): true
        Type.Array(_): vt == "array"
        Type.Dict(_, _): vt == "dict"
        Type.Set(_): vt == "set"
        _: true

# Normalizes a float type-name alias down to the same keyword val_type_name
# would produce ("f32"/"float32" → "float32", "f64"/"float64"/"float" →
# "float"), otherwise returns the name unchanged. Shared by
# value_matches_named_type_static (above) and type_overload_keyword (below).
def string normalize_overload_float_alias(string name):
    match name:
        "f32": "float32"
        "float32": "float32"
        "f64": "float"
        "float64": "float"
        "float": "float"
        _: name

# The outermost "shape" of a `Type`, as a keyword string, for
# types_match_for_overload below — nil for shapes that function doesn't
# compare (matches the Rust reference's fallback `_ => false`). A `Named`
# type normalizes through normalize_overload_float_alias first so
# `Named("f64")` and the dedicated `Float64` variant produce the same
# keyword; any other `Named` name (a struct/enum) passes through unchanged,
# so two `Named` types compare equal exactly when their names are equal —
# mirrors src/interpreter/mod.rs::types_match_for_overload.
def string? type_overload_keyword(Type ty):
    match ty:
        Type.Int: "int"
        Type.Uint: "uint"
        Type.Uint8: "uint8"
        Type.Int8: "int8"
        Type.Int16: "int16"
        Type.Int32: "int32"
        Type.Int64: "int64"
        Type.Int128: "int128"
        Type.Uint16: "uint16"
        Type.Uint32: "uint32"
        Type.Uint64: "uint64"
        Type.Uint128: "uint128"
        Type.Float32: "float32"
        Type.Float64: "float"
        Type.Str: "string"
        Type.Bool: "bool"
        Type.Named(name): normalize_overload_float_alias(name)
        Type.Array(_): "array"
        Type.Dict(_, _): "dict"
        Type.Set(_): "set"
        _: nil

# Simplified type-shape equality for overload-conflict/dedup purposes — only
# the outermost shape is compared (an `[int]` and a `[string]` param count as
# the same "shape" here), same simplification the Rust reference
# implementation makes (src/interpreter/mod.rs::types_match_for_overload).
def bool types_match_for_overload(Type a, Type b):
    let ka_opt = type_overload_keyword(a)
    let kb_opt = type_overload_keyword(b)
    if let ka = ka_opt:
        if let kb = kb_opt:
            return ka == kb
    false

# True when `a` and `b` declare the same parameter count and (shape-)matching
# param types — i.e. they are the *same* overload, not two different ones.
# Used by `ext` method merging (stdlib.br's Item.Ext handling) to distinguish
# "override this exact overload" from "add a new overload with the same
# name" — mirrors src/interpreter/mod.rs::params_same_signature.
def bool params_same_signature(FnDecl a, FnDecl b):
    if a.params.length != b.params.length:
        return false
    var i = 0
    while i < a.params.length:
        let pa_ty = a.params[i].ty
        let pb_ty = b.params[i].ty
        if let ta = pa_ty:
            if let tb = pb_ty:
                if not types_match_for_overload(ta, tb):
                    return false
            else:
                return false
        else:
            if pb_ty != nil:
                return false
        i = i + 1
    true

def Value call_method(mut Interpreter interp, Value recv, string method_name, [Value] args):
    if method_name == "clone" and args.length == 0:
        return recv
    let recv_type = recv.type_name()
    match recv:
        Value.Str(s):
            match method_name:
                "length":
                    Value.Int(s.length)
                "len":
                    Value.Int(s.length)
                "split":
                    let sep = args[0] else Value.Str("")
                    match sep:
                        Value.Str(sv):
                            Value.Array(s.split(sv).map((part): Value.Str(part)))
                        _: throw "split: expected string separator"
                "trim":
                    Value.Str(s.trim())
                "trimStart":
                    Value.Str(s.trimStart())
                "trimEnd":
                    Value.Str(s.trimEnd())
                "startsWith":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv): Value.Bool(s.startsWith(sv))
                        _: throw "startsWith: expected string argument"
                "endsWith":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv): Value.Bool(s.endsWith(sv))
                        _: throw "endsWith: expected string argument"
                "contains":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv): Value.Bool(s.contains(sv))
                        _: throw "contains: expected string argument"
                "replace":
                    let from_val = args[0] else Value.Str("")
                    let to_val = args[1] else Value.Str("")
                    match from_val:
                        Value.Str(from_s):
                            match to_val:
                                Value.Str(to_s): Value.Str(s.replace(from_s, to_s))
                                _: throw "replace: expected string arguments"
                        _: throw "replace: expected string arguments"
                "toUpper":
                    Value.Str(s.toUpper())
                "upper":
                    Value.Str(s.toUpper())
                "to_upper":
                    Value.Str(s.toUpper())
                "toLower":
                    Value.Str(s.toLower())
                "lower":
                    Value.Str(s.toLower())
                "to_lower":
                    Value.Str(s.toLower())
                "chars":
                    Value.Array(s.chars().map((c): Value.Str(c)))
                "lines":
                    Value.Array(s.split("\n").map((l): Value.Str(l)))
                "slice":
                    let start_val = args[0] else Value.Int(0)
                    let end_val = args[1] else Value.Int(s.length)
                    match start_val:
                        Value.Int(start):
                            match end_val:
                                Value.Int(end):
                                    # Clamp exactly like the native `a[m..n]` slice syntax
                                    # (see ExprKind.SliceRange in eval.br) — negative indices
                                    # count from the end, out-of-bounds indices clamp to the
                                    # string's own bounds, and an empty/inverted range yields
                                    # "" instead of panicking (this used to pass start/end
                                    # straight through to `s.slice`, so e.g. `"hi".slice(-1, 3)`
                                    # would crash instead of the Python-like idiom it looks like).
                                    let len = s.length
                                    let lo = if start < 0: (len + start).max(0) else: start.min(len)
                                    let hi = if end < 0: (len + end).max(0) else: end.min(len)
                                    if lo >= len or lo >= hi:
                                        Value.Str("")
                                    else:
                                        Value.Str(s.slice(lo, hi))
                                _: throw "slice: expected int end"
                        _: throw "slice: expected int start"
                "indexOf":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv):
                            let idx = s.indexOf(sv)
                            if let idx_val = idx:
                                Value.Int(idx_val)
                            else:
                                Value.Nil
                        _: throw "indexOf: expected string argument"
                "repeat":
                    let arg = args[0] else Value.Int(0)
                    match arg:
                        Value.Int(n): Value.Str(s.repeat(n as uint))
                        _: throw "repeat: expected int argument"
                "padLeft":
                    let width_val = args[0] else Value.Int(0)
                    let pad_val = args[1] else Value.Str(" ")
                    match width_val:
                        Value.Int(w):
                            match pad_val:
                                Value.Str(p):
                                    let cur_len = s.length
                                    if cur_len >= w:
                                        Value.Str(s)
                                    else:
                                        let padding = p.repeat((w - cur_len) as uint)
                                        Value.Str("{padding}{s}")
                                _: throw "padLeft: expected string pad"
                        _: throw "padLeft: expected int width"
                "padRight":
                    let width_val = args[0] else Value.Int(0)
                    let pad_val = args[1] else Value.Str(" ")
                    match width_val:
                        Value.Int(w):
                            match pad_val:
                                Value.Str(p):
                                    let cur_len = s.length
                                    if cur_len >= w:
                                        Value.Str(s)
                                    else:
                                        let padding = p.repeat((w - cur_len) as uint)
                                        Value.Str("{s}{padding}")
                                _: throw "padRight: expected string pad"
                        _: throw "padRight: expected int width"
                "parseInt":
                    let parsed = s.parseInt()
                    if parsed == nil:
                        Value.Nil
                    else:
                        Value.Int(parsed else 0)
                "parseFloat":
                    let parsed = s.parseFloat()
                    if parsed == nil:
                        Value.Nil
                    else:
                        Value.Float64(parsed else 0.0)
                "isDigit":
                    Value.Bool(s.length == 1 and s.chars().all((c): c >= "0" and c <= "9"))
                "isAlpha":
                    Value.Bool(s.length == 1 and ((s >= "a" and s <= "z") or (s >= "A" and s <= "Z")))
                "isEmpty":
                    Value.Bool(s.length == 0)
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Array(arr):
            match method_name:
                "length":
                    Value.Int(arr.length)
                "len":
                    Value.Int(arr.length)
                "append":
                    let other_val = args[0] else Value.Nil
                    match other_val:
                        Value.Array(other):
                            var result = arr
                            var i = 0
                            while i < other.length:
                                result.push(other[i])
                                i = i + 1
                            Value.Array(result)
                        _:
                            var result = arr
                            result.push(other_val)
                            Value.Array(result)
                "push":
                    let val = args[0] else Value.Nil
                    var result = arr
                    result.push(val)
                    Value.Array(result)
                "pop":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        arr[arr.length - 1]
                "remove":
                    let idx_val = args[0] else Value.Int(0)
                    match idx_val:
                        Value.Int(raw_idx):
                            let idx = if raw_idx < 0: arr.length + raw_idx else raw_idx
                            arr[idx] else Value.Nil
                        _: throw "remove: expected int index"
                "insert":
                    let idx_val = args[0] else Value.Int(0)
                    let val = args[1] else Value.Nil
                    match idx_val:
                        Value.Int(idx):
                            var result = arr
                            result.insert(idx, val)
                            Value.Array(result)
                        _: throw "insert: expected int index"
                "first":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        arr[0]
                "last":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        arr[arr.length - 1]
                "firstIndex":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        Value.Int(0)
                "nextIndex":
                    let cur = args[0] else Value.Nil
                    match cur:
                        Value.Int(i):
                            let next = i + 1
                            if next < arr.length:
                                Value.Int(next)
                            else:
                                Value.Nil
                        _: Value.Nil
                "contains":
                    let target = args[0] else Value.Nil
                    Value.Bool(arr.contains(target))
                "map":
                    let closure = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < arr.length:
                        let r = call_value(interp, closure, [arr[i]])
                        result.push(r)
                        i = i + 1
                    Value.Array(result)
                "filter":
                    let closure = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < arr.length:
                        let r = call_value(interp, closure, [arr[i]])
                        match r:
                            Value.Bool(b):
                                if b:
                                    result.push(arr[i])
                            _: throw "filter: predicate must return bool"
                        i = i + 1
                    Value.Array(result)
                "reduce":
                    let init_val = args[0] else Value.Nil
                    let closure = args[1] else Value.Nil
                    var acc = init_val
                    var i = 0
                    while i < arr.length:
                        acc = call_value(interp, closure, [acc, arr[i]])
                        i = i + 1
                    acc
                "sorted":
                    let n = arr.length
                    var sorted = arr
                    var i = 0
                    while i < n:
                        var j = i + 1
                        while j < n:
                            let si = val_to_string(sorted[i])
                            let sj = val_to_string(sorted[j])
                            if string_gt(si, sj):
                                let tmp = sorted[i]
                                sorted[i] = sorted[j]
                                sorted[j] = tmp
                            j = j + 1
                        i = i + 1
                    Value.Array(sorted)
                "sortedBy":
                    let closure = args[0] else Value.Nil
                    var keys = []
                    var i = 0
                    while i < arr.length:
                        let k = call_value(interp, closure, [arr[i]])
                        keys.push(k)
                        i = i + 1
                    # Build sorted copy of arr using insertion sort on keys
                    var sorted_arr = arr
                    var sorted_keys = keys
                    var si = 1
                    while si < sorted_arr.length:
                        var sj = si
                        while sj > 0 and value_lt(sorted_keys[sj], sorted_keys[sj - 1]):
                            let tmp_v = sorted_arr[sj]
                            sorted_arr[sj] = sorted_arr[sj - 1]
                            sorted_arr[sj - 1] = tmp_v
                            let tmp_k = sorted_keys[sj]
                            sorted_keys[sj] = sorted_keys[sj - 1]
                            sorted_keys[sj - 1] = tmp_k
                            sj = sj - 1
                        si = si + 1
                    Value.Array(sorted_arr)
                "reversed":
                    var result = arr
                    result = result.reversed()
                    Value.Array(result)
                "any":
                    let closure = args[0] else Value.Nil
                    var found = false
                    var i = 0
                    while i < arr.length and not found:
                        let r = call_value(interp, closure, [arr[i]])
                        match r:
                            Value.Bool(b):
                                if b:
                                    found = true
                            _: throw "any: predicate must return bool"
                        i = i + 1
                    Value.Bool(found)
                "all":
                    let closure = args[0] else Value.Nil
                    var all_pass = true
                    var i = 0
                    while i < arr.length and all_pass:
                        let r = call_value(interp, closure, [arr[i]])
                        match r:
                            Value.Bool(b):
                                if not b:
                                    all_pass = false
                            _: throw "all: predicate must return bool"
                        i = i + 1
                    Value.Bool(all_pass)
                "count":
                    if args.length == 0:
                        Value.Int(arr.length)
                    else:
                        let closure = args[0]
                        var n = 0
                        var i = 0
                        while i < arr.length:
                            let r = call_value(interp, closure, [arr[i]])
                            match r:
                                Value.Bool(b):
                                    if b:
                                        n = n + 1
                                _: throw "count: predicate must return bool"
                            i = i + 1
                        Value.Int(n)
                "take":
                    let n_val = args[0] else Value.Int(0)
                    match n_val:
                        Value.Int(n):
                            let end = if n < arr.length: n else: arr.length
                            Value.Array(arr.slice(0, end))
                        _: throw "take: expected int argument"
                "drop":
                    let n_val = args[0] else Value.Int(0)
                    match n_val:
                        Value.Int(n):
                            let start = if n < arr.length: n else: arr.length
                            Value.Array(arr.slice(start, arr.length))
                        _: throw "drop: expected int argument"
                "slice":
                    let start_val = args[0] else Value.Int(0)
                    let end_val = args[1] else Value.Int(arr.length)
                    match start_val:
                        Value.Int(start):
                            match end_val:
                                Value.Int(end):
                                    # Clamp exactly like the native `a[m..n]` slice syntax
                                    # (see ExprKind.SliceRange in eval.br) — negative indices
                                    # count from the end, out-of-bounds indices clamp to the
                                    # array's own bounds, and an empty/inverted range yields
                                    # [] instead of panicking. Previously only clamped the
                                    # upper bound (`if start < arr.length: start else: arr.length`),
                                    # which leaves a negative `start`/`end` untouched — the
                                    # Python-like idiom `arr.slice(-1, 3)` would crash instead
                                    # of slicing from the end.
                                    let len = arr.length
                                    let lo = if start < 0: (len + start).max(0) else: start.min(len)
                                    let hi = if end < 0: (len + end).max(0) else: end.min(len)
                                    if lo >= len or lo >= hi:
                                        Value.Array([])
                                    else:
                                        Value.Array(arr.slice(lo, hi))
                                _: throw "slice: expected int end"
                        _: throw "slice: expected int start"
                "zip":
                    let other_val = args[0] else Value.Array([])
                    match other_val:
                        Value.Array(other):
                            var result = []
                            let len = if arr.length < other.length: arr.length else: other.length
                            var i = 0
                            while i < len:
                                result.push(Value.Tuple([arr[i], other[i]]))
                                i = i + 1
                            Value.Array(result)
                        _: throw "zip: expected array argument"
                "enumerate":
                    var result = []
                    var i = 0
                    while i < arr.length:
                        result.push(Value.Tuple([Value.Int(i), arr[i]]))
                        i = i + 1
                    Value.Array(result)
                "indexOf":
                    let target = args[0] else Value.Nil
                    var found_idx = Value.Nil
                    var i = 0
                    while i < arr.length and found_idx == Value.Nil:
                        if arr[i] == target:
                            found_idx = Value.Int(i)
                        i = i + 1
                    found_idx
                "flat":
                    var result = []
                    var i = 0
                    while i < arr.length:
                        match arr[i]:
                            Value.Array(inner):
                                var j = 0
                                while j < inner.length:
                                    result.push(inner[j])
                                    j = j + 1
                            other:
                                result.push(other)
                        i = i + 1
                    Value.Array(result)
                "flatMap":
                    let closure = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < arr.length:
                        let r = call_value(interp, closure, [arr[i]])
                        match r:
                            Value.Array(inner):
                                var j = 0
                                while j < inner.length:
                                    result.push(inner[j])
                                    j = j + 1
                            other:
                                result.push(other)
                        i = i + 1
                    Value.Array(result)
                "join":
                    let sep_val = args[0] else Value.Str("")
                    match sep_val:
                        Value.Str(sep):
                            var [string] parts = []
                            var i = 0
                            while i < arr.length:
                                match arr[i]:
                                    Value.Str(sv): parts.push(sv)
                                    Value.Int(n): parts.push("{n}")
                                    Value.Float64(f): parts.push("{f}")
                                    Value.Float32(f): parts.push("{f}")
                                    Value.Bool(b): parts.push("{b}")
                                    _: parts.push("nil")
                                i = i + 1
                            Value.Str(parts.joined(sep))
                        _: throw "join_val: expected string separator"
                "sum":
                    var int_sum = 0
                    var float_sum = 0.0
                    var has_float = false
                    var i = 0
                    while i < arr.length:
                        match arr[i]:
                            Value.Int(n): int_sum = int_sum + n
                            Value.Float64(f):
                                float_sum = float_sum + f
                                has_float = true
                            Value.Float32(f):
                                float_sum = float_sum + (f as float64)
                                has_float = true
                            _: throw "sum: non-numeric element"
                        i = i + 1
                    if has_float:
                        Value.Float64(float_sum + int_sum as float64)
                    else:
                        Value.Int(int_sum)
                "min":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        var min_val = arr[0]
                        var i = 1
                        while i < arr.length:
                            match arr[i]:
                                Value.Int(n):
                                    match min_val:
                                        Value.Int(m):
                                            if n < m:
                                                min_val = arr[i]
                                        _: throw "min: mixed types"
                                Value.Float64(f):
                                    match min_val:
                                        Value.Float64(m):
                                            if f < m:
                                                min_val = arr[i]
                                        _: throw "min: mixed types"
                                Value.Float32(f):
                                    match min_val:
                                        Value.Float32(m):
                                            if f < m:
                                                min_val = arr[i]
                                        _: throw "min: mixed types"
                                _: throw "min: non-numeric element"
                            i = i + 1
                        min_val
                "max":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        var max_val = arr[0]
                        var i = 1
                        while i < arr.length:
                            match arr[i]:
                                Value.Int(n):
                                    match max_val:
                                        Value.Int(m):
                                            if n > m:
                                                max_val = arr[i]
                                        _: throw "max: mixed types"
                                Value.Float64(f):
                                    match max_val:
                                        Value.Float64(m):
                                            if f > m:
                                                max_val = arr[i]
                                        _: throw "max: mixed types"
                                Value.Float32(f):
                                    match max_val:
                                        Value.Float32(m):
                                            if f > m:
                                                max_val = arr[i]
                                        _: throw "max: mixed types"
                                _: throw "max: non-numeric element"
                            i = i + 1
                        max_val
                "shuffle":
                    Value.Array(arr)
                "distinct":
                    var result = []
                    var i = 0
                    while i < arr.length:
                        if not result.contains(arr[i]):
                            result.push(arr[i])
                        i = i + 1
                    Value.Array(result)
                "isEmpty":
                    Value.Bool(arr.length == 0)
                "reshape":
                    # flat.reshape(width = W, height = H) → labeled array
                    # (docs/array-multidim-types.md) — zero-copy at the value
                    # level (same underlying elements, just a shape attached).
                    # No static checker here, so the length check is always
                    # at runtime, unlike the Rust compiler's compile-time
                    # check when both sizes are known constants.
                    var axes = []
                    for a in args:
                        match a:
                            Value.Labeled(label, v):
                                match v:
                                    Value.Int(n): axes.push((label, n))
                                    _: throw "reshape: axis size for '{label}' must be int, got {v.type_name()}"
                            _: throw "reshape: every argument must be labeled (width = w, ...)"
                    if axes.length < 2:
                        throw "reshape: labeled array types need at least 2 axes"
                    var total = 1
                    for ax in axes:
                        total = total * ax.1
                    if arr.length != total:
                        throw "reshape: length mismatch — buffer has {arr.length} elements, shape needs {total}"
                    Value.LabeledArray(arr, axes)
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.LabeledArray(arr, axes):
            match method_name:
                "length":
                    Value.Int(arr.length)
                "len":
                    Value.Int(arr.length)
                "isEmpty":
                    Value.Bool(arr.length == 0)
                "flatten":
                    # a.flatten() → [T], exact inverse of .reshape() — drops
                    # the shape, keeps the same underlying elements
                    # (docs/array-multidim-types.md).
                    Value.Array(arr)
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Dict(pairs):
            match method_name:
                "length":
                    Value.Int(pairs.length)
                "len":
                    Value.Int(pairs.length)
                "get":
                    let key = args[0] else Value.Nil
                    let default = args[1] else Value.Nil
                    var found = default
                    var i = 0
                    while i < pairs.length:
                        let pair = pairs[i]
                        if pair.0 == key:
                            found = pair.1
                        i = i + 1
                    found
                "set":
                    let key = args[0] else Value.Nil
                    let val = args[1] else Value.Nil
                    var new_pairs = pairs
                    var update_idx = -1
                    var i = 0
                    while i < new_pairs.length:
                        let pair = new_pairs[i]
                        if pair.0 == key:
                            update_idx = i
                        i = i + 1
                    if update_idx >= 0:
                        new_pairs[update_idx] = (key, val)
                    else:
                        new_pairs.push((key, val))
                    Value.Dict(new_pairs)
                "put":
                    let key = args[0] else Value.Nil
                    let val = args[1] else Value.Nil
                    var new_pairs = pairs
                    var update_idx = -1
                    var i = 0
                    while i < new_pairs.length:
                        let pair = new_pairs[i]
                        if pair.0 == key:
                            update_idx = i
                        i = i + 1
                    if update_idx >= 0:
                        new_pairs[update_idx] = (key, val)
                    else:
                        new_pairs.push((key, val))
                    Value.Dict(new_pairs)
                "contains":
                    let key = args[0] else Value.Nil
                    var found = false
                    var i = 0
                    while i < pairs.length:
                        if pairs[i].0 == key:
                            found = true
                        i = i + 1
                    Value.Bool(found)
                "has":
                    let key = args[0] else Value.Nil
                    var found = false
                    var i = 0
                    while i < pairs.length:
                        if pairs[i].0 == key:
                            found = true
                        i = i + 1
                    Value.Bool(found)
                "remove":
                    let key = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < pairs.length:
                        if pairs[i].0 != key:
                            result.push(pairs[i])
                        i = i + 1
                    Value.Dict(result)
                "keys":
                    var result = []
                    var i = 0
                    while i < pairs.length:
                        result.push(pairs[i].0)
                        i = i + 1
                    Value.Array(result)
                "values":
                    var result = []
                    var i = 0
                    while i < pairs.length:
                        result.push(pairs[i].1)
                        i = i + 1
                    Value.Array(result)
                "entries":
                    var result = []
                    var i = 0
                    while i < pairs.length:
                        let (ek, ev) = pairs[i]
                        result.push(Value.Array([ek, ev]))
                        i = i + 1
                    Value.Array(result)
                "merge":
                    let other_val = args[0] else Value.Dict([])
                    match other_val:
                        Value.Dict(other):
                            var result = pairs
                            var i = 0
                            while i < other.length:
                                let oe = other[i]
                                var update_j = -1
                                var j = 0
                                while j < result.length:
                                    if result[j].0 == oe.0:
                                        update_j = j
                                    j = j + 1
                                if update_j >= 0:
                                    result[update_j] = oe
                                else:
                                    result.push(oe)
                                i = i + 1
                            Value.Dict(result)
                        _: throw "merge: expected dict argument"
                "isEmpty":
                    Value.Bool(pairs.length == 0)
                "filter":
                    let closure = args[0] else Value.Nil
                    var result = []
                    var fi = 0
                    while fi < pairs.length:
                        let pk = pairs[fi].0
                        let pv = pairs[fi].1
                        let r = call_value(interp, closure, [pk, pv])
                        match r:
                            Value.Bool(b):
                                if b:
                                    result.push(pairs[fi])
                            _: throw "dict.filter: predicate must return bool"
                        fi = fi + 1
                    Value.Dict(result)
                "map":
                    let closure = args[0] else Value.Nil
                    var result = []
                    var mi = 0
                    while mi < pairs.length:
                        let pk = pairs[mi].0
                        let pv = pairs[mi].1
                        let r = call_value(interp, closure, [pk, pv])
                        result.push((pairs[mi].0, r))
                        mi = mi + 1
                    Value.Dict(result)
                "any":
                    let closure = args[0] else Value.Nil
                    var found = false
                    var ai = 0
                    while ai < pairs.length:
                        let pk = pairs[ai].0
                        let pv = pairs[ai].1
                        let r = call_value(interp, closure, [pk, pv])
                        match r:
                            Value.Bool(true): found = true
                            _: nil
                        ai = ai + 1
                    Value.Bool(found)
                "all":
                    let closure = args[0] else Value.Nil
                    var all_ok = true
                    var alli = 0
                    while alli < pairs.length:
                        let pk = pairs[alli].0
                        let pv = pairs[alli].1
                        let r = call_value(interp, closure, [pk, pv])
                        match r:
                            Value.Bool(false): all_ok = false
                            _: nil
                        alli = alli + 1
                    Value.Bool(all_ok)
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Set(elements):
            match method_name:
                "length":
                    Value.Int(elements.length)
                "len":
                    Value.Int(elements.length)
                "contains":
                    let val = args[0] else Value.Nil
                    Value.Bool(elements.contains(val))
                "add":
                    let val = args[0] else Value.Nil
                    if elements.contains(val):
                        Value.Set(elements)
                    else:
                        var result = elements
                        result.push(val)
                        Value.Set(result)
                "remove":
                    let val = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < elements.length:
                        if elements[i] != val:
                            result.push(elements[i])
                        i = i + 1
                    Value.Set(result)
                "toArray":
                    Value.Array(elements)
                "union":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "union: expected set or array"
                    var result = elements
                    var i = 0
                    while i < other.length:
                        if not result.contains(other[i]):
                            result.push(other[i])
                        i = i + 1
                    Value.Set(result)
                "intersection":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "intersection: expected set or array"
                    var result = []
                    var i = 0
                    while i < elements.length:
                        if other.contains(elements[i]):
                            result.push(elements[i])
                        i = i + 1
                    Value.Set(result)
                "difference":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "difference: expected set or array"
                    var result = []
                    var i = 0
                    while i < elements.length:
                        if not other.contains(elements[i]):
                            result.push(elements[i])
                        i = i + 1
                    Value.Set(result)
                "isSubset":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "isSubset: expected set or array"
                    var all_in = true
                    var i = 0
                    while i < elements.length and all_in:
                        if not other.contains(elements[i]):
                            all_in = false
                        i = i + 1
                    Value.Bool(all_in)
                "isSuperset":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "isSuperset: expected set or array"
                    var all_in = true
                    var i = 0
                    while i < other.length and all_in:
                        if not elements.contains(other[i]):
                            all_in = false
                        i = i + 1
                    Value.Bool(all_in)
                "isEmpty":
                    Value.Bool(elements.length == 0)
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Int(n):
            match method_name:
                "abs":
                    if n < 0:
                        Value.Int(0 - n)
                    else:
                        Value.Int(n)
                "sqrt":
                    Value.Float64((n as float64).sqrt())
                "floor":
                    Value.Int(n)
                "ceil":
                    Value.Int(n)
                "round":
                    Value.Int(n)
                "toStr":
                    Value.Str("{n}")
                "toBin":
                    Value.Str("{n:b}")
                "toHex":
                    Value.Str("{n:x}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Uint(n):
            match method_name:
                "abs":
                    Value.Uint(n)
                "sqrt":
                    Value.Float64((n as float64).sqrt())
                "floor":
                    Value.Uint(n)
                "ceil":
                    Value.Uint(n)
                "round":
                    Value.Uint(n)
                "toStr":
                    Value.Str("{n}")
                "toBin":
                    Value.Str("{n:b}")
                "toHex":
                    Value.Str("{n:x}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Uint8(n):
            match method_name:
                "abs":
                    Value.Uint8(n)
                "sqrt":
                    Value.Float64((n as float64).sqrt())
                "floor":
                    Value.Uint8(n)
                "ceil":
                    Value.Uint8(n)
                "round":
                    Value.Uint8(n)
                "toStr":
                    Value.Str("{n}")
                "toBin":
                    Value.Str("{n:b}")
                "toHex":
                    Value.Str("{n:x}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Int8(n):
            match method_name:
                "abs": if n < 0: Value.Int8(0 - n) else: Value.Int8(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Int8(n)
                "ceil": Value.Int8(n)
                "round": Value.Int8(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Int16(n):
            match method_name:
                "abs": if n < 0: Value.Int16(0 - n) else: Value.Int16(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Int16(n)
                "ceil": Value.Int16(n)
                "round": Value.Int16(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Int32(n):
            match method_name:
                "abs": if n < 0: Value.Int32(0 - n) else: Value.Int32(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Int32(n)
                "ceil": Value.Int32(n)
                "round": Value.Int32(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Int64(n):
            match method_name:
                "abs": if n < 0: Value.Int64(0 - n) else: Value.Int64(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Int64(n)
                "ceil": Value.Int64(n)
                "round": Value.Int64(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Int128(n):
            match method_name:
                "abs": if n < 0: Value.Int128(0 - n) else: Value.Int128(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Int128(n)
                "ceil": Value.Int128(n)
                "round": Value.Int128(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Uint16(n):
            match method_name:
                "abs": Value.Uint16(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Uint16(n)
                "ceil": Value.Uint16(n)
                "round": Value.Uint16(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Uint32(n):
            match method_name:
                "abs": Value.Uint32(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Uint32(n)
                "ceil": Value.Uint32(n)
                "round": Value.Uint32(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Uint64(n):
            match method_name:
                "abs": Value.Uint64(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Uint64(n)
                "ceil": Value.Uint64(n)
                "round": Value.Uint64(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Uint128(n):
            match method_name:
                "abs": Value.Uint128(n)
                "sqrt": Value.Float64((n as float64).sqrt())
                "floor": Value.Uint128(n)
                "ceil": Value.Uint128(n)
                "round": Value.Uint128(n)
                "toStr": Value.Str("{n}")
                "toBin": Value.Str("{n:b}")
                "toHex": Value.Str("{n:x}")
                _: throw "unknown method {method_name} on {recv_type}"

        Value.Float64(f):
            match method_name:
                "abs":
                    if f < 0.0:
                        Value.Float64(0.0 - f)
                    else:
                        Value.Float64(f)
                "sqrt":
                    Value.Float64(f.sqrt())
                "floor":
                    Value.Int(f.floor() as int)
                "ceil":
                    Value.Int(f.ceil() as int)
                "round":
                    Value.Int(f.round() as int)
                "toStr":
                    Value.Str("{f}")
                "toBin":
                    let fi = f.floor() as int
                    Value.Str("{fi:b}")
                "toHex":
                    let fi = f.floor() as int
                    Value.Str("{fi:x}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        # float32 sibling of the Value.Float64 block above — same method set,
        # f32 precision throughout.
        Value.Float32(f):
            match method_name:
                "abs":
                    if f < 0.0:
                        Value.Float32(0.0 - f)
                    else:
                        Value.Float32(f)
                "sqrt":
                    Value.Float32(f.sqrt())
                "floor":
                    Value.Int(f.floor() as int)
                "ceil":
                    Value.Int(f.ceil() as int)
                "round":
                    Value.Int(f.round() as int)
                "toStr":
                    Value.Str("{f}")
                "toBin":
                    let fi = f.floor() as int
                    Value.Str("{fi:b}")
                "toHex":
                    let fi = f.floor() as int
                    Value.Str("{fi:x}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Range(start, end, inclusive, step):
            match method_name:
                "toArray":
                    var result = []
                    var i = start
                    let lim = if inclusive: end + 1 else: end
                    while i < lim:
                        result.push(Value.Int(i))
                        i = i + step
                    Value.Array(result)
                "contains":
                    let val = args[0] else Value.Nil
                    match val:
                        Value.Int(n):
                            let lim = if inclusive: end + 1 else: end
                            var found = false
                            var i = start
                            while i < lim and not found:
                                if i == n:
                                    found = true
                                i = i + step
                            Value.Bool(found)
                        _: Value.Bool(false)
                "length":
                    let lim = if inclusive: end + 1 else: end
                    let len = (lim - start + step - 1) / step
                    Value.Int(if len < 0: 0 else: len)
                "step":
                    let s_val = args[0] else Value.Int(1)
                    match s_val:
                        Value.Int(sv): Value.Range(start, end, inclusive, sv)
                        _: throw "step: expected int argument"
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Tuple(elems):
            match method_name:
                "length":
                    Value.Int(elems.length)
                "len":
                    Value.Int(elems.length)
                "isEmpty":
                    Value.Bool(elems.length == 0)
                "first":
                    elems[0] else Value.Nil
                "last":
                    elems[elems.length - 1] else Value.Nil
                "get":
                    let idx_val = args[0] else Value.Int(0)
                    match idx_val:
                        Value.Int(i): elems[i] else Value.Nil
                        _: throw "tuple.get: expected int"
                "map":
                    let fn_val = args[0] else Value.Nil
                    var result = []
                    for elem in elems:
                        let mapped = call_value(interp, fn_val, [elem])
                        result.push(mapped)
                    Value.Tuple(result)
                _:
                    throw "unknown method {method_name} on tuple"

        Value.Object(inner):
            # Channel TX send method
            if inner.type_name == "__ChannelTx__" and method_name == "send":
                let ch_id_opt = inner.get_field("__ch_id__")
                if let ch_id_val = ch_id_opt:
                    let ch_key = match ch_id_val:
                        Value.Str(s): s
                        _: ""
                    if ch_key != "":
                        let val_to_send = args[0] else Value.Nil
                        let queue_opt = interp.channel_queues.get(ch_key)
                        if let queue = queue_opt:
                            var mut_queue = queue
                            mut_queue.push(val_to_send)
                            var {string=[Value]} cq = interp.channel_queues
                            cq[ch_key] = mut_queue
                            interp.channel_queues = cq
                return Value.Nil
            # Struct method call
            let type_name = inner.type_name.clone()
            let method_decl_opt = interp.find_best_method(type_name, method_name, args)
            if let method_decl = method_decl_opt:
                let self_val = Value.Object(inner)
                let child_env = push_scope(interp)
                env_define(interp, "self", self_val, false)
                for field in inner.fields:
                    env_define(interp, field.0, field.1, true)
                var i = 0
                while i < method_decl.params.length and i < args.length:
                    let param = method_decl.params[i]
                    env_define(interp, param.name, args[i], param.mutable)
                    i += 1
                let result = eval_block(interp, method_decl.body)
                if method_decl.mutating:
                    for field in inner.fields:
                        let updated = interp.current_env.get(field.0)
                        if let v = updated:
                            inner.set_field(field.0, v)
                pop_scope(interp)
                result
            else:
                # `upgrade()` on weak ref — in the interpreter all refs are strong, just return self
                if method_name == "upgrade":
                    return Value.Object(inner)
                throw "unknown method {method_name} on {type_name}"

        Value.EnumDef(type_name):
            # EnumDef.Variant(args) → construct enum variant
            Value.EnumVariant(type_name, method_name, args)

        Value.EnumVariant(type_name, variant, fields):
            # Enum variant method call — look up in interp method table
            let method_decl_opt = interp.find_best_method(type_name, method_name, args)
            if let method_decl = method_decl_opt:
                let self_val = Value.EnumVariant(type_name, variant, fields)
                let child_env = push_scope(interp)
                env_define(interp, "self", self_val, false)
                var i = 0
                while i < method_decl.params.length and i < args.length:
                    let param = method_decl.params[i]
                    env_define(interp, param.name, args[i], param.mutable)
                    i += 1
                let result = eval_block(interp, method_decl.body)
                pop_scope(interp)
                result
            else:
                throw "no method '{method_name}' on enum '{type_name}'"

        _:
            throw "unknown method {method_name} on {recv_type}"
