# == BUILT-IN METHODS ==

def string val_type_name(Value v):
    match v:
        Value.Int(_): "int"
        Value.Float(_): "float"
        Value.Str(_): "string"
        Value.Bool(_): "bool"
        Value.Array(_): "array"
        Value.Dict(_): "dict"
        Value.Set(_): "set"
        Value.Nil: "nil"
        Value.Void: "void"
        Value.Tuple(_): "tuple"
        Value.Range(_, _, _, _): "range"
        Value.Object(inner): inner.type_name.clone()
        Value.EnumVariant(type_name, _, _): type_name
        _: "unknown"

def Value call_method(Interpreter interp, Value recv, string method_name, [Value] args):
    let recv_type = recv.type_name()
    match recv:
        Value.Str(s):
            match method_name:
                "length":
                    Value.Int(s.length)
                "len":
                    Value.Int(s.length)
                "split":
                    let sep = args[0] else Value.Str("")
                    match sep:
                        Value.Str(sv):
                            Value.Array(s.split(sv).map((part): Value.Str(part)))
                        _: throw "split: expected string separator"
                "trim":
                    Value.Str(s.trim())
                "trimStart":
                    Value.Str(s.trimStart())
                "trimEnd":
                    Value.Str(s.trimEnd())
                "startsWith":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv): Value.Bool(s.startsWith(sv))
                        _: throw "startsWith: expected string argument"
                "endsWith":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv): Value.Bool(s.endsWith(sv))
                        _: throw "endsWith: expected string argument"
                "contains":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv): Value.Bool(s.contains(sv))
                        _: throw "contains: expected string argument"
                "replace":
                    let from_val = args[0] else Value.Str("")
                    let to_val = args[1] else Value.Str("")
                    match from_val:
                        Value.Str(from_s):
                            match to_val:
                                Value.Str(to_s): Value.Str(s.replace(from_s, to_s))
                                _: throw "replace: expected string arguments"
                        _: throw "replace: expected string arguments"
                "toUpper":
                    Value.Str(s.toUpper())
                "upper":
                    Value.Str(s.toUpper())
                "to_upper":
                    Value.Str(s.toUpper())
                "toLower":
                    Value.Str(s.toLower())
                "lower":
                    Value.Str(s.toLower())
                "to_lower":
                    Value.Str(s.toLower())
                "chars":
                    Value.Array(s.chars().map((c): Value.Str(c)))
                "lines":
                    Value.Array(s.split("\n").map((l): Value.Str(l)))
                "slice":
                    let start_val = args[0] else Value.Int(0)
                    let end_val = args[1] else Value.Int(s.length)
                    match start_val:
                        Value.Int(start):
                            match end_val:
                                Value.Int(end): Value.Str(s.slice(start, end))
                                _: throw "slice: expected int end"
                        _: throw "slice: expected int start"
                "indexOf":
                    let arg = args[0] else Value.Str("")
                    match arg:
                        Value.Str(sv):
                            let idx = s.indexOf(sv)
                            if let idx_val = idx:
                                Value.Int(idx_val)
                            else:
                                Value.Nil
                        _: throw "indexOf: expected string argument"
                "repeat":
                    let arg = args[0] else Value.Int(0)
                    match arg:
                        Value.Int(n): Value.Str(s.repeat(n as uint))
                        _: throw "repeat: expected int argument"
                "padLeft":
                    let width_val = args[0] else Value.Int(0)
                    let pad_val = args[1] else Value.Str(" ")
                    match width_val:
                        Value.Int(w):
                            match pad_val:
                                Value.Str(p):
                                    let cur_len = s.length
                                    if cur_len >= w:
                                        Value.Str(s)
                                    else:
                                        let padding = p.repeat((w - cur_len) as uint)
                                        Value.Str("{padding}{s}")
                                _: throw "padLeft: expected string pad"
                        _: throw "padLeft: expected int width"
                "padRight":
                    let width_val = args[0] else Value.Int(0)
                    let pad_val = args[1] else Value.Str(" ")
                    match width_val:
                        Value.Int(w):
                            match pad_val:
                                Value.Str(p):
                                    let cur_len = s.length
                                    if cur_len >= w:
                                        Value.Str(s)
                                    else:
                                        let padding = p.repeat((w - cur_len) as uint)
                                        Value.Str("{s}{padding}")
                                _: throw "padRight: expected string pad"
                        _: throw "padRight: expected int width"
                "parseInt":
                    let parsed = s.parseInt()
                    if parsed == nil:
                        Value.Nil
                    else:
                        Value.Int(parsed else 0)
                "parseFloat":
                    let parsed = s.parseFloat()
                    if parsed == nil:
                        Value.Nil
                    else:
                        Value.Float(parsed else 0.0)
                "isDigit":
                    Value.Bool(s.length == 1 and s.chars().all((c): c >= "0" and c <= "9"))
                "isAlpha":
                    Value.Bool(s.length == 1 and ((s >= "a" and s <= "z") or (s >= "A" and s <= "Z")))
                "isEmpty":
                    Value.Bool(s.length == 0)
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Array(arr):
            match method_name:
                "length":
                    Value.Int(arr.length)
                "len":
                    Value.Int(arr.length)
                "append":
                    let other_val = args[0] else Value.Nil
                    match other_val:
                        Value.Array(other):
                            var result = arr
                            var i = 0
                            while i < other.length:
                                result.append(other[i])
                                i = i + 1
                            Value.Array(result)
                        _:
                            var result = arr
                            result.append(other_val)
                            Value.Array(result)
                "push":
                    let val = args[0] else Value.Nil
                    var result = arr
                    result.append(val)
                    Value.Array(result)
                "pop":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        arr[arr.length - 1]
                "remove":
                    let idx_val = args[0] else Value.Int(0)
                    match idx_val:
                        Value.Int(raw_idx):
                            let idx = if raw_idx < 0: arr.length + raw_idx else raw_idx
                            arr[idx] else Value.Nil
                        _: throw "remove: expected int index"
                "insert":
                    let idx_val = args[0] else Value.Int(0)
                    let val = args[1] else Value.Nil
                    match idx_val:
                        Value.Int(idx):
                            var result = arr
                            result.insert(idx, val)
                            Value.Array(result)
                        _: throw "insert: expected int index"
                "first":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        arr[0]
                "last":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        arr[arr.length - 1]
                "contains":
                    let target = args[0] else Value.Nil
                    Value.Bool(arr.contains(target))
                "map":
                    let closure = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < arr.length:
                        let r = call_value(interp, closure, [arr[i]])
                        result.append(r)
                        i = i + 1
                    Value.Array(result)
                "filter":
                    let closure = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < arr.length:
                        let r = call_value(interp, closure, [arr[i]])
                        match r:
                            Value.Bool(b):
                                if b:
                                    result.append(arr[i])
                            _: throw "filter: predicate must return bool"
                        i = i + 1
                    Value.Array(result)
                "reduce":
                    let init_val = args[0] else Value.Nil
                    let closure = args[1] else Value.Nil
                    var acc = init_val
                    var i = 0
                    while i < arr.length:
                        acc = call_value(interp, closure, [acc, arr[i]])
                        i = i + 1
                    acc
                "sorted":
                    let n = arr.length
                    var sorted = arr
                    var i = 0
                    while i < n:
                        var j = i + 1
                        while j < n:
                            let si = val_to_string(sorted[i])
                            let sj = val_to_string(sorted[j])
                            if string_gt(si, sj):
                                let tmp = sorted[i]
                                sorted[i] = sorted[j]
                                sorted[j] = tmp
                            j = j + 1
                        i = i + 1
                    Value.Array(sorted)
                "sortedBy":
                    let closure = args[0] else Value.Nil
                    var keys = []
                    var i = 0
                    while i < arr.length:
                        let k = call_value(interp, closure, [arr[i]])
                        keys.append(k)
                        i = i + 1
                    var indices = []
                    var j = 0
                    while j < arr.length:
                        indices.append(Value.Int(j))
                        j = j + 1
                    let sorted_indices = indices.sortedBy((idx_val):
                        match idx_val:
                            Value.Int(idx): keys[idx]
                            _: Value.Nil
                    )
                    var result = []
                    var k = 0
                    while k < sorted_indices.length:
                        match sorted_indices[k]:
                            Value.Int(idx): result.append(arr[idx])
                            _: throw "sortedBy: internal error"
                        k = k + 1
                    Value.Array(result)
                "reversed":
                    var result = arr
                    result = result.reversed()
                    Value.Array(result)
                "any":
                    let closure = args[0] else Value.Nil
                    var found = false
                    var i = 0
                    while i < arr.length and not found:
                        let r = call_value(interp, closure, [arr[i]])
                        match r:
                            Value.Bool(b):
                                if b:
                                    found = true
                            _: throw "any: predicate must return bool"
                        i = i + 1
                    Value.Bool(found)
                "all":
                    let closure = args[0] else Value.Nil
                    var all_pass = true
                    var i = 0
                    while i < arr.length and all_pass:
                        let r = call_value(interp, closure, [arr[i]])
                        match r:
                            Value.Bool(b):
                                if not b:
                                    all_pass = false
                            _: throw "all: predicate must return bool"
                        i = i + 1
                    Value.Bool(all_pass)
                "count":
                    if args.length == 0:
                        Value.Int(arr.length)
                    else:
                        let closure = args[0]
                        var n = 0
                        var i = 0
                        while i < arr.length:
                            let r = call_value(interp, closure, [arr[i]])
                            match r:
                                Value.Bool(b):
                                    if b:
                                        n = n + 1
                                _: throw "count: predicate must return bool"
                            i = i + 1
                        Value.Int(n)
                "take":
                    let n_val = args[0] else Value.Int(0)
                    match n_val:
                        Value.Int(n):
                            let end = if n < arr.length: n else: arr.length
                            Value.Array(arr.slice(0, end))
                        _: throw "take: expected int argument"
                "drop":
                    let n_val = args[0] else Value.Int(0)
                    match n_val:
                        Value.Int(n):
                            let start = if n < arr.length: n else: arr.length
                            Value.Array(arr.slice(start, arr.length))
                        _: throw "drop: expected int argument"
                "slice":
                    let start_val = args[0] else Value.Int(0)
                    let end_val = args[1] else Value.Int(arr.length)
                    match start_val:
                        Value.Int(start):
                            match end_val:
                                Value.Int(end):
                                    let s = if start < arr.length: start else: arr.length
                                    let e = if end < arr.length: end else: arr.length
                                    Value.Array(arr.slice(s, e))
                                _: throw "slice: expected int end"
                        _: throw "slice: expected int start"
                "zip":
                    let other_val = args[0] else Value.Array([])
                    match other_val:
                        Value.Array(other):
                            var result = []
                            let len = if arr.length < other.length: arr.length else: other.length
                            var i = 0
                            while i < len:
                                result.append(Value.Tuple([arr[i], other[i]]))
                                i = i + 1
                            Value.Array(result)
                        _: throw "zip: expected array argument"
                "enumerate":
                    var result = []
                    var i = 0
                    while i < arr.length:
                        result.append(Value.Tuple([Value.Int(i), arr[i]]))
                        i = i + 1
                    Value.Array(result)
                "indexOf":
                    let target = args[0] else Value.Nil
                    var found_idx = Value.Nil
                    var i = 0
                    while i < arr.length and found_idx == Value.Nil:
                        if arr[i] == target:
                            found_idx = Value.Int(i)
                        i = i + 1
                    found_idx
                "flat":
                    var result = []
                    var i = 0
                    while i < arr.length:
                        match arr[i]:
                            Value.Array(inner):
                                var j = 0
                                while j < inner.length:
                                    result.append(inner[j])
                                    j = j + 1
                            other:
                                result.append(other)
                        i = i + 1
                    Value.Array(result)
                "flatMap":
                    let closure = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < arr.length:
                        let r = call_value(interp, closure, [arr[i]])
                        match r:
                            Value.Array(inner):
                                var j = 0
                                while j < inner.length:
                                    result.append(inner[j])
                                    j = j + 1
                            other:
                                result.append(other)
                        i = i + 1
                    Value.Array(result)
                "join":
                    let sep_val = args[0] else Value.Str("")
                    match sep_val:
                        Value.Str(sep):
                            var [string] parts = []
                            var i = 0
                            while i < arr.length:
                                match arr[i]:
                                    Value.Str(sv): parts.append(sv)
                                    Value.Int(n): parts.append("{n}")
                                    Value.Float(f): parts.append("{f}")
                                    Value.Bool(b): parts.append("{b}")
                                    _: parts.append("nil")
                                i = i + 1
                            Value.Str(parts.joined(sep))
                        _: throw "join_val: expected string separator"
                "sum":
                    var int_sum = 0
                    var float_sum = 0.0
                    var has_float = false
                    var i = 0
                    while i < arr.length:
                        match arr[i]:
                            Value.Int(n): int_sum = int_sum + n
                            Value.Float(f):
                                float_sum = float_sum + f
                                has_float = true
                            _: throw "sum: non-numeric element"
                        i = i + 1
                    if has_float:
                        Value.Float(float_sum + int_sum as float)
                    else:
                        Value.Int(int_sum)
                "min":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        var min_val = arr[0]
                        var i = 1
                        while i < arr.length:
                            match arr[i]:
                                Value.Int(n):
                                    match min_val:
                                        Value.Int(m):
                                            if n < m:
                                                min_val = arr[i]
                                        _: throw "min: mixed types"
                                Value.Float(f):
                                    match min_val:
                                        Value.Float(m):
                                            if f < m:
                                                min_val = arr[i]
                                        _: throw "min: mixed types"
                                _: throw "min: non-numeric element"
                            i = i + 1
                        min_val
                "max":
                    if arr.length == 0:
                        Value.Nil
                    else:
                        var max_val = arr[0]
                        var i = 1
                        while i < arr.length:
                            match arr[i]:
                                Value.Int(n):
                                    match max_val:
                                        Value.Int(m):
                                            if n > m:
                                                max_val = arr[i]
                                        _: throw "max: mixed types"
                                Value.Float(f):
                                    match max_val:
                                        Value.Float(m):
                                            if f > m:
                                                max_val = arr[i]
                                        _: throw "max: mixed types"
                                _: throw "max: non-numeric element"
                            i = i + 1
                        max_val
                "shuffle":
                    Value.Array(arr)
                "distinct":
                    var result = []
                    var i = 0
                    while i < arr.length:
                        if not result.contains(arr[i]):
                            result.append(arr[i])
                        i = i + 1
                    Value.Array(result)
                "isEmpty":
                    Value.Bool(arr.length == 0)
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Dict(pairs):
            match method_name:
                "length":
                    Value.Int(pairs.length)
                "len":
                    Value.Int(pairs.length)
                "get":
                    let key = args[0] else Value.Nil
                    let default = args[1] else Value.Nil
                    var found = default
                    var i = 0
                    while i < pairs.length:
                        let pair = pairs[i]
                        if pair.0 == key:
                            found = pair.1
                        i = i + 1
                    found
                "set":
                    let key = args[0] else Value.Nil
                    let val = args[1] else Value.Nil
                    var new_pairs = pairs
                    var update_idx = -1
                    var i = 0
                    while i < new_pairs.length:
                        let pair = new_pairs[i]
                        if pair.0 == key:
                            update_idx = i
                        i = i + 1
                    if update_idx >= 0:
                        new_pairs[update_idx] = (key, val)
                    else:
                        new_pairs.append((key, val))
                    Value.Dict(new_pairs)
                "contains":
                    let key = args[0] else Value.Nil
                    var found = false
                    var i = 0
                    while i < pairs.length:
                        if pairs[i].0 == key:
                            found = true
                        i = i + 1
                    Value.Bool(found)
                "has":
                    let key = args[0] else Value.Nil
                    var found = false
                    var i = 0
                    while i < pairs.length:
                        if pairs[i].0 == key:
                            found = true
                        i = i + 1
                    Value.Bool(found)
                "remove":
                    let key = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < pairs.length:
                        if pairs[i].0 != key:
                            result.append(pairs[i])
                        i = i + 1
                    Value.Dict(result)
                "keys":
                    var result = []
                    var i = 0
                    while i < pairs.length:
                        result.append(pairs[i].0)
                        i = i + 1
                    Value.Array(result)
                "values":
                    var result = []
                    var i = 0
                    while i < pairs.length:
                        result.append(pairs[i].1)
                        i = i + 1
                    Value.Array(result)
                "entries":
                    var result = []
                    var i = 0
                    while i < pairs.length:
                        let (ek, ev) = pairs[i]
                        result.append(Value.Array([ek, ev]))
                        i = i + 1
                    Value.Array(result)
                "merge":
                    let other_val = args[0] else Value.Dict([])
                    match other_val:
                        Value.Dict(other):
                            var result = pairs
                            var i = 0
                            while i < other.length:
                                let oe = other[i]
                                var update_j = -1
                                var j = 0
                                while j < result.length:
                                    if result[j].0 == oe.0:
                                        update_j = j
                                    j = j + 1
                                if update_j >= 0:
                                    result[update_j] = oe
                                else:
                                    result.append(oe)
                                i = i + 1
                            Value.Dict(result)
                        _: throw "merge: expected dict argument"
                "isEmpty":
                    Value.Bool(pairs.length == 0)
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Set(elements):
            match method_name:
                "length":
                    Value.Int(elements.length)
                "len":
                    Value.Int(elements.length)
                "contains":
                    let val = args[0] else Value.Nil
                    Value.Bool(elements.contains(val))
                "add":
                    let val = args[0] else Value.Nil
                    if elements.contains(val):
                        Value.Set(elements)
                    else:
                        var result = elements
                        result.append(val)
                        Value.Set(result)
                "remove":
                    let val = args[0] else Value.Nil
                    var result = []
                    var i = 0
                    while i < elements.length:
                        if elements[i] != val:
                            result.append(elements[i])
                        i = i + 1
                    Value.Set(result)
                "toArray":
                    Value.Array(elements)
                "union":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "union: expected set or array"
                    var result = elements
                    var i = 0
                    while i < other.length:
                        if not result.contains(other[i]):
                            result.append(other[i])
                        i = i + 1
                    Value.Set(result)
                "intersection":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "intersection: expected set or array"
                    var result = []
                    var i = 0
                    while i < elements.length:
                        if other.contains(elements[i]):
                            result.append(elements[i])
                        i = i + 1
                    Value.Set(result)
                "difference":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "difference: expected set or array"
                    var result = []
                    var i = 0
                    while i < elements.length:
                        if not other.contains(elements[i]):
                            result.append(elements[i])
                        i = i + 1
                    Value.Set(result)
                "isSubset":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "isSubset: expected set or array"
                    var all_in = true
                    var i = 0
                    while i < elements.length and all_in:
                        if not other.contains(elements[i]):
                            all_in = false
                        i = i + 1
                    Value.Bool(all_in)
                "isSuperset":
                    let other_val = args[0] else Value.Set([])
                    let other = match other_val:
                        Value.Set(s): s
                        Value.Array(a): a
                        _: throw "isSuperset: expected set or array"
                    var all_in = true
                    var i = 0
                    while i < other.length and all_in:
                        if not elements.contains(other[i]):
                            all_in = false
                        i = i + 1
                    Value.Bool(all_in)
                "isEmpty":
                    Value.Bool(elements.length == 0)
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Int(n):
            match method_name:
                "abs":
                    if n < 0:
                        Value.Int(0 - n)
                    else:
                        Value.Int(n)
                "sqrt":
                    Value.Float((n as float).sqrt())
                "floor":
                    Value.Int(n)
                "ceil":
                    Value.Int(n)
                "round":
                    Value.Int(n)
                "toStr":
                    Value.Str("{n}")
                "toBin":
                    Value.Str("{n:b}")
                "toHex":
                    Value.Str("{n:x}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Float(f):
            match method_name:
                "abs":
                    if f < 0.0:
                        Value.Float(0.0 - f)
                    else:
                        Value.Float(f)
                "sqrt":
                    Value.Float(f.sqrt())
                "floor":
                    Value.Int(f.floor() as int)
                "ceil":
                    Value.Int(f.ceil() as int)
                "round":
                    Value.Int(f.round() as int)
                "toStr":
                    Value.Str("{f}")
                "toBin":
                    let fi = f.floor() as int
                    Value.Str("{fi:b}")
                "toHex":
                    let fi = f.floor() as int
                    Value.Str("{fi:x}")
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Range(start, end, inclusive, step):
            match method_name:
                "toArray":
                    var result = []
                    var i = start
                    let lim = if inclusive: end + 1 else: end
                    while i < lim:
                        result.append(Value.Int(i))
                        i = i + step
                    Value.Array(result)
                "contains":
                    let val = args[0] else Value.Nil
                    match val:
                        Value.Int(n):
                            let lim = if inclusive: end + 1 else: end
                            var found = false
                            var i = start
                            while i < lim and not found:
                                if i == n:
                                    found = true
                                i = i + step
                            Value.Bool(found)
                        _: Value.Bool(false)
                "length":
                    let lim = if inclusive: end + 1 else: end
                    let len = (lim - start + step - 1) / step
                    Value.Int(if len < 0: 0 else: len)
                "step":
                    let s_val = args[0] else Value.Int(1)
                    match s_val:
                        Value.Int(sv): Value.Range(start, end, inclusive, sv)
                        _: throw "step: expected int argument"
                _:
                    throw "unknown method {method_name} on {recv_type}"

        Value.Tuple(elems):
            match method_name:
                "length":
                    Value.Int(elems.length)
                "len":
                    Value.Int(elems.length)
                "isEmpty":
                    Value.Bool(elems.length == 0)
                "first":
                    elems[0] else Value.Nil
                "last":
                    elems[elems.length - 1] else Value.Nil
                "get":
                    let idx_val = args[0] else Value.Int(0)
                    match idx_val:
                        Value.Int(i): elems[i] else Value.Nil
                        _: throw "tuple.get: expected int"
                _:
                    throw "unknown method {method_name} on tuple"

        Value.Object(inner):
            # Struct method call
            let type_name = inner.type_name.clone()
            let method_decl_opt = interp.find_method(type_name, method_name)
            if let method_decl = method_decl_opt:
                let self_val = Value.Object(inner)
                let child_env = push_scope(interp)
                env_define(interp, "self", self_val, false)
                for field in inner.fields:
                    env_define(interp, field.0, field.1, true)
                var i = 0
                while i < method_decl.params.length and i < args.length:
                    let param = method_decl.params[i]
                    env_define(interp, param.name, args[i], param.mutable)
                    i += 1
                let result = eval_block(interp, method_decl.body)
                if method_decl.mutating:
                    for field in inner.fields:
                        let updated = interp.current_env.get(field.0)
                        if let v = updated:
                            inner.set_field(field.0, v)
                pop_scope(interp)
                result
            else:
                throw "unknown method {method_name} on {type_name}"

        Value.EnumDef(type_name):
            # EnumDef.Variant(args) → construct enum variant
            Value.EnumVariant(type_name, method_name, args)

        Value.EnumVariant(type_name, variant, fields):
            # Enum variant method call — look up in interp method table
            let method_decl_opt = interp.find_method(type_name, method_name)
            if let method_decl = method_decl_opt:
                let self_val = Value.EnumVariant(type_name, variant, fields)
                let child_env = push_scope(interp)
                env_define(interp, "self", self_val, false)
                var i = 0
                while i < method_decl.params.length and i < args.length:
                    let param = method_decl.params[i]
                    env_define(interp, param.name, args[i], param.mutable)
                    i += 1
                let result = eval_block(interp, method_decl.body)
                pop_scope(interp)
                result
            else:
                throw "no method '{method_name}' on enum '{type_name}'"

        _:
            throw "unknown method {method_name} on {recv_type}"
