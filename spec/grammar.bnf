# ─── Boring Language Grammar ─────────────────────────────────────────────────
#
# Notation: `?` = optional, `*` = zero or more, `+` = one or more, `ε` = empty
# Layout tokens (INDENT / DEDENT / NEWLINE) are produced by the lexer.
# Blank lines and `#`-comments are discarded before parsing.
# Inside `(…)`, newlines between tokens are ignored (implicit line continuation).

# ─── Top-level ───────────────────────────────────────────────────────────────

program         ::= item* EOF

item            ::= attr* "pub"? use_decl
                  | attr* "pub"? fn_decl
                  | attr* "pub"? struct_decl
                  | attr* "pub"? enum_decl
                  | attr* "pub"? trait_decl
                  | ext_decl
                  | kernel_decl      # GPU kernel struct (--target cuda / --target metal)
                  | mod_decl
                  | alias_decl       # top-level type alias: `use Name as Type`
                  | let_stmt
                  | stmt             # scripting mode: bare statements at top level

# Top-level type alias (distinct from `use mod.path.Item` which is an import).
# `use Name as Type'qual` — registers a named alias for a qualified type.
# `use Name<T> as Type'qual` — generic alias.
alias_decl      ::= "use" IDENT ("as" | "<" IDENT ("," IDENT)* ">" "as") type NEWLINE

# ─── Attributes ──────────────────────────────────────────────────────────────
#
# Attributes annotate item declarations for the transpiler.
# They become `#[name(args)]` in Rust output; the interpreter ignores them.
# Multiple attributes may be stacked, one per line, before the item.
#
# Examples:
#   @derive(Debug, Clone, PartialEq)
#   struct Point:
#
#   @inline
#   def int add(int x, int y): x + y
#
#   @serde(rename_all = "camelCase")
#   struct Config:

attr            ::= "@" IDENT ("(" attr_arg ("," attr_arg)* ")")? NEWLINE?
attr_arg        ::= IDENT ("=" (IDENT | STRING | INT))?
                  | STRING
                  | INT

# ─── Imports ─────────────────────────────────────────────────────────────────

use_decl        ::= "use" mod_path ".*" NEWLINE                                       # glob — all pub items
                  | "use" IDENT NEWLINE                                               # whole module (single segment only)
                  | "use" mod_path "." IDENT ("," IDENT)* NEWLINE                    # selective import
                  | "use" IDENT "as" type NEWLINE                                     # type alias
                  | "use" IDENT "<" IDENT ("," IDENT)* ">" "as" type NEWLINE         # generic type alias

mod_path        ::= path_seg ("." path_seg)*
path_seg        ::= IDENT | keyword_as_ident   # keywords like `sync` are valid path segments
keyword_as_ident ::= "sync" | "type" | "mod" | "new" | "set" | "init" | …
# The last dot-segment is always an item name, never a module name — this is
# why there is NO form for "the whole module a.b.c, no glob, no items": a
# multi-segment path always treats its final segment as a selected item.
# `use a.b.c` alone parses as "module a.b, item c", not "module a.b.c".
#
# Import forms actually implemented by the parser (parser/mod.rs's
# parse_use_decl — NOT a parenthesized item list; that shape does not exist):
#   use a                    — whole module a (single segment only)
#   use a.b.c.*              — glob: all pub items from module a.b.c
#   use a.b.c.X              — single item X from module a.b.c
#   use a.b.c.X, Y           — multiple items from module a.b.c
#
# ── boring stdlib ─────────────────────────────────────────────────────────────
# `use boring.<module>` resolves against the compiler's embedded first-party
# stdlib (src/stdlib_embed.rs, stdlib/*.br) rather than a project file — see
# stdlib/README.md for the module list and how to add one. Same selective-
# import rule as above applies: a bare `use boring.collections` does NOT mean
# "the whole module" (it means "item `collections` from module `boring`") —
# always use `.*` or name concrete items:
#   use boring.collections.*            — all of collections (Stack, Queue)
#   use boring.collections.Stack        — one item
#   use boring.collections.Stack, Queue — multiple items
#
# ── Built-in namespaces (no `use` needed) ────────────────────────────────────
#
#   fs — file-system operations (interpreter: std::fs; transpiler: tokio::fs in async)
#
#   fs.read(path)              → string          read entire file as text
#   fs.readLines(path)         → [string]        read file as array of lines
#   fs.write(path, text)       → void            write (overwrite) file
#   fs.append(path, text)      → void            append to file
#   fs.exists(path)            → bool            true if path exists
#   fs.isDir(path)             → bool            true if path is a directory
#   fs.isFile(path)            → bool            true if path is a regular file
#   fs.mkdir(path)             → void            create directory (and parents)
#   fs.remove(path)            → void            remove file or directory tree
#   fs.rename(from, to)        → void            rename / move a path (alias: fs.move)
#   fs.copy(from, to)          → void            copy file
#   fs.list(path)              → [string]        list directory entries (names only)
#   fs.readBytes(path)         → [uint]          read file as byte array
#   fs.writeBytes(path, bytes) → void            write byte array to file
#
# ── Native Rust types (pre-registered — no `use` needed) ─────────────────────
#   HashMap / BTreeMap  →  {K=V}  (Dict)
#   HashSet / BTreeSet  →  {T}    (Set)
#   Vec / VecDeque      →  [T]    (Array)
#   string              →  Arc<str>
#   Box, Rc, Arc, Option, Result  →  opaque
#   Duration, Instant   →  opaque time types (see wait / timeout)
#
# ── Rust stdlib ───────────────────────────────────────────────────────────────
#   use std.fs.File                  — single Rust type
#   use std.io.Write, BufRead        — multiple Rust types
#
# ── External crates ───────────────────────────────────────────────────────────
#   use crate.models.User, Post      — opaque types from current crate

# ─── Declarations ────────────────────────────────────────────────────────────

# Return type comes before the function name (Go/C style).
# Omitting the return type means void (inferred from body).
# Qualified name `Type.name` marks struct/trait method implementations.
# Modifiers `throws` and `task` may appear in either order after `)`.
# `def` is ALWAYS optional when a return type is explicitly present.

fn_decl         ::= def_decl | req_decl | stream_decl | shorthand_fn_decl

# `def` — mutating method (`&mut self`); callable on `var` bindings only.
def_decl        ::= attr* "def" type? (IDENT ".")? IDENT type_params? "(" param_list? ")" modifier* ":" fn_body

# `req` — non-mutating method (`&self`); callable on both `let` and `var` bindings.
# Zero-parameter `req` methods may be called without `()` (property-style access).
req_decl        ::= attr* "req" type? (IDENT ".")? IDENT type_params? "(" param_list? ")" modifier* ":" fn_body

# `stream` — generator function; body may use `yield`; returns an iterable stream.
stream_decl     ::= attr* ("stream" "def" | "stream" "req") type? (IDENT ".")? IDENT type_params? "(" param_list? ")" modifier* ":" fn_body
                  | attr* "stream" type (IDENT ".")? IDENT type_params? "(" param_list? ")" modifier* ":" fn_body  # shorthand: stream int next():

# Shorthand — `def` omitted when a return type is present.
#   string greet(string name):   ≡   def string greet(string name):
#   <Drawable> scale(float n):   ≡   def <Drawable> scale(float n):
shorthand_fn_decl ::= attr* type (IDENT ".")? IDENT type_params? "(" param_list? ")" modifier* ":" fn_body

modifier        ::= "throws" IDENT?  # may raise; optional concrete error type: `throws MyError`
                  | "task"            # async; may block / runs concurrently

fn_body         ::= expr NEWLINE                     # inline — implicit return
                  | block                            # indented block
                  | "pass" NEWLINE                   # empty body placeholder
                  | "native" NEWLINE                 # implemented by the runtime

# ── Function overloading ─────────────────────────────────────────────────────
#
# Multiple functions with the same name but different parameter types are allowed.
# The compiler selects the right variant by matching argument types at the call site.
#
#   string describe(int n):    "int: {n}"
#   string describe(string s): "str: {s}"
#   describe(42)               → "int: 42"
#
# Overloads also work for struct methods (inline or in `ext` blocks, same file).
# Cross-file overloads are NOT supported.
# Conflict: a function with default params creating an ambiguous arity overlap
# with another overload is a compile-time error.
#
# Name mangling in transpiled Rust: describe__int, describe__string, etc.

# param_list supports both single-line and multi-line forms.
# Newlines and indentation inside `(…)` are ignored.
param_list      ::= param ("," param)* ","?   # trailing comma allowed

# Type comes before the parameter name.
# A function-typed parameter has param types after the name: `int f(int, int)`.
# Binding prefix controls the parameter passing contract:
#   (none) / `let` — immutable borrow (&T); caller may pass let, mut, or var
#   `mut`          — mutable borrow (&mut T); caller must have at least mut or var
#   `var`          — out-parameter (&mut T, rebindable at call site); caller must have var
# Hierarchy enforced by the transpiler: let ≤ mut ≤ var — passing down is always an error.
param           ::= ("var" | "mut")? type "..." IDENT              # variadic: int... args → Vec<T>
                  | ("var" | "mut")? type IDENT "(" type_list? ")" # function-typed parameter
                  | ("var" | "mut")? type IDENT ("=" expr)?        # typed parameter, optional default
                  | ("var" | "mut")? IDENT                         # untyped, inferred

# Type and generic parameters declared in `<...>`.
# Used in struct and enum declarations; functions infer their lifetime params automatically.
#
# Type params: uppercase idents with optional trait constraints via `as`.
# Lifetime params: `&a`, `&b`, … — for Rust transpilation only; the interpreter ignores them.
# Constraints are written inline: `<T as Trait, U as (Trait1, Trait2)>`.
# No separate `where` clause.
#
# Examples:
#   struct Pair<T, U as Display>:
#   struct Excerpt<&a>:               — struct holding a borrowed reference
#   struct Cache<&a, T as Display>:   — lifetime + type param
type_params     ::= "<" type_or_generic_param ("," type_or_generic_param)* ">"
type_or_generic_param ::= lifetime_param | const_param | type_param
lifetime_param  ::= "&" LOWERCASE_IDENT                    # e.g. &a, &b  (stored as 'a for Rust)
# Const generic param — type before name, consistent with boring's variable syntax.
# Valid const types: int, uint, bool (primitives only; float is not valid in Rust const generics).
const_param     ::= ("int" | "uint" | "bool") IDENT
type_param      ::= IDENT ("as" (IDENT | "(" IDENT ("," IDENT)* ")"))?

# Functions do NOT need explicit lifetime params: they are auto-inferred from the signature.
#   def str&a longest(str&a x, str&a y):   — transpiles to fn longest<'a>(…) automatically

struct_decl     ::= attr* "struct" IDENT type_params? ("as" type_list)? ":" NEWLINE INDENT
                      struct_member+
                    DEDENT
                  | attr* "struct" IDENT type_params? ("as" type_list)? ":" "pass" NEWLINE    # empty struct
                  | attr* "struct" IDENT type_params? ("as" type_list)? ":" "native" NEWLINE  # runtime struct

struct_member   ::= field_decl
                  | init_decl
                  | "pub"? fn_decl
                  | "pub"? set_decl
                  | conformance_decl
                  | as_decl
                  | assoc_type_decl   # associated type (e.g. `type Output = int`)
                  | type_method_sig   # type-level method signature (e.g. `type def name():`)

# No keyword → public immutable field (neither reassignable nor content-mutable).
# `let` → private immutable, same as no keyword otherwise. `var` → private,
# REASSIGNABLE only (`self.field = x`) — no longer implies content mutation.
# `pub var` → public, reassignable. `mut`/`let mut` → private, CONTENT-MUTABLE
# only (`self.field.method()`) — not reassignable. `var mut` → both. Same
# four-way as local bindings (`binding_keyword` above) and same "mut lives in
# the type" mechanism — see docs/mut-type-modifier.md §3.
# `transient` → physically mutable even from `req` methods (lazy/cache pattern). Implies `var`.
field_decl      ::= "pub"? "transient"? binding_keyword? type IDENT ("=" expr)? NEWLINE

# ─── Constructors ─────────────────────────────────────────────────────────────
#
# No body: all params automatically declare and initialise struct fields.
#   `pub`     → public immutable field
#   `pub var` → public mutable field
#   `var`     → private mutable field
#   (none)    → private immutable field
#   Default values on params become the field defaults.
#
# With body: params are plain local variables. Fields must be declared in the struct body
# and assigned via `self.field = …`. `let` fields are writable inside `init` bodies.
#
# Either form may delegate to another `init` via `init(…)` as a statement.
#
# Newlines and indentation inside `(…)` are ignored — multi-line param lists are supported:
#   init(
#       string host = "localhost",
#       int port = 8080,
#   )
#
# Pattern 1 — no `init`: struct built with named-field syntax `Point(x=1, y=2)`.
# Pattern 2 — `init` without body: constructor with no computation needed.
# Pattern 3 — `init` with body: computed construction (validation, derived fields, etc.).

init_decl       ::= "init" "(" init_param_list? ")" NEWLINE          # no body — params = fields
                  | "init" "(" init_param_list? ")" ":" fn_body       # with body — params = locals

init_param_list ::= init_param ("," init_param)* ","?    # trailing comma allowed

init_param      ::= "pub" "var"? type IDENT ("=" expr)?   # pub [mutable] field / pub local
                  | "var"? type IDENT ("=" expr)?          # [mutable] private field / local
                  | "var"? IDENT                           # untyped param

set_decl        ::= "set" IDENT "(" type IDENT ")" ":" fn_body

# `as Trait:` block — groups method implementations for a given trait or parent struct.
conformance_decl ::= "as" IDENT ":" NEWLINE INDENT
                       fn_decl+
                     DEDENT

# Explicit conversion declaration — last expression is the converted value.
# `as string:` is honoured by print/write/log-level builtins and string interpolation `{expr}`.
# `as Trait:` groups method implementations for a conformance (implemented by ext blocks too).
as_decl         ::= "as" type ":" (expr NEWLINE | block)

enum_decl       ::= attr* "enum" IDENT type_params? ("as" type_list)? ":" NEWLINE INDENT
                      enum_variant+
                      enum_member*
                    DEDENT
                  | attr* "enum" IDENT type_params? ("as" type_list)? ":" "pass" NEWLINE
                  | attr* "enum" IDENT type_params? ("as" type_list)? ":" "native" NEWLINE

enum_variant    ::= IDENT ("(" variant_fields ")")? NEWLINE
variant_fields  ::= variant_field ("," variant_field)*
variant_field   ::= type IDENT?              # type first, optional name (consistent with params)

enum_member     ::= "pub"? fn_decl
                  | "pub"? set_decl
                  | as_decl
                  | conformance_decl

# Supertraits: `trait B as A:` means any type implementing B must also implement A.
# Multiple supertraits: `trait C as A, B:`
# Default method bodies are allowed inside trait declarations.
trait_decl      ::= "trait" IDENT type_params? ("as" type_list)? ":" NEWLINE INDENT
                      trait_member+
                    DEDENT

trait_member    ::= fn_signature           # abstract method (no body)
                  | fn_decl               # default method (with body)
                  | type_method_sig        # type-level method signature
                  | assoc_type_decl        # associated type

# Type-level method signature — used for class-method / static-method requirements in traits.
# `type def name(params): body`  or  `type req name(params): body`
type_method_sig ::= "type" ("def" | "req") type? IDENT "(" param_list? ")" modifier* (":" fn_body | NEWLINE)

# Associated type declaration inside a trait or struct.
# `type Output`          — abstract (no default, to be specified by impl)
# `type Output = int`    — concrete default
# `type Display as string` — associated type with an explicit alias name
assoc_type_decl ::= "type" IDENT ("=" type | "as" type)? NEWLINE

fn_signature    ::= ("def" | "req") type? IDENT "(" param_list? ")" modifier* NEWLINE

ext_decl        ::= "ext" IDENT type_params? ("as" type_list)? ":" NEWLINE INDENT
                      ext_member+
                    DEDENT

ext_member      ::= "pub"? fn_decl
                  | "pub"? set_decl
                  | as_decl
                  | assoc_type_decl   # associated type definition
                  | type_method_sig   # type-level method signature

# ─── GPU kernel structs ───────────────────────────────────────────────────────
#
# `kernel` structs declare GPU-resident data and the entry-point thread body.
# They transpile to CUDA C (--target cuda), MSL (--target metal), or
# WGSL/wgpu (--target wgpu).
#
# Declaration form:
#   kernel Name:                              # no generic params
#   kernel Name<int W, int H>:               # const generic params (int / uint / bool)
#   kernel Name<T, U as Trait>:              # type generic params
#   kernel Name<int N, T as Displayable>:    # mixed const + type params
#       <binding> [<type>]['<gpu_qual>] <field> ["=" expr]  # field, optional default
#       ...
#       init(<params>):                              # host-side allocator
#           <body>
#       def <helper>(<params>):                      # device-side helper method
#           <body>
#       def ():                                      # entry point — one call per thread
#           <body>
#
# Const generic params allow array sizes to be computed at instantiation time:
#   kernel Blur<int W, int H>:
#       let [float, W * H]'const weights
#   # Instantiated as: Blur<3, 3>()
#
# wgpu: const generics are monomorphised — each unique instantiation produces a
# distinct WGSL shader with concrete sizes. No WGSL const-generic support needed.
#
# Launch form (host side):
#   kernel(<launch_args>) expr                       # returns KernelHandle<T>
#   kernel(<launch_args>) expr |> .wait              # launch and block until done
#
# Launch args:
#   block    = <int>                   — threads per block (1-D); required
#   grid     = <int>                   — blocks per grid (1-D); optional, auto-inferred from data size
#   block    = (<int>, <int>, <int>)   — 3-D block dimensions
#   grid     = (<int>, <int>, <int>)   — 3-D grid dimensions
#   after    = kernel_var | [k1, k2]  — GPU-side ordering (CUDA: stream sync; Metal: no-op)
#   priority = "high" | "normal" | "low"  — stream scheduling priority (CUDA only; ignored elsewhere)
#
# GPU built-ins (device side only, no `use` needed):
#   gpu.thread.x / .y / .z      — thread index within block
#   gpu.block.x  / .y / .z      — block index within grid
#   gpu.block_dim.x / .y / .z   — block dimensions
#   gpu.grid_dim.x  / .y / .z   — grid dimensions
#   sync                         — explicit barrier (manual mode): wait for all threads in the block.
#                                  If `sync` appears in a `def`, auto-insertion is disabled for that
#                                  `def` and the developer owns all barrier placement.
#   gpu.warp.size               — threads per warp/wavefront/SIMD-group/subgroup
#   gpu.warp.lane               — this thread's index within its warp, 0..gpu.warp.size
#   gpu.warp.sync()             — warp-local barrier, cheaper than `sync` (block-wide)
#   gpu.warp.shuffle_down(v, delta) — read `v` from the lane `delta` above this one
#   gpu.warp.shuffle_up(v, delta)   — read `v` from the lane `delta` below this one
#   gpu.warp.shuffle_xor(v, mask)   — read `v` from lane `this_lane XOR mask`
#   gpu.warp.shuffle(v, src_lane)   — broadcast/read `v` from an arbitrary lane
#
# GPU memory qualifiers (kernel-context only — replace standard ownership qualifiers):
#
#   'unified  — unified DRAM (host + device); host can read/write directly.
#               On Apple Silicon (Metal), zero-copy. On CUDA x86: cudaMallocManaged.
#   'global   — device-only DRAM; host accesses via gpu.copy(). CUDA: __global__.
#   'sync     — block SRAM shared by all threads in a block. CUDA: __shared__. MSL: threadgroup.
#               Barriers are inserted automatically (auto mode) unless the `def` body contains
#               at least one explicit `sync` statement (manual mode).
#               A user-defined struct can also be qualified with 'sync to group compound state
#               that must be observed coherently across threads.
#   'local    — thread-private (registers). CUDA: local variables. MSL: default.
#   'const    — constant cache; read-only. CUDA: __constant__. MSL: constant buffer.
#
# Qualifier inference for kernel fields (explicit qualifier may be omitted):
#   let T field       →  'const   (scalar `let` → constant cache)
#   mut T field       →  'local   (scalar `mut`/`var` → thread-private register)
#   var T field       →  'local   (idem)
#   let [T, N] field  →  'const   (fixed array `let` → constant cache)
#   mut [T, N] field  →  'local   (fixed array `mut`/`var` → thread-private)
#   Dynamic [T] always requires an explicit qualifier ('unified, 'global, or 'sync).
#
# Host-side binding qualifiers for kernel results (outside kernel struct):
#   T'unified  — returned slice lives in unified memory; accessible on both host and device

kernel_decl     ::= "kernel" IDENT type_params? ":" NEWLINE INDENT
                      kernel_member+
                    DEDENT

kernel_member   ::= kernel_field_decl
                  | init_decl
                  | fn_decl

# Scalar fields may carry an inline default value (omitted from the generated constructor).
# Array/buffer fields ('unified, 'global, 'sync) must NOT have a default — the parser rejects them.
kernel_field_decl ::= ("let" | "mut" | "var") type IDENT ("=" expr)? NEWLINE

# Module grouping — flat scoping at runtime; structure preserved for the transpiler.
mod_decl        ::= "mod" IDENT ":" NEWLINE INDENT
                      item+
                    DEDENT

# ─── Statements ──────────────────────────────────────────────────────────────

block           ::= NEWLINE INDENT stmt+ DEDENT
                  | stmt             # inline (monoline) form — single statement on the same line

stmt            ::= let_stmt
                  | return_stmt
                  | throw_stmt
                  | break_stmt
                  | continue_stmt
                  | yield_stmt
                  | defer_stmt
                  | if_stmt
                  | match_stmt
                  | while_stmt
                  | while_let_stmt
                  | do_while_stmt
                  | loop_stmt
                  | for_stmt
                  | try_stmt
                  | guard_stmt
                  | with_stmt
                  | wait_stmt
                  | fn_decl
                  | struct_decl    # local struct — invisible outside the enclosing function
                  | enum_decl      # local enum  — invisible outside the enclosing function
                  | mod_decl       # local module — flat scoping, same as top-level mod
                  | alias_stmt     # local type alias
                  | expr NEWLINE

break_stmt      ::= "break" expr? NEWLINE       # optional value when used in `loop:` as expression
continue_stmt   ::= "continue" NEWLINE
yield_stmt      ::= "yield" expr NEWLINE        # inside `stream def`/`stream req` bodies

# Local type alias — `use` inside a function/method body.
alias_stmt      ::= "use" IDENT "as" type NEWLINE

# `wait` — pause the current async task.
# Accepts Duration (relative delay) or Instant (absolute deadline).
# The transpiler auto-selects sleep vs sleep_until based on the argument type.
#
#   wait .fromSecs(5)             → tokio::time::sleep(Duration::from_secs(5)).await
#   wait(Instant.now() + dur)     → tokio::time::sleep_until(instant).await
#
wait_stmt       ::= "wait" expr NEWLINE

# Type annotation comes BEFORE the name (consistent with params and fields).
# `pub` makes the binding visible outside its module.
# `static` makes it a module-level singleton (no re-evaluation on repeated calls).
#
# Binding semantics summary — see docs/mut-type-modifier.md for the full model:
#   let      — immutable binding, immutable instance
#   mut      — fixed binding, content-mutable instance (bare `mut Type a` ≡
#              `let mut Type a`, always — no context-dependent reading, no
#              scalar special case; `mut` on a scalar is a checker error)
#   var      — rebindable binding, NOT content-mutable (does not imply `mut`)
#   var mut  — rebindable AND content-mutable — the only way to get both
#
# `mut` lives in the `type` production (see below), not as a fifth keyword
# here — `binding_keyword` below covers exactly `let`/`mut`/`var`/`var mut`,
# resolved by whether a `type` is wrapped in `"mut"? type` once parsed.
#
# Move syntax: appending `'` to the binding name requests ownership transfer.
#   `let b = a`   — borrow by default: `b` is a reference, `a` remains valid
#   `let b' = a`  — move: `b` takes ownership, `a` is invalidated
let_stmt        ::= "pub"? "static"? (binding_keyword | "lazy") type? IDENT "'"? ("=" expr)? NEWLINE
                  | "pub"? "static"? binding_keyword destructure "=" expr NEWLINE
                  # `lazy` is let_stmt-only — not valid in a destructure slot
                  # or a field_decl, so it's kept out of `binding_keyword` itself.
                  # No initialiser: deferred binding — variable declared but not yet assigned.
                  # A deferred binding must be assigned before first use (Rust enforces this).
                  # Example:  var int x       (later:  x = compute())

# The statement's own leading keyword phrase is mandatory (disambiguates a
# `let_stmt` from a plain expression statement) and, in the parenthesised
# destructure form, doubles as the per-element default for an unmarked slot.
# Shared by let_stmt, destructure slots (`binding` below), and `field_decl`.
binding_keyword ::= ("let" | "var") "mut"?
                  | "mut"

# Bare-vs-parenthesised defaulting rule (docs/mut-type-modifier.md §4):
# an unmarked slot in the BARE form always defaults to `let`, independently
# per slot; an unmarked slot in the PARENTHESISED form inherits the group's
# own leading `binding_keyword` (element 0's — see `let_stmt` above) instead.
# A bare unmarked slot following a differently-keyworded sibling is valid but
# flagged with a lint (it reads as if it inherited that keyword; it doesn't).
destructure     ::= "(" binding ("," binding)* ")"   # parenthesised form
                  | binding ("," binding)+             # bare form (two bindings minimum)

binding         ::= binding_keyword? type IDENT    # typed binding, own keyword optional
                  | binding_keyword? IDENT          # inferred binding, own keyword optional
                  | "_"                              # ignored slot — never keyworded

return_stmt     ::= "return" expr? NEWLINE

throw_stmt      ::= "throw" expr? NEWLINE
                  # bare `throw` re-throws the implicit `error` variable in a catch block

# `defer` registers a cleanup block that runs when the enclosing function exits,
# regardless of whether it exits normally, via early return, or via exception.
# Multiple defers execute in LIFO order (last registered, first executed).
defer_stmt      ::= "defer" ":" block        # multiline block
                  | "defer" ":" stmt         # inline with colon
                  | "defer" stmt             # inline without colon

if_stmt         ::= "if" expr ":" fn_body
                    ("elif" expr ":" fn_body)*
                    ("else" ":"? fn_body)?

# Multi-clause if-let: one or more `let` bindings and/or boolean conditions.
# All clauses must pass (short-circuit); bindings are visible in the `then` body.
# `elif` branches carry their own clause list, tried in order on failure of the
# preceding one; an `elif` clause list with no "let" clause is a plain boolean elif.
if_let_stmt     ::= "if" cond_clause ("," cond_clause)* ":" fn_body
                    ("elif" cond_clause ("," cond_clause)* ":" fn_body)*
                    ("else" ":"? fn_body)?

cond_clause     ::= "let" pattern "=" expr  # destructuring bind: if let Some(x) = opt:
                  | "let" IDENT "=" expr    # simple bind: if let v = opt:
                  | "let" IDENT             # shorthand: if let v:  ≡  if let v = v:
                  | expr                    # boolean condition

match_stmt      ::= "match" expr ":" NEWLINE INDENT
                      match_arm+
                    DEDENT

match_arm       ::= pattern ("|" pattern)* ("if" expr)? ":" (expr NEWLINE | block)

while_stmt      ::= "while" expr ":" block
                  # inline:  `while cond: stmt` — body is a single statement on the same line

while_let_stmt  ::= "while" "let" pattern "=" expr ":" block   # pattern: while let Some(x) = f():
                  | "while" "let" IDENT "=" expr ":" block      # simple:  while let v = f():
                  | "while" "let" IDENT ":" block               # shorthand: while let v:  ≡  while let v = v:
                  # all three also admit the inline (monoline) form via the block rule

do_while_stmt   ::= "do" ":" block "while" expr NEWLINE
                  # inline:  `do: stmt while cond`
                  # Note: `do:` without a trailing `while` is a `do_expr` (see below)

loop_stmt       ::= "loop" ":" block
                  # inline:  `loop: stmt`

for_stmt        ::= "for" IDENT ("," IDENT)* "in" expr ":" block   # with binding
                  | "for" expr ":"  block                           # no binding (implicit `_`)
                  # both forms also admit the inline (monoline) form via the block rule

try_stmt        ::= "try" ":" block
                    catch_clause*

# catch_type_list absent = catch-all; `error` is bound to the original thrown value.
# Single type: `error` has the native type of the thrown value:
#   catch String: → error: string    catch Int: → error: int
#   catch Float:  → error: float     catch Bool: → error: bool
# Multi-type: body is duplicated per type arm, each with its native error type:
#   catch String, Int: …  → one arm per matched type, error is string/int respectively
# Named enum: `error: &MyEnum` — typed value for variant dispatch.
catch_clause    ::= "catch" catch_type_list? ":" block

catch_type_list ::= catch_type ("," catch_type)*
catch_type      ::= IDENT ("." IDENT)?   # type name, optionally dotted for enum variant: Error.Expired

guard_stmt      ::= "guard" guard_cond "else" ":"? (stmt | block)

# Scoped access block — grants extended, multi-statement host access to a value
# normally touched one operation at a time: `'gpu'unified`/`'gpu'global` residency
# (map-for-read/write, write-back on close) and `'actor`/`'guard` locks (held across
# the whole block instead of once per call). Each `name` must already be bound in
# scope; its qualifier and read/write access level are resolved by the checker, not
# here. Reuses the `with` keyword already used by inline `match expr with …` — that
# form is only ever consumed inside match_stmt, never at top-level stmt dispatch,
# so there is no grammar conflict.
with_stmt       ::= "with" IDENT ("," IDENT)* ":" block
guard_cond      ::= cond_clause ("," cond_clause)*   # let-bindings bind in ENCLOSING scope
                  | expr

# ─── Expressions ─────────────────────────────────────────────────────────────
#
# Precedence (low → high):
#   |>  (pipe)
#   else (nil-coalescing / try-else)
#   or
#   and
#   not
#   == != < > <= >= is is not
#   | ^ &  (bitwise)
#   << >>  (shift)
#   + -
#   * / %
#   unary: - not ~
#   postfix: call, trailing-closure, field, index, as, ?.
#   primary
#
# ── Multi-line expressions ────────────────────────────────────────────────────
#
# Inside parentheses `(…)`, newlines between binary operators are ignored,
# enabling Python-style implicit line continuation:
#
#   let total = (revenue        # operator at start of continuation (PEP 8 preferred)
#       + costs
#       - adjustments)
#
#   let valid = (a > 0          # boolean expressions
#       and b > 0
#       and result != nil)
#
# Outside parentheses, newlines always terminate an expression.

expr            ::= try_else_expr
                  | else_expr
                  | assign_expr

assign_expr     ::= postfix_expr "=" expr
                  | or_expr

else_expr       ::= pipe_expr "else" ":"? (expr | block)
try_else_expr   ::= "try" pipe_expr "else" ":"? (expr | block)  # inline try,  inline or block else — `error` bound
                  | "try" ":" block "else" ":"? (expr | block)   # block try,   inline or block else — `error` bound
                  | "try" "?" pipe_expr                          # shorthand: ≡ try expr else nil  (→ .ok() in Rust)

pipe_expr       ::= or_expr ("|>" IDENT ("(" arg_list? ")")?)*  # left pipe: x |> f(…)

or_expr         ::= and_expr ("or" and_expr)*
and_expr        ::= not_expr ("and" not_expr)*
not_expr        ::= "not" not_expr | cmp_expr
cmp_expr        ::= add_expr (cmp_op add_expr)*
cmp_op          ::= "==" | "!=" | "<" | ">" | "<=" | ">="
                  | "is"           # reference identity / type check / nil check
                  | "is" "not"     # negated form

add_expr        ::= mul_expr (("+" | "-") mul_expr)*
mul_expr        ::= unary_expr (("*" | "/" | "%") unary_expr)*
unary_expr      ::= "-" unary_expr | "~" unary_expr | postfix_expr
postfix_expr    ::= primary_expr postfix*

# ── Trailing closures ─────────────────────────────────────────────────────────
#
# When the last argument is a closure, it may be written OUTSIDE the call parens.
# All forms append the closure as the final argument.
#
# Standard (params in parens):
#   f(args) (p, q): body       → f(args, |p, q| body)
#
# No-paren single param:
#   f(args) p: body            → f(args, |p| body)
#
# Zero-arg forms (three equivalent styles):
#   f(args, (): body)          → explicit inside parens
#   f(args): body              → colon after call args (unambiguous when args contain . or operators)
#   f(args) expr               → no separator, same line only
#
# `do` keyword — always unambiguous, resolves identifier ambiguity:
#   f(args) do (p, q): body    → f(args, |p, q| body)   multi-param with parens
#   f(args) do p, q: body      → f(args, |p, q| body)   multi-param without parens
#   f(args) do p: body         → f(args, |p| body)       single param
#   f(args) do: body           → f(args, || body)         zero-arg with colon
#   f(args) do expr            → f(args, || expr)          zero-arg without colon
#
# Ambiguity: `f(name): body` — when ALL args are bare identifiers, `(name):` is
# parsed as a closure parameter list, not call args. Use `do` to disambiguate:
#   timeout(deadline) do: fetch()    ← deadline is a call arg, not a closure param

trailing_closure ::= "(" param_list? ")" modifier* ":" fn_body   # (p, q): body
                   | IDENT ":" fn_body                            # p: body
                   | ":" fn_body                                  # : body  (zero-arg)
                   | "do" "(" param_list? ")" modifier* ":" fn_body   # do (p, q): body
                   | "do" IDENT ("," IDENT)* ":" fn_body              # do p, q: body
                   | "do" ":" fn_body                                  # do: body
                   | "do" expr                                         # do expr (same-line)

postfix         ::= "(" arg_list? ")" trailing_closure?          # call with optional trailing closure
                  | "<" type_list ">" "(" arg_list? ")" trailing_closure?  # generic call: f<T>(args)
                  | trailing_closure                                         # trailing closure, no regular args
                  | "." IDENT                                                # field access
                  | "?." IDENT                                               # optional chaining — field
                  | "." IDENT "(" arg_list? ")"                             # method call
                  | "?." IDENT "(" arg_list? ")"                            # optional chaining — method
                  | "[" expr "]"                                             # index
                  | "[" IDENT "=" expr ("," IDENT "=" expr)* ","? "]"        # labeled index (2+ axes; see array-multidim-types.md):
                                                                             #   a[width = w, height = h] — every arg mandatorily
                                                                             #   labeled, order free at the use site (names disambiguate)
                  | "[" slice_range "]"                                     # slice: a[M..N], a[..N], a[M..], a[..]
                  | "as" type                                                # cast
                  | "as" "[" IDENT "=" IDENT ("," IDENT "=" IDENT)* ","? "]" # relabel cast (array-multidim-types.md):
                                                                             #   img as [line = width, column = height] —
                                                                             #   (target_label = source_label) pairs, must be a
                                                                             #   complete bijection over the source's own axes

arg_list        ::= arg ("," arg)* ","?    # trailing comma allowed
arg             ::= (IDENT "=")? expr      # labeled or positional
                  | ".." expr              # spread argument — expands into the variadic slot

primary_expr    ::= INT | FLOAT | STRING | STRING_INTERP | BOOL | "nil"
                  | IDENT
                  | "." IDENT "(" arg_list? ")"   # leading-dot static method: .fromSecs(5) — type inferred
                  | "." IDENT                     # leading-dot enum/field shorthand: .Red, .North
                  | "self"
                  | "(" expr ")"            # grouping — newlines inside ignored
                  | "(" expr "," expr ("," expr)* ")"   # tuple
                  | "[" (expr ("," expr)*)? "]"          # array literal
                  | "[" ".." expr "]"                    # array alloc: [..n] — allocate n elements without init
                  | "[" expr "for" ".." expr "]"                    # fill: [v for ..n]
                  | "[" expr "for" expr "]"                         # fill, bare count: [v for n] — `..` optional
                                                                     #   here (no bound loop var to justify requiring it);
                                                                     #   see array-multidim-types.md, "Fill shorthand"
                  | "[" expr "for" IDENT "in" (".." expr | expr) "]"
                                                                     # comprehension: [f(i) for i in ..n] (range, start
                                                                     #   must be 0 — `..n` or `0..n`) or
                                                                     #   [f(x) for x in xs] (iterate a collection)
                  | "[" expr ("for" IDENT "in" ".." expr)+ "]"       # chained comprehension (2+ clauses) → a labeled
                                                                     #   multi-dim array (array-multidim-types.md): the
                                                                     #   FIRST clause is axis 1 (fastest-varying in
                                                                     #   row-major storage), regardless of syntactic
                                                                     #   nesting order — see "Axis order is fixed at
                                                                     #   declaration". A single clause stays the plain
                                                                     #   comprehension form above, unchanged.
                  | "[" expr "for" IDENT "=" const_expr ("," IDENT "=" const_expr)+ "]"
                                                                     # labeled shape-only fill (2+ axes):
                                                                     #   [v for width = w, height = h] — the labels are
                                                                     #   NOT bound as usable variables in `v`, purely
                                                                     #   descriptive of shape (array-multidim-types.md,
                                                                     #   "Fill shorthand")
                  | "{" "}"                              # empty set  `{}`  → HashSet::new()
                  | "{" "=" "}"                          # empty dict `{=}` → HashMap::new()
                  | "{" dict_or_set "}"                  # dict or set (non-empty)
                  | range_expr
                  | closure_expr
                  | if_expr
                  | match_expr
                  | task_expr
                  | join_expr                            # join all tasks in a list
                  | do_expr                              # scoped block with own defer frame
                  | block_expr
                  | macro_call

# `join` — await all tasks in a list concurrently and return a list of results.
#   let results = join [f1, f2, f3]   → await all three futures in parallel
# Each element of the list must be a `Future<T>`; the result type is `[T]`.
join_expr       ::= "join" "[" expr ("," expr)* "]"

range_expr      ::= expr ".." expr      # exclusive range  [start, end)
                  | expr "..=" expr     # inclusive range  [start, end]

slice_range     ::= expr ".." expr      # a[M..N]  — exclusive sub-array
                  | expr "..=" expr     # a[M..=N] — inclusive sub-array
                  | ".." expr           # a[..N]   — from index 0
                  | "..=" expr          # a[..=N]  — from index 0, inclusive
                  | expr ".."           # a[M..]   — to end of array
                  | ".."               # a[..]    — full copy

closure_expr    ::= "(" param_list? ")" modifier* ":" fn_body  # standard: (x, y): x + y
                  | IDENT ":" fn_body                          # no-paren single param: x: x * 2
                  | ":" IDENT                                  # field shorthand: :name  ≡  (x): x.name
                  | ":" IDENT "(" arg_list? ")"               # method shorthand: :upper()
                  # `modifier`: `throws`, `task` (either order, both optional).
                  # `return` is NOT allowed inside closure bodies.

if_expr         ::= if_stmt                 # if used as expression — all branches must yield a value
match_expr      ::= match_stmt              # match used as expression

# task as expression — creates a Future.
# Auto-detects spawn_blocking: `task syncFn(args)` where syncFn is not declared `task`
# emits tokio::task::spawn_blocking; `task asyncFn(args)` emits tokio::spawn.
#
# Timeout forms: first arg may be Duration (relative) or Instant (absolute deadline).
# The transpiler auto-selects timeout vs timeout_at based on the argument type.
#
#   task .fromSecs(5)): body    → tokio::time::timeout(Duration::from_secs(5), …)
#   task(deadline): body        → tokio::time::timeout_at(instant, …)  [if deadline is Instant]
task_expr       ::= "task" ":"? expr                     # inline: task fetch() or task: fetch()
                  | "task" ":" block                     # block: last expression is the Future value
                  | "task" "(" expr ")" trailing_closure # with timeout; trailing closure is the body
                  # `return` is NOT allowed inside task blocks.

# `do:` scoped block — executes once; own scope + own defer frame.
# `defer` statements run when the block exits (not the enclosing function).
# `return`/`break`/`continue` propagate to the enclosing function/loop.
# Disambiguation: `do: … while cond` → do_while_stmt; `do:` without `while` → do_expr.
do_expr         ::= "do" ":" block

block_expr      ::= ":" block              # block used as expression (in else:, guard else:, etc.)

# ─── Macro calls ─────────────────────────────────────────────────────────────
#
# Syntax: IDENT "!" macro_args
# `!` is the Bang token; the parser distinguishes macro calls from logical-NOT
# by lookahead: `ident!(` → macro call, `!expr` → unary not.
#
macro_call      ::= IDENT "!" macro_args
macro_args      ::= "(" (expr ("," expr)*)? ")"
                  | "[" (expr ("," expr)*)? "]"
                  | "{" (expr ("," expr)*)? "}"

dict_or_set     ::= expr "=" expr ("," expr "=" expr)*     # dict: `{k = v, ...}`
                  | expr ("," expr)*                        # set:  `{a, b, ...}`

# ─── String interpolation ─────────────────────────────────────────────────────
#
# Boring uses `{expr}` inside string literals. No escape prefix needed.
# An optional format specifier follows a `:` inside the braces.
#
# Examples:
#   "Hello, {name}!"
#   "pi ≈ {3.14159:.3}"       — 3 decimal places
#   "hex = {255:x}"           — lowercase hex
#   "padded = {n:05}"         — zero-padded 5 digits
#   literal brace: "{{" → "{"
#
# Format specifiers (Rust-compatible):
#   :.Nf   — N decimal places:   "{pi:.2f}" → "3.14"
#   :Nd    — minimum N digits:   "{n:5d}"   → "   42"
#   :0Nd   — zero-padded:        "{n:05d}"  → "00042"
#   :+.Nf  — with sign:          "{x:+.2f}" → "+3.14"
#   :.Ne   — scientific:         "{x:.2e}"  → "3.14e0"
#   :.N%   — percentage:         "{x:.1%}"  → "31.4%"
#   :x     — lowercase hex       :X — uppercase hex
#   :b     — binary              :o — octal
#   :?     — debug representation

STRING_INTERP   ::= '"' (char | "{" expr (":" fmt_spec)? "}")* '"'
fmt_spec        ::= [+]? [0]? [0-9]* ("." [0-9]+)? ("f" | "d" | "e" | "%" | "x" | "X" | "b" | "o" | "?")?

# ─── Patterns ────────────────────────────────────────────────────────────────

pattern         ::= "_"                                          # wildcard
                  | IDENT                                        # bind
                  | IDENT "(" pattern ("," pattern)* ")"        # enum variant with fields
                  | "." IDENT                                    # leading-dot enum shorthand: .North
                  | "Some" "(" pattern ")"                       # optional unwrap
                  | lit_pattern
                  | "nil"

lit_pattern     ::= INT | FLOAT | STRING | BOOL

# ─── Types ───────────────────────────────────────────────────────────────────
#
# <Trait> vs bare Trait:
#   <Drawable>   — impl Trait (static dispatch, function determines the concrete type)
#                  → emits `impl Drawable` in Rust
#   Drawable     — Box<dyn Trait> (dynamic dispatch, heap allocated)
#                  → emits `Box<dyn Drawable>` in Rust
#
# Use <Trait> for the common single-use case.
# Use bare Trait only when different concrete types must be stored/returned at runtime.
# Use explicit `T fn<T as Trait>(T x)` when the same type must appear in multiple positions.

type            ::= primitive_type
                  | numeric_type
                  | "<" IDENT ">"                      # impl Trait shorthand: <Drawable>
                  | IDENT                              # named type; if a trait → Box<dyn Trait>
                  | IDENT "<" type_list ">"            # generic: Stack<Int>
                  | type "?"                           # optional: T?  →  Option<T>
                  | "[" type "]"                       # dynamic array: [T]  →  Vec<T>
                  | "[" type "," const_expr "]"        # fixed-size array: [T, N]  →  [T; N] in Rust
                                                       #   N may be an INT literal, a const generic param name,
                                                       #   or an arithmetic expression over those (W * H, N - 1, …)
                  | "[" type "," labeled_axis "," labeled_axis ("," labeled_axis)* "]"
                                                       #   labeled multi-dim array (2+ axes), array-multidim-types.md:
                                                       #     [T, width, height]           — dynamic shape (every axis
                                                       #                                    label-only)
                                                       #     [T, width = W, height = H]   — fixed shape (every axis
                                                       #                                    has a compile-time size)
                                                       #   axes are uniformly all-dynamic or all-fixed, never mixed
                                                       #   (checked at parse time). Axis order is significant and
                                                       #   permanent for the type — [T,width,height] and
                                                       #   [T,height,width] are different (transposed) types.
                                                       #   Disambiguated from `[T, N]` above purely by arity: exactly
                                                       #   one item after the comma keeps meaning "reference to an
                                                       #   existing const generic param" (unchanged); two or more
                                                       #   means this new form.
                  | "(" type ("," type)* ")"           # tuple: (T, U)
                  | "{" type "=" type "}"              # dict: {K = V}  →  HashMap<K,V>
                  | "{" type "}"                       # set: {T}  →  HashSet<T>
                  | type "(" type_list? ")"            # function type: ReturnType (ParamTypes)
                  | type "'" owner_qual                # heap / smart-pointer ownership qualifier
                  | type "&" borrow_qual               # borrow / reference qualifier
                  | "mut"? type "&" borrow_qual        # mut Type& → &mut Type (always valid — the
                                                       #   borrowed form has an existing Rust type to
                                                       #   target, `OwnerQual::BorrowMut`; composes into a
                                                       #   tuple/generic argument/array element/dict value
                                                       #   exactly like the unprefixed form above)
                  | "mut"? type                        # mut Type → valid only where the CHECKER allows
                                                       #   it (tuple slot, struct field, array element,
                                                       #   dict value, or a let_stmt's own top-level type —
                                                       #   see binding_keyword above); a Boring-only
                                                       #   permission with no distinct Rust type of its
                                                       #   own. Grammar-unrestricted on purpose — parses
                                                       #   anywhere a `type` does, rejected elsewhere by
                                                       #   the checker (scalar, `'shared`, `'weak`, a whole
                                                       #   tuple, a set element — docs/mut-type-modifier.md
                                                       #   §1/§3). See docs/mut-type-modifier.md for the
                                                       #   full model this generalizes from.

# Compile-time size expression — used in fixed-size array types `[T, N]`.
# Only available where the type system can resolve the value statically (kernel fields, etc.).
const_expr      ::= INT
                  | IDENT                              # reference to a const generic param (e.g. N, W)
                  | const_expr ("+" | "-" | "*" | "/") const_expr
                  | "-" const_expr                     # unary negation
                  | "(" const_expr ")"

# One axis of a labeled multi-dim array type (array-multidim-types.md).
labeled_axis    ::= IDENT                              # dynamic axis — shape known only at construction
                  | IDENT "=" const_expr                # fixed axis — compile-time size

# Note: `any Trait` (old syntax) is deprecated. Use bare `Trait` for Box<dyn> and `<Trait>` for impl.

# ─── Ownership qualifiers ─────────────────────────────────────────────────────
#
# The tick `'` is exclusively an OWNERSHIP qualifier — it never produces a reference.
# Lifetimes are written only in borrow position (see borrow_qual below).
#
# Default: stack allocation (T).  Heap allocation is always explicit.
#
#   T  /  T'stack   →  T                   stack-owned (Rust default)
#   T' /  T'heap    →  Box<T>              heap-owned, exclusive move
#   T'copy          →  T (Copy)            copied on every use: int, float, bool, …
#   T'const         →  &'static T          compile-time constant / string literal
#   T'shared        →  Rc<T>              ref-counted, single-thread
#   T'actor         →  Arc<Mutex<T>>      shared mutable; all accesses auto-locked
#   T'guard         →  Arc<RwLock<T>>     concurrent reads, exclusive writes
#   T'weak          →  Weak<T>            non-owning; .upgrade() → T'shared?
#
# Built-in type aliases (use these instead of explicit qualifiers):
#   str    →  String'const  →  &str
#   string →  String'shared →  Arc<str>  (single-thread: Rc<str>; multi-thread: Arc<str>)
#   int    →  Int'copy      →  i64
#   uint   →  Uint'copy     →  u64
#   float  →  Float64'copy  →  f64        (float is a pure alias of float64)
#   float32 → Float32'copy  →  f32
#   bool   →  Bool'copy     →  bool
#
owner_qual      ::= "heap" | "stack" | "copy" | "shared" | "actor" | "guard" | "weak"
                  | owner_qual "|" owner_qual   # qualifier union: T'stack|heap (resolved at inference time)
                  | ε                           # bare tick → same as 'heap (Box<T>)

# ─── Borrow qualifiers ────────────────────────────────────────────────────────
#
# `&` always means a REFERENCE (borrow). It never means ownership.
# The qualifier after `&` selects which smart-pointer type to borrow into.
#
# Prefix forms (T& or T&qual):
#   T&              →  &T             plain immutable borrow
#   var T&          →  &mut T         mutable borrow (`var` prefix absorbed into type)
#   T&heap          →  &Box<T>        borrow a heap value
#   T&shared        →  &Rc<T>         borrow an Rc (use sparingly)
#   T&option        →  &Option<T>     borrow an optional
#   T&weak          →  &Weak<T>       borrow a weak pointer
#   T&a             →  &'a T          borrow with explicit lifetime 'a
#
# Alias pattern: `use NodeRef as Node'shared;  def walk(NodeRef& n):`
# → the `&` after an alias resolves to the smart-pointer borrow of the aliased type.
#
# Lifetime letter is a single ASCII lowercase letter: a, b, c, …
# Declared automatically from usage — no explicit `<&a>` needed in function signatures.
# `<&a>` is only written explicitly in struct/enum type params.
#
borrow_qual     ::= "heap" | "stack" | "shared" | "actor" | "guard" | "option" | "weak"
                  | LOWERCASE_IDENT    # single lowercase letter → lifetime: &a, &b, …
                  | ε                  # plain borrow &T

primitive_type  ::= "int" | "uint" | "float" | "bool" | "string" | "nil" | "never"
                  # Capitalised aliases (Int, Float, …) are accepted by the parser for
                  # compatibility but normalised to lowercase in the AST.
                  # `int`/`uint` transpile to Rust `isize`/`usize` (pointer-width).
                  # `float` is a pure alias of `float64` below — unlike `int`/`uint`,
                  # it has no independent identity of its own (docs/float-width-types.md
                  # §2): every stage after alias resolution sees `float64`, never a
                  # separate `float` runtime type.

# Fixed-width numeric types — each is a distinct runtime type (its own Value variant in
# the interpreter, e.g. `uint8` → `Value::Uint8(u8)`, `float32` → `Value::Float32(f32)`),
# not an alias collapsing into the bare `int`/`uint`/`float` above (`float` is the one
# exception — see `primitive_type`'s note). The Rust-style spellings (`i8`, `u32`, `f32`,
# `f64`) are accepted as aliases for the corresponding boring name and transpile to the
# identical Rust type.
#   Signed:   int8/i8  int16/i16  int32/i32  int64/i64  int128/i128
#   Unsigned: uint8/u8  uint16/u16  uint32/u32  uint64/u64  uint128/u128
#   Floats:   float32/f32 (32-bit)   float64/f64 (64-bit, = bare `float`)
# Mixing two *distinct* fixed-width types directly (`a_uint16 + a_int32`,
# `a_float32 + a_float64`) is a type error requiring an explicit `as` cast — mirrors
# Rust's own refusal to implicitly coerce between distinct numeric types. Each
# fixed-width type freely mixes with its own family's flexible/untyped kind: the bare
# `int`/`uint` kind for integers, and an untyped float literal (not a resolved `float64`
# value — `float` has no independent flexible kind of its own) for `float32`/`float64`.
# GPU targets: WGSL (`--target wgpu`) only has native 32-bit int/uint/float —
# 8/16/64/128-bit int fields AND `float64` are a compile error (WGSL has no 64-bit
# float type at all). MSL (`--target metal`) has no native 64/128-bit integer and no
# native `double` — `float64` is a compile error there too (use `float32`). CUDA
# (`--target cuda`) and ROCm (`--target rocm`) support the full integer range via
# <cstdint> (128-bit via the non-standard `__int128` extension) and both float widths
# natively (`float` in device code, `double` for `float64`).
numeric_type    ::= "i8" | "i16" | "i32" | "i64" | "i128" | "isize"
                  | "u8" | "u16" | "u32" | "u64" | "u128" | "usize"
                  | "f32" | "f64" | "float32" | "float64"

type_list       ::= type ("," type)*

# ─── Compound assignment ──────────────────────────────────────────────────────
#
# Boring desugars compound assignment in the parser:
#   x += n    →  x = x + n
#   x -= n    →  x = x - n
#   x *= n    →  x = x * n
#   x /= n    →  x = x / n
# The transpiler re-folds them back to `+=`, `-=`, `*=`, `/=` in Rust output
# (except for string concatenation, which uses `Arc::new(…)` instead).

# ─── Exception semantics ─────────────────────────────────────────────────────
#
# A function marked `throws` may raise an exception with `throw expr`.
# Bare `throw` re-throws the implicit `error` variable inside a catch block.
# Exceptions propagate up the call stack until caught by `try/catch`.
#
# `throws` with a type narrows the Rust error type from `Box<dyn Error>` to a concrete type:
#   def int divide(int a, int b) throws:           →  Result<i64, Box<dyn Error>>
#   def int divide(int a, int b) throws CalcError: →  Result<i64, CalcError>
#
# `try expr else default` catches any exception from expr and returns default.
# The default can be a block (last expression = value):
#   let data = try fetch() else:
#       log("failed")
#       []
#
# All four combinations of try/else bodies are valid and always bind `error`:
#
#   try expr    else expr           # inline / inline
#   try expr    else: block         # inline / block
#   try: block  else expr           # block  / inline
#   try: block  else: block         # block  / block
#
# `error` is bound with its NATIVE TYPE in typed catch clauses:
#   catch String: → error: string    catch Int:   → error: int
#   catch Float:  → error: float     catch Bool:  → error: bool
#   catch MyEnum: → error: &MyEnum   (typed enum, for variant dispatch)
# Multi-type catch: body is duplicated per type arm, each with its native error type.
#
# `error` is automatically bound in each catch clause body and in `try:…else:` else blocks.
# Typed catch: `catch NetworkError, TimeoutError:` matches by type name.
# Catch-all: `catch:` matches any exception.

# ─── Task / concurrency semantics ────────────────────────────────────────────
#
# A function marked `task` may block on I/O or be long-running.
# `task expr` creates a Future — the expression is scheduled for evaluation.
# `future.value` blocks until the Future resolves and returns its value.
#
# Auto-detection of spawn vs spawn_blocking:
#   task asyncFn(args)  — asyncFn declared `task` → tokio::spawn
#   task syncFn(args)   — syncFn declared `def`   → tokio::task::spawn_blocking
#
# `wait` and `timeout` — built-in async primitives:
#   wait(dur)                     → tokio::time::sleep(dur).await
#   wait(instant)                 → tokio::time::sleep_until(instant).await
#   timeout(dur): body            → tokio::time::timeout(dur, body).await?
#   timeout(instant): body        → tokio::time::timeout_at(instant, body).await?
#   timeout(deadline) do: body    → (same, using do for unambiguous call arg)
#
# Leading-dot shorthand for Duration/Instant arguments:
#   wait(.fromSecs(5))            → Duration::from_secs(5) inferred from parameter type
#   timeout(.fromSecs(10)): body  → Duration::from_secs(10) inferred
#
# Two ownership patterns for shared data across tasks:
#
#   T'task    →  Arc<T>               read-only sharing across tasks
#   T'actor   →  Arc<Mutex<T>>        shared MUTABLE state across tasks
#   T'guard   →  Arc<RwLock<T>>       concurrent reads, exclusive writes
#
# Capture analysis is automatic — no explicit `Arc::clone` or `move` keyword needed.
#
# Arc-qualified receiver constraint:
#   A method declared `task` on a struct must use an Arc-qualified receiver type
#   (`self'task`, `self'actor`, or `self'guard`). Using a plain `self` receiver
#   is a compile-time error — the method cannot be safely called from a spawned task
#   without Arc-wrapping the struct instance.
#
#   struct Server:
#       int port
#   ext Server:
#       def void run(Server'task self) task:   # OK — Arc<Server> receiver
#           wait(.fromSecs(1))
#       def void bad(Server  self) task:       # ERROR — plain receiver in task method
#
# fire-and-forget:  task fetch()
# future:           let f = task fetch()
#                   let data = f.value
#
# ── Future<T> methods ────────────────────────────────────────────────────────
#
# `Future<T>` is the handle returned by any `task` expression.
# No import needed — Future is a built-in type.
#
# Blocking await (require a `task` context):
#   f.value          → T          await and return; throws if the task threw
#   f.wait           → void       await and discard (property or call syntax)
#   f.value(dur)     → T          await with relative timeout; throws Error.Expired
#   f.value(inst)    → T          await until absolute deadline; throws Error.Expired
#   f.wait(dur)      → void       await/discard with relative timeout
#   f.wait(inst)     → void       await/discard until absolute deadline
#
# Non-blocking:
#   f.done           → bool       true if result is already available (never blocks/throws)
#   f.done()         → bool       same — property and call syntax both valid
#
# Cancellation:
#   f.cancel()       → void       signal cancellation; next await on f throws Error.Cancelled
#                                 interpreter: no-op (cancellation tokens not available)
#
# Task.cancelled():
#   Task.cancelled() → bool       true if the current task received a cancellation signal
#                                 interpreter: always returns false
#
# Transpilation:
#   f.done           → handle.is_finished()
#   f.cancel()       → handle.abort()
#   f.value(dur)     → tokio::time::timeout(dur, handle).await??
#   f.value(inst)    → tokio::time::timeout_at(inst, handle).await??

# ─── Operator overloading ────────────────────────────────────────────────────
#
# When a binary or unary operator is applied to a struct instance, the interpreter
# looks for a method with the corresponding name.
#
# Binary operators → method names:
#   +   → add(rhs)   -   → sub(rhs)   *   → mul(rhs)   /   → div(rhs)   %   → rem(rhs)
#   ==  → eq(rhs)    !=  → ne(rhs) (or !eq(rhs) if ne not defined)
#   <   → lt(rhs)    >   → gt(rhs)    <=  → le(rhs)    >=  → ge(rhs)
#
# Unary: -  → neg()
#
# Example:
#   struct Vec2:
#       float x
#       float y
#   ext Vec2:
#       def Vec2' add(Vec2' rhs): Vec2(self.x + rhs.x, self.y + rhs.y)
#       def Vec2' neg():          Vec2(-self.x, -self.y)
#       req bool  eq(Vec2' rhs):  self.x == rhs.x and self.y == rhs.y

# ─── Tuple methods ───────────────────────────────────────────────────────────
#
# Tuples support a fixed set of built-in methods.  All methods are checked at
# parse/type-check time; there is no dynamic dispatch.
#
#   t.length()          → int          number of slots (always known at compile time)
#   t.isEmpty()         → bool         true iff length == 0
#   t.first()           → T0           first slot value (compile error on empty tuple)
#   t.last()            → TN           last  slot value (compile error on empty tuple)
#   t.map(x: f(x))      → (U0, U1, …)  apply closure to each slot; returns same-arity tuple
#   t.all(x: pred(x))   → bool         true iff predicate holds for every slot
#   t.any(x: pred(x))   → bool         true iff predicate holds for at least one slot
#
# For `.map`: the closure receives each slot value independently — per-slot type
# inference is preserved in Rust output.
# For `.all` / `.any`: short-circuit evaluation across slots.
# Field shorthand also works:  boxes.map(:value)  ≡  boxes.map(b: b.value)

# ─── camelCase convention ─────────────────────────────────────────────────────
#
# Boring uses camelCase for method names. The transpiler automatically converts
# camelCase to snake_case in Rust output:
#   .fromSecs(5)    → Duration::from_secs(5)
#   .fromMillis(n)  → Duration::from_millis(n)
#   .isEmpty()      → .is_empty()
#   .startsWith(s)  → .starts_with(s)
#
# For external Rust types (Duration, Instant, Path, etc.), leading-dot syntax
# infers the type from context:
#   wait(.fromSecs(5))       — type Duration inferred from wait's parameter
#   schedule(.fromMillis(n)) — type Duration inferred from schedule's parameter

# ─── Lexical conventions ─────────────────────────────────────────────────────

INT             ::= [0-9]+ ("_" [0-9]+)*    # underscores allowed: 1_000_000
FLOAT           ::= [0-9]+ "." [0-9]+ (("e"|"E") ("+"|"-")? [0-9]+)?
STRING          ::= '"' char* '"'
STRING_INTERP   ::= '"' (char | "{" expr (":" fmt_spec)? "}" | "{{" | "}}")* '"'
fmt_spec        ::= [+]? [0]? [0-9]* ("." [0-9]+)? [fdeEbBoxX%?]?
BOOL            ::= "true" | "false"
IDENT           ::= [a-zA-Z_][a-zA-Z0-9_]*
LOWERCASE_IDENT ::= [a-z]    # single ASCII lowercase letter (used for lifetime params)

INDENT          ::= increase in leading whitespace
DEDENT          ::= decrease in leading whitespace
NEWLINE         ::= end of logical line
SEMICOLON       ::= ";"                # treated as NEWLINE by the lexer — separates statements on one line
                                       # e.g.  let a = 1; let b = 2; print a + b
COMMENT         ::= "#" .* NEWLINE     # ignored by parser

# Keywords (reserved):
# def, req, transient, let, mut, var, lazy, pub, return, if, elif, else, match, while, do, loop, for, in,
# struct, enum, trait, ext, use, as, and, or, not, guard,
# break, continue, self, init, new, with,
# try, catch, throw, throws, defer,
# task, set, wait, join, sync,
# Note: `channel` is NOT a reserved keyword — it is a stdlib function (channel<T>(cap)).
#       Use `channel<T, N>()` or `channel<T>(cap)` as ordinary function calls.
# kernel,
# Note: `select` was removed in 0.3.0 — use Future.done() polling instead.
# true, false, nil, is,
# native, stream, yield, static, void, pass, mod,
# any  # deprecated — use bare Trait or <Trait> instead

# ─── Emission targets and build flags ───────────────────────────────────────
#
# The `--target` flag selects the emission backend. The parser, AST, and typing
# passes are shared; only the emitter changes.
#
#   boring build <file.br>                 — standard Rust + tokio (default)
#   boring build --target kernel <file.br> — Rust-for-Linux (no_std + kernel crates)
#   boring build --target kernel           — kernel project from boring.toml
#   boring build --target cuda <file.br>   — CUDA GPU backend (cudarc + PTX via nvcc)
#   boring build --target cuda             — CUDA project from boring.toml
#   boring build --target metal <file.br>  — Metal GPU backend (macOS, MSL compiled at runtime)
#   boring build --target metal            — Metal project from boring.toml
#   boring build --target wgpu <file.br>   — wgpu GPU backend (Windows/Linux/macOS; DirectX 12 / Vulkan / Metal)
#   boring build --target wgpu             — wgpu project from boring.toml
#   boring build --emit-rust <file.br>     — print generated Rust to stdout, no project created
#
# Debugging and profiling flags (orthogonal, composable, stable unless noted):
#
#   --mode managed        Auto-derive Debug on all types; #[track_caller] on every
#                         function; writes .cargo/config.toml with RUST_BACKTRACE=1.
#   --sanitize <san>      Writes .cargo/config.toml with -Zsanitizer=<san> and the
#                         host target triple.  <san> ∈ { address | thread | memory }.
#                         Requires a nightly toolchain (cargo +nightly run).
#   --instrument          Prepends an inline __boring_instrument module (no external
#                         dep).  Wraps every function body with a RAII Span guard.
#                         On exit writes boring_coverage.json (per-function stats)
#                         and boring_trace.json (Chrome Trace Format, Perfetto /
#                         Speedscope compatible).
#
# Builtin debugging functions (resolved as ordinary calls — not reserved keywords):
#
#   dbg(expr)             → dbg!(expr)      print file:line + value, return value
#   todo()                → todo!()         panic placeholder for unfinished paths
#   unreachable()         → unreachable!()  assert a branch is never reached
#   assert(cond)          → assert!(cond)   runtime assertion
#   assert_eq(a, b)       → assert_eq!(a,b) equality assertion
#   assert_neq(a, b)      → assert_ne!(a,b) inequality assertion
#   panic(msg)            → panic!("{:?}",…) unconditional panic
#
# Kernel target mappings (see docs/kernel-transpiler-mapping.md for full table):
#
#   Boring              Rust std                 Rust-for-Linux
#   ──────────────────  ───────────────────────  ──────────────────────────────
#   string              Arc<str>                 kernel::str::CStr / CString
#   {K: V}              HashMap<K, V>            kernel::rbtree::RBTree<K, V>
#   {T}                 HashSet<T>               RBTree<T, ()>
#   throws MyError      Result<T, Box<dyn Error>> Result<T, kernel::error::Error>
#   task def            async fn + tokio::spawn  Work item on system_wq
#   task expr           tokio::spawn(…)          system_wq.enqueue(work)
#   Future<T>           JoinHandle<T>            KernelFuture<T>
#   channel<T, N>       tokio::sync::mpsc(N)     ring buffer + Mutex + CondVar
#   stream<N> def       futures::Stream          KernelChan<T,N> + Work item
#   wait(dur)           tokio::time::sleep       kernel::delay::coarse_sleep
#   T'task              Arc<T>                   kernel::sync::Arc
#   T'actor             Arc<Mutex<T>>            kernel::sync::Mutex
#   T'guard             Arc<RwLock<T>>           kernel::sync::RwLock
#   print!              println!                 pr_info!
#   assert_eq!          assert_eq!               kernel::build_assert! / WARN_ON
#
# Forbidden in kernel target (validation rejects with an explicit error):
#   float, math builtins (FPU disabled), panic, T& / T&mut on task def
#
# Kernel error type binding (required for typed catch in kernel target):
#   type NetworkError as kernel.error.Error(ENETDOWN)
#   type TimeoutError as kernel.error.Error(ETIMEDOUT)

# ─── Naming conventions ──────────────────────────────────────────────────────
#
# Types (struct, enum, trait): uppercase first letter, ≥ 2 characters. Examples: Dog, Animal.
# Variables and functions: lowercase first letter or underscore. camelCase for multi-word.
# Methods: camelCase — the transpiler converts to snake_case in Rust output.
# Modules: lowercase, snake_case.
