# Ad-hoc Metal benchmark for native Q4_K and Q6_K prefill. It uses the
# Qwen2.5-3B projection shape from the motivating report, warms once, queues
# 20 calls, and synchronizes only on the final readback.
#
#   boring build --target metal examples/tensor_k_quant_prefill_bench.br
#   cd examples/tensor_k_quant_prefill_bench_metal
#   cargo run --release -- q4_k   # or q6_k

req [float32]'gpu'unified q4k_linear([float32]'gpu'global x, [uint8]'gpu'global w, int m, int n, int k) throws:
    mut [float32]'gpu'unified y = [0.0 as float32 for ..<m * n]
    gpu.tensor.linear(x, w, y, m = m, n = n, k = k, format = "q4_k")
    y

req [float32]'gpu'unified q6k_linear([float32]'gpu'global x, [uint8]'gpu'global w, int m, int n, int k) throws:
    mut [float32]'gpu'unified y = [0.0 as float32 for ..<m * n]
    gpu.tensor.linear(x, w, y, m = m, n = n, k = k, format = "q6_k")
    y

def main() throws:
    let [string] argv = args()
    let format = if argv.length > 1: argv[1] else: "q4_k"
    guard format == "q4_k" or format == "q6_k" else throw "expected q4_k or q6_k"
    let m = 128
    let k = 2048
    let n = 11008
    let [float32] x = [((i % 31) as float32 - 15.0 as float32) / 64.0 as float32 for i in 0..<(m * k)]
    let blockBytes = if format == "q4_k": 144 else: 210
    let weightBytes = (n * k / 256) * blockBytes
    let [uint8] weights = [((i * 17 + 29) % 256) as uint8 for i in 0..<weightBytes]

    let warmup = if format == "q4_k": q4k_linear(x, weights, m, n, k) else: q6k_linear(x, weights, m, n, k)
    with warmup:
        let warmupSink = warmup[0]

    var iteration = 1
    mut result = if format == "q4_k": q4k_linear(x, weights, m, n, k) else: q6k_linear(x, weights, m, n, k)
    while iteration < 20:
        result = if format == "q4_k": q4k_linear(x, weights, m, n, k) else: q6k_linear(x, weights, m, n, k)
        iteration += 1
    with result:
        print "{format} {m}x{k}x{n}, 20 calls, sink={result[0]}"
