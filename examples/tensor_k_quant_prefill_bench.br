# Resident-buffer Metal benchmark for native Q8_0, Q4_K, and Q6_K prefill.
# Usage: cargo run --release -- <q8_0|q4_k|q6_k> <m> <n> <k> [calls]
use std.time.Instant

kernel CopyBytesKernel:
    let [uint8]'global src
    mut [uint8]'unified out
    let int n
    init([uint8]'global s, int nn):
        src = s
        n = nn
        out = [0 as uint8 for ..<nn]
    def ():
        let block_idx = .block.x + .block.y * .grid_dim.x
        let base = (.thread.x + block_idx * .block_dim.x) * 16
        for j in 0..<16:
            if base + j < n:
                out[base + j] = src[base + j]

kernel CopyFloatsKernel:
    let [float32]'global src
    mut [float32]'unified out
    let int n
    init([float32]'global s, int nn):
        src = s
        n = nn
        out = [0.0 as float32 for ..<nn]
    def ():
        let block_idx = .block.x + .block.y * .grid_dim.x
        let base = (.thread.x + block_idx * .block_dim.x) * 4
        for j in 0..<4:
            if base + j < n:
                out[base + j] = src[base + j]

req [uint8]'kernel'unified upload_bytes(int n, [uint8]'global src) throws:
    let int blocks = (n + 4095) / 4096
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut copy = CopyBytesKernel(src, n)
    kernel:
        copy(block = 256, grid = (gx, gy))
    copy.out

req [float32]'kernel'unified upload_floats(int n, [float32]'global src) throws:
    let int blocks = (n + 1023) / 1024
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut copy = CopyFloatsKernel(src, n)
    kernel:
        copy(block = 256, grid = (gx, gy))
    copy.out

req [float32]'kernel'unified q8([float32]'kernel'global x, [uint8]'kernel'global w, int m, int n, int k) throws:
    mut [float32]'kernel'unified y = [0.0 as float32 for ..<m * n]
    kernel.tensors.linear(x, w, y, m = m, n = n, k = k, format = "q8_0")
    y
req [float32]'kernel'unified q4k([float32]'kernel'global x, [uint8]'kernel'global w, int m, int n, int k) throws:
    mut [float32]'kernel'unified y = [0.0 as float32 for ..<m * n]
    kernel.tensors.linear(x, w, y, m = m, n = n, k = k, format = "q4_k")
    y
req [float32]'kernel'unified q6k([float32]'kernel'global x, [uint8]'kernel'global w, int m, int n, int k) throws:
    mut [float32]'kernel'unified y = [0.0 as float32 for ..<m * n]
    kernel.tensors.linear(x, w, y, m = m, n = n, k = k, format = "q6_k")
    y

req [float32]'kernel'unified run(string format, [float32]'kernel'global x, [uint8]'kernel'global w, int m, int n, int k) throws:
    if format == "q8_0":
        q8(x, w, m, n, k)
    elif format == "q4_k":
        q4k(x, w, m, n, k)
    else:
        q6k(x, w, m, n, k)

def main() throws:
    let [string] argv = args()
    let format = if argv.length > 1: argv[1] else: "q4_k"
    guard format == "q8_0" or format == "q4_k" or format == "q6_k" else throw "expected q8_0, q4_k, or q6_k"
    guard argv.length >= 5 else throw "usage: <format> <m> <n> <k> [calls]"
    guard let m = (argv[2] as int) else throw "expected integer m"
    guard let n = (argv[3] as int) else throw "expected integer n"
    guard let k = (argv[4] as int) else throw "expected integer k"
    var calls = 10
    if argv.length > 5:
        guard let parsedCalls = (argv[5] as int) else throw "expected integer calls"
        calls = parsedCalls
    let blockElements = if format == "q8_0": 32 else: 256
    let blockBytes = if format == "q8_0": 34 elif format == "q4_k": 144 else: 210
    guard m > 1 and n > 0 and k > 0 and k % blockElements == 0 and calls > 0 else throw "invalid dimensions or calls"
    let [float32] hostX = [((i % 31) as float32 - 15.0 as float32) / 61.0 as float32 for i in 0..<m * k]
    let totalBytes = n * k / blockElements * blockBytes
    let [uint8] hostWeights = [fill_byte(i, blockBytes, format) as uint8 for i in 0..<totalBytes]
    let residentX = upload_floats(m * k, hostX)
    let residentWeights = upload_bytes(totalBytes, hostWeights)
    let warmup = run(format, residentX, residentWeights, m, n, k)
    with warmup:
        let warmupSink = warmup[0]
    let started = Instant.now()
    var iteration = 1
    mut result = run(format, residentX, residentWeights, m, n, k)
    while iteration < calls:
        result = run(format, residentX, residentWeights, m, n, k)
        iteration += 1
    with result:
        let perCall = (started.elapsed().asMicros() as float64) / (calls as float64)
        let tflops = (2.0 * (m as float64) * (n as float64) * (k as float64)) / perCall / 1000000.0
        let gbs = (totalBytes as float64) / perCall / 1000.0
        print "{format} m={m} n={n} k={k}: {perCall:.1f} us/call, {tflops:.3f} TFLOP/s, {gbs:.2f} GB/s, sink={result[0]}"
        if calls == 1:
            for sample in 0..<40:
                let index = sample * (m * n - 1) / 39
                print "sample={sample},value={result[index]}"

int fill_byte(int i, int blockBytes, string format):
    let at = i % blockBytes
    let scaleAt = if format == "q8_0": 0 elif format == "q4_k": 0 else: 208
    let scaleLen = if format == "q4_k": 4 else: 2
    if at >= scaleAt and at < scaleAt + scaleLen:
        let slot = at - scaleAt
        if slot == 0:
            return 102
        if slot == 1:
            return 46
        if slot == 2:
            return 51
        return 43
    return (i * 17 + 29) % 256
