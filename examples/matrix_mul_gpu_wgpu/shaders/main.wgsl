// ─── kernel MatrixMul ───

@group(0) @binding(0) var<storage, read> matrixmul_a: array<f32>;
@group(0) @binding(1) var<storage, read> matrixmul_b: array<f32>;
@group(0) @binding(2) var<storage, read_write> matrixmul_c: array<f32>;


@compute @workgroup_size(16, 16, 1)
fn MatrixMul_main(
    @builtin(local_invocation_id) bp_tid:  vec3<u32>,
    @builtin(workgroup_id)         bp_bid:  vec3<u32>,
    @builtin(num_workgroups)       bp_gdim: vec3<u32>,
) {
    let bp_bdim = vec3<u32>(16u, 16u, 1u);
    let row = ((i32(bp_bid.y) * i32(bp_bdim.y)) + i32(bp_tid.y));
    let col = ((i32(bp_bid.x) * i32(bp_bdim.x)) + i32(bp_tid.x));
    if (((row < 32) && (col < 32))) {
        var sum: f32 = 0.0;
        {
            var i: i32 = 0;
            loop {
                if !(i < 32) { break; }
                sum = (sum + (matrixmul_a[u32(i + row * 32)] * matrixmul_b[u32(col + i * 32)]));
                i = i + 1;
            }
        }
        matrixmul_c[u32(col + row * 32)] = sum;
    }
}

