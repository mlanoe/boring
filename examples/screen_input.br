# Screen input demo — screen.mouse and screen.key_pressed().
# A bright disc follows the mouse. Hold the left button to leave a trail,
# right button to erase it, middle button to fill the screen.
#
# Keys: C — clear (fires once per press via key_pressed)   Escape — quit
#
# Run: boring build examples/screen_input.br --target simd   (or metal / cuda / rocm)
#      cd examples/screen_input_simd && cargo run --release

let width  = 640
let height = 480
let screen = Screen(Dimension(width, height), title = "Screen input — boring")

kernel Paint:
    mut [uint]'surface pixels
    let Dimension dim
    var float32 mx
    var float32 my
    var int mode   # 0 = hover only, 1 = paint, 2 = erase, 3 = fill, 4 = clear

    init(Dimension d):
        pixels = [0xFF101010 for ..<d.width * d.height]
        dim    = d
        mx     = 0.0
        my     = 0.0
        mode   = 0

    def ():
        let col = .block.x * .block_dim.x + .thread.x
        let row = .block.y * .block_dim.y + .thread.y
        if col < dim.width and row < dim.height:
            let i = row * dim.width + col
            let dx = float32(col) - mx
            let dy = float32(row) - my
            let inside = dx * dx + dy * dy < 100
            if mode == 4:
                pixels[i] = 0xFF101010
            elif mode == 3:
                pixels[i] = 0xFF3060C0
            elif inside and mode == 1:
                pixels[i] = 0xFF40E080
            elif inside and mode == 2:
                pixels[i] = 0xFF101010

var mut paint = Paint(Dimension(width, height))

kernel:
    loop:
        paint.mx = float32(screen.mouse.x)
        paint.my = float32(screen.mouse.y)
        paint.mode = if screen.key_pressed("c"): 4 elif screen.mouse.middle: 3 elif screen.mouse.left: 1 elif screen.mouse.right: 2 else 0
        paint(block = (16, 16))
        screen.present(paint.pixels)
        if screen.key("\x1B"):
            break
