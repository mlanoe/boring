@derive Debug, Clone
struct User:
    uint id
    string name
    string email

enum AppError:
    @error "Timeout lors de la récupération des données"
    TimeoutError
    @error "Erreur réseau: {0}"
    NetworkError(string)
    @error "Données invalides"
    InvalidData

task def [User] read_users_from_file_blocking(string path) throws:
    wait(Duration.fromMillis(500))
    let users = [User(id = 1, name = "Alice", email = "alice@example.com"), User(id = 2, name = "Bob", email = "bob@example.com")]
    users

task def [User] fetch_users_from_api(string url) throws AppError:
    wait(Duration.fromMillis(300))
    let users = [User(id = 3, name = "Charlie", email = "charlie@example.com"), User(id = 4, name = "Diana", email = "diana@example.com")]
    users

task def User process_user(User user):
    info "Traitement de l'utilisateur: {user.name}"
    wait(Duration.fromMillis(200))
    User(id = user.id, name = user.name.upper(), email = user.email)

task def void main():
    info "🚀 Démarrage de l'application Tokio"

    let url = "https://jsonplaceholder.typicode.com/users"

    # Lance les deux sources en parallèle
    let h_file = task read_users_from_file_blocking("users.json")
    let h_api  = task fetch_users_from_api(url)

    # Collecte séquentielle — les fetches ont tourné en parallèle
    var [User] all_users = []
    try:
        all_users.extend(h_file.value)
        info "Fichier lu: {all_users.length} utilisateurs"
    catch:
        error "Erreur lors de la lecture du fichier: {error}"
    try:
        all_users.extend(h_api.value)
        info "API: {all_users.length} utilisateurs au total"
    catch:
        error "Erreur API: {error}"

    # Canal pour pipeliner le traitement
    let user_sender, user_receiver = channel<User>(10)

    # Producteur : envoie les utilisateurs puis ferme le canal
    let h_send = task:
        for user in all_users:
            try:
                user_sender.send(user)
            catch:
                warn "Échec de l'envoi d'un utilisateur dans le canal"
        drop(user_sender)

    # Consommateur : traite chaque utilisateur avec un timeout
    # 'actor est nécessaire ici car processed est modifié depuis une task
    var [User]'actor processed = []
    let h_proc = task:
        for user in user_receiver:
            try:
                let p = timeout(Duration.fromSecs(1)): process_user(user)
                info "✓ {p.name}"
                processed.push(p)
            catch:
                warn "Timeout ou erreur lors du traitement de {user.name}"

    h_send.wait
    h_proc.wait

    info "✅ {len(processed)} utilisateurs traités"
