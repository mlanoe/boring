# GPU vector addition — Boring with CUDA/Metal backend

let n = 1000

kernel VectorAdd:
    let [int]'global  a
    let [int]'global  b
    mut [int]'unified result

    init([int]'global input_a, [int]'global input_b):
        a = input_a
        b = input_b
        result = [0 for ..n]

    def ():
        let i = gpu.block.x * gpu.block_dim.x + gpu.thread.x
        if i < n:
            result[i] = a[i] + b[i]

var [int] host_a = [i for i in 0..n]
var [int] host_b = [i * 2 for i in 0..n]

var k = VectorAdd(host_a, host_b)
kernel:
    k(block = 256)

# `k.result[i]` alone would read the whole buffer back from the GPU on every
# iteration of this loop. Binding it through an alias and reading it inside a
# `with` block materializes it exactly once instead — see
# docs/scoped-access-blocks.md. The `'gpu'unified` qualifier is inferred here
# from `k.result` itself being declared `'unified` above; no annotation needed.
let result = k.result
with result:
    for i in 0..n:
        print "c[{i}] = {result[i]}"
