#!/bin/sh
# Stub `nvcc` for smoke-testing `boring build --target cuda`'s GENERATED RUST
# HOST CODE on a machine with no CUDA toolkit (e.g. macOS, or any CI runner
# without an NVIDIA GPU) — see the README in this directory for exactly what
# this does and does not verify before relying on it.
#
# The generated project's build.rs invokes `nvcc --ptx -O2 --output-file
# <path> kernels/main.cu` to compile the kernel source to PTX, then makes
# that path available to main.rs via the BORING_PTX_PATH env var. This stub
# never touches kernels/main.cu at all — it just finds --output-file and
# writes an empty placeholder there, so the build.rs succeeds and cargo can
# proceed to compile/type-check main.rs against a real cudarc.

for arg in "$@"; do
  if [ "$arg" = "--version" ]; then
    # `cudarc`'s own build.rs (the `cuda-version-from-build-system` feature,
    # which the generated Cargo.toml now always requests) shells out to
    # `nvcc --version` and parses line 4 as "<label>, release X.Y, VX.Y.Z" --
    # fabricate a version real nvcc could have printed so that detection
    # succeeds the same way it would against a real toolkit.
    echo "nvcc: NVIDIA (R) Cuda compiler driver"
    echo "Copyright (c) 2005-2024 NVIDIA Corporation"
    echo "Built on Tue_Oct_29_22:21:04_PDT_2024"
    echo "Cuda compilation tools, release 12.6, V12.6.85"
    echo "Build cuda_12.6.r12.6/compiler.34714021_0"
    exit 0
  fi
done

out=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "--output-file" ]; then
    out="$arg"
  fi
  prev="$arg"
done

if [ -n "$out" ]; then
  : > "$out"
fi

exit 0
