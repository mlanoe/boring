# ---- float16_dict_literal_width ----
# Regression test: untyped numeric literals in a dict literal adopt the width of the
# declared value type (`let {string=float16} d = {"k" = 2.5}`) or of a typed float
# value in the same literal (`{"a" = x, "b" = 2.0}` with `float16 x`).
def run_float16_dict_literal_width():
    let {string=float16} d = {"k" = 2.5, "j" = 1}
    print "{d["k"] as float64} {d["j"] as float64}"
    let float16 x = 1.5
    let m = {"a" = x, "b" = 2.0}
    print "{m["a"] + m["b"]}"
    var float16 total = 0.0
    for k in ["a", "b"]:
        total += m[k]
    print "{total as float64}"

# ---- float32_dict_literal_width ----
# Regression test: untyped numeric literals in a dict literal adopt the width of the
# declared value type (`let {string=float32} d = {"k" = 2.5}`) or of a typed float
# value in the same literal (`{"a" = x, "b" = 2.0}` with `float32 x`).
def run_float32_dict_literal_width():
    let {string=float32} d = {"k" = 2.5, "j" = 1}
    print "{d["k"] as float64} {d["j"] as float64}"
    let float32 x = 1.5
    let m = {"a" = x, "b" = 2.0}
    print "{m["a"] + m["b"]}"
    var float32 total = 0.0
    for k in ["a", "b"]:
        total += m[k]
    print "{total as float64}"

# ---- float64_dict_literal_width ----
# Regression test: untyped numeric literals in a dict literal adopt the width of the
# declared value type (`let {string=float64} d = {"k" = 2.5}`) or of a typed float
# value in the same literal (`{"a" = x, "b" = 2.0}` with `float64 x`).
def run_float64_dict_literal_width():
    let {string=float64} d = {"k" = 2.5, "j" = 1}
    print "{d["k"] as float64} {d["j"] as float64}"
    let float64 x = 1.5
    let m = {"a" = x, "b" = 2.0}
    print "{m["a"] + m["b"]}"
    var float64 total = 0.0
    for k in ["a", "b"]:
        total += m[k]
    print "{total as float64}"

# ---- float16_array_annotated_literal ----
# Regression test: untyped numeric literals (incl. bare ints) in an array literal with a
# declared float element type adopt that width: `let [float16] a = [1.5, 2]`.
def run_float16_array_annotated_literal():
    let [float16] a = [1.5, 2.0, 3]
    print "{a[0] as float64} {a[1] as float64} {a[2] as float64}"
    let [float32] b = [1, 2, -3]
    print "{b[0] as float64} {b[2] as float64}"
    let [float64] c = [1, 2.5]
    print "{c[0]} {c[1]}"

def main() throws:
    print "== float16_dict_literal_width =="
    run_float16_dict_literal_width()
    print "== float32_dict_literal_width =="
    run_float32_dict_literal_width()
    print "== float64_dict_literal_width =="
    run_float64_dict_literal_width()
    print "== float16_array_annotated_literal =="
    run_float16_array_annotated_literal()
