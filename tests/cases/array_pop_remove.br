# array.pop() and array.remove() — write-back and return value

var arr = [1, 2, 3]
let v = arr.pop()
print v        # expected 3
print arr      # expected [1, 2]

# pop as statement (discard return value)
arr.pop()
print arr      # expected [1]

# remove returns the removed element
var arr2 = [10, 20, 30, 40]
let r = arr2.remove(1)
print r        # expected 20
print arr2     # expected [10, 30, 40]

# remove with negative index
let r2 = arr2.remove(-1)
print r2       # expected 40
print arr2     # expected [10, 30]

# remove as statement
arr2.remove(0)
print arr2     # expected [30]
