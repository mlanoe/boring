struct P:
    int id
    var mut {string=string} props = {=}

def P mk():
    mut p = P(id = 1)
    p.props["value"] = "v"
    p

def [P] all():
    [mk()]

def P nth(int n):
    let a = all()
    a[n]

print(mk().props["value"] else (""))
print(nth(0).props["value"] else (""))
print(nth(0).props["zzz"] else ("none"))
