def int width(string t):
    t.length

def main():
    let s = "héllo…😀é"
    print(s.length)
    print("é".length)
    print(width(s))
    print(s.chars().length)
    print(s.isEmpty())
    let int? i1 = s.indexOf("…")
    let int? i2 = s.indexOf("é")
    let int? i3 = s.indexOf("😀")
    print(i1)
    print(i2)
    print(i3)
    print(s.slice(1, 3))
    print(s[1..<3])
    print(s[5])
    print(s.startsWith("hé"))
    print(s.split("l").length)
    let n = s.length
    print(s[0..<n])
    # other receiver shapes: len(), struct field, call result, concatenation, trim chain
    print(len(s))
    let b = Box(label = s)
    print(b.label.length)
    print(b.size())
    print(name().length)
    let t = (s + "é").length
    print(t)
    print(s.trim().length)
    print("日本語".length)
    var total = 0
    for i in 0..<s.length:
        total += 1
    print(total)

struct Box:
    string label
    req int size():
        label.length

def string name():
    "ñandú"
