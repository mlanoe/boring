# ---- actor_guard_scalar_mutation ----
# Regression test: a scalar (no-fields) local qualified `'actor`/`'guard` used to
# never route its own bare-`Var` read/write through the lock — only a struct-typed
# `'actor`/`'guard` binding was ever exercised in practice, where every mutation goes
# through a field write or a `def` method call (both already routed through the lock
# — see `emit_expr_assign`'s `Field`-target branches). A scalar binding has no fields,
# so every mutation *is* a bare-`Var`-target read/write, which fell through to a plain
# Rust read/assignment on the `Arc<Mutex<T>>`/`Arc<RwLock<T>>` handle itself — invalid
# Rust (no `Display`/`AddAssign`/plain-assign on the handle type). See
# `src/transpiler/mod.rs`'s `var_lock_scalar` doc comment for the fix.
#
# Covers: `'actor` (int) and `'guard` (bool, float) scalars; a bare compound
# assignment and a plain assignment; both outside and inside a `with` block (which
# shadows the binding to the already-acquired guard for the block's duration — a
# separate codegen path, see `emit_stmt.rs`'s `emit_with`).
def run_actor_guard_scalar_mutation():
    var counter'actor = 0
    counter += 5
    counter -= 2
    print "{counter}"

    with counter:
        counter += 100
    print "{counter}"

    var flag'guard = false
    flag = true
    print "{flag}"

    with flag:
        flag = false
    print "{flag}"

    var total'guard = 1.5
    total += 2.5
    print "{total}"

# ---- actor_field_method_outer_var ----
# Regression test: calling a method on a struct field through a plain outer LOCAL
# VARIABLE (not `self`) used to mis-transpile `outer_var.field.method(args)` into
# `outer_var.field.clone().method(args)` instead of routing through the lock/borrow
# guard (`.lock().unwrap()` multi-thread, `.borrow_mut()` single-thread) — a real
# E0599 ("no method named `inc` found for struct `Arc<Mutex<Counter>>`"), since
# `.clone()` on the Arc/Rc handle just produces another handle, never the inner value.
#
# `self.field.method()` (inside the owning struct's own methods) already routed
# through the lock correctly via a dedicated self-scoped branch in
# `try_emit_mutex_method` — this fixture exercises the sibling `outer_var.field...`
# shape (`try_emit_actor_field_method`'s first branch), which was declared but never
# actually fired: the field's stored type is `Type::Mut(Qualified(_, Actor))` (fields
# need their own `mut`/`var mut` permission to allow `def` calls at all), not a bare
# `Type::Qualified(_, Actor)`, so the `is_actor_field` check always missed and the call
# fell through to the generic fallback's `.clone()`-producing path instead.
struct ActorFieldMethodOuterVarCounter:
    var int value = 0
    def inc(): value += 1
    req int get(): value

struct ActorFieldMethodOuterVarHolder:
    mut ActorFieldMethodOuterVarCounter'actor c = ActorFieldMethodOuterVarCounter()

def run_actor_field_method_outer_var():
    mut h = ActorFieldMethodOuterVarHolder()
    h.c.inc()
    h.c.inc()
    h.c.inc()
    print "{h.c.get()}"

def main() throws:
    print "== actor_guard_scalar_mutation =="
    run_actor_guard_scalar_mutation()
    print "== actor_field_method_outer_var =="
    run_actor_field_method_outer_var()
