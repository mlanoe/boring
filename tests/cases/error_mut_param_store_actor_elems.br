# An element of a plain `[T]` member cannot alias the caller's value (only `[T'actor]` elements can, see
# mut_param_store_actor_infer_elems): still rejected.
struct ElemPoint:
    var float x

struct ElemHolder:
    var [ElemPoint] all = []

    def add(mut ElemPoint p):
        all.push(p)

def main():
    mut p = ElemPoint(1.0)
    mut h = ElemHolder()
    h.add(p)
