# Calling an optional function-typed field's unwrapped handle INSIDE a struct method, where the
# field is read as a bare implicit-self name (`if let f = make`) rather than `s.make`.
use MakeInt as def int()

struct S:
    MakeInt? make = nil
    req int viaIfLet():
        if let f = make:
            return f()
        0
    req int viaIfLetNoReturn():
        if let f = make:
            let r = f()
            return r
        0
    req int viaGuard():
        guard let f = make else:
            return 0
        f()
    req int viaNilCheck():
        if make != nil:
            return make()
        0

def main():
    let a = S(make = ():
        7)
    print a.viaIfLet()
    print S().viaIfLet()
    print a.viaIfLetNoReturn()
    print S().viaIfLetNoReturn()
    print a.viaGuard()
    print S().viaGuard()
    print a.viaNilCheck()
    print S().viaNilCheck()
