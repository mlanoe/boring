# A `mut` parameter stored by bare name into a `T'actor` member is inferred `'actor`: the member and
# the caller's variable are the same object, in `boring run` and `boring build` alike. The caller's
# variable becomes `'actor` too; every other use of it (a `mut` parameter that is not stored, a field
# write) keeps working through the lock.
struct InferPoint:
    var float x
    var float y

struct InferHolder:
    var InferPoint'actor kept = InferPoint(0.0, 0.0)
    var InferPoint'actor other = InferPoint(0.0, 0.0)

    def keep(mut InferPoint p):
        kept = p

    def keepSelf(mut InferPoint p):
        self.other = p

    def bump(mut InferPoint p):
        p.x += 1.0

def main():
    mut p = InferPoint(1.0, 2.0)
    mut h = InferHolder()
    h.keep(p)
    h.keepSelf(p)
    p.x = 9.0
    print h.kept.x
    print h.other.x
    h.kept.y = 7.0
    print p.y
    h.bump(p)
    print h.kept.x
    mut q = InferPoint(5.0, 6.0)
    h.keep(q)
    q.x = 8.0
    print h.kept.x
    print p.x
