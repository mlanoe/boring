# Bare-trait params of free functions are inferred borrowed (`&dyn Trait`) unless the body
# consumes them; a borrowed arg can then be reused after the call.
trait Builder:
    req int build(int x)

struct Four as Builder:
    req int build(int x): x + 4

struct Two as Builder:
    req int build(int x): x + 2

# receiver-only -> borrowed
int leaf(Builder b, int n):
    b.build(n)

# forwards to a borrowed param -> borrowed (3 deep)
int mid(Builder b):
    leaf(b, 1) + leaf(b, 2)

int top(Builder b):
    mid(b) + mid(b)

# mutual recursion with no consumer stays borrowed
int ping(Builder b, int n):
    if n <= 0:
        return b.build(0)
    pong(b, n - 1)

int pong(Builder b, int n):
    ping(b, n)

# forwards to an explicit `Trait&`
int viaExplicit(Builder& b):
    leaf(b, 5)

int fwdExplicit(Builder b):
    viaExplicit(b)

# consumed: stored in a struct field -> stays by value
struct Holder:
    Builder b

Holder store(Builder b):
    Holder(b)

# consumed: captured by a closure
int viaClosure(Builder b):
    let f = (n):
        b.build(n)
    f(7)

# consumed: forwarded to a by-value param
int viaStore(Builder b):
    let h = store(b)
    h.b.build(1)

# arg produced by a call -> that position stays by value (call-site guard)
Builder make():
    Four()

int takesMade(Builder b):
    b.build(100)

def main():
    let Builder local = Four()
    print leaf(local, 1)
    print leaf(local, 2)
    print leaf(Two(), 3)
    print top(local)
    print top(Two())
    print ping(local, 3)
    print fwdExplicit(local)
    print fwdExplicit(Two())
    let h = store(Two())
    print h.b.build(1)
    print viaClosure(Two())
    print viaStore(Four())
    print takesMade(make())
    print leaf(h.b, 9)
