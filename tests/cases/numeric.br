def i32 add_i32(i32 x, i32 y):
    return x + y
print add_i32(10, 32)

def u64 double_u64(u64 x):
    return x * 2
print double_u64(21)

def f32 half_f32(f32 x):
    return x / 2.0
print half_f32(3.14)

let usize nu = 10
let usize ru = nu + 5
print ru

let isize ni = -10
let isize ri = ni + 5
print ri

let i8 a = 1
let i16 b = 2
let i32 c = 3
let i64 d = 4
let isize e = 5
let sum_i = (a as int) + (b as int) + (c as int) + (d as int) + e
print sum_i

let u8 ua = 1
let u16 ub = 2
let u32 uc = 3
let u64 ud = 4
let usize ue = 5
let sum_u = (ua as uint) + (ub as uint) + (uc as uint) + (ud as uint) + ue
print sum_u

let int xint = 42
print xint + 1

let string sname = "Alice"
print "Hello, " + sname

# Regression: unary `-` on each fixed-width *signed* integer type — the
# self-hosted interpreter's UnaryOp.Neg only handled bare Int/Float64/Float32/
# Object and threw "cannot negate" for int8/int16/int32/int64/int128.
let int8 n8 = 5
let int8 neg8 = -n8
print neg8
let int16 n16 = 5
let int16 neg16 = -n16
print neg16
let int32 n32 = 5
let int32 neg32 = -n32
print neg32
let int64 n64 = 5
let int64 neg64 = -n64
print neg64
let int128 n128 = 5
let int128 neg128 = -n128
print neg128
