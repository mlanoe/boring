enum Al:
    Leading
    Center

struct C:
    [string] kids
    int n = 3

struct D:
    int n = 3
    float? f = nil
    [string] kids

struct E:
    Al a = Al.Center
    string s = "hi"
    [int] xs = [1, 2]
    int k

struct S:
    int v = 7

def main():
    let c = C(kids = ["a"])
    print c.n
    let c2 = C(["b"])
    print c2.n
    let d = D(f = 1.0, kids = ["a"])
    print d.n
    let d2 = D(kids = ["z"])
    print d2.n
    let e = E(k = 5)
    print e.s
    print e.xs[1]
    print e.k
    let s = S()
    print s.v
