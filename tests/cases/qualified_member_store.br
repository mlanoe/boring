struct Point:
    var float x
    var float y

struct Holder:
    var [Point'shared] shArr = []
    var [Point'actor] acArr = []
    var [Point'owned] owArr = []
    var Point'owned owOne = Point(0.0, 0.0)
    var Point'shared shOne = Point(0.0, 0.0)
    var {string = Point'shared} shDict = {=}
    var {string = Point'actor} acDict = {=}
    var {string = Point'owned} owDict = {=}

    def pushSh(Point p):
        shArr.push(p)
    def pushAc(Point p):
        acArr.push(p)
    def pushOw(Point p):
        owArr.push(p)
    def setOw(Point p):
        owOne = p
    def setSh(Point p):
        shOne = p
    def putSh(Point p):
        shDict["a"] = p
    def putAc(Point p):
        acDict["a"] = p
    def putOw(Point p):
        owDict["a"] = p
    def setShDict(Point p):
        shDict.set("b", p)

def main():
    mut p = Point(1.0, 2.0)
    mut h = Holder()
    h.pushSh(p)
    h.pushAc(p)
    h.pushOw(p)
    h.setOw(p)
    h.setSh(p)
    h.putSh(p)
    h.putAc(p)
    h.putOw(p)
    h.setShDict(p)
    p.x = 9.0
    print h.shArr[0].x
    print h.shOne.x
    let Point'shared s = Point(5.0, 6.0)
    h.shOne = s
    h.shArr.push(s)
    print h.shOne.y
    print h.shArr[1].y
    print h.shDict["a"].x
    print h.shDict["b"].x
    h.shDict["c"] = s
    print h.shDict["c"].y
