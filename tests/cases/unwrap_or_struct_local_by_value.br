struct Handle:
    int id

struct Rt:
    var int n = 0
    def Handle? handle(int id):
        Handle(id)
    def bool write(Handle h, int v):
        n += v
        true

def main():
    mut b = Rt()
    let hr = b.handle(2).unwrap_or(Handle(-1))
    _ = b.write(hr, 1)
    _ = b.write(hr, 2)
    print "{b.n}"
