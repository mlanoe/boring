# docs/self-field-loop-match-borrow-bug.md -- a `for`/`match` directly over a
# bare struct field (implicit `self.field`, no explicit `self.` prefix) inside
# a `req`/`def` method generated Rust that tried to *consume* the field even
# though the method only holds a borrowed `&self`/`&mut self`:
#   - `for s in items:` over a `[T]` field emitted `self.items.into_iter()`
#     (E0507: moves out of a shared reference).
#   - `match status:` over an enum field bound arms by value out of the same
#     borrow (same E0507 shape).
#   - `for k, v in scores:` over a `{K=V}` field mis-transpiled through the
#     array-style auto-enumerate path (`.enumerate().map(|(i, v)| (i as isize,
#     v))`), binding the loop var to the whole `(k, v)` pair instead of just
#     the value.
# All three read a field only through a `req` (`&self`) method -- never moved,
# never reassigned -- so the field must still be usable afterward.
#
# Repro 2b (`counts` field + `bump_highest` method below): repro 2's exact
# shape still mis-transpiled the same way when the dict field is
# content-mutable (`var mut {K=V}`, not a plain `{K=V}`) *and* the loop lives
# inside one of that struct's own `def` (mutating) methods -- the real-world
# case that surfaced it (`scratch-boring`'s `LayerOrders.go_to_front`, a
# `Resource` struct managing its own `var mut {string=int}` field). Root
# cause: `iterable_yields_tuples`'s dict-shape check matched a bare
# `Type::Dict`, but a content-mutable field resolves as `Type::Mut(Dict(K,
# V))` -- the wrapper was never stripped before the match, so the check
# reported "not tuple-shaped" and `needs_auto_enumerate` wrongly re-wrapped
# the (already-correct, elsewhere) `.clone().into_iter()` base in
# `.enumerate().map(|(i, v)| (i as isize, v))`, binding the value loop
# variable to the whole `(id, v)` pair instead of just the value -- same
# broken shape as repro 2, different trigger. Confirmed via `cargo build`
# (E0308: expected `(Arc<str>, isize)`, found integer) before the fix.

enum Status:
    Active
    Inactive

struct Bag:
    [string] items
    Status status
    {string=int} scores
    var mut {string=int} counts

    # Repro 1: `for` loop consuming a borrowed `[T]` field.
    req string? first_match(string needle):
        for s in items:
            if s == needle:
                return s
        nil

    # Match over a borrowed enum field.
    req string describe():
        match status:
            Active: "on"
            Inactive: "off"

    # Repro 2: `{K=V}` field, 2-variable destructuring. Plain `int` accumulator
    # (not `int?`) -- an `int` vs. `int?` comparison is a separate, unrelated
    # gap; this test is only about the destructuring/borrow codegen.
    req int highest():
        var int best = 0
        for id, score in scores:
            if score > best:
                best = score
        best

    # Repro 2b: same 2-var destructuring as `highest()` above, but the field
    # is content-mutable (`var mut`) and this is a `def` (mutating) method
    # that both reads the key (to exclude it from the scan) and writes the
    # field back afterward -- the exact shape of `LayerOrders.go_to_front`.
    def bump_highest(string exclude_id):
        var max_order = 0
        var found = false
        for id, v in counts:
            if id != exclude_id:
                if !found or v > max_order:
                    max_order = v
                    found = true
        counts[exclude_id] = max_order + 1

def main():
    mut bag = Bag(["apple", "banana", "cherry"], Status.Active, {"a" = 3, "b" = 7, "c" = 1}, {"a" = 3, "b" = 7})

    match bag.first_match("banana"):
        Some(x): print "first_match: {x}"
        None: print "first_match: nil"

    match bag.first_match("mango"):
        Some(x): print "first_match: {x}"
        None: print "first_match: nil"

    print "describe: {bag.describe()}"

    print "highest: {bag.highest()}"

    bag.bump_highest("a")
    let bumped = bag.counts["a"] else -1
    print "bump_highest a: {bumped}"

    # The field itself must still be intact after all three borrow-only calls.
    print "items.length: {bag.items.length}"
