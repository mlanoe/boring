# A function returning its own bare-trait parameter (`Box<dyn Trait>`) must move
# the box (tail expression and explicit `return`), not `.clone()` it, and the
# bare-trait return type is `Box<dyn Trait>` (docs/book.md "Traits as types").
trait Builder:
    req int build(int x)

struct Four as Builder:
    req int build(int x): x + 4

struct Ten as Builder:
    req int build(int x): x + 10

Builder ident(Builder b):
    b

Builder pick(Builder b, bool early):
    if early:
        return b
    Ten()

Builder make():
    Four()

def main():
    print ident(Four()).build(2)
    print pick(Four(), true).build(1)
    print pick(Four(), false).build(1)
    print make().build(5)
