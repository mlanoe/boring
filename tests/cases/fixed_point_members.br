print "{(2.5 as fixed16_16).round()} {(-2.5 as fixed16_16).round()}"
print "{x.min(1.0)} {x.max(2)} {x.clamp(0.0, 1.5)}"
let u = 3.5 as ufixed8_8
print "{u.raw} {u.floor()} {u.round()}"
