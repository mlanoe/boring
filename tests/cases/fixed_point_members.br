let x = 1.75 as fixed16_16
print "raw {x.raw} {x.raw as int}"
print "fromRaw {fixed16_16.fromRaw(0x1_C000)}"
print "consts {fixed16_16.epsilon} {fixed8_8.min} {fixed8_8.max} {ufixed8_8.max}"
let n = -1.25 as fixed16_16
