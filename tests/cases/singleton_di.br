struct Counter:
    var int value = 0
    def inc():
        value += 1

# `@singleton` (docs/design-notes/boring-di-draft.md §4): memoizes the function's
# result behind a compiler-synthesized LazyLock — the body runs at most once, and
# every call thereafter clones out the same shared instance. Bare constructor-call
# tail expression, matching the design doc's own @provide examples verbatim (this
# used to need a local-`'actor`-binding workaround — task_b8f97224 fixed the
# underlying gap, wrapping a bare constructor return to match a qualified return
# type, unrelated to @singleton itself).
@singleton
Counter'actor makeCounter():
    print "constructing counter"
    Counter(0)

def main():
    let c1 = makeCounter()
    c1.inc()
    let c2 = makeCounter()
    c2.inc()
    # Read one at a time -- c1/c2 alias the same underlying `'actor` cell (that's
    # the whole point of this test), and `std::sync::Mutex` isn't reentrant: locking
    # both inside one `print` interpolation would try to lock the same mutex twice
    # in the same statement and deadlock.
    let v1 = c1.value
    let v2 = c2.value
    print "c1={v1} c2={v2}"
