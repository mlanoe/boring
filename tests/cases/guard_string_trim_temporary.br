# `slot.value.trim()` on a locked `Slot<string>'actor` must own the trimmed text: borrowing it
# straight from the lock-guard temporary dies at the end of the `let` statement (E0716).
struct Slot<T>:
    var T value

struct Form:
    Slot<string>'actor title

def submit(mut Form f):
    let clean = f.title.value.trim()
    if clean.length == 0:
        print "empty"
        return
    print "got [{clean}]"

def main():
    mut f = Form(title = Slot(value = "  hi  "))
    submit(f)
    mut g = Form(title = Slot(value = "   "))
    submit(g)
