int sum((int, int) t):
    t.0 + t.1

fixed16_16 first((fixed16_16, int) t):
    t.0

(int, int) swap((int, int) t):
    (t.1, t.0)

def main():
    let (int, int) t = (1, 3)
    print "t = {t.0},{t.1}"
    print "sum = {sum(t)}"
    let (fixed16_16, int) f = (0.75, 3)
    print "first = {first(f)}"
    print "lit = {first((0.75, 3))}"
    let (a, b) = (5, 6)
    print "destructure = {a + b}"
    let (x, y) = swap(t)
    print "swap = {x},{y}"
