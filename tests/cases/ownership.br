struct ATree:
    init(pub int value)

use ANode as ATree'shared

def int read2(ANode& n):
    n.value

let an = ANode(99)
print read2(an)

struct MCounter:
    init(pub var int n)

def void increment(var MCounter& c):
    c.n = c.n + 1

var mc = MCounter(0)
increment(mc)
increment(mc)
print mc.n

struct MPoint:
    init(pub var int x, pub var int y)

var mp = MPoint(3, 4)
var mut MPoint& refp = mp
refp.x = 10
print mp.x

struct MVal:
    init(pub var int n)

def void copy_into(MVal& src, var MVal& dst):
    dst.n = src.n

var ma = MVal(42)
var mb = MVal(0)
copy_into(ma, mb)
print mb.n
