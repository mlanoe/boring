struct OBox:
    init(pub int val)

let ob1 = OBox(val = 42)
let ob2 = ob1
print ob2.val

struct ODog:
    init(pub string name)

let od1 = ODog(name = "Rex")
let od2 = od1
print od2.name

struct OPoint:
    init(pub var int x, pub var int y)

let op1 = OPoint(x = 1, y = 2)
mut op2 = op1
op2.x = 10
print op2.x

struct OToken:
    init(pub int id)

def int transfer():
    let a2 = OToken(id = 7)
    let b2 = a2
    return b2.id

print transfer()

let copya = 99
let copyb = copya
print copya
print copyb

struct WDog:
    init(pub string name)

def WDog'shared'weak get_weak(WDog'shared d):
    let WDog'shared'weak w = d
    w

let WDog'shared wd = WDog(name = "Rex")
let ww = get_weak(wd)
print "weak-sig-ok"

struct WNode:
    init(pub int val)

let WNode'shared strong = WNode(val = 42)
let WNode'shared'weak weakn = strong
let upgraded = weakn.upgrade()
print upgraded.val

let wa'shared = WDog(name = "Rex")
let wb'weak = wa
let wup = wb.upgrade()
print wup.name

struct WDog2:
    init(pub int age)

let wc'shared = WDog2(age = 5)
let wd2'weak = wc
let wupg = wd2.upgrade()
print wupg.age

let WDog'shared strong2 = WDog(name = "Buddy")
let WDog'shared'weak  w2 = strong2
let upgr2 = w2.upgrade()
print upgr2.name

def int clamp(int x, int lo, int hi):
    var result = x
    if result < lo: result = lo
    if result > hi: result = hi
    return result

print clamp(5, 0, 10)
print clamp(-3, 0, 10)
print clamp(42, 0, 10)

let [int]'shared items = [1, 2, 3]
let fsync = task: items.len()
print fsync.value


struct OCounter:
    init(int n)

def int peek1(OCounter'shared c):
    c.n

let OCounter'shared obj1 = OCounter(10)
print peek1(obj1)

def int peek2(OCounter'shared c):
    c.n

let OCounter'shared obj2 = OCounter(7)
print peek2(obj2)

struct OBoxB:
    init(int value)

def OBoxB& identity(OBoxB& b):
    b

let OBoxB'shared ob_b = OBoxB(99)
print identity(ob_b).value

struct OItem:
    init(int v)

let OItem'shared raw = OItem(55)
let OItem'shared x = raw
print x.v

def int peek3(OCounter'shared c):
    c.n
print peek3(obj1)

def int peek4(OCounter'shared c):
    c.n
print peek4(obj2)

struct OTree:
    init(int value)

use ONode as OTree'shared

def int readt(ONode& n):
    n.value

let ONode root = OTree(42)
print readt(root)

def OBoxB& identity2(OBoxB& b):
    b

let OBoxB'shared ob_b2 = OBoxB(99)
print identity2(ob_b2).value

struct OPointB:
    init(pub int x, pub int y)

def int sum_o(OPointB p):
    p.x + p.y

let op = OPointB(3, 4)
print sum_o(op)

def int sum_or(OPointB& p):
    p.x + p.y
print sum_or(op)

struct OCounterB:
    init(pub int n)

let OCounterB cc = OCounterB(42)
print cc.n

struct OItemB:
    init(pub int v)

def int read_stack(OItemB i): i.v
def int read_borrow(OItemB& i): i.v
def int read_heap(OItemB'new i): i.v

let OItemB ii = OItemB(10)
print read_stack(ii) + read_borrow(ii) + read_heap(ii)

struct ADog:
    init(pub string name)

use ADog2 as ADog'stack
let ad = ADog2("rex")
print ad.name

