# Function-typed struct fields spelled as collections / inline-optional, through a `use` alias:
# `[Seed]` -> Vec<handle>, `{string=Seed}` -> HashMap<K, handle>, `(def int())?` -> Option<handle>
# (a parenthesized fn type is grouping, not a 1-tuple). Dict literals use `=`, never `:`.
use Seed as def int()

struct T:
    mut [Seed] many
    {string=Seed} named
    (def int())? inl = nil

def main():
    mut t = T(many = [(): 1, (): 2], named = {"a" = (): 7})
    t.many.push((): 3)
    print t.many.len()
    for f in t.many:
        print f()
    print t.many[0]()
    print t.many[2]()
    if let g = t.named["a"]:
        print g()
    if let h = t.inl:
        print h()
    else:
        print "no inl"
    let u = T(many = [], named = {=}, inl = (): 5)
    if let h = u.inl:
        print h()
