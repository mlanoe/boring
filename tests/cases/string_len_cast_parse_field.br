# `(s.length as float)` must be a numeric `as f64` cast (not a string `.trim().parse()`), and
# `parseFloat`/`parseInt` must work on any string expression — params, struct fields — plus
# string literals against `Arc<str>` in `assert_eq` / `join`.
struct P:
    var string txt = ""
    var [string] names = []

def float? conv(string s):
    return s.parseFloat()

def int? toint(string s):
    return s.parseInt()

def float lenf(string s):
    return (s.length as float) * 2.0

def string sep([string] parts, string d):
    return parts.join(d)

def main():
    let s = "hello"
    let w = (s.length as float) * 2.0
    print w
    let p = P(txt = "2.5", names = ["7", "y"])
    print (conv("1.5") else (0.0))
    print (conv("zz") else (-1.0))
    print (toint(p.names[0]) else (-1))
    print (p.txt.parseFloat() else (0.0))
    print (p.names[0].parseInt() else (0))
    print lenf(p.txt)
    print (p.txt.length as float)
    let arr = ["a", "b"]
    print arr.join("|")
    print p.names.join(",")
    print sep(arr, "-")
    assert_eq(arr[0], "a")
    assert_eq(p.names[1], "y")
    assert_eq(arr.join("+"), "a+b")
    assert_eq(p.txt, "2.5")
    assert(arr[0] == "a", "eq")
    assert(arr.join("|") == "a|b", "joined")
