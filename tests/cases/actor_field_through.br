pub struct Slot<T>:
    pub var mut T value

struct Profile:
    var string name = ""
    def rename(string n):
        name = n

struct ParentState:
    pub var mut Slot<string>'actor name = Slot(value = "a")
    pub var mut Slot<Profile>'actor profile = Slot(value = Profile())

struct Child:
    var mut Slot<string>'actor __bind_name
    var mut Slot<Profile>'actor __bind_profile
    req string read():
        __bind_name.value
    req void write(string s):
        __bind_name.value = s
        __bind_profile.value.rename(s)

def main():
    mut st = ParentState()
    let c = Child(__bind_name = st.name, __bind_profile = st.profile)
    c.write("z")
    print st.name.value
    print c.read()
    print st.profile.value.name
