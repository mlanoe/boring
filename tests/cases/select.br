# select: statement — tokio::select! wrapper
task run_select():
    let tx, rx = channel<string>(4)

    task:
        tx.send("hello")
        tx.send("world")
        drop(tx)

    loop:
        select:
            msg = rx.recv():
                print msg
                if msg == "world": break
            after Duration.from_millis(100):
                print "timeout"
                break

task sleep_forever():
    wait Duration.from_secs(999999)

task run_after():
    select:
        _ = sleep_forever():
            print "done"
        after Duration.from_millis(100):
            print "timed out"

let t1 = task run_select()
t1.value
let t2 = task run_after()
t2.value
