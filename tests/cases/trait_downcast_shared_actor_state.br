# Typed view state behind a `'shared` trait object: a struct holding an `'actor` handle is
# recovered with `as ... else (default)`, and the `'actor` field is lent to a `mut ...'actor`
# parameter. The downcast clones the struct, but the clone's `'actor` field is an `Arc`/`Rc`
# clone, so mutations through the clone are visible through the original.

trait StateBox:
    pass

struct NoState as StateBox:
    pass

struct Cell as StateBox:
    var mut Counter'actor st = Counter()

struct Counter:
    var int n = 0

struct Owner:
    req int bump(StateBox'shared box):
        let cell = box as Cell else (Cell())
        self.add(cell.st)
        self.add(cell.st)
        cell.st.n
    req void add(mut Counter'actor c):
        c.n += 1

def main():
    let StateBox'shared b = Cell()
    let owner = Owner()
    print owner.bump(b)
    print owner.bump(b)
    # a different implementor takes the `else` default: a fresh Cell, not shared with `b`
    let StateBox'shared other = NoState()
    print owner.bump(other)
    print owner.bump(other)
