# [f(x) for x in collection] — iter comprehension

# basic map over ints
let [int] nums = [1, 2, 3, 4, 5]
let [int] doubled = [x * 2 for x in nums]
print doubled

# expression with multiple ops
let [int] squares = [x * x for x in nums]
print squares

# map over result of another comprehension
let [int] evens = [i * 2 for i in ..5]
let [int] evens_sq = [x * x for x in evens]
print evens_sq

# map over struct fields
struct Point:
    int x
    int y

int manhattan(Point p):
    p.x + p.y

let [Point] points = [Point(1, 2), Point(3, 4), Point(5, 6)]
let [int] dists = [manhattan(p) for p in points]
print dists

# chained — double then add 1
let [int] a = [1, 2, 3]
let [int] b = [x * 2 for x in a]
let [int] c = [x + 1 for x in b]
print c
