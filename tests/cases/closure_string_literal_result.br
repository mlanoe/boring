# A string literal (or interpolation) that is a closure's result — or the initializer of a
# typed `let` inside a block-bodied closure — is a `string` (Arc/Rc<str>), not a Rust `&str`.
use Seed as def string()

struct S:
    Seed make

def main():
    let s = S(make = (): "Ada")
    print s.make()
    let n = 3
    let g = (): "n={n}"
    print g()
    let f = ():
        let string v = "Bob"
        let [int] xs = []
        v
    print f()
