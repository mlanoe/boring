# Regression test: `return if cond: a else: b` (an inline `if`/`else` expression
# as the operand of `return`) used to fail with "expected newline, got Dedent".
# The inline form's body parsing already consumes the statement's trailing
# newline, which `return`'s strict newline check then did not find; `return`
# (and `throw`) now use the soft newline check, same as a `let` initializer.
def string inline_form(string k):
    return if k == "a": "x" else: "y"

def string block_form(int n):
    return if n > 0:
        "pos"
    elif n < 0:
        "neg"
    else:
        "zero"

def int nested(int n):
    if n > 100:
        return if n > 200: 2 else: 1
    return 0

def main():
    print inline_form("a")
    print inline_form("b")
    print block_form(5)
    print block_form(-5)
    print block_form(0)
    print nested(300)
    print nested(150)
    print nested(1)
