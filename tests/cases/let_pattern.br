# if let Some(x) — happy path
let int? maybe = 42
if let Some(v) = maybe:
    print "got {v}"
else:
    print "none"

# nil path
let int? empty = nil
if let Some(v) = empty:
    print "got {v}"
else:
    print "none"

# combined let + bool guard
let int? x = 7
if let Some(n) = x, n > 5:
    print "big: {n}"

let int? y = 2
if let Some(n) = y, n > 5:
    print "big"
else:
    print "small"

# while let Some(x) using a function
def int? next(int counter):
    if counter <= 0: return nil
    let c = counter - 1
    return c + 1

var c = 3
while let Some(n) = next(c):
    print "tick {n}"
    c = c - 1

# Swift-style shorthand rebind: `if let v:` ≡ `if let v = v:`
let int? p = 99
if let p:
    print "p = {p}"
else:
    print "no p"

let int? q = nil
if let q:
    print "q = {q}"
else:
    print "no q"

# Shorthand with guard
def void greet(string? name):
    guard let name else:
        print "anonymous"
        return
    print "hello {name}"

greet("Alice")
greet(nil)

# Swift-style shorthand LOOP form: `while let v:` ≡ `while let v = v:`, with the
# body reassigning `v` to advance to the next value — this is book.md's own
# documented stdin-read-loop idiom, generalized here with a pure function
# instead of readLine() so the test stays deterministic. Regression test: this
# used to be rejected by the checker ("cannot assign to `tick`: declared as
# `let`") and, once that was worked around, failed to compile under
# `boring build` (Rust E0308 from the loop-bound `tick` shadowing the outer
# `Option`-typed `tick`).
def int? prevTick(int n):
    if n <= 0: return nil
    return n - 1

var tick = prevTick(4)
while let tick:
    print "self tick {tick}"
    tick = prevTick(tick)
print "self done"

# Regression: same self-shorthand LOOP form as above, but with a `break` in
# the body (not just a plain fall-through reassignment) — book.md's stdin
# "type empty line to quit" REPL idiom needs exactly this shape. This used to
# compile fine under `boring run` and even under `boring build` WITHOUT a
# `break`, but adding one produced Rust E0382 ("use of partially moved
# value") on the post-loop sync: the loop head's `while let Some(name) =
# outer` match moves `outer`'s contents into `name` every iteration, and the
# tail reassignment that normally refills `outer` never runs on the
# iteration that hits `break` — so `outer` was still in that iteration's
# moved-from state when the post-loop sync tried to read it back out.
var countdown = prevTick(5)
while let countdown:
    if countdown == 2:
        break
    print "counting {countdown}"
    countdown = prevTick(countdown)
if let Some(n) = countdown:
    print "countdown stopped at {n}"
else:
    print "countdown stopped at nil"

# Regression: `while let name:` self-referencing shorthand loop whose bound
# variable is a non-Copy value (string) reused 2+ times in the loop body,
# including once inside an `if`/`else` expression — e.g. pushed into a
# history array, then read again to encode. Found wiring boring-llm's
# KV-cache chat loop (`user_msgs.push(line); let t = if first_turn:
# tok.encode_chat(...) else: tok.encode_chat_turn(line)` inside a `while let
# line:` loop reading `readLine()`). `emit_while_let` never registered the
# loop-bound name's type at all (unlike an `if let`/`elif let` binding), so
# NEITHER later use site got `.clone()` inserted at `boring build` —
# `error[E0382]: use of moved value` at `cargo build`, even though the exact
# same reuse shape for an ordinary `let`-bound local already worked. Also
# covers the underlying gap that made the bug invisible outside `readLine()`
# itself: an unannotated `var x = someOptFn()` only tracked `x` in
# `optional_vars`, never in `var_types` — so nothing later unwrapping `x`
# (this loop included) could resolve its inner type either.
pub struct Tok:
    req string encode(string text):
        "<{text}>"

string? nextTok(int n):
    if n <= 0: return nil
    return "tok{n}"

let tok = Tok()
var [string] tokHistory = []
var n2 = 3
var word = nextTok(n2)
while let word:
    tokHistory.push(word)
    let tag = if tokHistory.len() == 1:
        tok.encode(word)
    else:
        tok.encode(word)
    print tag
    n2 = n2 - 1
    word = nextTok(n2)
print "history size: {tokHistory.len()}"

# Regression: `let x = <optional-expr> else <default>` binding — e.g.
# `readLine() else "default"` or `dict[key] else "fallback"` — reused 2+
# times, including once inside an `if`/`else` expression. Same underlying
# `string_vars` clone-tracking gap as the `while let`/`as string` bugs above
# and in tests/string_cast_let_reuse.rs, but a genuinely different trigger:
# `else` unconditionally unwraps the optional, so the binding's Rust type is
# the *default*'s type (never `Option<_>`), yet `track_let_metadata` never
# registered it in `string_vars` at all when the initializer was an
# `ExprKind::Else` — NEITHER `history.push(line)` nor either branch of the
# `if`/`else` got `.clone()` inserted, `error[E0382]: use of moved value` at
# `cargo build`, invisible from the Boring source itself. Found wiring
# boring-llm's KV-cache chat loop (`let line = readLine() else "default"`,
# reused via `history.push(line)` + `tok.encode_a/b(line)`). Covers both the
# `<T?-returning-call> else default` shape and the `dict[key] else default`
# shape (same `ExprKind::Else` AST node, same fix).
string? maybeGreeting(int n):
    if n <= 0: return nil
    return "hi{n}"

var [string] greetHistory = []
let greet1 = maybeGreeting(2) else "default"
greetHistory.push(greet1)
let encoded1 = if greetHistory.len() == 1:
    tok.encode(greet1)
else:
    tok.encode(greet1)
print encoded1

let greet2 = maybeGreeting(0) else "default"
greetHistory.push(greet2)
print greetHistory.len()

let {string=string} greetTable = {"a" = "yo"}
let greet3 = greetTable["a"] else "fallback"
greetHistory.push(greet3)
let encoded3 = if greetHistory.len() == 3:
    tok.encode(greet3)
else:
    tok.encode(greet3)
print encoded3

let greet4 = greetTable["missing"] else "fallback"
greetHistory.push(greet4)
print greetHistory.len()
