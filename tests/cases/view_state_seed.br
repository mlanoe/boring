# Parent-supplied state seeds: `Counter(count = 10)` seeds that identity's `state` at mount; a
# description without the argument keeps the declaration's default. (Laziness — the argument being
# evaluated once per mount and never on a rebuild — is checked in `view_state_seed_values`.) A
# string-literal seed is a closure returning a literal, which `boring build` must convert too.
use boring.ui.*

view Counter:
    string title
    state int count = 0
    state string label = "none"

    req int current():
        count

    req string tag():
        label

    body():
        Text("{title}{count}")

def int seedValue(int base):
    base * 2 + 1

def main():
    let plain = Counter(title = "a")
    let seeded = Counter(title = "b", count = seedValue(5), label = "custom")
    mut a = plain.seededState()
    mut b = seeded.seededState()
    print plain.current(a)
    print seeded.current(b)
    print plain.tag(a)
    print seeded.tag(b)
