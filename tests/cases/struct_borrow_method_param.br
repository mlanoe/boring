# Explicit `T&` / `mut T&` parameters of methods: the caller keeps ownership and passes a
# reference, whatever the receiver (struct, enum, trait object, 'actor value) and whatever the
# argument (local used twice, fresh value, field, forwarded borrowed parameter, implicit-self field).
struct Pt:
    var int x

struct Box2:
    Pt p

struct R:
    var int n = 0
    Pt own
    def int m(Pt& p):
        n += 1
        p.x
    def int fwd(Pt& p):
        self.m(p)
    req int peek(Pt& p):
        p.x
    req int viaField():
        self.peek(own)
    def int bump(mut Pt& p):
        p.x += 1
        p.x
    def int total([int]& xs):
        var s = 0
        for v in xs:
            s += v
        s

enum Shape:
    A
    B
    def int m(Pt& p):
        p.x * 2

trait Reader:
    req int read(Pt& p)

struct Doubler as Reader:
    req int read(Pt& p): p.x * 2

def main():
    mut r = R(own = Pt(9))
    let p = Pt(3)
    print r.m(p)
    print r.m(p)
    print r.m(Pt(4))
    print r.fwd(p)
    let b = Box2(Pt(5))
    print r.m(b.p)
    print r.viaField()
    var mut q = Pt(7)
    print r.bump(q)
    print q.x
    let xs = [1, 2, 3]
    print r.total(xs)
    print r.total(xs)
    let Shape e = Shape.A
    print e.m(p)
    print e.m(p)
    let Reader rd = Doubler()
    print rd.read(p)
    print rd.read(p)
