# Error fixture: a `mut` bare-trait parameter is lent; a body that consumes it is rejected.
trait Counter:
    req int peek()
    def int bump()

struct Cell as Counter:
    var int n = 0
    req int peek(): n
    def int bump():
        n += 1
        n

struct Holder:
    Counter c

int keep(mut Counter c):
    let h = Holder(c)
    h.c.peek()

def main():
    var mut Counter first = Cell()
    print keep(first)
