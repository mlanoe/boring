# Writes into function-typed collection fields after construction: index assignment and the
# insert/set/put/append mutators wrap each closure in the field's handle.
use Seed as def int()

struct T:
    mut {string=Seed} named
    mut [Seed] many

def main():
    mut t = T(named = {"a" = (): 7}, many = [(): 1, (): 2])
    t.named["b"] = (): 1
    t.named["a"] = (): 70
    t.many[0] = (): 9
    t.many.insert(1, (): 5)
    t.many.append([(): 11])
    t.named.set("d", (): 4)
    t.named.put("e", (): 6)
    for f in t.many:
        print f()
    for k in ["a", "b", "c", "d", "e"]:
        if let g = t.named[k]:
            print g()
