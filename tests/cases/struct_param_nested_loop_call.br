# A struct-typed loop variable passed on to a function taking a struct param is lent by
# reference (`&c`), including inside a nested `for` over that function's own result.
struct Placed:
    int id
    string kind
    [Placed] children

def [Placed] findAll(Placed p, string kind):
    mut [Placed] out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in findAll(c, kind):
            out.push(f)
    out

def main():
    let a = Placed(id = 3, kind = "b", children = [])
    let b = Placed(id = 2, kind = "a", children = [a])
    let root = Placed(id = 1, kind = "b", children = [b])
    for p in findAll(root, "b"):
        print p.id
    print findAll(root, "a").length
