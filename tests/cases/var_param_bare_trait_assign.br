trait Counter:
    req int peek()
    def int bump()

struct Cell as Counter:
    var int n = 0
    req int peek(): n
    def int bump():
        n += 1
        n

struct Step as Counter:
    var int n = 100
    req int peek(): n
    def int bump():
        n += 10
        n

Counter make():
    Step()

def viaVar(var Counter c):
    c = Cell()

def viaOther(var Counter c, Counter other):
    c = other

def viaCall(var Counter c):
    c = make()

def main():
    var mut Counter first = Cell()
    viaVar(first)
    print first.peek()
    var mut Counter second = Step()
    viaCall(first)
    print first.peek()
    viaVar(first)
    print first.bump()
    viaOther(second, first)
    print second.peek()
