# Regression test: unary `-`
# on an `int64`/`int128`-TAGGED value (i.e. one that actually went through an
# `as int64`/`as int128` cast, not just a bare literal handed to a typed
# param — a bare literal passed to a typed param can stay untagged and
# skip the buggy path entirely, which is why a naive repro doesn't always
# trigger it) used to fail with "cannot negate Int64"/"cannot negate Int128".
def show64(int64 v):
    let n = -v
    print n

def show128(int128 v):
    let n = -v
    print n

show64(-42 as int64)
show64(42 as int64)
show128(-42 as int128)
show128(42 as int128)
