# Behavioral test for the `'observed` composable ownership-qualifier suffix
# (docs/book.md's "'observed" section): construction + subscribe() + mutation +
# notification for each of the four legal compositions ('inline/'owned/'actor/
# 'guard'observed — 'shared'observed is a separate, checker-rejection test, see
# tests/observed_qualifier.rs). Mutation happens via a DIRECT method call
# (`a.inc()`, no `.value`) — 'actor/'guard already dispatch method calls
# transparently elsewhere in Boring (docs/book.md §21), and 'observed follows the
# same convention; `.value` is the explicit, silent escape hatch that skips
# notification even for a deliberate mutation (see the `e`/`e_val` case below).
# Also covers `Subscription`'s Drop genuinely unsubscribing, and multiple
# independent subscribers all firing on one write. Runs identically under all
# four mode/threading combinations.
#
# `subscribe()`'s callback takes exactly one parameter: a reference to the same
# observed struct being subscribed to, supplied fresh at each notification — every
# `.subscribe((obj): ...)` call site below exercises that shape, even where the
# body never actually reads `obj` (the `a`/`b`/`c`/`d`/`e`/`f`/`g` cases just bump
# an external counter, same as before this signature change). The `h`/`i` cases
# further down are the ones that specifically prove the fix: they read `.value`
# off the callback's own `obj` parameter instead of separately capturing the
# observed variable itself.
struct Counter:
    var int value = 0

    def inc():
        value += 1

    req int current():
        value

# ── Struct-field / parameter / return-type `'observed` support (this session's
# extension — see docs/book.md's "'observed" section, now covering fields,
# parameters and return types, not just local bindings). `self.field`-scoped
# dispatch only (a pre-existing gap in the analogous `'actor` case for an
# arbitrary `outer_var.field`, flagged separately in this session's report, means
# this doesn't yet generalize to that shape).
struct FormModel:
    var string name = ""

    def setName(string s):
        name = s

    req string getName():
        name

# `mut FormModel'actor'observed model = FormModel()` — declared and constructed
# entirely inline (no explicit `init`), same as any local `'observed` binding.
struct Container:
    mut FormModel'actor'observed model = FormModel()

    def mount():
        let sub = self.model.subscribe((obj):
            print "container saw {obj.value.getName()}"
        )
        self.model.setName("Ada")

    req string currentName():
        self.model.value.getName()

# `mut FormModel'observed model` — bare (no explicit base), defaulting to
# `'actor'observed` (docs/book.md's "'observed" section, "Qualifier inference for
# bare parameters/fields/returns" — a deliberately simpler default than the
# usage-based inference bare *local* bindings get, since a field/param/return has
# no single-body usage signal of its own to analyze).
struct BareContainer:
    mut FormModel'observed model = FormModel()

    def mount():
        let sub = self.model.subscribe((obj):
            print "bare-field saw {obj.value.getName()}"
        )
        self.model.setName("Zed")

# `init(FormModel'actor'observed model): self.model = model` — a struct's own
# constructor receiving an ALREADY-observed value from outside instead of only
# ever constructing one inline (the `@ObservedObject`-shaped case,
# docs/design-notes/boring-ui-draft.md's comparative table).
struct View:
    mut FormModel'actor'observed model

    init(FormModel'actor'observed model):
        self.model = model

    def mount():
        let sub = self.model.subscribe((obj):
            print "view saw {obj.value.getName()}"
        )
        self.model.setName("Bea")

# A function/method that constructs and hands back a fresh `'observed` value
# (docs/book.md's "'observed" section, return-type support) — forwarded directly
# into another function's matching `'observed` parameter (a known, documented
# scope limit: re-binding the return value into an explicitly re-annotated local
# double-wraps it instead of passing the already-observed value through — see
# this session's report — so this proves the feature via direct forwarding,
# the pattern that already works end to end).
def FormModel'actor'observed makeModel():
    FormModel()

def useModel(FormModel'actor'observed m):
    m.setName("FromParam")
    print "param saw {m.value.getName()}"

# A struct with an `'inline'observed` field must still get a correctly working
# auto-derived `Clone` (docs/book.md's "'observed" section — `BoringObserved<V>`
# itself has no derive at all pre-existing this session's fix; every struct with
# ANY `'observed` field of ANY base broke `Clone`/`Debug`/`PartialEq` outright
# before `emit_observed_derived_impls`, not just the "maybe non-Clone"
# `'inline'observed`/`'owned'observed` case the task's own scope note called out).
struct Position:
    var float x = 0.0

    req float getX():
        x

struct Canvas:
    mut Position'inline'observed origin = Position()

    req float originX():
        self.origin.value.getX()

def main():
    # 1. Each legal composition: construct, mutate via a DIRECT call (no `.value` —
    # 'actor/'guard already dispatch method calls transparently in Boring, and
    # 'observed follows the same convention), confirm a subscribed callback fires.
    mut Counter'inline'observed a = Counter(0)
    var mut int'atomic a_calls = 0
    let a_sub = a.subscribe((obj):
        a_calls += 1
    )
    a.inc()

    mut Counter'owned'observed b = Counter(0)
    var mut int'atomic b_calls = 0
    let b_sub = b.subscribe((obj):
        b_calls += 1
    )
    b.inc()

    mut Counter'actor'observed c = Counter(0)
    var mut int'atomic c_calls = 0
    let c_sub = c.subscribe((obj):
        c_calls += 1
    )
    c.inc()

    mut Counter'guard'observed d = Counter(0)
    var mut int'atomic d_calls = 0
    let d_sub = d.subscribe((obj):
        d_calls += 1
    )
    d.inc()

    # 3. `.value` is the explicit, silent escape hatch — neither a read nor a
    # deliberate mutation reached through it ever notifies subscribers.
    mut Counter'actor'observed e = Counter(9)
    var mut int'atomic e_calls = 0
    let e_sub = e.subscribe((obj):
        e_calls += 1
    )
    let e_read = e.value.current()
    e.value.inc()   # mutates, but silently — must NOT fire e_sub

    # 4. `Subscription`'s `Drop` genuinely unsubscribes.
    mut Counter'actor'observed f = Counter(0)
    var mut int'atomic f_calls = 0
    if true:
        let f_sub = f.subscribe((obj):
            f_calls += 1
        )
        f.inc()   # sub still alive -> fires
    f.inc()        # sub dropped at end of `if true:` block -> must not fire again

    # 5. Multiple independent subscribers on the same instance all fire on one write.
    mut Counter'actor'observed g = Counter(0)
    var mut int'atomic g_calls_1 = 0
    var mut int'atomic g_calls_2 = 0
    let g_sub_1 = g.subscribe((obj):
        g_calls_1 += 1
    )
    let g_sub_2 = g.subscribe((obj):
        g_calls_2 += 10
    )
    g.inc()

    # 6. The actual fix: the callback reads `.value` off its OWN parameter, never
    # separately capturing the observed variable itself. For 'actor'observed (and
    # 'guard'observed), the OLD zero-arg-callback pattern happened to still work by
    # just capturing `h` directly from the enclosing scope — this case proves the
    # new parameter carries the exact same live value, without any such capture.
    mut Counter'actor'observed h = Counter(0)
    var mut int'atomic h_calls = 0
    var mut int'atomic h_last_seen = 0
    let h_sub = h.subscribe((obj):
        h_calls += 1
        h_last_seen = obj.value.current()
    )
    h.inc()
    h.inc()

    # 7. Same proof, but for 'inline'observed — the case that most concretely shows
    # why the fix is necessary: `value` here is a bare `Counter` with no shareable
    # handle at all (no `Rc`/`Arc`, no `Clone` guaranteed), so the old pattern of
    # "just capture a long-lived handle and clone it inside the closure" was never
    # even possible for this composition. Reading `obj.value` off the callback's own
    # parameter is the only way this case could ever observe the current value.
    mut Counter'inline'observed i = Counter(0)
    var mut int'atomic i_last_seen = 0
    let i_sub = i.subscribe((obj):
        i_last_seen = obj.value.current()
    )
    i.inc()
    i.inc()

    print "a={a_calls} b={b_calls} c={c_calls} d={d_calls} e_read={e_read} e_calls={e_calls} e_val={e.value.current()} f={f_calls} g1={g_calls_1} g2={g_calls_2} h_calls={h_calls} h_last_seen={h_last_seen} i_last_seen={i_last_seen}"

    # 8. Struct field, declared+constructed inline — self.field.subscribe() and a
    # `def` method reached through the field both dispatch transparently and notify.
    mut container = Container()
    container.mount()
    print "container currentName={container.currentName()}"

    # 9. Bare `'observed` struct field — defaults to `'actor'observed`.
    mut bare_container = BareContainer()
    bare_container.mount()

    # 10. `'observed` constructor parameter (`@ObservedObject`) — a struct receiving
    # an already-observed value from outside rather than constructing one inline.
    # `shared_model` is declared with an explicit `'observed` annotation directly
    # (not via a function call's return value assigned to a local — see this
    # session's report for that specific, separate, known scope gap) so it's a
    # plain, already-registered `'observed` local going into `View`'s constructor.
    mut FormModel'actor'observed shared_model = FormModel()
    mut view = View(shared_model)
    view.mount()

    # 11. `'observed` return type, forwarded directly into a matching parameter.
    useModel(makeModel())

    # 12. `'inline'observed` struct field — the containing struct's auto-derived
    # `Clone` must still work (regression: `BoringObserved<V>` itself has no
    # derive at all without this session's fix, breaking Clone/Debug/PartialEq for
    # ANY struct with an `'observed` field, not just this "maybe non-Clone" case).
    mut canvas = Canvas()
    let Canvas canvas2 = canvas.clone()
    print "canvas clone originX={canvas2.originX()}"
