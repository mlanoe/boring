# Explicit `Trait&` (`&dyn Trait`) on a *method* parameter: a fresh value, a local used twice,
# a forwarded borrowed param, a field, and a free function reached from a method all pass
# without a Box or a move.
trait Builder:
    req int build(int x)

struct Four as Builder:
    req int build(int x): x + 4

struct Two as Builder:
    req int build(int x): x + 2

int inner(Builder& b, int n):
    b.build(n)

struct Runner:
    var int n = 0
    def int flush(Builder& b):
        n += 1
        b.build(n)
    def int endEvent(Builder& b):
        self.flush(b)
    def int viaFree(Builder& b):
        inner(b, 100)

struct Holder:
    Builder b

def main():
    mut r = Runner()
    print r.endEvent(Four())
    let Builder local = Two()
    print r.endEvent(local)
    print r.endEvent(local)
    print r.viaFree(Four())
    let h = Holder(Four())
    print r.endEvent(h.b)
