# ---- method_name_collides_builtin ----
# Regression test: a Boring-declared struct method whose name collides with a builtin
# Vec/iterator method that takes a positional index (`swap`, `insert`, `drain`, ...).
# `emit_method_call_fallback` used to cast the FIRST argument `as usize` for any such name
# whenever the receiver wasn't a set/dict -- it wasn't guarded by `!is_user_struct_receiver`,
# unlike the neighboring `contains`/`contains_key`/`remove` guards -- so a `var [uint8]`
# out-param emitted `s.swap((&mut buf as usize))` (invalid cast) and an `int` argument was
# silently narrowed to `usize`. Covers an out-param, and a signed `int` that must stay `isize`.
# Transpile-only (`transpile_test!`): `boring run`'s interpreter doesn't honor method `var`
# out-params yet.

struct MethodNameCollidesBuiltinSrc:
    var int pos = 0

    def int swap(var [uint8] b):
        pos += 1
        b = [1 as uint8, 2 as uint8]
        pos

    def int insert(int idx, string s):
        pos += idx
        pos

def run_method_name_collides_builtin():
    var mut MethodNameCollidesBuiltinSrc s = MethodNameCollidesBuiltinSrc()
    var [uint8] buf = [0 as uint8 for i in 0..<4]
    let m = s.swap(buf)
    print m
    print buf.length
    print buf[0]

    let k = s.insert(-1, "x")
    print k

# ---- optional_dyn_field_struct_literal_clone ----
# `Desc(view = n.view, control = n.control)` built from the optional trait-object fields of a param
# cloned the pointers (a cheap Arc clone) instead of moving them out of the borrowed struct (E0507).
trait OptionalDynFieldStructLiteralCloneShape:
    req int area(): 0

struct OptionalDynFieldStructLiteralCloneSq as OptionalDynFieldStructLiteralCloneShape:
    int side
    req int area(): side * side

struct OptionalDynFieldStructLiteralCloneMounted:
    pub string kind
    pub var OptionalDynFieldStructLiteralCloneShape? view = nil
    pub var OptionalDynFieldStructLiteralCloneShape? control = nil

struct OptionalDynFieldStructLiteralCloneDesc:
    pub string kind
    pub OptionalDynFieldStructLiteralCloneShape? view = nil
    pub OptionalDynFieldStructLiteralCloneShape? control = nil

def OptionalDynFieldStructLiteralCloneDesc optional_dyn_field_struct_literal_clone_rebuild(OptionalDynFieldStructLiteralCloneMounted n):
    OptionalDynFieldStructLiteralCloneDesc(kind = n.kind, view = n.view, control = n.control)

def run_optional_dyn_field_struct_literal_clone():
    let m = OptionalDynFieldStructLiteralCloneMounted(kind = "k", view = OptionalDynFieldStructLiteralCloneSq(side = 3), control = OptionalDynFieldStructLiteralCloneSq(side = 2))
    let d = optional_dyn_field_struct_literal_clone_rebuild(m)
    let again = optional_dyn_field_struct_literal_clone_rebuild(m)
    if let v = d.view:
        print v.area()
    if let v = again.control:
        print v.area()

# ---- split_call_arg_then_split ----
string split_call_arg_then_split_join_from([string] parts, int from, string sep):
    "x>y"

string split_call_arg_then_split_pieces_of(string text):
    let after = split_call_arg_then_split_join_from(text.split("<"), 1, "<")
    let [string] closed = after.split(">")
    closed[0]

def run_split_call_arg_then_split():
    print split_call_arg_then_split_pieces_of("\<a>b")

# ---- throws_method_name_collision ----
# Regression test.
#
# A nested method call inside a `throws` function used to get a spurious `?`
# based purely on the callee's *name*: as long as *some* method named `mul`
# *anywhere in the whole program* was `throws`-declared, *every* call to
# `.mul(...)` inside any `throws` function got `?` appended, regardless of
# the actual receiver's type. `Inner.mul` below is plain (non-throwing);
# `Outer2.mul` (a completely unrelated struct) is `throws`-declared with the
# same method name. `Outer.combo` calls `self.numerator.mul(...)` --
# `self.numerator` is an `Inner`, so this call must NOT get a `?` (it isn't
# even `Result`-returning) -- the receiver is reached via a field-of-field
# chain (`self.numerator`, not a bare local/`self`), which is exactly the
# receiver shape the old bare-name fallback mishandled.

enum ThrowsMethodNameCollisionMyErr:
    Bad

struct ThrowsMethodNameCollisionInner:
    int v

    # Non-throwing -- shares the name "mul" with Outer2.mul below.
    req ThrowsMethodNameCollisionInner mul(ThrowsMethodNameCollisionInner other):
        ThrowsMethodNameCollisionInner(v = v * other.v)

struct ThrowsMethodNameCollisionOuter2:
    int v

    # Throwing -- unrelated type, same method name "mul" as Inner.mul.
    req ThrowsMethodNameCollisionOuter2 mul(ThrowsMethodNameCollisionOuter2 other) throws ThrowsMethodNameCollisionMyErr:
        guard true else throw ThrowsMethodNameCollisionMyErr.Bad
        ThrowsMethodNameCollisionOuter2(v = v * other.v)

struct ThrowsMethodNameCollisionOuter:
    ThrowsMethodNameCollisionInner numerator
    ThrowsMethodNameCollisionInner denominator

    req ThrowsMethodNameCollisionOuter combo(ThrowsMethodNameCollisionOuter other) throws ThrowsMethodNameCollisionMyErr:
        guard true else throw ThrowsMethodNameCollisionMyErr.Bad
        # Field-of-field receiver (self.numerator), not a bare local/self --
        # the shape that used to fall through to the bare-name "mul" lookup
        # and pick up an invalid `?` from Outer2.mul.
        let n = self.numerator.mul(other.denominator)
        let d = denominator
        ThrowsMethodNameCollisionOuter(numerator = n, denominator = d)

def throws_method_name_collision_run() throws ThrowsMethodNameCollisionMyErr:
    let a = ThrowsMethodNameCollisionOuter(numerator = ThrowsMethodNameCollisionInner(v = 2), denominator = ThrowsMethodNameCollisionInner(v = 3))
    let b = ThrowsMethodNameCollisionOuter(numerator = ThrowsMethodNameCollisionInner(v = 5), denominator = ThrowsMethodNameCollisionInner(v = 7))
    let c = a.combo(b)
    print "{c.numerator.v}"
    print "{c.denominator.v}"

def run_throws_method_name_collision():
    try:
        throws_method_name_collision_run()
    catch:
        print "error: {error}"

# ---- unwrap_or_struct_local_by_value ----
struct UnwrapOrStructLocalByValueHandle:
    int id

struct UnwrapOrStructLocalByValueRt:
    var int n = 0
    def UnwrapOrStructLocalByValueHandle? handle(int id):
        UnwrapOrStructLocalByValueHandle(id)
    def bool write(UnwrapOrStructLocalByValueHandle h, int v):
        n += v
        true

def run_unwrap_or_struct_local_by_value():
    mut b = UnwrapOrStructLocalByValueRt()
    let hr = b.handle(2).unwrap_or(UnwrapOrStructLocalByValueHandle(-1))
    _ = b.write(hr, 1)
    _ = b.write(hr, 2)
    print "{b.n}"

def main() throws:
    print "== method_name_collides_builtin =="
    run_method_name_collides_builtin()
    print "== optional_dyn_field_struct_literal_clone =="
    run_optional_dyn_field_struct_literal_clone()
    print "== split_call_arg_then_split =="
    run_split_call_arg_then_split()
    print "== throws_method_name_collision =="
    run_throws_method_name_collision()
    print "== unwrap_or_struct_local_by_value =="
    run_unwrap_or_struct_local_by_value()
