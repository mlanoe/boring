# `as <scalar>` followed by `<`, `<<`, `<=`, `>`, `>>`, `<<=`, `>>=`: the operator is not a generic-args opener.
let r = 3
let g = 5
let b = 7
let a = (255 as uint << 24) | (r << 16) | (g << 8) | b
print a
print r as int < g as int
print g as int <= g as int
print g as int > r as int
print a as uint >> 8
var s = 1
s = s as uint << 3
print s
s <<= 2
print s
s >>= 1
print s
