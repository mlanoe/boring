# Regression test:
# a decimal integer literal that overflows the default `int` (i64) type but
# fits `uint64` must lex/parse successfully when immediately cast, and the
# cast must produce the literal's true value (not an error, and not `nil`).
let direct = 18446744073709551615 as uint64   # u64::MAX
let u32_max64 = 4294967295 as uint64
let via_shift = (u32_max64 << 32) | u32_max64  # previous workaround, same value
print "{direct}"
print "{via_shift}"
print "{direct == via_shift}"
