# ---- optional_field_else_keeps_field ----
struct OptionalFieldElseKeepsFieldHandle:
    int id

struct OptionalFieldElseKeepsFieldRt:
    var OptionalFieldElseKeepsFieldHandle? focus = nil
    var int? count = nil

def run_optional_field_else_keeps_field() throws:
    mut rt = OptionalFieldElseKeepsFieldRt()
    rt.focus = OptionalFieldElseKeepsFieldHandle(id = 3)
    let a = rt.focus else (OptionalFieldElseKeepsFieldHandle(id = -1))
    let b = rt.focus else (OptionalFieldElseKeepsFieldHandle(id = -2))
    print(a.id)
    print(b.id)
    print(rt.count else (7))

# ---- optional_let_throws_non_optional_return ----
# `let int? x = compute()` where `compute` is `throws` but its declared
# return type is a plain `int` (not `int?`) — must still wrap the value in
# `Some(...)`, matching the `T?` annotation. `emit_let_value_optional`'s
# `already_opt` check used to treat ANY throws-propagated call (anything
# ending in `?`, whose expr kind is `Call`) as already `Option<T>`-shaped,
# with no check of the function's actual declared return type — generating
# `let x: Option<isize> = compute()?;`, which fails to compile (E0308:
# expected `Option<isize>`, found `isize`) since `compute()?` is a plain
# `isize`, not an `Option<isize>` (audit finding #6).
def int optional_let_throws_non_optional_return_compute() throws:
    return 42

def optional_let_throws_non_optional_return_foo() throws:
    let int? x = optional_let_throws_non_optional_return_compute()
    print x

def run_optional_let_throws_non_optional_return() throws:
    optional_let_throws_non_optional_return_foo()

def main() throws:
    print "== optional_field_else_keeps_field =="
    run_optional_field_else_keeps_field()
    print "== optional_let_throws_non_optional_return =="
    run_optional_let_throws_non_optional_return()
