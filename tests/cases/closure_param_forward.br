# A closure-typed parameter forwarded to another function moves, never `.clone()`s.
use UIAction as def void()

struct Builder:
    var int n = 0

def inner(Builder host, UIAction body):
    body()
    body()

def outer(Builder host, UIAction body):
    inner(host, body)

def sayHi():
    print "hi"

def main():
    let b = Builder()
    outer(b, sayHi)
