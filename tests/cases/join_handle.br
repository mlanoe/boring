# let f = task: expr — capture the JoinHandle
# f.value — await the result

task int fetch_users():
    wait Duration.from_millis(10)
    return 42

task int fetch_products():
    wait Duration.from_millis(10)
    return 99

task run():
    # Capture JoinHandles
    let f1 = task: fetch_users()
    let f2 = task: fetch_products()

    # Await results sequentially
    let users = f1.value
    let products = f2.value
    print users
    print products

    # Parallel await with join
    let f3 = task: fetch_users()
    let f4 = task: fetch_products()
    let a, b = join (f3, f4)
    print a
    print b

let t = task run()
t.value
