struct Key:
    var int id
    var string name

enum Wrap:
    Holder(Key)
    Empty

def main():
    let a = Key(1, "x")
    let b = Key(1, "x")
    let c = Key(2, "x")
    print a == b
    print a != b
    print a == c
    print a != c
    let [Key] arr = [Key(1, "x"), Key(2, "y")]
    print arr.contains(Key(2, "y"))
    print arr == [Key(1, "x"), Key(2, "y")]
    let t1 = (Key(1, "x"), 5)
    let t2 = (Key(1, "x"), 5)
    print t1 == t2
    print Wrap.Holder(Key(3, "z")) == Wrap.Holder(Key(3, "z"))
    print Wrap.Holder(Key(3, "z")) == Wrap.Holder(Key(4, "z"))
