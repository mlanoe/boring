# Inline expression-bodied closures as labeled constructor args of function-typed fields
# (`req` = Fn, `def` = FnMut).
use Look as req int(string)
use Cmd as def int(string)

struct Row:
    int id
    Look onLook
    Cmd onCommand

def main():
    let r = Row(id = 1, onLook = (s): s.len() as int, onCommand = (c): c.len() as int + 1)
    let q = Row(id = 2, onLook = (s): 4, onCommand = (c): 5)
    print r.onLook("abc")
    print r.onCommand("abc")
    print q.onLook("abc")
    print q.onCommand("abc")
