int double(int n): n * 2
int inc(int n): n + 1
[int] keep_positive([int] arr): arr.filter(n: n > 0)

struct PipeResult:
    int output

# single-line pipe chain
let x = 5 |> double() |> inc() |> inc()
print x

# multi-line pipe
let y = 5
    |> double()
    |> inc()
print y

# string methods via pipe
let shout = "  hello  "
    |> trim()
    |> upper()
print shout

# mixed function + method dispatch
let nums = [-1, 2, -3, 4]
    |> keep_positive()
    |> map(n: n * 2)
print nums

# parenthesis-free pipe stage projects a field
let output = PipeResult(42) |> output
print output

# a leading dot explicitly forces method dispatch
let forced = "forced" |> .upper()
print forced
