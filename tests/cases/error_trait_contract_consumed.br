# Error fixture: an implementer consuming a trait parameter that the trait passes by reference.
trait Builder:
    req int build(int x)

struct Four as Builder:
    req int build(int x): x + 4

struct Holder:
    Builder b

trait Visitor:
    req int visit(Builder b)

struct A as Visitor:
    req int visit(Builder b):
        let h = Holder(b)
        h.b.build(1)

def main():
    let A a = A()
    print a.visit(Four())
