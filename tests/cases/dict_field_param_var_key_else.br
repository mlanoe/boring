# Regression: `param.dict_field[key] else default` with a non-self struct param
# transpiled to `.get((k) as usize)` (E0308/E0605): expr_is_dict's Field arm only
# consulted var_struct_type(s), missing a param typed only via var_types.

struct D:
    var {string=string} props = {"x" = "2.5"}

    req string get(string k):
        props[k] else ("0")

    req string get2(string k):
        self.props[k] else ("0")

string valueOf(D d, string k):
    d.props[k] else ("0")

string valueOf2(D d, string k):
    d.props[k]

string valueOf3(D d, string k):
    let s = d.props[k]
    s

string local(string k):
    let m = {"x" = "7"}
    m[k] else ("0")

def main():
    let d = D()
    print valueOf(d, "x")
    print valueOf(d, "y")
    print valueOf2(d, "x")
    print valueOf3(d, "x")
    print local("x")
    print d.get("x")
    print d.get2("x")
