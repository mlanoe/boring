struct Point:
    var float x
    var float y

struct Holder:
    var mut Point kept = Point(0.0, 0.0)
    var [Point] all = []
    var [int] nums = []

    def keep(mut Point p):
        kept = p

    def add(mut Point p):
        all.push(p)

    def setn(mut [int] a):
        nums = a

def main():
    mut p = Point(1.0, 2.0)
    mut h = Holder()
    h.keep(p)
    h.add(p)
    p.x = 9.0
    print h.kept.x
