# A closure stored in a struct field must be 'static: it works on a snapshot of `self` and on
# clones of the struct-typed locals it captures (the loop element), so the loop and the method
# stay usable afterwards.
use Notify as def void(string)

struct Todo:
    int id
    string title

struct Row:
    Todo item
    int prefix
    Notify onTap

struct Board:
    int base = 10
    Todo seed = Todo(id = 0, title = "seed")

    req [Row] rows([Todo] items):
        mut out = []
        for item in items:
            out.push(Row(item = item, prefix = item.id, onTap = (what):
                print "{what}:{base + item.id}:{item.title}:{seed.title}"))
        out

def main():
    let board = Board()
    let rows = board.rows([Todo(id = 1, title = "a"), Todo(id = 2, title = "b")])
    print rows.length
    for r in rows:
        r.onTap("tap")
