# `join` of handles where one throws a `throws` task: the throw surfaces at the join.
task int ok(int x) throws:
    x * 10

task int bad(int x) throws:
    if x < 0:
        throw "neg"
    x

task run():
    let f1 = task: ok(1)
    let f2 = task: bad(-1)
    let r = try:
        let a, b = join (f1, f2)
        a + b
    else:
        -1
    print r
    let f3 = task: ok(2)
    let f4 = task: bad(3)
    let r2 = try:
        let a, b = join (f3, f4)
        a + b
    else:
        -1
    print r2
    let f5 = task: ok(2)
    let f6 = task: bad(-2)
    try:
        let a, b = join (f5, f6)
        print a + b
    catch:
        print "join caught: {error}"

let t = task run()
t.value
