struct Point:
    var float x
    var float y
struct Holder:
    var Point'actor kept = Point(0.0, 0.0)
    def keep_by_value(Point p):
        kept = p
    def keep_cloned(mut Point p):
        kept = p.clone()
def main():
    mut p = Point(1.0, 2.0)
    mut h = Holder()
    h.keep_by_value(p)
    p.x = 9.0
    print h.kept.x
    mut q = Point(3.0, 4.0)
    h.keep_cloned(q)
    q.x = 8.0
    print h.kept.x
