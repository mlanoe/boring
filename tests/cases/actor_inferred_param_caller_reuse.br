# A parameter inferred `'actor` (captured by a closure that mutates it) used to leave the
# caller's own local a plain `St`: the call site emitted `run(&Arc::new(Mutex::new(st)))`,
# moving `st` (rustc E0382 on the later `st.n` read) and hiding the callee's mutation. The
# caller's local is now promoted to `'actor` too, as if declared `mut St'actor st`.

struct St:
    var int n = 0

def run(mut St st):
    let f = ():
        st.n += 1
    f()

def main():
    mut st = St()
    run(st)
    print st.n
