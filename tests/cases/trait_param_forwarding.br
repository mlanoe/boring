# A bare-trait parameter (dynamic dispatch, `Box<dyn Trait>`) forwarded to another
# function/method must be handed over, not `.clone()`d (Box<dyn Trait> isn't Clone).
trait Builder:
    req int build(int x)

struct Four as Builder:
    req int build(int x): x + 4

int inner(Builder b, int n):
    b.build(n)

int outer(Builder b):
    inner(b, 1)

struct Runner:
    var int n = 0
    def int flush(Builder b):
        n += 1
        b.build(n)
    def int endEvent(Builder b):
        self.flush(b)
    def int viaFree(Builder b):
        outer(b)

def main():
    mut r = Runner()
    print r.endEvent(Four())
    print r.viaFree(Four())
    print outer(Four())
