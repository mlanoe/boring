# `if let s = dict[key]:` binds a string; `s.parseFloat()` must get string-method dispatch
# (it emitted `s.parse_float()`, E0599 on Arc<str>), and returning it from a `float?`
# function must not double-wrap in `Some(...)`.
struct N:
    {string=string} props

    req float? numProp(string key):
        if let s = props[key]:
            return s.parseFloat()
        nil

    req int? intProp(string key):
        if let s = props[key]:
            return s.parseInt()
        nil

def main():
    let n = N(props = {"a" = "1.5", "b" = "x", "c" = "7"})
    print n.numProp("a")
    print n.numProp("b")
    print n.numProp("zzz")
    print n.intProp("c")
    print n.intProp("a")
