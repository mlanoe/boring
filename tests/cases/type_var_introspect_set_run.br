# `Field.set` on `type var` via reflection — boring run variant (raw values; the build variant is type_var_introspect_set.br).
struct Config as Introspect:
    int id

    pub type let int limit = 10
    pub type var int count = 0
    pub type var string label = "a"
    pub type var float ratio = 0.5
    pub type var bool on = false
    pub type var int clamped = 1

    pub type set clamped(int v):
        if v >= 0: Config.clamped = v

def main() throws:
    let c = Config(id = 1)
    let info = c.introspect()
    for f in info.fields:
        if !f.isInstance:
            print "{f.name} rebindable={f.isRebindable} = {f.get():?}"
    for f in info.fields:
        if f.name == "count": f.set(42)
        if f.name == "label": f.set("hello")
        if f.name == "ratio": f.set(2.5)
        if f.name == "on": f.set(true)
        if f.name == "clamped": f.set(-5)
    print "direct: {Config.count} {Config.label} {Config.ratio} {Config.on} {Config.clamped}"
    for f in info.fields:
        if f.name == "clamped": f.set(7)
    print "clamped after valid set: {Config.clamped}"
    Config.count = 100
    for f in info.fields:
        if f.name == "count": print "after direct write: {f.get():?}"
