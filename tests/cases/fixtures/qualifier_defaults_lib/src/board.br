# Declarations with defaulted and chained qualifier parameters, used from another project.
pub struct Point:
    pub var int x = 0

    pub def bump():
        x += 1

    pub req int get():
        x

pub struct Board<'elem = 'inline>:
    pub var [mut Point'elem] cells = []

    pub def add(Point'elem p):
        cells.push(p)

    pub req int total():
        var int sum = 0
        for i in 0..<cells.len():
            sum += cells[i].x
        sum

pub struct Watched<'q as 'actor|'actor'observed = 'actor'observed>:
    pub mut Point'q pt = Point()

    pub def bump():
        pt.bump()

    pub req int get():
        pt.get()
