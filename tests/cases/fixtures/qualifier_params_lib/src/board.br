# Dependency project of tests/cases/qualifier_params_xfile: the qualifier-generic declarations
# that `Board<elem'actor>` in the consuming project's files names.
pub struct Point:
    pub var int x = 0

pub struct Board<'elem>:
    pub var [mut Point'elem] cells = []

    pub def add(Point'elem p):
        cells.push(p)

    pub req int total():
        var int sum = 0
        for i in 0..<cells.len():
            sum += cells[i].x
        sum

pub ext Board<'elem>:
    pub req int doubled():
        self.total() * 2

pub enum Slot<'elem>:
    Empty
    Full(Point'elem)
