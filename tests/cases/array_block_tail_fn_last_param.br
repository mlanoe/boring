# Trailing array-block sugar: resolution redesign. `WithLog` is an
# UPPERCASE-led callee (deliberately, to prove the fix) whose last
# parameter is `Fn(...)`-typed, invoked via the bare block form with no
# explicit `(params)`. Under the old uppercase-led casing gate, this would
# have been forced into the array-block/collect interpretation and
# rejected (`Fn(...)` isn't `[dyn Trait]`) -- the exact misrouting bug this
# redesign fixes. It must instead resolve to the ordinary, pre-existing
# trailing-closure sugar (tail semantics): exactly as if written
# `WithLog((): body)`.
#
int WithLog(int action()):
    print "before"
    let r = action()
    print "after"
    r

def main():
    let r = WithLog:
        print "doing work"
        42
    print r
