# def-optional shorthand at top level
# All forms are equivalent: bare RetType, def RetType, req RetType

int add(int a, int b): a + b
string greet(string name): "Hello, {name}!"
bool positive(int n): n > 0
[int] doubled([int] xs): xs.map((x): x * 2)

# req at top level — pure function signal
req int square(int n): n * n
req string shout(string s): s.upper()

# def without return type — still requires def keyword
def log(string msg):
    print "[LOG] {msg}"

# Optional-return-type shorthand (bare and array-of-T) — regression test for
# `parser_is_fn_shorthand` not recognizing an optional-type suffix (`?`)
# between the return type and the function name.
string? maybeGreet(int n):
    if n <= 0: return nil
    return "hi"

[int]? maybeNums(int n):
    if n <= 0: return nil
    return [n]

print add(3, 4)
print greet("World")
print positive(-1)
print positive(5)
print doubled([1, 2, 3])
print square(7)
print shout("hello")
log("test")
print maybeGreet(5)
print maybeGreet(-1)
print maybeNums(3)
print maybeNums(-1)
