# An optional function-typed struct field (`Seed? make = nil`), spelled through a `use` alias:
# stored as `Option<handle>` (impl Trait is illegal in a field), constructed with nil or a
# closure, unwrapped with `if let` / `guard let`, and called through the unwrapped handle.
use Seed as def int()

struct S:
    int id
    Seed? make = nil

int run(S s):
    if let f = s.make:
        return f()
    -1

int viaGuard(S s):
    guard let f = s.make else:
        return 0
    f() * 2

def main():
    let a = S(id = 1)
    let b = S(id = 2, make = nil)
    let c = S(id = 3, make = (): 42)
    print run(a)
    print run(b)
    print run(c)
    let d = c.clone()
    print run(d)
    if let g = c.make:
        print g() + 1
    print viaGuard(a)
    print viaGuard(c)
