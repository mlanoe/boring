# A closure bound with `let` inside a view's `body` and later passed to a callback field
# transpiles like the same closure written inline: it captures the state handles by clone
# (`'static`), and an untyped parameter takes its type from the field it is stored in.
# Only compiled here — a transpiled `body` is not runnable without the runtime.
use boring.ui.*

use Command as def void(string)

pub view Panel:
    state bool alive = true
    state string last = ""
    Command onCommand
    body():
        let gone = ():
            alive = false
        let record = (name):
            last = name
            onCommand(name)
        Column(spacing = 4.0):
            OnMount(onMount = gone):
                Text("mounted")
            Entry(onCommand = record)

pub view Entry:
    Command onCommand
    body():
        Button(label = "x", onActivate = ():
            onCommand("x"))

def main():
    print "ok"
