# Grapheme clusters (UAX #29) and terminal display width; identical in `boring run`
# and `boring build`.
def main():
    let e = "é"          # e + combining acute: 1 cluster, 2 scalars, 1 cell
    print(e.length)
    print(e.graphemeCount)
    print(e.displayWidth)
    let s = "héllo 日本 😀 🇫🇷"
    print(s.length)
    print(s.graphemeCount)
    print(s.displayWidth)
    let gs = s.graphemes()
    print(gs.length)
    print(gs[1].length)
    print(gs[1] == e)
    print(gs.join("|"))
    # cutting at grapheme boundaries never splits a cluster
    print(s.graphemeSlice(1, 3))
    print(s.graphemeSlice(0, 2).graphemeCount)
    print(s.graphemeSlice(6, 9))
    print(s.graphemeSlice(2, 99))
    print(s.graphemeSlice(-3, 2))
    print("[" + s.graphemeSlice(5, 3) + "]")
    print("日本".displayWidth)
    print("😀".displayWidth)
    print("".displayWidth)
    print("".graphemeCount)
    print("abc".displayWidth)
    print("a​b".displayWidth)
    let fam = "👨‍👩‍👧"
    print(fam.graphemeCount)
    print(fam.displayWidth)
    var w = 0
    for g in s.graphemes():
        w += g.displayWidth
    print(w)
