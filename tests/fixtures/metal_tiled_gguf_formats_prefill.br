def main() throws:
    let [string] argv = args()
    let format = argv[1]
    guard let m = (argv[2] as int) else throw "m"
    guard let n = (argv[3] as int) else throw "n"
    guard let k = (argv[4] as int) else throw "k"
    let with_bias = argv.length < 6 or argv[5] == "bias"
    let block_elements = if format == "f16" or format == "bf16": 1 elif format == "q5_k" or format == "q3_k" or format == "q2_k": 256 else: 32
    let block_bytes = if format == "q4_0" or format == "iq4_nl": 18 elif format == "q5_0": 22 elif format == "q4_1": 20 elif format == "q5_1": 24 elif format == "q5_k": 176 elif format == "f16" or format == "bf16": 2 elif format == "q3_k": 110 else: 84
    let scale_at = if format == "q3_k": 108 elif format == "q2_k": 80 else: 0
    let [float32] host_x = [(((i * 7919) % 10007) as float32) / 10007.0 as float32 * 2.0 as float32 - 1.0 as float32 for i in 0..<m * k]
    let total_bytes = n * k / block_elements * block_bytes
    let [uint8] host_weights = [fill_byte(i, block_bytes, scale_at, format) as uint8 for i in 0..<total_bytes]
    let [float32] host_bias = [(((i * 131) % 97) as float32) / 97.0 as float32 + 1.0 as float32 for i in 0..<n]
    let x = upload_floats(host_x)
    let w = upload_bytes(host_weights)
    let bias = upload_floats(host_bias)
    let result = if with_bias:
        if format == "q4_0": q4_0_b(x, w, bias, m, n, k) elif format == "q5_0": q5_0_b(x, w, bias, m, n, k) elif format == "iq4_nl": iq4_nl_b(x, w, bias, m, n, k) elif format == "q3_k": q3_k_b(x, w, bias, m, n, k) elif format == "q4_1": q4_1_b(x, w, bias, m, n, k) elif format == "q5_1": q5_1_b(x, w, bias, m, n, k) elif format == "q5_k": q5_k_b(x, w, bias, m, n, k) elif format == "f16": f16_b(x, w, bias, m, n, k) elif format == "bf16": bf16_b(x, w, bias, m, n, k) else: q2_k_b(x, w, bias, m, n, k)
    else:
        if format == "q4_0": q4_0_nb(x, w, m, n, k) elif format == "q5_0": q5_0_nb(x, w, m, n, k) elif format == "iq4_nl": iq4_nl_nb(x, w, m, n, k) elif format == "q3_k": q3_k_nb(x, w, m, n, k) elif format == "q4_1": q4_1_nb(x, w, m, n, k) elif format == "q5_1": q5_1_nb(x, w, m, n, k) elif format == "q5_k": q5_k_nb(x, w, m, n, k) elif format == "f16": f16_nb(x, w, m, n, k) elif format == "bf16": bf16_nb(x, w, m, n, k) else: q2_k_nb(x, w, m, n, k)
    with result:
        for i in 0..<m * n:
            print "value={result[i]}"

# Finite fp16 scales (0x2E66 ~ 0.1) at the format's scale slots; pseudo-random everywhere else.
int fill_byte(int i, int block_bytes, int scale_at, string format):
    let at = i % block_bytes
    let rel = at - scale_at
    if format == "f16" or format == "bf16":
        # Every element is its own value: keep the exponent byte finite and varied.
        if at == 1:
            return 48 + (i * 7) % 12
        return (i * 17 + 29) % 256
    let scale_len = if format == "q2_k" or format == "q4_1" or format == "q5_1" or format == "q5_k": 4 else: 2
    if rel >= 0 and rel < scale_len:
        if rel % 2 == 0:
            return 102
        return 46
    return (i * 17 + 29) % 256
