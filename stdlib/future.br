# Boring standard library — Future<T>
#
# A Future<T> is a handle to a value being computed concurrently by a `task`.
# It is created by any `task` expression:
#
#   let f: Future<int> = task compute(n)
#   let g: Future<string> = task:
#       fetch(url)
#
# No import is needed — `Future` is a built-in type.

# Future<T> — handle to a concurrently-running task.
#
# Methods require a `task` context (the calling function must be `task`).
#
# No-timeout forms (property or method syntax):
#   f.value    — await and return the result
#   f.wait     — await and discard the result
#   f.value()  — same, method syntax
#   f.wait()   — same, method syntax
#
# Timeout forms — throws Error.Expired if the deadline elapses.
# The underlying task keeps running; only the caller unblocks with an error.
#   f.value(Duration.fromSecs(5))        — await with relative timeout → T
#   f.value(Instant.now() + dur)         — await until absolute deadline → T
#   f.wait(Duration.fromSecs(5))         — await/discard with relative timeout
#   f.wait(Instant.now() + dur)          — await/discard until absolute deadline
#
# Transpilation:
#   f.value(dur)   → tokio::time::timeout(dur, handle).await??
#   f.value(inst)  → tokio::time::timeout_at(inst, handle).await??
#   f.wait(dur)    → tokio::time::timeout(dur, handle).await??; (result dropped)
#   f.wait(inst)   → tokio::time::timeout_at(inst, handle).await??; (result dropped)

struct Future<T>: native

ext Future<T>:
    # Await the task and return its result. Throws if the task threw.
    # Equivalent to the property form `f.value` (no parens).
    task req T value() throws: native

    # Await the task and discard its result (fire-and-wait).
    # Equivalent to the property form `f.wait` (no parens).
    task req wait() throws: native

    # Await with a relative timeout. Throws Error.Expired if the duration
    # elapses, or any error the task itself threw. The task keeps running.
    task req T value(Duration timeout) throws: native

    # Await until an absolute deadline. Throws Error.Expired if the instant
    # passes, or any error the task itself threw. The task keeps running.
    task req T value(Instant deadline) throws: native

    # Await and discard with a relative timeout. Throws Error.Expired if the
    # duration elapses, or any error the task itself threw. The task keeps running.
    task req wait(Duration timeout) throws: native

    # Await and discard until an absolute deadline. Throws Error.Expired if the
    # instant passes, or any error the task itself threw. The task keeps running.
    task req wait(Instant deadline) throws: native
