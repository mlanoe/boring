# Boring standard library — string built-in methods.
#
# All methods are implemented by the runtime; this file documents their
# signatures.  Loadable via `use stdlib.string` if explicit scope is needed.
# Strings are immutable values; all methods return new strings or derived values.

ext string:
    # ── Query ───────────────────────────────────────────────────────────────────
    req bool     isEmpty():                     native   # true if len == 0
    req bool     contains(string sub):          native
    req bool     startsWith(string prefix):     native
    req bool     endsWith(string suffix):       native
    req int      indexOf(string sub):           native   # -1 if not found

    # ── Transform ───────────────────────────────────────────────────────────────
    req string   trim():                        native   # strip leading/trailing whitespace
    req string   upper():                       native   # also: toUpper, toUpperCase
    req string   lower():                       native   # also: toLower, toLowerCase
    req string   replace(string old, string new): native
    req string   slice(int from, int to):       native   # substring [from, to)
    req string   repeat(int n):                 native   # "ha".repeat(3) → "hahaha"

    # ── Split / join ────────────────────────────────────────────────────────────
    req [string] split(string sep):             native   # split on separator
    req [string] chars():                       native   # one element per character
    req [string] lines():                       native   # split on \n

    # ── Parse ───────────────────────────────────────────────────────────────────
    req int?     parseInt():                    native   # nil on failure
    req float?   parseFloat():                  native   # nil on failure

    # ── Properties (accessed as fields, not calls) ──────────────────────────────
    # s.length  →  int   (number of bytes; also: .len)
