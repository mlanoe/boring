# Boring standard library — boring.ui
#
# The public facade of boring-ui (docs/design-notes/boring-ui-draft.md, "Boring facade for Rust
# primitives"). Components are declared as `view`s with a `native` body: the visible fields are
# the component's real signature, and the linked UI runtime supplies the adapter. Until that
# runtime exists they lower (src/lower_view.rs) to plain structs conforming to `View`, so
# application views compose them in `body()` and the array-block sugar collects children.
#
#   use boring.ui.*
#
#   view Greeting:
#       string name
#       body():
#           Column(spacing = 8):
#               Text("Hello")
#               Text(name)
#
# `View` is a marker: a `view` declaration conforms automatically and a hand-written
# `struct X as View` is rejected (a struct has neither a `body()` nor a native adapter).

# Type-erased storage for one mounted view's `state`. A composite view's generated `V__State`
# conforms to it; the runtime keeps one per mounted node and hands it back to `expand`.
pub trait StateBox:
    pass

pub struct NoState as StateBox:
    pass

# Marker for a value a `Provide` installs for descendant views' `env` fields: an `env Theme theme`
# field is the nearest ancestor-provided value that is a `Theme`, so `Theme` declares `as EnvValue`.
pub trait EnvValue:
    pass

# What the UI runtime needs to walk a tree of views without knowing their types. Every method is
# GENERATED by the `view` lowering (src/lower_view.rs) — application code never implements `View`:
#   viewKind      the component name (the type part of a node's identity)
#   viewChildren  a native container's `[View] children`
#   viewKey/Site  a native `KeyedGroup`'s `key` / `site` fields
#   viewProps     a native view's scalar fields, stringified (`float? spacing = nil` is absent while nil)
#   isComposite   true for a view with a `body()`; the runtime then calls
#   newState      once at mount (the declaration's default seed), and
#   expand        on every build, with that node's persistent state, to get the body's view
# A parameterless callback, as held by `Button.onActivate`.
pub use UIAction as def void()

# One start of an `OnTask` body. Plain data: whether it is still current is the runtime's call
# (`Runtime.isCurrent(run)`), because it is current only while BOTH the mounted node's generation
# and the task-run generation still match — an `id` change or an unmount makes it stale.
pub struct TaskRun:
    pub int node
    pub int nodeGeneration
    pub int generation
    pub string id

# The body of an `OnTask`, handed its own run.
pub use TaskAction as def void(TaskRun)

pub trait View:
    req string viewKind(): ""
    req [View] viewChildren(): []
    req {string=string} viewProps(): {=}
    req string viewKey(): ""
    req int viewSite(): -1
    req bool isComposite(): false
    req StateBox'shared newState(): NoState()
    req View expand(StateBox'shared st): Text(content = "")
    # A view with `env` fields: the runtime then calls `expandIn` (the providers in scope for this node,
    # nearest ancestor first) instead of `expand`. Both are generated.
    # Writes this view's bind projections back into their collections (by key); the number of stale ones.
    req int commitProjectionsIn(StateBox'shared st): 0
    req bool usesEnv(): false
    req View expandIn(StateBox'shared st, [EnvValue] scope): Text(content = "")
    # What a `Provide` adds to its subtree's scope (generated from its `value` field).
    req EnvValue? viewProvides(): nil
    # The runtime delivering a semantic action to a native control: "activate" (Button), "toggle"
    # (Toggle), "setText" with the new text as `arg` (TextField). Generated like the rest from the
    # facade's shape (see src/lower_view.rs); default: nothing to do.
    req void viewAct(string action, string arg):
        pass
    # Whether this native control has a handler for the semantic `action` (so the runtime knows whether
    # an Enter was consumed by a TextField's `onSubmit`); generated, default: no.
    req bool viewHandles(string action): false
    # An `OnTask` view starting one run of its body (generated from the facade's `onTask` field).
    req void viewTask(TaskRun run):
        pass

# The shared storage cell behind `bind`: a parent's `state` that is handed to a child's `bind` is
# stored as `Slot<T>'actor`, and the child's `bind T name` field is the same slot (see
# src/lower_view.rs). Application code never names it.
pub struct Slot<T>:
    pub var mut T value

pub enum AxisAlignment:
    Leading
    Center
    Trailing

# Two-axis alignment for `Layer` and `Fill`.
# (`Middle*` rather than `Center`/`Leading`/`Trailing`: those variant names belong to `AxisAlignment`
# and a dot-prefix would become ambiguous everywhere.)
pub enum Alignment:
    TopLeading
    Top
    TopTrailing
    MiddleLeading
    Middle
    MiddleTrailing
    BottomLeading
    Bottom
    BottomTrailing

pub enum ScrollAxis:
    Vertical
    Horizontal

pub view Text:
    string content
    # At most this many lines: the text wraps first, then the last visible line is truncated with an
    # ellipsis (draft, "Text").
    int? lineLimit = nil
    body(): native

pub view Column:
    AxisAlignment alignment = .Center
    float? spacing = nil
    [View] children
    body(): native

pub view Row:
    AxisAlignment alignment = .Center
    float? spacing = nil
    [View] children
    body(): native

# One iteration of a keyed `for … with key:` in an array block (the array-block lowering emits
# `KeyedGroup("{key}", items)`): the key identifies the whole iteration subtree.
pub view KeyedGroup:
    string key
    [View] children
    int site = -1
    body(): native

# A transparent static-position tag: the array-block lowering wraps each element of a `[View]`
# block that has `if`/`for` control flow as `Sited(site = n, children = [element])`, `n` being the
# element's position in the block's source (conditional branches get distinct numbers). The
# runtime treats it as its single child with that site, so a branch keeps its identity whatever
# its siblings did. Application code never writes it.
pub view Sited:
    int site
    [View] children
    body(): native

# ── Layout wrappers (docs/design-notes/boring-ui-draft.md, "Layout and modifier composition") ──────
# Each wraps its single child, in order: `Padding(insets = 10.0):` then an indented child, and the
# outer wrapper sees the inner one's size. (The `view.padding(10)` method form is not implemented.)

pub view Padding:
    float insets
    [View] children
    body(): native

pub view Frame:
    float? width = nil
    float? height = nil
    float? minWidth = nil
    float? maxWidth = nil
    float? minHeight = nil
    float? maxHeight = nil
    [View] children
    body(): native

pub view Priority:
    float value
    [View] children
    body(): native

pub view Spacer:
    float? minLength = nil
    body(): native

# ── Painting wrappers ───────────────────────────────────────────────────────────────────────────

# Paints `color` (a color name or `#rrggbb`) over the wrapper's bounds, then its child.
pub view Background:
    string color
    [View] children
    body(): native

# Restricts painting and hit testing of its child to the wrapper's own bounds.
pub view Clip:
    [View] children
    body(): native

# ── Semantic modifiers (docs/design-notes/boring-ui-draft.md, "Accessibility semantics") ─────────────
# Ordered wrappers like every modifier; layout-transparent. A label/hint/heading applies to the one
# semantic element it wraps; `AccessibilityGroup` makes a group node; `AccessibilityHidden` removes
# its whole subtree from the accessibility tree without touching layout or painting.

pub view AccessibilityLabel:
    string label
    [View] children
    body(): native

pub view AccessibilityHint:
    string hint
    [View] children
    body(): native

pub view AccessibilityHeading:
    int level
    [View] children
    body(): native

pub view AccessibilityHidden:
    [View] children
    body(): native

pub view AccessibilityGroup:
    string label = ""
    [View] children
    body(): native

# ── Controls ──────────────────────────────────────────────────────────────────────────────────────
# Native controls: the runtime owns their interaction (focus, pointer, keyboard, accessibility
# actions) and reaches the application through the `bind` slot (`Button`: its `onActivate` callback).

# A button's semantic role: `Cancel` is the Escape action of its focus scope; the others inform
# theme and platform behaviour.
pub enum ButtonRole:
    Normal
    Destructive
    Cancel

pub view Button:
    string label
    UIAction onActivate
    ButtonRole role = .Normal
    body(): native

pub view Toggle:
    bind bool value
    string label
    body(): native

pub view TextField:
    bind string value
    string label
    string placeholder = ""
    # Enter's semantic action ("submit"); without one, Enter falls through to the scope's default action.
    UIAction? onSubmit = nil
    body(): native

# ── Interaction modifiers (docs/design-notes/boring-ui-draft.md, "Button", "Event dispatch") ───────────
#   Disabled        a disabled subtree accepts no activation, editing or keyboard focus and reports the
#                   disabled state; layout, hit testing and the accessibility tree still see it
#   DefaultAction   marks the wrapped Button as the Enter default of its scope (an enabled one)

pub view Disabled:
    bool value = true
    [View] children
    body(): native

pub view DefaultAction:
    bool enabled = true
    [View] children
    body(): native

# ── Lifecycle modifiers (docs/design-notes/boring-ui-draft.md, "Lifecycle and identity-scoped tasks") ──
# Ordered wrappers, layout- and paint-transparent; each owns its own identity and lifetime.
#   OnMount     runs once after the wrapper and its subtree committed (before any task starts)
#   OnUnmount   runs once, while inputs are still valid, as the wrapper is released
#   OnTask      starts a run after the update following mount is stable; a changed `id` cancels the old
#               run (its generation goes stale) and starts a new one; unmount cancels it

pub view OnMount:
    UIAction onMount
    [View] children
    body(): native

pub view OnUnmount:
    UIAction onUnmount
    [View] children
    body(): native

pub view OnTask:
    string id = ""
    TaskAction onTask
    [View] children
    body(): native

# ── Environment (docs/design-notes/boring-ui-draft.md, "Environment, theme, and control styles") ──────
# `Provide(value = x):` + children installs `x` for every descendant `env` field of x's type (nearest
# provider wins). `EnvMissing` is what a view with an unsatisfied `env` renders instead of its body;
# the runtime reports it.

pub view Provide:
    EnvValue value
    [View] children
    body(): native

pub view EnvMissing:
    string what
    body(): native

# ── Composition and effects (docs/design-notes/boring-ui-draft.md, "Overflow, clipping, and scrolling",
# "Paint order and modifier effects", "Layout primitives") ──────────────────────────────────────────
#   Layer     overlay stack: every child gets the same proposal, the layer reports the union, later children
#             paint above earlier ones
#   Fill      accepts the finite size its parent proposes on the chosen axes (no manufactured space, never
#             clips a larger child) and aligns its child in the extra room
#   Scroll    a finite viewport over content that chooses its full extent on the scrolling axis; the offset is
#             mounted control state, clamped after layout
#   Border    an inside stroke painted over its child
#   Opacity   composites the child's whole result with `value` (0...1)
#   Shadow    an outer shadow of the child's result, painted under it
#   Offset    a paint/hit-test translation that never changes sizes or siblings

pub view Layer:
    Alignment alignment = .Middle
    [View] children
    body(): native

pub view Fill:
    bool width = true
    bool height = true
    Alignment alignment = .Middle
    [View] children
    body(): native

pub view Scroll:
    ScrollAxis axis = .Vertical
    [View] children
    body(): native

pub view Border:
    string color
    float lineWidth = 1.0
    [View] children
    body(): native

pub view Opacity:
    float value
    [View] children
    body(): native

pub view Shadow:
    string color = "black"
    float radius = 4.0
    float dx = 0.0
    float dy = 2.0
    [View] children
    body(): native

pub view Offset:
    float x = 0.0
    float y = 0.0
    [View] children
    body(): native
