# Boring standard library — boring.ui
#
# The public facade of boring-ui (docs/design-notes/boring-ui-draft.md, "Boring facade for Rust
# primitives"). Components are declared as `view`s with a `native` body: the visible fields are
# the component's real signature, and the linked UI runtime supplies the adapter. Until that
# runtime exists they lower (src/lower_view.rs) to plain structs conforming to `View`, so
# application views compose them in `body()` and the array-block sugar collects children.
#
#   use boring.ui.*
#
#   view Greeting:
#       string name
#       body():
#           Column(spacing = 8):
#               Text("Hello")
#               Text(name)
#
# `View` is a marker: a `view` declaration conforms automatically and a hand-written
# `struct X as View` is rejected (a struct has neither a `body()` nor a native adapter).

# Type-erased storage for one mounted view's `state`. A composite view's generated `V__State`
# conforms to it; the runtime keeps one per mounted node and hands it back to `expand`.
pub trait StateBox:
    pass

pub struct NoState as StateBox:
    pass

# Marker for a value a `Provide` installs for descendant views' `env` fields: an `env Theme theme`
# field is the nearest ancestor-provided value that is a `Theme`, so `Theme` declares `as EnvValue`.
pub trait EnvValue:
    pass

# What the UI runtime needs to walk a tree of views without knowing their types. Every method is
# GENERATED by the `view` lowering (src/lower_view.rs) — application code never implements `View`:
#   viewKind      the component name (the type part of a node's identity)
#   viewChildren  a native container's `[View] children`
#   viewKey/Site  a native `KeyedGroup`'s `key` / `site` fields
#   viewProps     a native view's scalar fields, stringified (`float? spacing = nil` is absent while nil)
#   isComposite   true for a view with a `body()`; the runtime then calls
#   newState      once at mount (the declaration's default seed), and
#   expand        on every build, with that node's persistent state, to get the body's view
# A parameterless callback, as held by `Button.onActivate`.
pub use UIAction as def void() throws

# `List`'s optional semantic callbacks: reorder (final index after the move) and delete (unique ascending
# indices into one pre-event snapshot).
pub use MoveAction as def void(int, int) throws
pub use DeleteAction as def void([int]) throws

# One start of an `OnTask` body. Plain data: whether it is still current is the runtime's call
# (`Runtime.isCurrent(run)`), because it is current only while BOTH the mounted node's generation
# and the task-run generation still match — an `id` change or an unmount makes it stale.
pub struct TaskRun:
    pub int node
    pub int nodeGeneration
    pub int generation
    pub string id

# The body of an `OnTask`, handed its own run.
pub use TaskAction as def void(TaskRun) throws

# Where a mounted node's state reports that a callback is about to (maybe) change it: the runtime owns
# one `DirtySink` and hands each composite's state a `StateOwner` (its own id + generation, and the
# sink) at mount. Every callback a view's body passes to a constructor (`Button(onActivate = ...)`)
# is lowered to report first: `touch` when it provably only touches its own `state` (that composite
# alone is re-expanded), `escalate` when it also reaches anything else (an input, a `bind`, an `env`,
# a free function) so the runtime keeps the whole-window rebuild. A callback that reports nothing
# (not built by a lowered view) is treated as unknown by the runtime.
pub struct DirtySink:
    pub var mut [int] ids = []
    pub var mut [int] generations = []
    pub var bool all = false
    pub var int reports = 0

    def void touch(int id, int generation):
        ids.push(id)
        generations.push(generation)
        reports += 1

    def void escalate():
        all = true
        reports += 1

    def void clear():
        ids = []
        generations = []
        all = false

pub struct StateOwner:
    pub int id
    pub int generation
    pub mut DirtySink'actor sink

    req void touch():
        sink.touch(id, generation)

    req void escalate():
        sink.escalate()

pub trait View:
    req string viewKind(): ""
    req [View] viewChildren(): []
    req {string=string} viewProps(): {=}
    req string viewKey(): ""
    req int viewSite(): -1
    req bool isComposite(): false
    req StateBox'shared newState(): NoState()
    req View expand(StateBox'shared st): Text(content = "")
    # A view with `env` fields: the runtime then calls `expandIn` (the providers in scope for this node,
    # nearest ancestor first) instead of `expand`. Both are generated.
    # Writes this view's bind projections back into their collections (by key); the number of stale ones.
    req int commitProjectionsIn(StateBox'shared st): 0
    # The mount-time state already linked to its owner (generated when the view has `state`).
    req StateBox'shared newOwnedState(StateOwner owner): NoState()
    req bool usesEnv(): false
    req View expandIn(StateBox'shared st, [EnvValue] scope): Text(content = "")
    # What a `Provide` adds to its subtree's scope (generated from its `value` field).
    req EnvValue? viewProvides(): nil
    # The runtime delivering a semantic action to a native control: "activate" (Button), "toggle"
    # (Toggle), "setText" with the new text as `arg` (TextField). Generated like the rest from the
    # facade's shape (see src/lower_view.rs); default: nothing to do.
    req void viewAct(string action, string arg) throws:
        pass
    # Whether this native control has a handler for the semantic `action` (so the runtime knows whether
    # an Enter was consumed by a TextField's `onSubmit`); generated, default: no.
    req bool viewHandles(string action): false
    # An `OnTask` view starting one run of its body (generated from the facade's `onTask` field).
    req void viewTask(TaskRun run) throws:
        pass

# The shared storage cell behind `bind`: a parent's `state` that is handed to a child's `bind` is
# stored as `Slot<T>'actor`, and the child's `bind T name` field is the same slot (see
# src/lower_view.rs). Application code never names it.
pub struct Slot<T>:
    pub var mut T value

pub enum AxisAlignment:
    Leading
    Center
    Trailing

# Two-axis alignment for `Layer` and `Fill`.
# (`Middle*` rather than `Center`/`Leading`/`Trailing`: those variant names belong to `AxisAlignment`
# and a dot-prefix would become ambiguous everywhere.)
pub enum Alignment:
    TopLeading
    Top
    TopTrailing
    MiddleLeading
    Middle
    MiddleTrailing
    BottomLeading
    Bottom
    BottomTrailing

pub enum ScrollAxis:
    Vertical
    Horizontal

# Typography roles (docs/design-notes/boring-ui-draft.md, "Semantic tokens"): the theme maps each to a
# size, weight and line height.
pub enum FontRole:
    LargeTitle
    Title
    Headline
    Body
    Label
    Caption
    Monospace

pub view Text:
    string content
    FontRole font = .Body
    # At most this many lines: the text wraps first, then the last visible line is truncated with an
    # ellipsis (draft, "Text").
    int? lineLimit = nil
    body(): native

pub view Column:
    AxisAlignment alignment = .Center
    float? spacing = nil
    [View] children
    body(): native

pub view Row:
    AxisAlignment alignment = .Center
    float? spacing = nil
    [View] children
    body(): native

# One iteration of a keyed `for … with key:` in an array block (the array-block lowering emits
# `KeyedGroup("{key}", items)`): the key identifies the whole iteration subtree.
pub view KeyedGroup:
    string key
    [View] children
    int site = -1
    body(): native

# A transparent static-position tag: the array-block lowering wraps each element of a `[View]`
# block that has `if`/`for` control flow as `Sited(site = n, children = [element])`, `n` being the
# element's position in the block's source (conditional branches get distinct numbers). The
# runtime treats it as its single child with that site, so a branch keeps its identity whatever
# its siblings did. Application code never writes it.
pub view Sited:
    int site
    [View] children
    body(): native

# ── Layout wrappers (docs/design-notes/boring-ui-draft.md, "Layout and modifier composition") ──────
# Each wraps its single child, in order: `Padding(insets = 10.0):` then an indented child, and the
# outer wrapper sees the inner one's size. (The `view.padding(10)` method form is not implemented.)

pub view Padding:
    float insets
    [View] children
    body(): native

pub view Frame:
    float? width = nil
    float? height = nil
    float? minWidth = nil
    float? maxWidth = nil
    float? minHeight = nil
    float? maxHeight = nil
    [View] children
    body(): native

pub view Priority:
    float value
    [View] children
    body(): native

pub view Spacer:
    float? minLength = nil
    body(): native

# ── Painting wrappers ───────────────────────────────────────────────────────────────────────────

# Paints `color` (a color name or `#rrggbb`) over the wrapper's bounds, then its child.
pub view Background:
    string color
    [View] children
    body(): native

# Restricts painting and hit testing of its child to the wrapper's own bounds.
pub view Clip:
    [View] children
    body(): native

# ── Semantic modifiers (docs/design-notes/boring-ui-draft.md, "Accessibility semantics") ─────────────
# Ordered wrappers like every modifier; layout-transparent. A label/hint/heading applies to the one
# semantic element it wraps; `AccessibilityGroup` makes a group node; `AccessibilityHidden` removes
# its whole subtree from the accessibility tree without touching layout or painting.

pub view AccessibilityLabel:
    string label
    [View] children
    body(): native

pub view AccessibilityHint:
    string hint
    [View] children
    body(): native

pub view AccessibilityHeading:
    int level
    [View] children
    body(): native

pub view AccessibilityHidden:
    [View] children
    body(): native

pub view AccessibilityGroup:
    string label = ""
    [View] children
    body(): native

# ── Controls ──────────────────────────────────────────────────────────────────────────────────────
# Native controls: the runtime owns their interaction (focus, pointer, keyboard, accessibility
# actions) and reaches the application through the `bind` slot (`Button`: its `onActivate` callback).

# A button's semantic role: `Cancel` is the Escape action of its focus scope; the others inform
# theme and platform behaviour.
pub enum ButtonRole:
    Normal
    Destructive
    Cancel

# A button's built-in visual style. `Inherit` takes the active theme's choice for the button's role;
# the others fix it (docs/design-notes/boring-ui-draft.md, "Component styles").
pub enum ButtonStyle:
    Inherit
    Primary
    Secondary
    Plain
    Compact

pub view Button:
    string label
    UIAction onActivate
    ButtonRole role = .Normal
    ButtonStyle style = .Inherit
    body(): native

pub view Toggle:
    bind bool value
    string label
    body(): native

pub view TextField:
    bind string value
    string label
    string placeholder = ""
    # Enter's semantic action ("submit"); without one, Enter falls through to the scope's default action.
    UIAction? onSubmit = nil
    body(): native

# ── Interaction modifiers (docs/design-notes/boring-ui-draft.md, "Button", "Event dispatch") ───────────
#   Disabled        a disabled subtree accepts no activation, editing or keyboard focus and reports the
#                   disabled state; layout, hit testing and the accessibility tree still see it
#   DefaultAction   marks the wrapped Button as the Enter default of its scope (an enabled one)

pub view Disabled:
    bool value = true
    [View] children
    body(): native

pub view DefaultAction:
    bool enabled = true
    [View] children
    body(): native

# ── Lifecycle modifiers (docs/design-notes/boring-ui-draft.md, "Lifecycle and identity-scoped tasks") ──
# Ordered wrappers, layout- and paint-transparent; each owns its own identity and lifetime.
#   OnMount     runs once after the wrapper and its subtree committed (before any task starts)
#   OnUnmount   runs once, while inputs are still valid, as the wrapper is released
#   OnTask      starts a run after the update following mount is stable; a changed `id` cancels the old
#               run (its generation goes stale) and starts a new one; unmount cancels it

pub view OnMount:
    UIAction onMount
    [View] children
    body(): native

pub view OnUnmount:
    UIAction onUnmount
    [View] children
    body(): native

pub view OnTask:
    string id = ""
    TaskAction onTask
    [View] children
    body(): native

# ── Environment (docs/design-notes/boring-ui-draft.md, "Environment, theme, and control styles") ──────
# `Provide(value = x):` + children installs `x` for every descendant `env` field of x's type (nearest
# provider wins). `EnvMissing` is what a view with an unsatisfied `env` renders instead of its body;
# the runtime reports it.

pub view Provide:
    EnvValue value
    [View] children
    body(): native

pub view EnvMissing:
    string what
    body(): native

# ── Composition and effects (docs/design-notes/boring-ui-draft.md, "Overflow, clipping, and scrolling",
# "Paint order and modifier effects", "Layout primitives") ──────────────────────────────────────────
#   Layer     overlay stack: every child gets the same proposal, the layer reports the union, later children
#             paint above earlier ones
#   Fill      accepts the finite size its parent proposes on the chosen axes (no manufactured space, never
#             clips a larger child) and aligns its child in the extra room
#   Scroll    a finite viewport over content that chooses its full extent on the scrolling axis; the offset is
#             mounted control state, clamped after layout
#   Border    an inside stroke painted over its child
#   Opacity   composites the child's whole result with `value` (0...1)
#   Shadow    an outer shadow of the child's result, painted under it
#   Offset    a paint/hit-test translation that never changes sizes or siblings

pub view Layer:
    Alignment alignment = .Middle
    [View] children
    body(): native

pub view Fill:
    bool width = true
    bool height = true
    Alignment alignment = .Middle
    [View] children
    body(): native

pub view Scroll:
    ScrollAxis axis = .Vertical
    [View] children
    body(): native

pub view Border:
    string color
    float lineWidth = 1.0
    [View] children
    body(): native

pub view Opacity:
    float value
    [View] children
    body(): native

pub view Shadow:
    string color = "black"
    float radius = 4.0
    float dx = 0.0
    float dy = 2.0
    [View] children
    body(): native

pub view Offset:
    float x = 0.0
    float y = 0.0
    [View] children
    body(): native

# ── Animation (docs/design-notes/boring-ui-draft.md, "Animation and transitions") ───────────────────
#   AnimationScope  `.animation(curve, value = x)`: when `value` changes after the first mount, the
#                   presentation differences inside use this animation (a string trigger here: write
#                   `value = "{expanded}"`); it never animates because an ancestor merely rebuilt
#   Transition      how a conditional / keyed subtree enters and leaves when the transaction that inserts or
#                   removes it is animated: Identity, Fade, Scale (`amount`, e.g. 0.96) or Slide (`dx`, `dy`);
#                   asymmetric by giving `insertion` and `removal` different kinds

# (`Fade`/`Slide` rather than the draft's `Opacity`/`Offset`: an enum variant named like a view would
# shadow `Opacity(...)` / `Offset(...)` in every program.)
pub enum TransitionKind:
    Identity
    Fade
    Scale
    Slide

pub view AnimationScope:
    string curve = "EaseInOut"
    float duration = 200.0
    float response = 300.0
    float damping = 0.8
    string value = ""
    [View] children
    body(): native

pub view Transition:
    TransitionKind insertion = .Fade
    TransitionKind removal = .Fade
    float amount = 0.96
    float dx = 0.0
    float dy = 0.0
    [View] children
    body(): native

# ── Modal presentation, focus and collections (docs/design-notes/boring-ui-draft.md, "Modal presentation",
# "Focus", "List, selection, deletion, and reordering") ──────────────────────────────────────────────────
#   Sheet         contributes no bounds to its parent; presented (`isPresented` true) its child is mounted in the
#                 window's presentation layer, modal: it traps focus and pointer input, Escape writes `false`
#   DefaultFocus  the control that takes focus first when its scope (a presented Sheet) activates
#   Focused       `.focused(flag)`: the wrapped control's focus state, both ways, through a bound bool
#   FocusedAs     `.focused(focus, equals = token)`: several controls sharing one bound token (a string here)
#   List          a scrolling collection of keyed rows with single selection (the row's key, "" for none) and
#                 optional `onMove` / `onDelete` callbacks that enable reordering and deletion

pub view Sheet:
    bind bool isPresented
    [View] children
    body(): native

pub view DefaultFocus:
    bool enabled = true
    [View] children
    body(): native

# Non-modal focus scopes (draft, "Focus scopes and traversal"):
#   FocusScope  groups its descendants as one traversal unit; Tab leaves it for its parent's next control, unless
#               `trap` (reserved for genuine modal semantics), which wraps traversal inside the scope
#   FocusOrder  `.focusOrder(value)`: orders the wrapped control among its siblings (ascending, ties keep structural
#               order, default 0, negative = earlier)
#   FocusSection `.focusSection()`: a group directional (arrow) navigation searches first, and that moving between
#               sections treats as one box (the union of its controls' bounds)
#   Focusable   `.focusable(false)`: the wrapped subtree is skipped by keyboard traversal; layout, hit testing,
#               pointer focus and accessibility are unchanged

pub view FocusScope:
    bool trap = false
    [View] children
    body(): native

pub view FocusOrder:
    float value = 0.0
    [View] children
    body(): native

pub view FocusSection:
    [View] children
    body(): native

pub view Focusable:
    bool enabled = true
    [View] children
    body(): native

pub view Focused:
    bind bool value
    [View] children
    body(): native

pub view FocusedAs:
    bind string value
    string token
    [View] children
    body(): native

pub view List:
    bind string selection
    MoveAction? onMove = nil
    DeleteAction? onDelete = nil
    [View] children
    body(): native

# ── Components: Separator, Slider, Image (docs/design-notes/boring-ui-draft.md, "Layout primitives",
# "Image, Video, and asynchronous media", "Common control rules") ────────────────────────────────────
#   Separator  a thin line; inside a `Row` it is vertical, inside a `Column` (or a `List`) horizontal,
#              elsewhere `axis` is required; thickness and color come from the theme
#   Slider     `bind float value` between `min` and `max`, adjusted by pointer drag and the arrow / page /
#              Home / End keys in steps of `step` (0 = a twentieth of the range)
#   Image      a raster/vector image identified by `source` (a resource key). The headless toolkit decodes
#              nothing: the intrinsic size is given by `width` / `height`; `label` is its accessible name
#              (required unless `decorative`)

# (`HorizontalRule`/`VerticalRule`: `.Horizontal`/`.Vertical` already belong to `ScrollAxis`.)
pub enum SeparatorAxis:
    Auto
    HorizontalRule
    VerticalRule

pub view Separator:
    SeparatorAxis axis = .Auto
    body(): native

pub view Slider:
    bind float value
    float min = 0.0
    float max = 1.0
    float step = 0.0
    string label
    body(): native

pub view Image:
    string source
    float width = 0.0
    float height = 0.0
    string label = ""
    bool decorative = false
    body(): native
