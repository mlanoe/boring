# Boring standard library — boring.collections
#
# Genuine Boring-authored composite types built on top of the native `[T]`
# array — unlike `[T]`/`{T}`/`{K=V}` themselves (always-global primitives,
# see docs/book.md's "Built-in Types & Functions Reference"), `Stack<T>` and
# `Queue<T>` don't exist until you import this module:
#
#   use boring.collections.*             # everything (note: a bare
#                                         # `use boring.collections` does NOT
#                                         # mean this — see stdlib/README.md)
#   use boring.collections.Stack         # selective import
#   use boring.collections.Stack, Queue  # selective, multiple items
#
# Not to be confused with the `Stack<T, uint N>` fixed-capacity example in
# docs/book.md §13 (Const generics) — that's a teaching example for the
# `<uint N>` const-generic feature. This `Stack<T>` is the real, unbounded,
# growable stack you actually get from `use boring.collections.*`.
#
# Implementation note: deliberately built only from `isEmpty`/`count`/
# `push`/`slice`/indexing — not `.pop()`/`.first()`/`.last()`, which (as of
# this writing) the transpiler doesn't yet round-trip correctly through a
# generic method declared `T?` (see the transpiler fixes landed alongside
# this module: `emit_methods.rs`'s `is_option_expr`, `emit_let.rs`'s
# `GenericCall` struct-type tracking, `emit_expr.rs`'s constructor turbofish
# and Optional-method-call print detection). Revisit once `.pop()`'s
# `map_method` unwrap-to-default semantics and `.first()`/`.last()`'s
# missing `.cloned()` are fixed for real.

# ── Stack<T> — LIFO, backed by [T] ──────────────────────────────────────────

pub struct Stack<T>:
    pub var mut [T] items

    req bool isEmpty():
        items.isEmpty()

    req int count():
        items.count()

    def void push(T item):
        items.push(item)

    def T? pop():
        guard !items.isEmpty() else return nil
        let top = items[items.count() - 1]
        items = items.slice(0, items.count() - 1)
        top

    req T? peek():
        guard !items.isEmpty() else return nil
        items[items.count() - 1]

# ── Queue<T> — FIFO, backed by [T] ──────────────────────────────────────────

pub struct Queue<T>:
    pub var mut [T] items

    req bool isEmpty():
        items.isEmpty()

    req int count():
        items.count()

    def void enqueue(T item):
        items.push(item)

    def T? dequeue():
        guard !items.isEmpty() else return nil
        let front = items[0]
        items = items.slice(1, items.count())
        front

    req T? peek():
        guard !items.isEmpty() else return nil
        items[0]
